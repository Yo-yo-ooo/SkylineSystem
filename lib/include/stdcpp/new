// -*- C++ -*-
//=============================================================
// new.hpp -- complete <new>, C++98~C++26.
//=============================================================
#ifndef STDCPP_NEW_HPP
#define STDCPP_NEW_HPP

#include <cstddef>
#include <cstdlib>

#define STDCPP_NEW_CXX11 (__cplusplus >= 201103L)
#define STDCPP_NEW_CXX14 (__cplusplus >= 201402L)
#define STDCPP_NEW_CXX17 (__cplusplus >= 201703L)
#define STDCPP_NEW_CXX20 (__cplusplus >= 202002L)

#ifndef _GLIBCXX_NEW
#  define _GLIBCXX_NEW 1
#endif

//=============================================================
// placement new / delete
//=============================================================
#if STDCPP_NEW_CXX11
inline void* operator new(size_t, void* p) noexcept { return p; }
inline void* operator new[](size_t, void* p) noexcept { return p; }
inline void operator delete(void*, void*) noexcept {}
inline void operator delete[](void*, void*) noexcept {}
#else
inline void* operator new(size_t, void* p) throw() { return p; }
inline void* operator new[](size_t, void* p) throw() { return p; }
inline void operator delete(void*, void*) throw() {}
inline void operator delete[](void*, void*) throw() {}
#endif

namespace std {

//=============================================================
// nothrow_t
//=============================================================
#if STDCPP_NEW_CXX11
struct nothrow_t { explicit nothrow_t() = default; };
#else
struct nothrow_t {};
#endif
extern const nothrow_t nothrow;

//=============================================================
// new_handler
//=============================================================
typedef void (*new_handler)();
#if STDCPP_NEW_CXX11
new_handler set_new_handler(new_handler new_p) noexcept;
new_handler get_new_handler() noexcept;
#else
new_handler set_new_handler(new_handler new_p) throw();
new_handler get_new_handler() throw();
#endif

//=============================================================
// bad_alloc
//=============================================================
class bad_alloc {
public:
#if STDCPP_NEW_CXX11
    bad_alloc() noexcept {}
    virtual ~bad_alloc();
    virtual const char* what() const noexcept { return "std::bad_alloc"; }
#else
    bad_alloc() {}
    virtual ~bad_alloc();
    virtual const char* what() const { return "std::bad_alloc"; }
#endif
};
inline bad_alloc::~bad_alloc() {}

//=============================================================
// bad_array_new_length (C++11)
//=============================================================
#if STDCPP_NEW_CXX11
class bad_array_new_length : public bad_alloc {
public:
    bad_array_new_length() noexcept {}
    const char* what() const noexcept override { return "std::bad_array_new_length"; }
};
#endif

//=============================================================
// align_val_t (C++17)
//=============================================================
#if STDCPP_NEW_CXX17
enum class align_val_t : size_t {};
#endif

//=============================================================
// destroying_delete_t (C++20)
//=============================================================
#if STDCPP_NEW_CXX20
struct destroying_delete_t { explicit destroying_delete_t() = default; };
inline constexpr destroying_delete_t destroying_delete{};
#endif

//=============================================================
// hardware_*interference_size (C++17)
//=============================================================
#if STDCPP_NEW_CXX17
inline constexpr size_t hardware_destructive_interference_size = 64;
inline constexpr size_t hardware_constructive_interference_size = 64;
#endif

//=============================================================
// launder (C++17)
//=============================================================
#if STDCPP_NEW_CXX17
template<class T>
constexpr T* launder(T* p) noexcept {
    return __builtin_launder(p);
}
#endif

} // namespace std

//=============================================================
// non-throwing allocation operators
//=============================================================
#if STDCPP_NEW_CXX11
void* operator new(size_t size, const std::nothrow_t&) noexcept {
    void* p = nullptr;
    try { p = malloc(size); } catch (...) {}
    return p;
}
void* operator new[](size_t size, const std::nothrow_t&) noexcept {
    void* p = nullptr;
    try { p = malloc(size); } catch (...) {}
    return p;
}
void operator delete(void* ptr, const std::nothrow_t&) noexcept { free(ptr); }
void operator delete[](void* ptr, const std::nothrow_t&) noexcept { free(ptr); }
#else
void* operator new(size_t size, const std::nothrow_t&) throw() { return malloc(size); }
void* operator new[](size_t size, const std::nothrow_t&) throw() { return malloc(size); }
void operator delete(void* ptr, const std::nothrow_t&) throw() { free(ptr); }
void operator delete[](void* ptr, const std::nothrow_t&) throw() { free(ptr); }
#endif

#endif // STDCPP_NEW_HPP
