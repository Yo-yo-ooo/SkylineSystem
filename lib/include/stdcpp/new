//=============================================================
// <new> — placement / nothrow / bad_alloc / align_val_t
//
// 与旧实现的差异：
//   1. 不再包含 <cstdlib>：freestanding（-nostdinc）下根本没有该头，
//      原来靠宿主 glibc 才编得过，内核里必然失败。
//   2. nothrow 版 operator new/delete 改为 inline。原实现是头文件里的
//      非内联定义，被两个 TU 包含即 multiple definition。
//   3. 只声明 replaceable 的普通 operator new/delete，不提供定义：
//      内核已有 mem/new.cpp，用户态由 lib/stdc/stdcpp_new.cpp 提供。
//   4. `extern const nothrow_t nothrow;` 只有声明没有定义，改为 inline 变量。
//=============================================================
#ifndef STDCPP_NEW_HPP
#define STDCPP_NEW_HPP

#include <cstddef>
#include "detail/config.h"
#include "detail/throw.h"

#ifndef _GLIBCXX_NEW
#  define _GLIBCXX_NEW 1
#endif

//-------------------------------------------------------------
// replaceable 全局分配函数：仅声明，定义由平台提供
//-------------------------------------------------------------
void* operator new(std::size_t);
void* operator new[](std::size_t);
void operator delete(void*) noexcept;
void operator delete[](void*) noexcept;
void operator delete(void*, std::size_t) noexcept;
void operator delete[](void*, std::size_t) noexcept;

//-------------------------------------------------------------
// placement new / delete
//-------------------------------------------------------------
inline void* operator new(std::size_t, void* p) noexcept { return p; }
inline void* operator new[](std::size_t, void* p) noexcept { return p; }
inline void operator delete(void*, void*) noexcept {}
inline void operator delete[](void*, void*) noexcept {}

namespace std {

//-------------------------------------------------------------
// nothrow_t
//-------------------------------------------------------------
struct nothrow_t { explicit nothrow_t() = default; };
STDCPP_INLINE_VAR const nothrow_t nothrow{};

//-------------------------------------------------------------
// new_handler
//-------------------------------------------------------------
typedef void (*new_handler)();
new_handler set_new_handler(new_handler) noexcept;
new_handler get_new_handler() noexcept;

//-------------------------------------------------------------
// bad_alloc / bad_array_new_length
//-------------------------------------------------------------
class bad_alloc {
public:
    bad_alloc() noexcept {}
    bad_alloc(const bad_alloc&) noexcept {}
    bad_alloc& operator=(const bad_alloc&) noexcept { return *this; }
    virtual ~bad_alloc() noexcept {}
    virtual const char* what() const noexcept { return "std::bad_alloc"; }
};

class bad_array_new_length : public bad_alloc {
public:
    bad_array_new_length() noexcept {}
    const char* what() const noexcept override { return "std::bad_array_new_length"; }
};

#if STDCPP_CXX17
enum class align_val_t : std::size_t {};
#endif

//-------------------------------------------------------------
// launder
//-------------------------------------------------------------
template<class T>
constexpr T* launder(T* p) noexcept { return __builtin_launder(p); }

//-------------------------------------------------------------
// 干扰尺寸（仅供 API 兼容，非真实测量值）
//-------------------------------------------------------------
STDCPP_INLINE_VAR constexpr std::size_t hardware_destructive_interference_size = 64;
STDCPP_INLINE_VAR constexpr std::size_t hardware_constructive_interference_size = 64;

} // namespace std

//-------------------------------------------------------------
// nothrow 版分配：失败返回 nullptr（不抛异常）
//-------------------------------------------------------------
inline void* operator new(std::size_t size, const std::nothrow_t&) noexcept {
#if STDCPP_HAS_EXCEPTIONS
    try { return ::operator new(size); } catch (...) { return nullptr; }
#else
    return ::operator new(size);
#endif
}
inline void* operator new[](std::size_t size, const std::nothrow_t&) noexcept {
    return ::operator new(size, std::nothrow);
}
inline void operator delete(void* p, const std::nothrow_t&) noexcept { ::operator delete(p); }
inline void operator delete[](void* p, const std::nothrow_t&) noexcept { ::operator delete[](p); }

#endif // STDCPP_NEW_HPP
