template<class Iter, class Hash = hash<typename iterator_traits<Iter>::value_type>,
         class Pred = equal_to<typename iterator_traits<Iter>::value_type> >
class default_searcher {
    Iter _M_first, _M_last;
    Pred _M_pred;
public:
    default_searcher(Iter first, Iter last, Pred pred = Pred())
        : _M_first(first), _M_last(last), _M_pred(pred) {}

    template<class FIter>
    pair<FIter, FIter> operator()(FIter first, FIter last) const {
        for (FIter it = first; it != last; ++it) {
            FIter t = it;
            Iter p = _M_first;
            bool match = true;
            while (p != _M_last) {
                if (t == last || !_M_pred(*t, *p)) { match = false; break; }
                ++t; ++p;
            }
            if (match) return pair<FIter, FIter>(it, t);
        }
        return pair<FIter, FIter>(last, last);
    }
};
