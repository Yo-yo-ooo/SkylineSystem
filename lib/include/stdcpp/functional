//=============================================================
namespace __ftl
{
    // SFINAE helper: is R invocable from F(Args...) (F treated as lvalue)?
    template<class R, class F, class... Args>
    struct __callable_r
    {
        template<class G, class = decltype(
            __x_invoke_r<R>(std::declval<G&>(), std::declval<Args>()...))>
        static true_type _S_test(int);
        template<class G>
        static false_type _S_test(...);
        static constexpr bool value =
            decltype(_S_test<typename decay<F>::type>(0))::value;
    };

#if !STDCPP_CXX17
    template<class R, class... Args> struct __func_base { typedef R result_type; };
    template<class R, class A1> struct __func_base<R, A1> {
        typedef R result_type; typedef A1 argument_type;
    };
    template<class R, class A1, class A2> struct __func_base<R, A1, A2> {
        typedef R result_type; typedef A1 first_argument_type;
        typedef A2 second_argument_type;
    };
#endif
}

template<class> class function; // undefined

template<class R, class... Args>
class function<R(Args...)>
#if !STDCPP_CXX17
    : public __ftl::__func_base<R, Args...>
#endif
{
    struct _Base
    {
        virtual ~_Base() STDCPP_NOEXCEPT {}
        virtual R _invoke(Args&&... args) const = 0;
        virtual _Base* _clone(void* where) const = 0;
        virtual _Base* _move(void* where) STDCPP_NOEXCEPT = 0;
        virtual const type_info& _target_type() const STDCPP_NOEXCEPT = 0;
    };

    template<class F>
    struct _Impl : _Base
    {
        F _f;
        template<class G>
        _Impl(G&& g) : _f(std::forward<G>(g)) {}
        R _invoke(Args&&... args) const override
        {
            // std::function invokes the target as a non-const lvalue even
            // though operator() is const.
            return __ftl::__x_invoke_r<R>(
                const_cast<F&>(_f), std::forward<Args>(args)...);
        }
        _Base* _clone(void* where) const override
        { return where ? ::new (where) _Impl(_f) : new _Impl(_f); }
        _Base* _move(void* where) STDCPP_NOEXCEPT override
        { return where ? ::new (where) _Impl(std::move(_f))
                       : new _Impl(std::move(_f)); }
        const type_info& _target_type() const STDCPP_NOEXCEPT override
        { return typeid(F); }
    };

    static const size_t _BufSize  = sizeof(void*) * 3;
    static const size_t _BufAlign = alignof(max_align_t);
    using _Storage = typename aligned_storage<_BufSize, _BufAlign>::type;

    _Base*   _M_ptr;
    bool     _M_local;
    _Storage _M_buf;

    template<class FD>
    static constexpr bool _S_fits()
    {
        return sizeof(_Impl<FD>) <= _BufSize
            && alignof(_Impl<FD>) <= _BufAlign;
    }

    void _M_destroy() STDCPP_NOEXCEPT
    {
        if (!_M_ptr) return;
        if (_M_local) _M_ptr->~_Base();
        else delete _M_ptr;
        _M_ptr = nullptr;
        _M_local = false;
    }

    template<class FD, class F>
    void _M_init(F&& f, true_type)
    {
        _M_ptr = ::new (static_cast<void*>(&_M_buf)) _Impl<FD>(std::forward<F>(f));
        _M_local = true;
    }
    template<class FD, class F>
    void _M_init(F&& f, false_type)
    {
        _M_ptr = new _Impl<FD>(std::forward<F>(f));
        _M_local = false;
    }

    template<class F>
    void _M_init(F&& f)
    {
        using FD = typename decay<F>::type;
        _M_init<FD>(std::forward<F>(f),
                    integral_constant<bool, _S_fits<FD>()>{});
    }

    void _M_copy_from(const function& o)
    {
        if (!o._M_ptr) { _M_ptr = nullptr; _M_local = false; return; }
        if (o._M_local) {
            _M_ptr = o._M_ptr->_clone(&_M_buf);
            _M_local = true;
        } else {
            _M_ptr = o._M_ptr->_clone(nullptr);
            _M_local = false;
        }
    }

    void _M_move_from(function& o) STDCPP_NOEXCEPT
    {
        if (!o._M_ptr) { _M_ptr = nullptr; _M_local = false; return; }
        if (o._M_local) {
            _M_ptr = o._M_ptr->_move(&_M_buf);
            _M_local = true;
            o._M_destroy();
        } else {
            _M_ptr = o._M_ptr;
            _M_local = false;
            o._M_ptr = nullptr;
        }
    }

public:
    using result_type = R;

    STDCPP_CONSTEXPR function() STDCPP_NOEXCEPT : _M_ptr(nullptr), _M_local(false) {}
    STDCPP_CONSTEXPR function(nullptr_t) STDCPP_NOEXCEPT : _M_ptr(nullptr), _M_local(false) {}

    template<class F, class = typename enable_if<
        !is_same<typename remove_cv<typename decay<F>::type>::type, function>::value,
        decltype(__ftl::__callable_r<R, F, Args...>::value ? 0 : 0)>::type>
    function(F&& f) : _M_ptr(nullptr), _M_local(false)
    {
        static_assert(__ftl::__callable_r<R, F, Args...>::value,
                      "std::function target must be callable with the given signature");
        _M_init(std::forward<F>(f));
    }

    function(const function& o) : _M_ptr(nullptr), _M_local(false) { _M_copy_from(o); }
    function(function&& o) STDCPP_NOEXCEPT : _M_ptr(nullptr), _M_local(false) { _M_move_from(o); }

    ~function() { _M_destroy(); }

    function& operator=(const function& o)
    {
        if (this != &o) { _M_destroy(); _M_copy_from(o); }
        return *this;
    }
    function& operator=(function&& o) STDCPP_NOEXCEPT
    {
        if (this != &o) { _M_destroy(); _M_move_from(o); }
        return *this;
    }
    function& operator=(nullptr_t) STDCPP_NOEXCEPT { _M_destroy(); return *this; }

    template<class F>
    typename enable_if<
        !is_same<typename remove_cv<typename decay<F>::type>::type, function>::value,
        function&>::type
    operator=(F&& f)
    {
        function(std::forward<F>(f)).swap(*this);
        return *this;
    }

    void swap(function& o) STDCPP_NOEXCEPT
    {
        function tmp(std::move(*this));
        *this = std::move(o);
        o = std::move(tmp);
    }

    template<class F, class... A>
    void assign(F&& f, A&&... a)
    { function(std::bind(std::forward<F>(f), std::forward<A>(a)...)).swap(*this); }

    explicit operator bool() const STDCPP_NOEXCEPT { return _M_ptr != nullptr; }

    R operator()(Args... args) const
    {
        if (!_M_ptr) throw bad_function_call();
        return _M_ptr->_invoke(std::forward<Args>(args)...);
    }

    const type_info& target_type() const STDCPP_NOEXCEPT
    { return _M_ptr ? _M_ptr->_target_type() : typeid(void); }

    template<class F> F* target() STDCPP_NOEXCEPT
    {
        if (_M_ptr && _M_ptr->_target_type() == typeid(F))
            return &(static_cast<_Impl<F>*>(_M_ptr)->_f);
        return nullptr;
    }
    template<class F> const F* target() const STDCPP_NOEXCEPT
    {
        if (_M_ptr && _M_ptr->_target_type() == typeid(F))
            return &(static_cast<const _Impl<F>*>(_M_ptr)->_f);
        return nullptr;
    }
};

template<class R, class... Args>
inline void swap(function<R(Args...)>& a, function<R(Args...)>& b) STDCPP_NOEXCEPT
{ a.swap(b); }

