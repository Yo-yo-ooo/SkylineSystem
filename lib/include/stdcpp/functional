    static_assert(is_invocable_r_v<R, const F&, ArgTypes...>, \
        "const copyable_function target must be const-callable")
#define STDCPP_CF_REQ_NOEX \
    static_assert(is_nothrow_invocable_r_v<R, F&, ArgTypes...>, \
        "noexcept copyable_function target must be nothrow-callable")
#define STDCPP_CF_REQ_CONST_NOEX \
    static_assert(is_nothrow_invocable_r_v<R, const F&, ArgTypes...>, \
        "const noexcept copyable_function target must be const-nothrow-callable")

#define STDCPP_CF_CALL_LV  (__ftl::__x_invoke_r<R>(_f, std::forward<ArgTypes>(args)...))
#define STDCPP_CF_CALL_RV  (__ftl::__x_invoke_r<R>(std::move(_f), std::forward<ArgTypes>(args)...))

STDCPP_CF_SPEC(,                 ,                STDCPP_CF_CALL_LV, ,          STDCPP_CF_REQ_PLAIN, _M_ptr->)
STDCPP_CF_SPEC(noexcept,         ,                STDCPP_CF_CALL_LV, noexcept,   STDCPP_CF_REQ_NOEX, _M_ptr->)
STDCPP_CF_SPEC(const,            const,           STDCPP_CF_CALL_LV, ,          STDCPP_CF_REQ_CONST, _M_ptr->)
STDCPP_CF_SPEC(const noexcept,   const,           STDCPP_CF_CALL_LV, noexcept,   STDCPP_CF_REQ_CONST_NOEX, _M_ptr->)
STDCPP_CF_SPEC(&,                &,               STDCPP_CF_CALL_LV, ,          STDCPP_CF_REQ_PLAIN, _M_ptr->)
STDCPP_CF_SPEC(& noexcept,       &,               STDCPP_CF_CALL_LV, noexcept,   STDCPP_CF_REQ_NOEX, _M_ptr->)
STDCPP_CF_SPEC(const &,          const &,         STDCPP_CF_CALL_LV, ,          STDCPP_CF_REQ_CONST, _M_ptr->)
STDCPP_CF_SPEC(const & noexcept, const &,         STDCPP_CF_CALL_LV, noexcept,   STDCPP_CF_REQ_CONST_NOEX, _M_ptr->)
STDCPP_CF_SPEC(&&,               &&,              STDCPP_CF_CALL_RV, ,          STDCPP_CF_REQ_PLAIN, std::move(*_M_ptr).)
STDCPP_CF_SPEC(&& noexcept,      &&,              STDCPP_CF_CALL_RV, noexcept,   STDCPP_CF_REQ_NOEX, std::move(*_M_ptr).)
STDCPP_CF_SPEC(const &&,         const &&,        STDCPP_CF_CALL_RV, ,          STDCPP_CF_REQ_CONST, std::move(*_M_ptr).)
STDCPP_CF_SPEC(const && noexcept,const &&,        STDCPP_CF_CALL_RV, noexcept,   STDCPP_CF_REQ_CONST_NOEX, std::move(*_M_ptr).)

#undef STDCPP_CF_SPEC
#undef STDCPP_CF_BUF_INIT
#undef STDCPP_CF_CALL_LV
#undef STDCPP_CF_CALL_RV
#undef STDCPP_CF_REQ_PLAIN
#undef STDCPP_CF_REQ_CONST
#undef STDCPP_CF_REQ_NOEX
#undef STDCPP_CF_REQ_CONST_NOEX

