//=============================================================
//  Searchers  [func.search]  (C++17)
//=============================================================
#if STDCPP_CXX17
namespace __ftl
{
    // Minimal iterator value type (we do not include <iterator>).
    template<class It> struct __iter_val { typedef typename It::value_type type; };
    template<class T> struct __iter_val<T*> { typedef T type; };
    template<class T> struct __iter_val<const T*> { typedef T type; };

    // Simple RAII dynamic array.
    template<class T>
    class __array_owner
    {
        T* _p;
        size_t _n;
        __array_owner(const __array_owner&);
        __array_owner& operator=(const __array_owner&);
    public:
        explicit __array_owner(size_t n) : _p(n ? new T[n] : nullptr), _n(n) {}
        ~__array_owner() { delete[] _p; }
        T& operator[](size_t i) { return _p[i]; }
        const T& operator[](size_t i) const { return _p[i]; }
        T* get() { return _p; }
        const T* get() const { return _p; }
        size_t size() const { return _n; }
    };

    // Minimal advance (we cannot include <iterator>). The searchers require
    // random-access iterators, so += is always well-formed.
    template<class It, class D>
    inline void __advance(It& it, D n) { it += n; }

    // Open-addressing hash map from pattern character -> rightmost index.
    template<class Key, class Hash, class Pred>
    class __bm_bad_char
    {
        struct Slot { Key key; ptrdiff_t pos; bool used; };
        Slot* _slots;
        size_t _mask;
        Hash  _hash;
        Pred  _pred;

        size_t _idx(const Key& k) const
        { return static_cast<size_t>(_hash(k)) & _mask; }

    public:
        __bm_bad_char(size_t pat_len, Hash h, Pred p)
            : _slots(nullptr), _mask(0), _hash(h), _pred(p)
        {
            size_t cap = 4;
            while (cap < pat_len * 2 + 8) cap <<= 1;
            _mask = cap - 1;
            _slots = new Slot[cap];
            for (size_t i = 0; i < cap; ++i) _slots[i].used = false;
        }
        ~__bm_bad_char() { delete[] _slots; }

        void set(const Key& k, ptrdiff_t pos)
        {
            size_t i = _idx(k);
            while (_slots[i].used) {
                if (_pred(_slots[i].key, k)) { _slots[i].pos = pos; return; }
                i = (i + 1) & _mask;
            }
            _slots[i].used = true;
            _slots[i].key = k;
            _slots[i].pos = pos;
        }

        ptrdiff_t get(const Key& k, ptrdiff_t def) const
        {
            size_t i = _idx(k);
            while (_slots[i].used) {
                if (_pred(_slots[i].key, k)) return _slots[i].pos;
                i = (i + 1) & _mask;
            }
            return def;
        }
    };
}

// ---- default_searcher ------------------------------------------
template<class Iter,
         class Hash = hash<typename __ftl::__iter_val<Iter>::type>,
         class Pred = equal_to<>>
class default_searcher
{
    Iter _first, _last;
    Hash _hash;
    Pred _pred;
public:
    default_searcher(Iter first, Iter last, Hash h = Hash(), Pred p = Pred())
        : _first(first), _last(last), _hash(h), _pred(p) {}

    template<class FIter>
    pair<FIter, FIter> operator()(FIter first, FIter last) const
    {
        for (;;) {
            FIter it = first;
            Iter pat = _first;
            while (it != last && pat != _last && _pred(*it, *pat)) { ++it; ++pat; }
            if (pat == _last) return { first, it };
            if (it == last) return { last, last };
            ++first;
        }
    }
};

// ---- boyer_moore_horspool_searcher -----------------------------
template<class Iter,
         class Hash = hash<typename __ftl::__iter_val<Iter>::type>,
         class Pred = equal_to<>>
class boyer_moore_horspool_searcher
{
    using K = typename __ftl::__iter_val<Iter>::type;

    __ftl::__array_owner<K> _pat;
    size_t _m;
    __ftl::__bm_bad_char<K, Hash, Pred> _bc;
    Pred _pred;

    boyer_moore_horspool_searcher(Iter first, Iter last, size_t m,
                                  Hash h, Pred p)
        : _pat(m), _m(m), _bc(m, h, p), _pred(p)
    {
        size_t i = 0;
        for (Iter it = first; it != last; ++it, ++i) _pat[i] = *it;
        for (size_t k = 0; k + 1 < _m; ++k) _bc.set(_pat[k], (ptrdiff_t)k);
    }

public:
    boyer_moore_horspool_searcher(Iter first, Iter last,
                                  Hash h = Hash(), Pred p = Pred())
        : _pat(0), _m(0), _bc(0, h, p), _pred(p)
    {
        size_t m = 0;
        for (Iter it = first; it != last; ++it) ++m;
        this->~boyer_moore_horspool_searcher();
        new (this) boyer_moore_horspool_searcher(first, last, m, h, p);
    }

    template<class FIter>
    pair<FIter, FIter> operator()(FIter first, FIter last) const
    {
        if (_m == 0) return { first, first };
        size_t n = 0;
        for (FIter it = first; it != last; ++it) ++n;
        if (n < _m) return { last, last };

        size_t i = 0;
        while (i <= n - _m) {
            ptrdiff_t j = (ptrdiff_t)_m - 1;
            FIter cur = first;
            __ftl::__advance(cur, i + (size_t)j);
            while (j >= 0 && _pred(_pat[(size_t)j], *cur)) {
                --j;
                if (j >= 0) --cur;
            }
            if (j < 0) {
                FIter r = first;
                __ftl::__advance(r, i);
                FIter r2 = r;
                __ftl::__advance(r2, _m);
                return { r, r2 };
            }
            FIter last_cur = first;
            __ftl::__advance(last_cur, i + _m - 1);
            ptrdiff_t pos = _bc.get(*last_cur, -1);
            size_t shift = (pos < (ptrdiff_t)_m - 1)
                ? (size_t)((ptrdiff_t)_m - 1 - pos) : 1;
            i += shift;
        }
        return { last, last };
    }
};

// ---- boyer_moore_searcher --------------------------------------
template<class Iter,
         class Hash = hash<typename __ftl::__iter_val<Iter>::type>,
         class Pred = equal_to<>>
class boyer_moore_searcher
{
    using K = typename __ftl::__iter_val<Iter>::type;

    __ftl::__array_owner<K> _pat;
    size_t _m;
    __ftl::__bm_bad_char<K, Hash, Pred> _bc;
    __ftl::__array_owner<ptrdiff_t> _gs; // good-suffix table, size m+1
    Pred _pred;

    void _build_good_suffix()
    {
        if (_m == 0) return;
        __ftl::__array_owner<ptrdiff_t> suff(_m);
        suff[_m - 1] = (ptrdiff_t)_m;
        ptrdiff_t g = (ptrdiff_t)_m - 1, f = 0;
        for (ptrdiff_t i = (ptrdiff_t)_m - 2; i >= 0; --i) {
            if (i > g && suff[(size_t)(i + (ptrdiff_t)_m - 1 - f)] < i - g) {
                suff[(size_t)i] = suff[(size_t)(i + (ptrdiff_t)_m - 1 - f)];
            } else {
                if (i < g) g = i;
                f = i;
                while (g >= 0 && _pred(_pat[(size_t)g],
                                      _pat[(size_t)(g + (ptrdiff_t)_m - 1 - f)]))
                    --g;
                suff[(size_t)i] = f - g;
            }
        }
        for (size_t i = 0; i <= _m; ++i) _gs[i] = (ptrdiff_t)_m;
        ptrdiff_t j = 0;
        for (ptrdiff_t i = (ptrdiff_t)_m - 1; i >= 0; --i) {
            if (suff[(size_t)i] == i + 1) {
                for (; j < (ptrdiff_t)_m - 1 - i; ++j)
                    if (_gs[(size_t)j] == (ptrdiff_t)_m)
                        _gs[(size_t)j] = (ptrdiff_t)_m - 1 - i;
            }
        }
        for (size_t i = 0; i <= _m - 2; ++i)
            _gs[_m - 1 - (size_t)suff[i]] = (ptrdiff_t)_m - 1 - (ptrdiff_t)i;
    }

    boyer_moore_searcher(Iter first, Iter last, size_t m, Hash h, Pred p)
        : _pat(m), _m(m), _bc(m, h, p), _gs(m + 1), _pred(p)
    {
        size_t i = 0;
        for (Iter it = first; it != last; ++it, ++i) _pat[i] = *it;
        for (size_t k = 0; k < _m; ++k) _bc.set(_pat[k], (ptrdiff_t)k);
        _build_good_suffix();
    }

public:
    boyer_moore_searcher(Iter first, Iter last,
                         Hash h = Hash(), Pred p = Pred())
        : _pat(0), _m(0), _bc(0, h, p), _gs(0), _pred(p)
    {
        size_t m = 0;
        for (Iter it = first; it != last; ++it) ++m;
        new (this) boyer_moore_searcher(first, last, m, h, p);
    }

    template<class FIter>
    pair<FIter, FIter> operator()(FIter first, FIter last) const
    {
        if (_m == 0) return { first, first };
        size_t n = 0;
        for (FIter it = first; it != last; ++it) ++n;
        if (n < _m) return { last, last };

        size_t i = 0;
        while (i <= n - _m) {
            ptrdiff_t j = (ptrdiff_t)_m - 1;
            FIter cur = first;
            __ftl::__advance(cur, i + (size_t)j);
            while (j >= 0 && _pred(_pat[(size_t)j], *cur)) {
                --j;
                if (j >= 0) --cur;
            }
            if (j < 0) {
                FIter r = first;
                __ftl::__advance(r, i);
                FIter r2 = r;
                __ftl::__advance(r2, _m);
                return { r, r2 };
            }
            ptrdiff_t pos = _bc.get(*cur, -1);
            size_t bc = (pos < j) ? (size_t)(j - pos) : 1;
            size_t gs = (size_t)_gs[(size_t)j];
            i += (bc > gs ? bc : gs);
        }
        return { last, last };
    }
};
#endif // C++17

