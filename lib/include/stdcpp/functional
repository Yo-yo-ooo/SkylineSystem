template<class T> struct hash<T*> {
    size_t operator()(T* p) const noexcept { return (size_t)p; }
};

template<> struct hash<float> {
    size_t operator()(float v) const noexcept {
        size_t r; __builtin_memcpy(&r, &v, sizeof(float)); return r;
    }
};
template<> struct hash<double> {
    size_t operator()(double v) const noexcept {
        size_t r; __builtin_memcpy(&r, &v, sizeof(double)); return r;
    }
};

//=============================================================
// reference_wrapper (C++11)
//=============================================================
#if STDCPP_FN_CXX11
template<class T>
class reference_wrapper {
    T* _M_ptr;
public:
    typedef T type;

    reference_wrapper(T& t) noexcept : _M_ptr(&t) {}
    reference_wrapper(T&&) = delete;

    operator T&() const noexcept { return *_M_ptr; }
    T& get() const noexcept { return *_M_ptr; }

    template<class... Args>
    auto operator()(Args&&... args) const
        -> decltype((*_M_ptr)(std::forward<Args>(args)...)) {
        return (*_M_ptr)(std::forward<Args>(args)...);
    }
};

template<class T>
reference_wrapper<T> ref(T& t) noexcept { return reference_wrapper<T>(t); }
template<class T>
reference_wrapper<const T> cref(const T& t) noexcept { return reference_wrapper<const T>(t); }
template<class T>
void ref(const T&&) = delete;
template<class T>
void cref(const T&&) = delete;
#endif

//=============================================================
// function (C++11)
//=============================================================
#if STDCPP_FN_CXX11
template<class> class function;

template<class R, class... Args>
class function<R(Args...)> {
    struct _base {
        virtual ~_base() {}
        virtual _base* _M_copy() const = 0;
        virtual R _M_call(Args... args) = 0;
    };
    template<class F>
    struct _holder : _base {
        F _M_f;
        _holder(const F& f) : _M_f(f) {}
        _holder(F&& f) : _M_f(std::move(f)) {}
        _base* _M_copy() const override { return new _holder(_M_f); }
        R _M_call(Args... args) override { return _M_f(std::forward<Args>(args)...); }
    };

    _base* _M_ptr;
public:
    function() noexcept : _M_ptr(nullptr) {}
    function(nullptr_t) noexcept : _M_ptr(nullptr) {}

    template<class F>
    function(F f) : _M_ptr(new _holder<F>(std::move(f))) {}

    function(const function& other) : _M_ptr(other._M_ptr ? other._M_ptr->_M_copy() : nullptr) {}
    function(function&& other) noexcept : _M_ptr(other._M_ptr) { other._M_ptr = nullptr; }

    ~function() { delete _M_ptr; }

    function& operator=(const function& other) {
        if (this != &other) {
            delete _M_ptr;
            _M_ptr = other._M_ptr ? other._M_ptr->_M_copy() : nullptr;
        }
        return *this;
    }
    function& operator=(function&& other) noexcept {
        delete _M_ptr;
        _M_ptr = other._M_ptr;
        other._M_ptr = nullptr;
        return *this;
    }
    function& operator=(nullptr_t) noexcept {
        delete _M_ptr; _M_ptr = nullptr; return *this;
    }

    template<class F>
    function& operator=(F&& f) {
        delete _M_ptr;
        _M_ptr = new _holder<typename decay<F>::type>(std::forward<F>(f));
        return *this;
    }

    explicit operator bool() const noexcept { return _M_ptr != nullptr; }

    R operator()(Args... args) const {
        return _M_ptr->_M_call(std::forward<Args>(args)...);
    }

    void swap(function& other) noexcept { std::swap(_M_ptr, other._M_ptr); }
};

template<class R, class... Args>
void swap(function<R(Args...)>& a, function<R(Args...)>& b) noexcept { a.swap(b); }
#endif

//=============================================================
// bind / mem_fn (simplified C++11)
//=============================================================
#if STDCPP_FN_CXX11
namespace __placeholders {
    struct _ph {};
}
namespace placeholders {
    constexpr __placeholders::_ph _1{};
    constexpr __placeholders::_ph _2{};
    constexpr __placeholders::_ph _3{};
}

template<class R, class C, class... A>
class mem_fn_t {
    R (C::*_M_pm)(A...);
public:
    mem_fn_t(R (C::*pm)(A...)) : _M_pm(pm) {}
    R operator()(C& c, A... a) const { return (c.*_M_pm)(std::forward<A>(a)...); }
    R operator()(C* c, A... a) const { return (c->*_M_pm)(std::forward<A>(a)...); }
};

template<class R, class C, class... A>
mem_fn_t<R, C, A...> mem_fn(R (C::*pm)(A...)) { return mem_fn_t<R, C, A...>(pm); }
#endif

//=============================================================
// invoke (C++17)
//=============================================================
#if STDCPP_FN_CXX17
template<class F, class... Args>
auto invoke(F&& f, Args&&... args)
    -> decltype(std::forward<F>(f)(std::forward<Args>(args)...)) {
    return std::forward<F>(f)(std::forward<Args>(args)...);
}

template<class R, class F, class... Args>
R invoke_r(F&& f, Args&&... args) {
    return static_cast<R>(std::invoke(std::forward<F>(f), std::forward<Args>(args)...));
}
#endif

//=============================================================
// not_fn (C++17)
//=============================================================
#if STDCPP_FN_CXX17
template<class F>
struct not_fn_t {
    F _M_f;
    explicit not_fn_t(F&& f) : _M_f(std::move(f)) {}
    template<class... Args>
    auto operator()(Args&&... args) & -> decltype(!_M_f(std::forward<Args>(args)...)) {
        return !_M_f(std::forward<Args>(args)...);
    }
    template<class... Args>
    auto operator()(Args&&... args) const& -> decltype(!_M_f(std::forward<Args>(args)...)) {
        return !_M_f(std::forward<Args>(args)...);
    }
};

template<class F>
not_fn_t<typename decay<F>::type> not_fn(F&& f) {
    return not_fn_t<typename decay<F>::type>(std::forward<F>(f));
}
#endif

//=============================================================
// boyer_moore_searcher / boyer_moore_horspool_searcher (C++17)
//=============================================================
#if STDCPP_FN_CXX17
template<class Iter, class Hash = hash<typename iterator_traits<Iter>::value_type>,
         class Pred = equal_to<typename iterator_traits<Iter>::value_type> >
class boyer_moore_horspool_searcher {
    Iter _M_first, _M_last;
    Hash _M_hash;
    Pred _M_pred;
public:
    boyer_moore_horspool_searcher(Iter first, Iter last, Hash hf = Hash(), Pred pred = Pred())
        : _M_first(first), _M_last(last), _M_hash(hf), _M_pred(pred) {}

    template<class FIter>
    pair<FIter, FIter> operator()(FIter first, FIter last) const {
        size_t m = distance(_M_first, _M_last);
        size_t n = distance(first, last);
        if (m == 0) return pair<FIter, FIter>(first, first);
        if (n < m) return pair<FIter, FIter>(last, last);

        size_t skip[256];
        for (size_t i = 0; i < 256; ++i) skip[i] = m;
        size_t idx = 0;
        for (Iter it = _M_first; it != _M_last; ++it, ++idx) {
            skip[(unsigned char)_M_hash(*it) % 256] = m - 1 - idx;
        }

        FIter cur = first;
        advance(cur, m - 1);
        while (cur != last) {
            FIter t = cur;
            Iter p = _M_last;
            --p;
            bool match = true;
            for (size_t i = 0; i < m; ++i) {
                if (!_M_pred(*t, *p)) { match = false; break; }
                --t; --p;
            }
            if (match) {
                FIter r = cur;
                advance(r, -(ptrdiff_t)(m - 1));
                FIter r2 = r;
                advance(r2, m);
                return pair<FIter, FIter>(r, r2);
            }
            size_t s = skip[(unsigned char)_M_hash(*cur) % 256];
            if (s == 0) s = 1;
            advance(cur, s);
        }
        return pair<FIter, FIter>(last, last);
    }
};

template<class Iter, class Hash = hash<typename iterator_traits<Iter>::value_type>,
