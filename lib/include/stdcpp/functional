// -*- C++ -*-
//=============================================================
// functional.hpp  --  a complete, self-contained implementation
// of the C++ standard library header <functional>, covering
// C++98 / C++03 / C++11 / C++14 / C++17 / C++20 / C++23 / C++26.
//
// This file is written as a drop-in replacement: everything lives
// in namespace std.  It only depends on a minimal set of compiler
// support headers so that it does not collide with libstdc++'s own
// <bits/stl_function.h> / <bits/functional_hash.h>:
//
//   <cstddef> <cstdint> <cstring> <exception> <new> <typeinfo>
//   <type_traits> <utility> <tuple> <initializer_list>
//
// It compiles with GCC in -std=c++98 through -std=c++2b.
//
// NOTE: this header defines the full set of <functional> entities
// itself, so do not include it together with the system <functional>
// nor with headers that transitively pull in libstdc++'s functional
// bits (e.g. <algorithm>, <memory>, <vector>, <string>, <iterator>).
// It is intended as a standalone replacement, used with freestanding
// / minimal include sets such as <cstdio> / <cassert>.
//=============================================================
#ifndef STDCPP_FUNCTIONAL_HPP
#define STDCPP_FUNCTIONAL_HPP

//-------------------------------------------------------------
// Version detection (must come before any conditional includes).
// GCC/clang use non-final experimental values (e.g. 202100L for
// the C++23 draft); accept those as the corresponding standard.
// A value may be overridden on the command line (-DSTDCPP_CXX26=1).
//-------------------------------------------------------------
#define STDCPP_CXX98 1
#define STDCPP_CXX11 (__cplusplus >= 201103L)
#define STDCPP_CXX14 (__cplusplus >= 201402L)
#define STDCPP_CXX17 (__cplusplus >= 201703L)
#define STDCPP_CXX20 (__cplusplus >= 202002L)
#ifndef STDCPP_CXX23
#  define STDCPP_CXX23 (__cplusplus >= 202302L || __cplusplus == 202100L)
#endif
#ifndef STDCPP_CXX26
#  define STDCPP_CXX26 (__cplusplus > 202302L)
#endif

