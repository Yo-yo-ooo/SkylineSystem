// ---- unary_negate / binary_negate ------------------------------
template<class Pred>
class unary_negate
    : public unary_function<typename Pred::argument_type, bool>
{
protected:
    Pred pred;
public:
    explicit unary_negate(const Pred& x) : pred(x) {}
    bool operator()(const typename Pred::argument_type& x) const
    { return !pred(x); }
#if STDCPP_CXX11
    bool operator()(typename Pred::argument_type& x) const
    { return !pred(x); }
#endif
};

template<class Pred>
inline unary_negate<Pred> not1(const Pred& pred)
{ return unary_negate<Pred>(pred); }

template<class Pred>
class binary_negate
    : public binary_function<typename Pred::first_argument_type,
                             typename Pred::second_argument_type, bool>
{
protected:
    Pred pred;
public:
    explicit binary_negate(const Pred& x) : pred(x) {}
    bool operator()(const typename Pred::first_argument_type& x,
                    const typename Pred::second_argument_type& y) const
    { return !pred(x, y); }
#if STDCPP_CXX11
    bool operator()(typename Pred::first_argument_type& x,
                    typename Pred::second_argument_type& y) const
    { return !pred(x, y); }
#endif
};

template<class Pred>
inline binary_negate<Pred> not2(const Pred& pred)
{ return binary_negate<Pred>(pred); }

