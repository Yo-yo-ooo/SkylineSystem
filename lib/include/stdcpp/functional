#if STDCPP_CXX26
template<class... _Sigs> class function_ref; // primary, undefined

#define STDCPP_FREF_SPEC(_NAMESIG, _QUAL, _PTR, _FCV, _NOEXCEPT)                      \
template<class R, class... ArgTypes>                                         \
class function_ref<R(ArgTypes...) _NAMESIG> {                                \
    using _Thunk = R(*)(_PTR, ArgTypes...);                                  \
    _PTR _obj = nullptr;                                                     \
    _Thunk _thunk = nullptr;                                                 \
    template<class F> static R _thunk_obj(_PTR p, ArgTypes... args)          \
        _NOEXCEPT {                                                          \
        return __ftl::__x_invoke_r<R>(*static_cast<_FCV F*>(p),             \
            std::forward<ArgTypes>(args)...);                                \
    }                                                                        \
    static R _thunk_fn(_PTR p, ArgTypes... args) _NOEXCEPT {                 \
        using FP = R(*)(ArgTypes...);                                        \
        return __ftl::__x_invoke_r<R>(reinterpret_cast<FP>(p),               \
            std::forward<ArgTypes>(args)...);                                \
    }                                                                        \
public:                                                                      \
    function_ref() noexcept = default;                                       \
    function_ref(nullptr_t) noexcept {}                                      \
    /* lvalue callable object */                                             \
    template<class F, class = enable_if_t<                                    \
        is_lvalue_reference_v<F&&>                                           \
        && !is_same_v<remove_cvref_t<F>, function_ref>                       \
        && !is_function_v<remove_cvref_t<F>>>>                               \
    function_ref(F&& f) noexcept                                             \
        : _obj(static_cast<_PTR>(const_cast<void*>(                          \
            static_cast<const volatile void*>(&f)))),                        \
          _thunk(&_thunk_obj<remove_reference_t<F>>) {}                      \
    /* function pointer */                                                   \
    template<class F, class = enable_if_t<is_function_v<F>>>                 \
    function_ref(F* fp) noexcept                                             \
        : _obj(reinterpret_cast<_PTR>(fp)), _thunk(&_thunk_fn) {}            \
    function_ref(const function_ref&) noexcept = default;                    \
    function_ref& operator=(const function_ref&) noexcept = default;         \
    function_ref& operator=(nullptr_t) noexcept {                            \
        _obj = nullptr; _thunk = nullptr; return *this;                      \
    }                                                                        \
    explicit operator bool() const noexcept { return _thunk != nullptr; }   \
    R operator()(ArgTypes... args) _QUAL _NOEXCEPT {                         \
        return _thunk(_obj, std::forward<ArgTypes>(args)...);                \
    }                                                                        \
    friend bool operator==(const function_ref& f, nullptr_t) noexcept        \
    { return !f._thunk; }                                                    \
    friend bool operator==(nullptr_t, const function_ref& f) noexcept        \
    { return !f._thunk; }                                                    \
    friend bool operator!=(const function_ref& f, nullptr_t) noexcept        \
    { return (bool)f._thunk; }                                               \
    friend bool operator!=(nullptr_t, const function_ref& f) noexcept        \
    { return (bool)f._thunk; }                                               \
    void swap(function_ref& o) noexcept {                                    \
        _PTR to = _obj; _obj = o._obj; o._obj = to;                          \
        _Thunk tt = _thunk; _thunk = o._thunk; o._thunk = tt;                \
    }                                                                        \
};

