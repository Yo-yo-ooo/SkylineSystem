namespace __ftl
{
    inline size_t __hash_float_bits(const void* p, size_t n) STDCPP_NOEXCEPT
    {
        // -0.0 and +0.0 must hash equal; the caller has already handled 0.
        const unsigned char* b = static_cast<const unsigned char*>(p);
        size_t h = 0;
        for (size_t i = 0; i < n; ++i)
            h = h * 131u + b[i];
        return h;
    }
}

#define STDCPP_HASH_FLOAT(T, UT)                                               \
template<> struct hash<T> {                                                 \
    size_t operator()(T v) const STDCPP_NOEXCEPT {                             \
        if (v == T(0)) return 0;                                            \
        UT u; std::memcpy(&u, &v, sizeof(T));                               \
        return static_cast<size_t>(u);                                      \
    }                                                                       \
};

STDCPP_HASH_FLOAT(float,       uint32_t)
STDCPP_HASH_FLOAT(double,      uint64_t)
#undef STDCPP_HASH_FLOAT

template<> struct hash<long double> {
    size_t operator()(long double v) const STDCPP_NOEXCEPT {
        if (v == 0.0L) return 0;
        return __ftl::__hash_float_bits(&v, sizeof(long double));
    }
};

