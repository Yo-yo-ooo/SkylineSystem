//=============================================================
// unary_function / binary_function (C++98, deprecated C++11, removed C++17)
//=============================================================
template<class Arg, class Result>
struct unary_function {
    typedef Arg    argument_type;
    typedef Result result_type;
};

template<class Arg1, class Arg2, class Result>
struct binary_function {
    typedef Arg1   first_argument_type;
    typedef Arg2   second_argument_type;
    typedef Result result_type;
};

//=============================================================
// arithmetic functors
//=============================================================
template<class T = void>
struct plus : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a + b; }
};
template<class T = void>
struct minus : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a - b; }
};
template<class T = void>
struct multiplies : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a * b; }
};
template<class T = void>
struct divides : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a / b; }
};
template<class T = void>
struct modulus : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a % b; }
};
template<class T = void>
struct negate : unary_function<T, T> {
    T operator()(const T& a) const { return -a; }
};

//=============================================================
// comparison functors
//=============================================================
template<class T = void>
struct equal_to : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a == b; }
};
template<class T = void>
struct not_equal_to : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a != b; }
};
template<class T = void>
struct greater : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a > b; }
};
template<class T = void>
struct less : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a < b; }
};
template<class T = void>
struct greater_equal : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a >= b; }
};
template<class T = void>
struct less_equal : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a <= b; }
};

//=============================================================
// logical functors
//=============================================================
template<class T = void>
struct logical_and : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a && b; }
};
template<class T = void>
struct logical_or : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return a || b; }
};
template<class T = void>
struct logical_not : unary_function<T, bool> {
    bool operator()(const T& a) const { return !a; }
};

//=============================================================
// bitwise functors
//=============================================================
template<class T = void>
struct bit_and : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a & b; }
};
template<class T = void>
struct bit_or : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a | b; }
};
template<class T = void>
struct bit_xor : binary_function<T, T, T> {
    T operator()(const T& a, const T& b) const { return a ^ b; }
};
template<class T = void>
struct bit_not : unary_function<T, T> {
    T operator()(const T& a) const { return ~a; }
};

