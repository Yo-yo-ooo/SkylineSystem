    size_t operator()(T* p) const STDCPP_NOEXCEPT
    { return reinterpret_cast<size_t>(p); }
};

template<> struct hash<nullptr_t> {
    size_t operator()(nullptr_t) const STDCPP_NOEXCEPT { return 0; }
};

