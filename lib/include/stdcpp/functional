namespace __ftl
{
    struct __x_invoke_memfun_ref  {};
    struct __x_invoke_memfun_deref{};
    struct __x_invoke_memobj_ref  {};
    struct __x_invoke_memobj_deref{};
    struct __x_invoke_other      {};

    // Determine which invocation form to use for (f, first_arg).
    template<class F, class FirstArg>
    struct __x_invoke_tag { typedef __x_invoke_other type; };

    template<class R, class C, class FirstArg>
    struct __x_invoke_tag<R C::*, FirstArg>
    {
    private:
        typedef typename remove_cv<FirstArg>::type _D;
        static const bool __is_ref = is_base_of<C, _D>::value;
        typedef typename conditional<is_function<R>::value,
                    __x_invoke_memfun_ref, __x_invoke_memobj_ref>::type _Ref;
        typedef typename conditional<is_function<R>::value,
                    __x_invoke_memfun_deref, __x_invoke_memobj_deref>::type _Deref;
    public:
        typedef typename conditional<__is_ref, _Ref, _Deref>::type type;
    };

    // member function, object is an lvalue of class type (or derived)
    template<class R, class C, class T1, class... Args>
    auto __x_invoke_impl(__x_invoke_memfun_ref, R C::* f, T1&& t1, Args&&... args)
        -> decltype((std::forward<T1>(t1).*f)(std::forward<Args>(args)...))
    { return (std::forward<T1>(t1).*f)(std::forward<Args>(args)...); }

    // member function, object reached via dereference (pointer / smart ptr)
    template<class R, class C, class T1, class... Args>
    auto __x_invoke_impl(__x_invoke_memfun_deref, R C::* f, T1&& t1, Args&&... args)
        -> decltype(((*std::forward<T1>(t1)).*f)(std::forward<Args>(args)...))
    { return ((*std::forward<T1>(t1)).*f)(std::forward<Args>(args)...); }

    // member object, class-type lvalue
    template<class R, class C, class T1>
    auto __x_invoke_impl(__x_invoke_memobj_ref, R C::* f, T1&& t1)
        -> decltype(std::forward<T1>(t1).*f)
    { return std::forward<T1>(t1).*f; }

    // member object, via dereference
    template<class R, class C, class T1>
    auto __x_invoke_impl(__x_invoke_memobj_deref, R C::* f, T1&& t1)
        -> decltype((*std::forward<T1>(t1)).*f)
    { return (*std::forward<T1>(t1)).*f; }

    // free function / function object
    template<class F, class... Args>
    auto __x_invoke_impl(__x_invoke_other, F&& f, Args&&... args)
        -> decltype(std::forward<F>(f)(std::forward<Args>(args)...))
    { return std::forward<F>(f)(std::forward<Args>(args)...); }

    // Pick the tag for the first argument (or __x_invoke_other if none).
    template<class F, class... Args>
    struct __x_invoke_first { typedef __x_invoke_other type; };

    template<class F, class First, class... Rest>
    struct __x_invoke_first<F, First, Rest...>
    {
        typedef typename __x_invoke_tag<
            typename decay<F>::type,
            typename decay<First>::type>::type type;
    };

    template<class F, class... Args>
    STDCPP_CONSTEXPR14
    auto __x_invoke(F&& f, Args&&... args)
        -> decltype(__x_invoke_impl(
              std::declval<typename __x_invoke_first<F, Args...>::type>(),
              std::forward<F>(f), std::forward<Args>(args)...))
    {
        typedef typename __x_invoke_first<F, Args...>::type _Tag;
        return __x_invoke_impl(_Tag(),
                             std::forward<F>(f), std::forward<Args>(args)...);
    }

    // INVOKE<R>: same as INVOKE but with an explicit return type R.
    template<class R, class F, class... Args>
    inline STDCPP_CONSTEXPR14
    typename enable_if<!is_void<R>::value, R>::type
    __x_invoke_r(F&& f, Args&&... args)
    {
        return static_cast<R>(
            __x_invoke(std::forward<F>(f), std::forward<Args>(args)...));
    }

    template<class R, class F, class... Args>
    inline STDCPP_CONSTEXPR14
    typename enable_if<is_void<R>::value, R>::type
    __x_invoke_r(F&& f, Args&&... args)
    {
        __x_invoke(std::forward<F>(f), std::forward<Args>(args)...);
    }

    // addressof without including <memory>
    template<class T>
    inline T* __addressof(T& r) STDCPP_NOEXCEPT
    { return __builtin_addressof(r); }

    // index_sequence / make_index_sequence (C++14 has them in <utility>;
    // for C++11 we provide a minimal implementation inside __ftl).
#if STDCPP_CXX14
    using std::index_sequence;
    using std::make_index_sequence;
#else
    template<size_t... Is> struct index_sequence {};
    template<size_t N, size_t... Is>
    struct __make_iseq : __make_iseq<N-1, N-1, Is...> {};
    template<size_t... Is>
    struct __make_iseq<0, Is...> { typedef index_sequence<Is...> type; };
    template<size_t N>
    using make_index_sequence = typename __make_iseq<N>::type;
#endif

} // namespace __ftl

