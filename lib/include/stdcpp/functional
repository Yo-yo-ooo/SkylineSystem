//=============================================================
//
//  C++98 / C++03  --  [depr.function.objects]
//
//  unary_function / binary_function were deprecated in C++11 and
//  removed in C++17.  They are defined here for C++98..C++14.
//
//=============================================================
#if !STDCPP_CXX17

template<class Arg, class Result>
struct unary_function
{
    typedef Arg argument_type;
    typedef Result result_type;
};

template<class Arg1, class Arg2, class Result>
struct binary_function
{
    typedef Arg1 first_argument_type;
    typedef Arg2 second_argument_type;
    typedef Result result_type;
};

#endif // !C++17

//=============================================================
//
//  Arithmetic / comparison / logical / bitwise function objects.
//
//  The primary templates exist since C++98; the transparent
//  <void> specializations were added in C++14.  bit_not is new
//  in C++14.  The C++98 pointer specializations for the ordering
//  comparators are provided for all versions.
//
//=============================================================
#if STDCPP_CXX17
// binary_function / unary_function were removed; no base class.
#  define STDCPP_BIN_BASE(T1,T2,R)
#  define STDCPP_UN_BASE(T,R)
#else
#  define STDCPP_BIN_BASE(T1,T2,R) : binary_function<T1,T2,R>
#  define STDCPP_UN_BASE(T,R)    : unary_function<T,R>
#endif

// ---- arithmetic ------------------------------------------------
#define STDCPP_DEFINE_BINOP(name, op)                                         \
template<class T STDCPP_DFLT_VOID> struct name STDCPP_BIN_BASE(T,T,T) {          \
    STDCPP_CONSTEXPR T operator()(const T& x, const T& y) const               \
    { return x op y; }                                                     \
};                                                                         \
STDCPP_DEFINE_BINOP_VOID(name, op)

#if STDCPP_CXX14
#  define STDCPP_DEFINE_BINOP_VOID(name, op)                                  \
template<> struct name<void> {                                             \
    template<class T, class U>                                             \
    constexpr auto operator()(T&& t, U&& u) const                          \
        -> decltype(std::forward<T>(t) op std::forward<U>(u))              \
    { return std::forward<T>(t) op std::forward<U>(u); }                   \
    typedef void is_transparent;                                           \
};
#else
#  define STDCPP_DEFINE_BINOP_VOID(name, op)
#endif

STDCPP_DEFINE_BINOP(plus,       +)
STDCPP_DEFINE_BINOP(minus,      -)
STDCPP_DEFINE_BINOP(multiplies, *)
STDCPP_DEFINE_BINOP(divides,    /)
STDCPP_DEFINE_BINOP(modulus,    %)

#undef STDCPP_DEFINE_BINOP_VOID
#undef STDCPP_DEFINE_BINOP

#define STDCPP_DEFINE_UNOP(name, op)                                          \
template<class T STDCPP_DFLT_VOID> struct name STDCPP_UN_BASE(T,T) {             \
    STDCPP_CONSTEXPR T operator()(const T& x) const { return op x; }          \
};                                                                         \
STDCPP_DEFINE_UNOP_VOID(name, op)

#if STDCPP_CXX14
#  define STDCPP_DEFINE_UNOP_VOID(name, op)                                   \
template<> struct name<void> {                                             \
    template<class T>                                                      \
    constexpr auto operator()(T&& t) const                                 \
        -> decltype(op std::forward<T>(t))                                 \
    { return op std::forward<T>(t); }                                      \
    typedef void is_transparent;                                           \
};
#else
#  define STDCPP_DEFINE_UNOP_VOID(name, op)
#endif

STDCPP_DEFINE_UNOP(negate, -)

#undef STDCPP_DEFINE_UNOP_VOID
#undef STDCPP_DEFINE_UNOP

// ---- comparisons -----------------------------------------------
#define STDCPP_DEFINE_CMPOP(name, op)                                         \
template<class T STDCPP_DFLT_VOID> struct name STDCPP_BIN_BASE(T,T,bool) {       \
    STDCPP_CONSTEXPR bool operator()(const T& x, const T& y) const            \
    { return x op y; }                                                     \
};                                                                         \
STDCPP_DEFINE_CMPOP_VOID(name, op)

#if STDCPP_CXX14
#  define STDCPP_DEFINE_CMPOP_VOID(name, op)                                  \
template<> struct name<void> {                                             \
    template<class T, class U>                                             \
    constexpr auto operator()(T&& t, U&& u) const                          \
        -> decltype(std::forward<T>(t) op std::forward<U>(u))              \
    { return std::forward<T>(t) op std::forward<U>(u); }                   \
    typedef void is_transparent;                                           \
};
#else
#  define STDCPP_DEFINE_CMPOP_VOID(name, op)
#endif

STDCPP_DEFINE_CMPOP(equal_to,      ==)
STDCPP_DEFINE_CMPOP(not_equal_to,  !=)
STDCPP_DEFINE_CMPOP(greater,       >)
STDCPP_DEFINE_CMPOP(less,          <)
STDCPP_DEFINE_CMPOP(greater_equal, >=)
STDCPP_DEFINE_CMPOP(less_equal,    <=)

#undef STDCPP_DEFINE_CMPOP_VOID
#undef STDCPP_DEFINE_CMPOP

// C++98 pointer specializations: comparing unrelated pointers with
// the built-in < is undefined, so the library functors impose a
// total order via an integer cast.
#define STDCPP_DEFINE_CMPOP_PTR(name, op)                                     \
template<class T> struct name<T*> STDCPP_BIN_BASE(T*,T*,bool) {               \
    bool operator()(T* x, T* y) const {                                    \
        return reinterpret_cast<__UINTPTR_TYPE__>(x)                        \
            op reinterpret_cast<__UINTPTR_TYPE__>(y);                      \
    }                                                                      \
};                                                                         \
template<class T> struct name<const T*> STDCPP_BIN_BASE(const T*,const T*,bool) { \
    bool operator()(const T* x, const T* y) const {                        \
        return reinterpret_cast<__UINTPTR_TYPE__>(x)                        \
            op reinterpret_cast<__UINTPTR_TYPE__>(y);                      \
    }                                                                      \
};

STDCPP_DEFINE_CMPOP_PTR(greater,       >)
STDCPP_DEFINE_CMPOP_PTR(less,          <)
STDCPP_DEFINE_CMPOP_PTR(greater_equal, >=)
STDCPP_DEFINE_CMPOP_PTR(less_equal,    <=)

#undef STDCPP_DEFINE_CMPOP_PTR

