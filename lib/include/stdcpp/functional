// ---- binder1st / binder2nd ------------------------------------
template<class Op>
class binder1st
    : public unary_function<typename Op::second_argument_type,
                            typename Op::result_type>
{
protected:
    Op op;
    typename Op::first_argument_type value;
public:
    binder1st(const Op& x, const typename Op::first_argument_type& y)
        : op(x), value(y) {}

    typename Op::result_type
    operator()(const typename Op::second_argument_type& x) const
    { return op(value, x); }

#if STDCPP_CXX11
    typename Op::result_type
    operator()(typename Op::second_argument_type& x) const
    { return op(value, x); }
#endif
};

template<class Op, class T>
inline binder1st<Op>
bind1st(const Op& op, const T& x)
{
    typedef typename Op::first_argument_type _Arg1;
    return binder1st<Op>(op, _Arg1(x));
}

template<class Op>
class binder2nd
    : public unary_function<typename Op::first_argument_type,
                            typename Op::result_type>
{
protected:
    Op op;
    typename Op::second_argument_type value;
public:
    binder2nd(const Op& x, const typename Op::second_argument_type& y)
        : op(x), value(y) {}

    typename Op::result_type
    operator()(const typename Op::first_argument_type& x) const
    { return op(x, value); }

#if STDCPP_CXX11
    typename Op::result_type
    operator()(typename Op::first_argument_type& x) const
    { return op(x, value); }
#endif
};

template<class Op, class T>
inline binder2nd<Op>
bind2nd(const Op& op, const T& x)
{
    typedef typename Op::second_argument_type _Arg2;
    return binder2nd<Op>(op, _Arg2(x));
}

// ---- pointer_to_unary_function / pointer_to_binary_function ---
template<class Arg, class Result>
class pointer_to_unary_function : public unary_function<Arg, Result>
{
protected:
    Result (*_M_ptr)(Arg);
public:
    pointer_to_unary_function() : _M_ptr(0) {}
    explicit pointer_to_unary_function(Result (*x)(Arg)) : _M_ptr(x) {}
    Result operator()(Arg x) const { return _M_ptr(x); }
};

template<class Arg, class Result>
inline pointer_to_unary_function<Arg, Result>
ptr_fun(Result (*x)(Arg))
{ return pointer_to_unary_function<Arg, Result>(x); }

template<class Arg1, class Arg2, class Result>
class pointer_to_binary_function
    : public binary_function<Arg1, Arg2, Result>
{
protected:
    Result (*_M_ptr)(Arg1, Arg2);
public:
    pointer_to_binary_function() : _M_ptr(0) {}
    explicit pointer_to_binary_function(Result (*x)(Arg1, Arg2)) : _M_ptr(x) {}
    Result operator()(Arg1 x, Arg2 y) const { return _M_ptr(x, y); }
};

template<class Arg1, class Arg2, class Result>
inline pointer_to_binary_function<Arg1, Arg2, Result>
ptr_fun(Result (*x)(Arg1, Arg2))
{ return pointer_to_binary_function<Arg1, Arg2, Result>(x); }

// ---- mem_fun family -------------------------------------------
// PREFIX is "" / "const_" / "volatile_" / "const_volatile_".
// CV     is "" / "const" / "volatile" / "const volatile".
#define STDCPP_MEM_FUN_T(PREFIX, CV)                                           \
template<class R, class T>                                                 \
class PREFIX##mem_fun_t : public unary_function<T*, R> {                   \
    typedef R (T::*_Fptr)() CV;                                            \
    _Fptr _M_pm;                                                           \
public:                                                                    \
    explicit PREFIX##mem_fun_t(_Fptr pm) : _M_pm(pm) {}                    \
    R operator()(T* p) const { return (p->*_M_pm)(); }                     \
};                                                                         \
template<class R, class T, class A>                                        \
class PREFIX##mem_fun1_t : public binary_function<T*, A, R> {              \
    typedef R (T::*_Fptr)(A) CV;                                           \
    _Fptr _M_pm;                                                           \
public:                                                                    \
    explicit PREFIX##mem_fun1_t(_Fptr pm) : _M_pm(pm) {}                   \
    R operator()(T* p, A a) const { return (p->*_M_pm)(a); }               \
};                                                                         \
template<class R, class T>                                                 \
class PREFIX##mem_fun_ref_t : public unary_function<T&, R> {               \
    typedef R (T::*_Fptr)() CV;                                            \
    _Fptr _M_pm;                                                           \
public:                                                                    \
    explicit PREFIX##mem_fun_ref_t(_Fptr pm) : _M_pm(pm) {}                \
    R operator()(T& p) const { return (p.*_M_pm)(); }                      \
};                                                                         \
template<class R, class T, class A>                                        \
class PREFIX##mem_fun1_ref_t : public binary_function<T&, A, R> {          \
    typedef R (T::*_Fptr)(A) CV;                                           \
    _Fptr _M_pm;                                                           \
public:                                                                    \
    explicit PREFIX##mem_fun1_ref_t(_Fptr pm) : _M_pm(pm) {}               \
    R operator()(T& p, A a) const { return (p.*_M_pm)(a); }                \
};

STDCPP_MEM_FUN_T(/* prefix */, /* cv */)
STDCPP_MEM_FUN_T(const_,          const)
STDCPP_MEM_FUN_T(volatile_,       volatile)
STDCPP_MEM_FUN_T(const_volatile_, const volatile)

#undef STDCPP_MEM_FUN_T

