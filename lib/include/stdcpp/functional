//  bind  [func.bind]
//=============================================================
namespace __ftl
{
    // Auto-unwrap a reference_wrapper stored as a bound argument.
    template<class T>
    inline T& __mu_unwrap(T& t) STDCPP_NOEXCEPT { return t; }
    template<class T>
    inline T& __mu_unwrap(reference_wrapper<T>& r) STDCPP_NOEXCEPT { return r.get(); }
    template<class T>
    inline const T& __mu_unwrap(const reference_wrapper<T>& r) STDCPP_NOEXCEPT { return r.get(); }

    // Case 1: bound argument is itself a bind expression -> invoke it
    // with all of the outer call arguments.
    template<size_t I, int J, class Bound, class Call, size_t... Ks>
    inline STDCPP_CONSTEXPR14
    auto __mu(Bound&& b, Call& c, true_type, integral_constant<int,J>,
              index_sequence<Ks...>)
        -> decltype(std::get<I>(b)(std::get<Ks>(c)...))
    { return std::get<I>(b)(std::get<Ks>(c)...); }

    // Case 2: a placeholder -> forward the Nth outer call argument.
    template<size_t I, int J, class Bound, class Call, size_t... Ks>
    inline STDCPP_CONSTEXPR14
    auto __mu(Bound&& b, Call& c, false_type, integral_constant<int,J>,
              index_sequence<Ks...>)
        -> decltype(std::get<J-1>(c))
    {
        static_assert(J > 0, "placeholder index must be positive");
        (void)b;
        return std::get<J-1>(c);
    }

    // Case 3: a plain bound value (reference_wrapper unwrapped).
    template<size_t I, class Bound, class Call, size_t... Ks>
    inline STDCPP_CONSTEXPR14
    auto __mu(Bound&& b, Call&, false_type, integral_constant<int,0>,
              index_sequence<Ks...>)
        -> decltype(__mu_unwrap(std::get<I>(b)))
    { return __mu_unwrap(std::get<I>(b)); }

    template<size_t I, class Bound, class Call>
    inline STDCPP_CONSTEXPR14
    auto __mu_entry(Bound&& b, Call& c)
        -> decltype(__mu<I>(
            std::forward<Bound>(b), c,
            is_bind_expression<typename tuple_element<I,
                typename remove_cv<typename remove_reference<Bound>::type>::type>::type>{},
            integral_constant<int, is_placeholder<typename tuple_element<I,
                typename remove_cv<typename remove_reference<Bound>::type>::type>::type>::value>{},
            make_index_sequence<tuple_size<typename remove_cv<Call>::type>::value>{}))
    {
        using _BoundPlain = typename remove_cv<typename remove_reference<Bound>::type>::type;
        using T = typename tuple_element<I, _BoundPlain>::type;
        return __mu<I>(
            std::forward<Bound>(b), c,
            is_bind_expression<T>{},
            integral_constant<int, is_placeholder<T>::value>{},
            make_index_sequence<tuple_size<typename remove_cv<Call>::type>::value>{});
    }

    template<class Bound, class Call, size_t... Is>
    inline STDCPP_CONSTEXPR14
    auto __bind_apply(Bound&& b, Call& c, index_sequence<Is...>)
        -> decltype(__x_invoke(std::get<0>(b), __mu_entry<Is+1>(std::forward<Bound>(b), c)...))
    { return __x_invoke(std::get<0>(b), __mu_entry<Is+1>(std::forward<Bound>(b), c)...); }

    template<class Bound, class Call>
    inline STDCPP_CONSTEXPR14
    auto __bind_dispatch(Bound&& b, Call&& c)
        -> decltype(__bind_apply(
            std::forward<Bound>(b), c,
            make_index_sequence<tuple_size<typename remove_cv<typename remove_reference<Bound>::type>::type>::value - 1>{}))
    {
        using _BoundPlain = typename remove_cv<typename remove_reference<Bound>::type>::type;
        return __bind_apply(
            std::forward<Bound>(b), c,
            make_index_sequence<tuple_size<_BoundPlain>::value - 1>{});
    }
} // namespace __ftl

template<class F, class... BoundArgs>
class _Bind
{
    tuple<typename decay<F>::type, typename decay<BoundArgs>::type...> _M_args;

public:
    // The perfect-forwarding constructor must not hijack copy/move.
    template<class G, class... A, class = typename enable_if<
        !is_same<_Bind, typename remove_cv<typename remove_reference<G>::type>::type>::value>::type>
    STDCPP_CONSTEXPR20
    explicit _Bind(G&& g, A&&... a)
        : _M_args(std::forward<G>(g), std::forward<A>(a)...) {}

    // C++11/14/17: only a const operator().
    template<class... Args>
    STDCPP_CONSTEXPR20
    auto operator()(Args&&... args) const
        -> decltype(__ftl::__bind_dispatch(
            _M_args,
            std::forward_as_tuple(std::forward<Args>(args)...)))
    {
        return __ftl::__bind_dispatch(
            _M_args,
            std::forward_as_tuple(std::forward<Args>(args)...));
    }

#if STDCPP_CXX20
    template<class... Args>
    STDCPP_CONSTEXPR20
    auto operator()(Args&&... args)
        -> decltype(__ftl::__bind_dispatch(
            _M_args,
            std::forward_as_tuple(std::forward<Args>(args)...)))
    {
        return __ftl::__bind_dispatch(
            _M_args,
            std::forward_as_tuple(std::forward<Args>(args)...));
    }

    template<class... Args>
    STDCPP_CONSTEXPR20
    auto operator()(Args&&... args) &&
        -> decltype(__ftl::__bind_dispatch(
            std::move(_M_args),
            std::forward_as_tuple(std::forward<Args>(args)...)))
    {
        return __ftl::__bind_dispatch(
            std::move(_M_args),
            std::forward_as_tuple(std::forward<Args>(args)...));
    }

    template<class... Args>
    STDCPP_CONSTEXPR20
    auto operator()(Args&&... args) const&&
        -> decltype(__ftl::__bind_dispatch(
            std::move(_M_args),
            std::forward_as_tuple(std::forward<Args>(args)...)))
    {
        return __ftl::__bind_dispatch(
            std::move(_M_args),
            std::forward_as_tuple(std::forward<Args>(args)...));
    }
#endif
};

template<class F, class... BoundArgs>
struct is_bind_expression<_Bind<F, BoundArgs...>> : true_type {};

template<class F, class... BoundArgs>
inline STDCPP_CONSTEXPR20
_Bind<typename decay<F>::type, typename decay<BoundArgs>::type...>
bind(F&& f, BoundArgs&&... args)
{
    return _Bind<typename decay<F>::type, typename decay<BoundArgs>::type...>(
        std::forward<F>(f), std::forward<BoundArgs>(args)...);
}

