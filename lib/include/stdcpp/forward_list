#ifndef STDCPP_FORWARD_LIST_HPP
#define STDCPP_FORWARD_LIST_HPP

#include <cstddef>
#include <cstdlib>
#include <type_traits>
#include <utility>
#include <iterator>
#include <initializer_list>
#include <functional>

#define STDCPP_FL_CXX11 (__cplusplus >= 201103L)
#define STDCPP_FL_CXX20 (__cplusplus >= 202002L)

#ifndef _GLIBCXX_FORWARD_LIST
#  define _GLIBCXX_FORWARD_LIST 1
#endif

#if __cplusplus >= 201103L
namespace std {

template<class T, class Allocator = void>
class forward_list {
    struct _node {
        T _M_data;
        _node* _M_next;
        _node(const T& d) : _M_data(d), _M_next(nullptr) {}
        _node(T&& d) : _M_data(STDCPP_MOVE(d)), _M_next(nullptr) {}
        template<class... A>
        _node(A&&... a) : _M_data(std::forward<A>(a)...), _M_next(nullptr) {}
    };

    _node* _M_head;

public:
    typedef T value_type;
    typedef size_t size_type;
    typedef T& reference;
    typedef const T& const_reference;

    class iterator {
    public:
        typedef forward_iterator_tag iterator_category;
        typedef T value_type;
        typedef ptrdiff_t difference_type;
        typedef T* pointer;
        typedef T& reference;
        _node* _M_node;
        iterator(_node* n) : _M_node(n) {}
        T& operator*() const { return _M_node->_M_data; }
        T* operator->() const { return &_M_node->_M_data; }
        iterator& operator++() { _M_node = _M_node->_M_next; return *this; }
        iterator operator++(int) { iterator t = *this; _M_node = _M_node->_M_next; return t; }
        bool operator==(const iterator& o) const { return _M_node == o._M_node; }
        bool operator!=(const iterator& o) const { return _M_node != o._M_node; }
    };
    class const_iterator {
    public:
        typedef forward_iterator_tag iterator_category;
        typedef T value_type;
        typedef ptrdiff_t difference_type;
        typedef const T* pointer;
        typedef const T& reference;
        const _node* _M_node;
        const_iterator(const _node* n) : _M_node(n) {}
        const_iterator(const iterator& it) : _M_node(it._M_node) {}
        const T& operator*() const { return _M_node->_M_data; }
        const T* operator->() const { return &_M_node->_M_data; }
        const_iterator& operator++() { _M_node = _M_node->_M_next; return *this; }
        const_iterator operator++(int) { const_iterator t = *this; _M_node = _M_node->_M_next; return t; }
        bool operator==(const const_iterator& o) const { return _M_node == o._M_node; }
        bool operator!=(const const_iterator& o) const { return _M_node != o._M_node; }
    };

    forward_list() { _M_head = (_node*)malloc(sizeof(_node)); _M_head->_M_next = nullptr; }
    explicit forward_list(size_type n, const T& v = T()) : forward_list() { for (size_type i = 0; i < n; ++i) push_front(v); reverse(); }
    template<class InputIt>
    forward_list(InputIt first, InputIt last) : forward_list() { for (; first != last; ++first) push_front(*first); reverse(); }
    forward_list(const forward_list& other) : forward_list() { for (auto it = other.begin(); it != other.end(); ++it) push_front(*it); reverse(); }
    forward_list(initializer_list<T> il) : forward_list() { for (const T& v : il) push_front(v); reverse(); }
    ~forward_list() { clear(); free(_M_head); }

    forward_list& operator=(const forward_list& other) {
        if (this != &other) { clear(); for (const T& v : other) push_front(v); reverse(); }
        return *this;
    }
    forward_list& operator=(initializer_list<T> il) { clear(); for (const T& v : il) push_front(v); reverse(); return *this; }

    iterator before_begin() { return iterator(_M_head); }
    const_iterator before_begin() const { return const_iterator(_M_head); }
    const_iterator cbefore_begin() const { return const_iterator(_M_head); }
    iterator begin() { return iterator(_M_head->_M_next); }
    const_iterator begin() const { return const_iterator(_M_head->_M_next); }
    iterator end() { return iterator(nullptr); }
    const_iterator end() const { return const_iterator(nullptr); }

    bool empty() const { return _M_head->_M_next == nullptr; }
    reference front() { return _M_head->_M_next->_M_data; }
    const_reference front() const { return _M_head->_M_next->_M_data; }

    void push_front(const T& v) { _node* n = new _node(v); n->_M_next = _M_head->_M_next; _M_head->_M_next = n; }
    void push_front(T&& v) { _node* n = new _node(STDCPP_MOVE(v)); n->_M_next = _M_head->_M_next; _M_head->_M_next = n; }
    template<class... A>
    reference emplace_front(A&&... a) { _node* n = new _node(std::forward<A>(a)...); n->_M_next = _M_head->_M_next; _M_head->_M_next = n; return n->_M_data; }
    void pop_front() { _node* n = _M_head->_M_next; _M_head->_M_next = n->_M_next; delete n; }

    iterator insert_after(const_iterator pos, const T& v) {
        _node* p = const_cast<_node*>(pos._M_node);
        _node* n = new _node(v);
        n->_M_next = p->_M_next; p->_M_next = n;
        return iterator(n);
    }
    iterator insert_after(const_iterator pos, size_type n, const T& v) {
        iterator r = end();
        for (size_type i = 0; i < n; ++i) { iterator t = insert_after(pos, v); if (i == 0) r = t; }
        return r;
    }
    template<class InputIt>
    iterator insert_after(const_iterator pos, InputIt first, InputIt last) {
        iterator r = end();
        for (; first != last; ++first) { iterator t = insert_after(pos, *first); if (r == end()) r = t; }
        return r;
    }

    iterator erase_after(const_iterator pos) {
        _node* p = const_cast<_node*>(pos._M_node);
        _node* n = p->_M_next;
        p->_M_next = n->_M_next;
        delete n;
        return iterator(p->_M_next);
    }
    iterator erase_after(const_iterator first, const_iterator last) {
        while (first._M_node->_M_next != last._M_node) erase_after(first);
        return iterator(const_cast<_node*>(last._M_node));
    }

    void clear() { while (_M_head->_M_next) pop_front(); }

    void resize(size_type n) { resize(n, T()); }
    void resize(size_type n, const T& v) {
        size_type sz = 0; _node* cur = _M_head;
        while (cur->_M_next) { ++sz; cur = cur->_M_next; }
        if (n < sz) { cur = _M_head; for (size_type i = 0; i < n; ++i) cur = cur->_M_next; while (cur->_M_next) { _node* d = cur->_M_next; cur->_M_next = d->_M_next; delete d; } }
        else { cur = _M_head; while (cur->_M_next) cur = cur->_M_next; for (size_type i = sz; i < n; ++i) { _node* n2 = new _node(v); n2->_M_next = nullptr; cur->_M_next = n2; cur = n2; } }
    }

    void assign(size_type n, const T& v) { clear(); for (size_type i = 0; i < n; ++i) push_front(v); reverse(); }
    template<class InputIt>
    void assign(InputIt first, InputIt last) { clear(); for (; first != last; ++first) push_front(*first); reverse(); }
    void assign(initializer_list<T> il) { assign(il.begin(), il.end()); }

    void splice_after(const_iterator pos, forward_list& other) {
        if (!other.empty()) {
            _node* p = const_cast<_node*>(pos._M_node);
            _node* first = other._M_head->_M_next;
            _node* last = first; while (last->_M_next) last = last->_M_next;
            other._M_head->_M_next = nullptr;
            last->_M_next = p->_M_next; p->_M_next = first;
        }
    }
    void splice_after(const_iterator pos, forward_list&& other) { splice_after(pos, other); }
    void splice_after(const_iterator pos, forward_list&, const_iterator it) {
        _node* p = const_cast<_node*>(pos._M_node);
        _node* n = const_cast<_node*>(it._M_node);
        _node* d = n->_M_next; if (!d) return;
        n->_M_next = d->_M_next; d->_M_next = p->_M_next; p->_M_next = d;
    }
    void splice_after(const_iterator pos, forward_list&& other, const_iterator it) { splice_after(pos, other, it); }
    void splice_after(const_iterator pos, forward_list& other, const_iterator first, const_iterator last) {
        _node* p = const_cast<_node*>(pos._M_node);
        _node* f = const_cast<_node*>(first._M_node);
        _node* l = const_cast<_node*>(last._M_node);
        _node* rf = f->_M_next; if (!rf || rf == l) return;
        _node* rl = rf; while (rl->_M_next != l) rl = rl->_M_next;
        f->_M_next = l; rl->_M_next = p->_M_next; p->_M_next = rf;
    }

    void remove(const T& v) {
        _node* cur = _M_head;
        while (cur->_M_next) { if (cur->_M_next->_M_data == v) { _node* d = cur->_M_next; cur->_M_next = d->_M_next; delete d; } else cur = cur->_M_next; }
    }
    template<class Pred>
    void remove_if(Pred p) {
        _node* cur = _M_head;
        while (cur->_M_next) { if (p(cur->_M_next->_M_data)) { _node* d = cur->_M_next; cur->_M_next = d->_M_next; delete d; } else cur = cur->_M_next; }
    }
    void reverse() {
        _node* prev = nullptr; _node* cur = _M_head->_M_next;
        while (cur) { _node* next = cur->_M_next; cur->_M_next = prev; prev = cur; cur = next; }
        _M_head->_M_next = prev;
    }
    void merge(forward_list& other) { merge(other, less<T>()); }
    template<class Compare>
    void merge(forward_list& other, Compare comp) {
        _node* p = _M_head;
        while (p->_M_next && other._M_head->_M_next) {
            if (comp(other._M_head->_M_next->_M_data, p->_M_next->_M_data)) {
                _node* n = other._M_head->_M_next;
                other._M_head->_M_next = n->_M_next;
                n->_M_next = p->_M_next; p->_M_next = n;
            }
            p = p->_M_next;
        }
        if (other._M_head->_M_next) {
            _node* last = p; while (last->_M_next) last = last->_M_next;
            last->_M_next = other._M_head->_M_next;
            other._M_head->_M_next = nullptr;
        }
    }
    void sort() { sort(less<T>()); }
    template<class Compare>
    void sort(Compare comp) {
        if (!_M_head->_M_next || !_M_head->_M_next->_M_next) return;
        // insertion sort
        _node* sorted = nullptr;
        _node* cur = _M_head->_M_next;
        while (cur) {
            _node* next = cur->_M_next;
            if (!sorted || !comp(sorted->_M_data, cur->_M_data)) {
                cur->_M_next = sorted; sorted = cur;
            } else {
                _node* s = sorted;
                while (s->_M_next && comp(s->_M_next->_M_data, cur->_M_data)) s = s->_M_next;
                cur->_M_next = s->_M_next; s->_M_next = cur;
            }
            cur = next;
        }
        _M_head->_M_next = sorted;
    }
    void unique() {
        _node* cur = _M_head->_M_next;
        while (cur && cur->_M_next) {
            if (cur->_M_data == cur->_M_next->_M_data) { _node* d = cur->_M_next; cur->_M_next = d->_M_next; delete d; }
            else cur = cur->_M_next;
        }
    }
    void swap(forward_list& other) { std::swap(_M_head, other._M_head); }
};

template<class T, class A>
bool operator==(const forward_list<T, A>& a, const forward_list<T, A>& b) {
    auto i = a.begin(), j = b.begin();
    for (; i != a.end() && j != b.end(); ++i, ++j) if (!(*i == *j)) return false;
    return i == a.end() && j == b.end();
}
template<class T, class A>
void swap(forward_list<T, A>& a, forward_list<T, A>& b) { a.swap(b); }

#if STDCPP_FL_CXX20
template<class T, class A, class U>
typename forward_list<T, A>::size_type erase(forward_list<T, A>& c, const U& value) {
    auto it = c.before_begin(); typename forward_list<T, A>::size_type n = 0;
    while (it._M_node->_M_next) { if (it._M_node->_M_next->_M_data == value) { c.erase_after(it); ++n; } else ++it; }
    return n;
}
template<class T, class A, class Pred>
typename forward_list<T, A>::size_type erase_if(forward_list<T, A>& c, Pred pred) {
    auto it = c.before_begin(); typename forward_list<T, A>::size_type n = 0;
    while (it._M_node->_M_next) { if (pred(it._M_node->_M_next->_M_data)) { c.erase_after(it); ++n; } else ++it; }
    return n;
}
#endif

} // namespace std

