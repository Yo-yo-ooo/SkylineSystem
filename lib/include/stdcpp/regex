//=============================================================
// 内部：字符分类 / 字符类 / 字节码
//=============================================================
namespace __regex_detail {

inline bool is_word_char(uint32_t c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
           (c >= '0' && c <= '9') || c == '_';
}
inline bool is_space_char(uint32_t c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v';
}
inline bool is_digit_char(uint32_t c) { return c >= '0' && c <= '9'; }

inline uint32_t ascii_lower(uint32_t c) {
    return (c >= 'A' && c <= 'Z') ? (c + 32) : c;
}

struct char_class {
    // 区间列表；negated 表示取反
    std::vector<std::pair<uint32_t, uint32_t> > ranges;
    bool negated;

    char_class() : negated(false) {}

    void add(uint32_t lo, uint32_t hi) { ranges.push_back(std::make_pair(lo, hi)); }
    void add(uint32_t c) { add(c, c); }

    bool raw_match(uint32_t c) const {
        for (size_t i = 0; i < ranges.size(); ++i)
            if (c >= ranges[i].first && c <= ranges[i].second) return true;
        return false;
    }

    bool match(uint32_t c, bool icase) const {
        bool hit = raw_match(c);
        if (!hit && icase) {
            // 大小写不敏感：再试一次换大小写后的字符
            if (c >= 'a' && c <= 'z') hit = raw_match(c - 32);
            else if (c >= 'A' && c <= 'Z') hit = raw_match(c + 32);
        }
        return negated ? !hit : hit;
    }
};

struct inst {
    enum op_t {
        OpChar,      // 匹配单字符 c
        OpAny,       // 匹配任意字符（不含换行，除非 match_any）
        OpClass,     // 匹配字符类（c = 类下标）
        OpSplit,     // 优先走 x，失败再走 y
        OpJmp,       // 跳到 x
        OpSave,      // 记录捕获槽 c 的当前位置
        OpBol,       // ^
        OpEol,       // $
        OpWordB,     // \b
        OpNotWordB,  // \B
        OpBackref,   // 反向引用（c = 组号）
        OpMatch      // 成功
    };

    op_t     op;
    uint32_t c;
    size_t   x;
    size_t   y;

    inst(op_t o = OpMatch, uint32_t cc = 0, size_t xx = 0, size_t yy = 0)
        : op(o), c(cc), x(xx), y(yy) {}
};

//-------------------------------------------------------------
// 解析器：边解析边发射字节码
//-------------------------------------------------------------
template<class CharT, class Traits>
class compiler {
public:
    typedef CharT value_type;

    compiler(const CharT* pat, size_t len, regex_constants::syntax_option_type flags)
        : _M_p(pat), _M_len(len), _M_pos(0), _M_flags(flags), _M_groups(0), _M_error(-1) {}

    bool compile() {
        emit(inst::OpSave, 0);
        if (!parse_alternation()) return false;
        emit(inst::OpSave, 1);
        emit(inst::OpMatch);
        if (_M_pos != _M_len) { fail(regex_constants::error_paren); return false; }
        return true;
    }

    std::vector<inst>&     program() { return _M_prog; }
    std::vector<char_class>& classes() { return _M_classes; }
    size_t group_count() const { return _M_groups; }
    int    error() const { return _M_error; }

private:
    const CharT* _M_p;
    size_t       _M_len;
    size_t       _M_pos;
    regex_constants::syntax_option_type _M_flags;
    std::vector<inst>       _M_prog;
    std::vector<char_class> _M_classes;
    size_t       _M_groups;
    int          _M_error;

    bool icase() const { return (_M_flags & regex_constants::icase) != 0; }
    bool multiline() const { return (_M_flags & regex_constants::multiline) != 0; }

    void fail(int code) { if (_M_error < 0) _M_error = code; }

    bool eof() const { return _M_pos >= _M_len; }
    CharT cur() const { return _M_p[_M_pos]; }

    size_t emit(inst::op_t op, uint32_t c = 0, size_t x = 0, size_t y = 0) {
        _M_prog.push_back(inst(op, c, x, y));
        return _M_prog.size() - 1;
    }

    // 从 _M_pos 起，在当前括号深度内是否还有 '|'。
    // 只有确认存在多分支时才发射 Split，避免单分支也平白多出一次回溯分叉。
    bool has_alternation() const {
        size_t depth = 0;
        for (size_t i = _M_pos; i < _M_len; ++i) {
            const CharT c = _M_p[i];
            if (c == '\\') { ++i; continue; }
            if (c == '[') {
                ++i;
                while (i < _M_len && _M_p[i] != ']') { if (_M_p[i] == '\\') ++i; ++i; }
                continue;
            }
            if (c == '(') { ++depth; continue; }
            if (c == ')') {
                if (depth == 0) return false;      // 本层结束
                --depth;
                continue;
            }
            if (c == '|' && depth == 0) return true;
        }
        return false;
    }

    // alternation := concat ('|' concat)*
    //
    // 生成结构（以 a|b|c 为例）：
    //     S1: Split a, S2
    //     a:  <code a>   Jmp End
    //     S2: Split b, c
    //     b:  <code b>   Jmp End
    //     c:  <code c>
    //     End:
    //
    // 两个必须避开的坑：
    //   1) 只发 Jmp 不发 Split → "cat|dog" 会被编译成 "catdog"，
    //      分支 1 失败后根本没机会试分支 2。
    //   2) 给最后一个分支也发 Split(分支, End) → 分支失败时会跳到 End，
    //      等于"跳过整个分组"，于是 a(b|c)d 能匹配 "ad"。
    //      所以只有后面还有分支时才发 Split。
    bool parse_alternation() {
        if (!has_alternation()) return parse_concat();

        std::vector<size_t> jmps;                  // 各分支末尾 Jmp End，待回填
        size_t prev_split = emit(inst::OpSplit);

        _M_prog[prev_split].x = _M_prog.size();
        if (!parse_concat()) return false;

        while (!eof() && cur() == '|') {
            ++_M_pos;
            jmps.push_back(emit(inst::OpJmp));     // 上一分支成功 → 跳到 End

            if (has_alternation()) {
                // 后面还有分支：先开一个 Split，上一分支失败时转到这里
                const size_t sp = emit(inst::OpSplit);
                _M_prog[prev_split].y = sp;
                prev_split = sp;
                _M_prog[prev_split].x = _M_prog.size();
            } else {
                // 最后一个分支：直接落在这里
                _M_prog[prev_split].y = _M_prog.size();
            }
            if (!parse_concat()) return false;
        }

        const size_t end = _M_prog.size();
        for (size_t k = 0; k < jmps.size(); ++k) _M_prog[jmps[k]].x = end;
        return _M_error < 0;
    }

    // concat := repeat*
    bool parse_concat() {
        while (!eof() && cur() != '|' && cur() != ')') {
            if (!parse_repeat()) return false;
        }
        return _M_error < 0;
    }

    // repeat := atom quantifier?
    bool parse_repeat() {
        const size_t atom_start = _M_prog.size();
        if (!parse_atom()) return false;

        if (eof()) return true;

        // 量词
        CharT c = cur();
        if (c == '*' || c == '+' || c == '?') {
            ++_M_pos;
            bool greedy = true;
            if (!eof() && cur() == '?') { greedy = false; ++_M_pos; }

            if (c == '*')      apply_star(atom_start, greedy);
            else if (c == '+') apply_plus(atom_start, greedy);
            else               apply_question(atom_start, greedy);
            return true;
        }
        if (c == '{') {
            // {n} / {n,} / {n,m}
            const size_t save = _M_pos;
            ++_M_pos;
            long n = 0, m = -1;
            bool has_comma = false;
            if (!parse_number(n)) { _M_pos = save; return true; }   // 不是量词，按字面量处理
            if (!eof() && cur() == ',') {
                has_comma = true;
                ++_M_pos;
                if (!eof() && cur() >= '0' && cur() <= '9') {
                    if (!parse_number(m)) return true;
                }
            }
            if (eof() || cur() != '}') {
                fail(regex_constants::error_badbrace);
                return false;
            }
            ++_M_pos;
            bool greedy = true;
            if (!eof() && cur() == '?') { greedy = false; ++_M_pos; }

            if (has_comma && m < 0) {
                apply_n_or_more(atom_start, (size_t)n, greedy);
            } else if (!has_comma) {
                apply_n_times(atom_start, (size_t)n, greedy);
            } else {
                if (m < n) { fail(regex_constants::error_badbrace); return false; }
                apply_n_to_m(atom_start, (size_t)n, (size_t)m, greedy);
            }
            return true;
        }
        return true;
    }

    bool parse_number(long& out) {
        if (eof() || cur() < '0' || cur() > '9') return false;
        out = 0;
        while (!eof() && cur() >= '0' && cur() <= '9') {
            out = out * 10 + (cur() - '0');
            if (out > 100000) { fail(regex_constants::error_badbrace); return false; }
            ++_M_pos;
        }
        return true;
    }

    // 把 [atom_start, end) 拷到新位置，返回新起点
    size_t copy_block(size_t from, size_t to) {
        const size_t base = _M_prog.size();
        for (size_t i = from; i < to; ++i) {
            inst in = _M_prog[i];
            if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                in.x = (in.x >= from && in.x < to) ? (in.x - from + base) : in.x;
                in.y = (in.y >= from && in.y < to) ? (in.y - from + base) : in.y;
            }
            _M_prog.push_back(in);
        }
        return base;
    }

    void apply_star(size_t atom_start, bool greedy) {
        const size_t atom_end = _M_prog.size();
        const size_t block_len = atom_end - atom_start;
        if (block_len == 0) { fail(regex_constants::error_badrepeat); return; }

        // 把原子整体搬家，在前面留出 Split 的位置
        std::vector<inst> block(_M_prog.begin() + atom_start, _M_prog.end());
        _M_prog.resize(atom_start);

        const size_t split = emit(inst::OpSplit);
        const size_t body = _M_prog.size();
        for (size_t i = 0; i < block.size(); ++i) {
            inst in = block[i];
            if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                if (in.x >= atom_start && in.x < atom_end)
                    in.x = in.x - atom_start + body;
                if (in.y >= atom_start && in.y < atom_end)
                    in.y = in.y - atom_start + body;
            }
            _M_prog.push_back(in);
        }
        emit(inst::OpJmp, 0, split);
        const size_t after = _M_prog.size();

        if (greedy) { _M_prog[split].x = body; _M_prog[split].y = after; }
        else        { _M_prog[split].x = after; _M_prog[split].y = body; }
    }

    void apply_plus(size_t atom_start, bool greedy) {
        const size_t atom_end = _M_prog.size();
        if (atom_end == atom_start) { fail(regex_constants::error_badrepeat); return; }

        // X+ == X X*
        std::vector<inst> block(_M_prog.begin() + atom_start, _M_prog.end());
        const size_t body = atom_start;
        const size_t split = emit(inst::OpSplit);
        const size_t body2 = _M_prog.size();
        for (size_t i = 0; i < block.size(); ++i) {
            inst in = block[i];
            if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                if (in.x >= body && in.x < atom_end) in.x = in.x - body + body2;
                if (in.y >= body && in.y < atom_end) in.y = in.y - body + body2;
            }
            _M_prog.push_back(in);
        }
        emit(inst::OpJmp, 0, split);
        const size_t after = _M_prog.size();
        if (greedy) { _M_prog[split].x = body2; _M_prog[split].y = after; }
        else        { _M_prog[split].x = after; _M_prog[split].y = body2; }
    }

    void apply_question(size_t atom_start, bool greedy) {
        std::vector<inst> block(_M_prog.begin() + atom_start, _M_prog.end());
        _M_prog.resize(atom_start);

        const size_t split = emit(inst::OpSplit);
        const size_t body = _M_prog.size();
        for (size_t i = 0; i < block.size(); ++i) {
            inst in = block[i];
            if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                if (in.x >= atom_start) in.x = in.x - atom_start + body;
                if (in.y >= atom_start) in.y = in.y - atom_start + body;
            }
            _M_prog.push_back(in);
        }
        const size_t after = _M_prog.size();
        if (greedy) { _M_prog[split].x = body; _M_prog[split].y = after; }
        else        { _M_prog[split].x = after; _M_prog[split].y = body; }
    }

    void apply_n_times(size_t atom_start, size_t n, bool greedy) {
        (void)greedy;
        std::vector<inst> block(_M_prog.begin() + atom_start, _M_prog.end());
        _M_prog.resize(atom_start);
        for (size_t k = 0; k < n; ++k) {
            const size_t base = _M_prog.size();
            for (size_t i = 0; i < block.size(); ++i) {
                inst in = block[i];
                if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                    if (in.x >= atom_start) in.x = in.x - atom_start + base;
                    if (in.y >= atom_start) in.y = in.y - atom_start + base;
                }
                _M_prog.push_back(in);
            }
        }
    }

    void apply_n_or_more(size_t atom_start, size_t n, bool greedy) {
        std::vector<inst> block(_M_prog.begin() + atom_start, _M_prog.end());
        _M_prog.resize(atom_start);
        // n 份必需
        for (size_t k = 0; k < n; ++k) {
            const size_t base = _M_prog.size();
            for (size_t i = 0; i < block.size(); ++i) {
                inst in = block[i];
                if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                    if (in.x >= atom_start) in.x = in.x - atom_start + base;
                    if (in.y >= atom_start) in.y = in.y - atom_start + base;
                }
                _M_prog.push_back(in);
            }
        }
        // 再来一个 X*
        const size_t star_start = _M_prog.size();
        {
            const size_t base = _M_prog.size();
            for (size_t i = 0; i < block.size(); ++i) {
                inst in = block[i];
                if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                    if (in.x >= atom_start) in.x = in.x - atom_start + base;
                    if (in.y >= atom_start) in.y = in.y - atom_start + base;
                }
                _M_prog.push_back(in);
            }
        }
        apply_star(star_start, greedy);
    }

    void apply_n_to_m(size_t atom_start, size_t n, size_t m, bool greedy) {
        std::vector<inst> block(_M_prog.begin() + atom_start, _M_prog.end());
        _M_prog.resize(atom_start);
        for (size_t k = 0; k < n; ++k) {
            const size_t base = _M_prog.size();
            for (size_t i = 0; i < block.size(); ++i) {
                inst in = block[i];
                if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                    if (in.x >= atom_start) in.x = in.x - atom_start + base;
                    if (in.y >= atom_start) in.y = in.y - atom_start + base;
                }
                _M_prog.push_back(in);
            }
        }
        for (size_t k = n; k < m; ++k) {
            const size_t before = _M_prog.size();
            const size_t base = _M_prog.size();
            for (size_t i = 0; i < block.size(); ++i) {
                inst in = block[i];
                if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                    if (in.x >= atom_start) in.x = in.x - atom_start + base;
                    if (in.y >= atom_start) in.y = in.y - atom_start + base;
                }
                _M_prog.push_back(in);
            }
            // 包一层 Split 变成可选
            const size_t block_end = _M_prog.size();
            std::vector<inst> opt(_M_prog.begin() + before, _M_prog.end());
            _M_prog.resize(before);
            const size_t split = emit(inst::OpSplit);
            const size_t body = _M_prog.size();
            for (size_t i = 0; i < opt.size(); ++i) {
                inst in = opt[i];
                if (in.op == inst::OpSplit || in.op == inst::OpJmp) {
                    if (in.x >= before && in.x < block_end) in.x = in.x - before + body;
                    if (in.y >= before && in.y < block_end) in.y = in.y - before + body;
                }
                _M_prog.push_back(in);
            }
            const size_t after = _M_prog.size();
            if (greedy) { _M_prog[split].x = body; _M_prog[split].y = after; }
            else        { _M_prog[split].x = after; _M_prog[split].y = body; }
        }
    }

    // atom := '(' alt ')' | '[' class ']' | '.' | '^' | '$' | '\' esc | char
    bool parse_atom() {
        if (eof()) return true;
        const CharT c = cur();

        if (c == '(') {
            ++_M_pos;
            bool capture = true;
            if (!eof() && cur() == '?') {
                if (_M_pos + 1 < _M_len && _M_p[_M_pos + 1] == ':') {
                    _M_pos += 2;
                    capture = false;
                } else {
                    fail(regex_constants::error_paren);   // 不支持 (?= 等
                    return false;
                }
            }
            size_t slot = 0;
            if (capture) {
                ++_M_groups;
                slot = _M_groups;
                emit(inst::OpSave, static_cast<uint32_t>(2 * slot));
            }
            if (!parse_alternation()) return false;
            if (eof() || cur() != ')') { fail(regex_constants::error_paren); return false; }
            ++_M_pos;
            if (capture) emit(inst::OpSave, static_cast<uint32_t>(2 * slot + 1));
            return true;
        }

        if (c == ')') { fail(regex_constants::error_paren); return false; }

        if (c == '[') { return parse_class(); }

        if (c == '.') { ++_M_pos; emit(inst::OpAny); return true; }

        if (c == '^') { ++_M_pos; emit(inst::OpBol); return true; }
        if (c == '$') { ++_M_pos; emit(inst::OpEol); return true; }

        if (c == '\\') { return parse_escape(false); }

        // 裸量词符号出现在原子位置 → 非法
        if (c == '*' || c == '+' || c == '?') {
            fail(regex_constants::error_badrepeat);
            return false;
        }
        ++_M_pos;
        emit(inst::OpChar, static_cast<uint32_t>(c));
        return true;
    }

    bool parse_escape(bool in_class) {
        ++_M_pos;                     // 跳过 '\'
        if (eof()) { fail(regex_constants::error_escape); return false; }
        const CharT c = cur();
        ++_M_pos;

        switch (c) {
            case 'd': add_class_shorthand(1, false); return true;
            case 'D': add_class_shorthand(1, true);  return true;
            case 'w': add_class_shorthand(2, false); return true;
            case 'W': add_class_shorthand(2, true);  return true;
            case 's': add_class_shorthand(3, false); return true;
            case 'S': add_class_shorthand(3, true);  return true;
            case 'b':
                if (in_class) { emit(inst::OpChar, 8); return true; }   // 退格
                emit(inst::OpWordB); return true;
            case 'B':
                if (in_class) { emit(inst::OpChar, 'B'); return true; }
                emit(inst::OpNotWordB); return true;
            case 'n': emit(inst::OpChar, '\n'); return true;
            case 'r': emit(inst::OpChar, '\r'); return true;
            case 't': emit(inst::OpChar, '\t'); return true;
            case 'f': emit(inst::OpChar, '\f'); return true;
            case 'v': emit(inst::OpChar, '\v'); return true;
            case '0': emit(inst::OpChar, 0); return true;
            case 'x': {
                uint32_t v = 0;
                if (!parse_hex(2, v)) { fail(regex_constants::error_escape); return false; }
                emit(inst::OpChar, v);
                return true;
            }
            case 'u': {
                uint32_t v = 0;
                if (!parse_hex(4, v)) { fail(regex_constants::error_escape); return false; }
                emit(inst::OpChar, v);
                return true;
            }
            case 'c': {
                if (eof()) { fail(regex_constants::error_escape); return false; }
                const uint32_t v = static_cast<uint32_t>(cur()) & 0x1F;
                ++_M_pos;
                emit(inst::OpChar, v);
                return true;
            }
            default:
                break;
        }

        if (c >= '1' && c <= '9' && !in_class) {
            // 反向引用
            const uint32_t g = static_cast<uint32_t>(c - '0');
            if (g > _M_groups) { fail(regex_constants::error_backref); return false; }
            emit(inst::OpBackref, g);
            return true;
        }

        // 其余转义按字面量处理（\. \* \\ 等）
        emit(inst::OpChar, static_cast<uint32_t>(c));
        return true;
    }

    bool parse_hex(int n, uint32_t& out) {
        out = 0;
        for (int i = 0; i < n; ++i) {
            if (eof()) return false;
            const CharT c = cur();
            int d;
            if (c >= '0' && c <= '9') d = c - '0';
            else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
            else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
            else return false;
            out = out * 16 + static_cast<uint32_t>(d);
            ++_M_pos;
        }
        return true;
    }

    void add_class_shorthand(int which, bool negate) {
        char_class cls;
        cls.negated = negate;
        if (which == 1) { cls.add('0', '9'); }
        else if (which == 2) {
            cls.add('a', 'z'); cls.add('A', 'Z'); cls.add('0', '9'); cls.add('_');
        } else {
            cls.add(' '); cls.add('\t'); cls.add('\n'); cls.add('\r'); cls.add('\f'); cls.add('\v');
        }
        _M_classes.push_back(cls);
        emit(inst::OpClass, static_cast<uint32_t>(_M_classes.size() - 1));
    }

    // '[' ... ']'
    bool parse_class() {
        ++_M_pos;                       // 跳过 '['
        char_class cls;
        if (!eof() && cur() == '^') { cls.negated = true; ++_M_pos; }

        bool first = true;
        while (!eof()) {
            if (cur() == ']' && !first) break;
            first = false;

            // 转义简写类（\d \w \s）在类内要并入区间
            if (cur() == '\\' && _M_pos + 1 < _M_len) {
                const CharT e = _M_p[_M_pos + 1];
                if (e == 'd' || e == 'D' || e == 'w' || e == 'W' || e == 's' || e == 'S') {
                    _M_pos += 2;
                    const bool neg = (e == 'D' || e == 'W' || e == 'S');
                    const int which = (e == 'd' || e == 'D') ? 1 : (e == 'w' || e == 'W') ? 2 : 3;
                    if (neg) {
                        // 取反的简写类无法用区间并集表达，这里按标准做法：
                        // 生成一个嵌套类，用两条指令组合实现
                        char_class inner;
                        if (which == 1) inner.add('0', '9');
                        else if (which == 2) { inner.add('a', 'z'); inner.add('A', 'Z'); inner.add('0', '9'); inner.add('_'); }
                        else { inner.add(' '); inner.add('\t'); inner.add('\n'); inner.add('\r'); inner.add('\f'); inner.add('\v'); }
                        inner.negated = true;
                        _M_classes.push_back(inner);
                        // 用「类 + 负向」表达：等价于 [^...]，与已有区间取并集时
                        // 按“命中任一即匹配”，所以直接发射为独立类会有冲突。
                        // 简化：把负向简写类展开为完整区间（char 范围内）
                        char_class expanded;
                        const uint32_t maxc = 0x10FFFF;
                        // 将 inner 的补集加入 cls
                        std::vector<std::pair<uint32_t, uint32_t> > comp;
                        uint32_t cursor = 0;
                        for (size_t i = 0; i < inner.ranges.size(); ++i) {
                            if (cursor < inner.ranges[i].first)
                                comp.push_back(std::make_pair(cursor, inner.ranges[i].first - 1));
                            cursor = inner.ranges[i].second + 1;
                        }
                        if (cursor <= maxc) comp.push_back(std::make_pair(cursor, maxc));
                        for (size_t i = 0; i < comp.size(); ++i) cls.add(comp[i].first, comp[i].second);
                    } else {
                        if (which == 1) cls.add('0', '9');
                        else if (which == 2) { cls.add('a', 'z'); cls.add('A', 'Z'); cls.add('0', '9'); cls.add('_'); }
                        else { cls.add(' '); cls.add('\t'); cls.add('\n'); cls.add('\r'); cls.add('\f'); cls.add('\v'); }
                    }
                    continue;
                }
            }

            // 普通字符或转义字符
            uint32_t lo;
            if (cur() == '\\') {
                ++_M_pos;
                if (eof()) { fail(regex_constants::error_escape); return false; }
                const CharT e = cur();
                ++_M_pos;
                switch (e) {
                    case 'n': lo = '\n'; break;
                    case 'r': lo = '\r'; break;
                    case 't': lo = '\t'; break;
                    case 'f': lo = '\f'; break;
                    case 'v': lo = '\v'; break;
                    case '0': lo = 0; break;
                    case 'x': { uint32_t v; if (!parse_hex(2, v)) { fail(regex_constants::error_escape); return false; } lo = v; break; }
                    case 'u': { uint32_t v; if (!parse_hex(4, v)) { fail(regex_constants::error_escape); return false; } lo = v; break; }
                    default:  lo = static_cast<uint32_t>(e); break;
                }
            } else {
                lo = static_cast<uint32_t>(cur());
                ++_M_pos;
            }

            // 区间 a-z
            if (!eof() && cur() == '-' && _M_pos + 1 < _M_len && _M_p[_M_pos + 1] != ']') {
                ++_M_pos;
                uint32_t hi;
                if (cur() == '\\') {
                    ++_M_pos;
                    if (eof()) { fail(regex_constants::error_escape); return false; }
                    const CharT e = cur();
                    ++_M_pos;
                    switch (e) {
                        case 'n': hi = '\n'; break;
                        case 'r': hi = '\r'; break;
                        case 't': hi = '\t'; break;
                        default:  hi = static_cast<uint32_t>(e); break;
                    }
                } else {
                    hi = static_cast<uint32_t>(cur());
                    ++_M_pos;
                }
                if (hi < lo) { fail(regex_constants::error_range); return false; }
                cls.add(lo, hi);
            } else {
                cls.add(lo, lo);
            }
        }

        if (eof()) { fail(regex_constants::error_brack); return false; }
        ++_M_pos;                        // 跳过 ']'
        _M_classes.push_back(cls);
        emit(inst::OpClass, static_cast<uint32_t>(_M_classes.size() - 1));
        return true;
    }
};

