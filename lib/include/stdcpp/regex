template<class BidirIt, class CharT, class Traits>
bool regex_match(BidirIt first, BidirIt last,
                 match_results<BidirIt>& m,
                 const basic_regex<CharT, Traits>& re,
                 regex_constants::match_flag_type flags = regex_constants::match_default) {
    typedef __regex_detail::matcher<CharT, Traits> M;
    const size_t n = static_cast<size_t>(last - first);
    M mm(re, &*first, n,
         (re.flags() & regex_constants::icase) != 0,
         (re.flags() & regex_constants::multiline) != 0);
    // match_not_bol / match_not_eol 会关闭 ^ / $ 的锚定语义
    mm.not_bol((flags & regex_constants::match_not_bol) != 0);
    mm.not_eol((flags & regex_constants::match_not_eol) != 0);

    // regex_match：必须从 first 开始且消耗到 last。
    // full_match 让引擎在 OpMatch 处校验 sp == len 并继续回溯，
    // 而不是"找到第一个就返回"（那样贪婪/懒惰量词在整串匹配时会直接失败）。
    mm.full(true);

    if (!mm.run(0, 0)) {
        // 即便失败也把槽位填满，避免调用方索引未初始化的 sub_match
        m._M_set(true, first, last);
        m._M_slots().assign(mm.ngroups + 1, sub_match<BidirIt>());
        return false;
    }

    m._M_set(true, first, last);
    std::vector<sub_match<BidirIt> >& subs = m._M_slots();
    subs.assign(mm.ngroups + 1, sub_match<BidirIt>());
    for (size_t g = 0; g <= mm.ngroups; ++g) {
        if (mm.caps[2 * g] != M::npos() && mm.caps[2 * g + 1] != M::npos()) {
            subs[g].first = first + static_cast<typename iterator_traits<BidirIt>::difference_type>(mm.caps[2 * g]);
            subs[g].second = first + static_cast<typename iterator_traits<BidirIt>::difference_type>(mm.caps[2 * g + 1]);
            subs[g].matched = true;
        }
    }
    return true;
}

template<class BidirIt, class CharT, class Traits>
bool regex_match(BidirIt first, BidirIt last, const basic_regex<CharT, Traits>& re,
                 regex_constants::match_flag_type flags = regex_constants::match_default) {
    match_results<BidirIt> m;
    return regex_match(first, last, m, re, flags);
}

