template<class BidirIt, class CharT, class Traits>
bool regex_search(BidirIt first, BidirIt last,
                  match_results<BidirIt>& m,
                  const basic_regex<CharT, Traits>& re,
                  regex_constants::match_flag_type flags = regex_constants::match_default) {
    typedef __regex_detail::matcher<CharT, Traits> M;
    const size_t n = static_cast<size_t>(last - first);
    if (n == 0 && re.mark_count() == 0 && re.empty()) return false;

    const size_t start = (flags & regex_constants::match_continuous) ? 0 : 0;
    const size_t stop = (flags & regex_constants::match_continuous) ? 1 : n + 1;

    for (size_t pos = start; pos < stop; ++pos) {
        M mm(re, &*first, n,
             (re.flags() & regex_constants::icase) != 0,
             (re.flags() & regex_constants::multiline) != 0);
        // 把文本起点“偏移”到 pos：直接让 matcher 从 pos 开始尝试
        if (mm.run(0, pos)) {
            m._M_set(true, first, last);
            m._M_slots().assign(mm.ngroups + 1, sub_match<BidirIt>());
            for (size_t g = 0; g <= mm.ngroups; ++g) {
                if (mm.caps[2 * g] != M::npos() && mm.caps[2 * g + 1] != M::npos()) {
                    m._M_slots()[g].first = first + static_cast<typename iterator_traits<BidirIt>::difference_type>(mm.caps[2 * g]);
                    m._M_slots()[g].second = first + static_cast<typename iterator_traits<BidirIt>::difference_type>(mm.caps[2 * g + 1]);
                    m._M_slots()[g].matched = true;
                }
            }
            // prefix / suffix
            typename iterator_traits<BidirIt>::difference_type b =
                static_cast<typename iterator_traits<BidirIt>::difference_type>(mm.caps[0]);
            typename iterator_traits<BidirIt>::difference_type e =
                static_cast<typename iterator_traits<BidirIt>::difference_type>(mm.caps[1]);
            m._M_prefix_slot().first = first;
            m._M_prefix_slot().second = first + b;
            m._M_prefix_slot().matched = true;
            m._M_suffix_slot().first = first + e;
            m._M_suffix_slot().second = last;
            m._M_suffix_slot().matched = true;
            return true;
        }
    }
    return false;
}

