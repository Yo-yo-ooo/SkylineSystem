namespace __regex_detail {

// 展开替换格式：$1..$9、$&、$$（format_default）；\1..\9 用于 format_sed
template<class CharT, class Traits, class OutIt>
OutIt format_expand(const std::string& fmt, bool sed,
                    const match_results<const CharT*>& m, OutIt out) {
    for (size_t i = 0; i < fmt.size(); ++i) {
        const char c = fmt[i];
        if (c == '$' && !sed && i + 1 < fmt.size()) {
            const char d = fmt[i + 1];
            if (d == '$') { *out++ = CharT('$'); ++i; continue; }
            if (d == '&') {
                const std::string s = m.str(0);
                for (size_t k = 0; k < s.size(); ++k) *out++ = static_cast<CharT>(s[k]);
                ++i; continue;
            }
            if (d >= '0' && d <= '9') {
                const size_t g = static_cast<size_t>(d - '0');
                if (g < m.size()) {
                    const std::string s = m.str(g);
                    for (size_t k = 0; k < s.size(); ++k) *out++ = static_cast<CharT>(s[k]);
                }
                ++i; continue;
            }
            *out++ = CharT('$');
            continue;
        }
        if (c == '\\' && sed && i + 1 < fmt.size()) {
            const char d = fmt[i + 1];
            if (d >= '0' && d <= '9') {
                const size_t g = static_cast<size_t>(d - '0');
                if (g < m.size()) {
                    const std::string s = m.str(g);
                    for (size_t k = 0; k < s.size(); ++k) *out++ = static_cast<CharT>(s[k]);
                }
                ++i; continue;
            }
        }
        *out++ = static_cast<CharT>(c);
    }
    return out;
}

} // namespace __regex_detail

template<class OutIt, class BidirIt, class CharT, class Traits, class ST, class SA>
OutIt regex_replace(OutIt out, BidirIt first, BidirIt last,
                    const basic_regex<CharT, Traits>& re,
                    const basic_string<CharT, ST, SA>& fmt,
                    regex_constants::match_flag_type flags = regex_constants::match_default) {
    typedef match_results<BidirIt> MR;
    const bool no_copy = (flags & regex_constants::format_no_copy) != 0;
    const bool first_only = (flags & regex_constants::format_first_only) != 0;
    const bool sed = (flags & regex_constants::format_sed) != 0;

    std::string narrow;
    for (size_t i = 0; i < fmt.size(); ++i) narrow.push_back(static_cast<char>(fmt[i]));

    BidirIt cur = first;
    while (cur != last) {
        MR m;
        if (!regex_search(cur, last, m, re, flags)) break;

        // 匹配前的原文
        if (!no_copy) {
            for (BidirIt it = cur; it != m[0].first; ++it) *out++ = *it;
        }
        // 展开替换
        {
            // 借用 const CharT* 版本的 formatter：这里直接内联展开
            for (size_t i = 0; i < narrow.size(); ++i) {
                const char c = narrow[i];
                if (c == '$' && !sed && i + 1 < narrow.size()) {
                    const char d = narrow[i + 1];
                    if (d == '$') { *out++ = static_cast<CharT>('$'); ++i; continue; }
                    if (d == '&') {
                        for (BidirIt it = m[0].first; it != m[0].second; ++it) *out++ = *it;
                        ++i; continue;
                    }
                    if (d >= '0' && d <= '9') {
                        const size_t g = static_cast<size_t>(d - '0');
                        if (g < m.size() && m[g].matched) {
                            for (BidirIt it = m[g].first; it != m[g].second; ++it) *out++ = *it;
                        }
                        ++i; continue;
                    }
                    *out++ = static_cast<CharT>('$');
                    continue;
                }
                if (c == '\\' && sed && i + 1 < narrow.size()) {
                    const char d = narrow[i + 1];
                    if (d >= '0' && d <= '9') {
                        const size_t g = static_cast<size_t>(d - '0');
                        if (g < m.size() && m[g].matched) {
                            for (BidirIt it = m[g].first; it != m[g].second; ++it) *out++ = *it;
                        }
                        ++i; continue;
                    }
                }
                *out++ = static_cast<CharT>(c);
            }
        }

        cur = m[0].second;
        if (first_only) break;
        if (m[0].first == m[0].second) {
            // 空匹配：前进一个字符，避免死循环
            if (cur == last) break;
            if (!no_copy) *out++ = *cur;
            ++cur;
        }
    }
    if (!no_copy) {
        for (BidirIt it = cur; it != last; ++it) *out++ = *it;
    }
    return out;
}

// 注意：返回串的重载不能带"推导不出来"的模板参数（原实现多了一个 class A，
// 它不在任何函数参数里出现 → 永远推导失败 → 这个重载实际上不可调用）。
template<class CharT, class Traits, class ST, class SA>
basic_string<CharT, ST, SA> regex_replace(const basic_string<CharT, ST, SA>& s,
                                          const basic_regex<CharT, Traits>& re,
                                          const basic_string<CharT, ST, SA>& fmt,
                                          regex_constants::match_flag_type flags = regex_constants::match_default) {
    basic_string<CharT, ST, SA> result;
    regex_replace(std::back_inserter(result), s.begin(), s.end(), re, fmt, flags);
    return result;
}

// 输入串是 C 字符串：用默认 traits/allocator 构造出 basic_string 再走上面的版本
template<class CharT, class Traits>
basic_string<CharT, Traits> regex_replace(const CharT* s,
                                          const basic_regex<CharT, Traits>& re,
                                          const basic_string<CharT, Traits>& fmt,
                                          regex_constants::match_flag_type flags = regex_constants::match_default) {
    return regex_replace(basic_string<CharT, Traits>(s), re, fmt, flags);
}

// 替换串是 C 字符串：直接转成 basic_string 再走上面的版本
template<class CharT, class Traits, class ST, class SA>
basic_string<CharT, ST, SA> regex_replace(const basic_string<CharT, ST, SA>& s,
                                          const basic_regex<CharT, Traits>& re,
                                          const CharT* fmt,
                                          regex_constants::match_flag_type flags = regex_constants::match_default) {
    return regex_replace(s, re, basic_string<CharT, ST, SA>(fmt), flags);
}

//=============================================================
// regex_iterator
//=============================================================
template<class BidirIt, class CharT = typename iterator_traits<BidirIt>::value_type,
         class Traits = char_traits<CharT> >
class regex_iterator {
public:
    typedef basic_regex<CharT, Traits> regex_type;
    typedef match_results<BidirIt>     value_type;
    typedef ptrdiff_t                  difference_type;
    typedef const value_type*          pointer;
    typedef const value_type&          reference;
    typedef std::forward_iterator_tag  iterator_category;

    regex_iterator() : _M_re(nullptr), _M_done(true) {}
    regex_iterator(BidirIt a, BidirIt b, const regex_type& re,
                   regex_constants::match_flag_type f = regex_constants::match_default)
        : _M_begin(a), _M_end(b), _M_re(&re), _M_flags(f), _M_done(false) {
        _M_search();
    }
    regex_iterator(const regex_iterator&) = default;
    regex_iterator& operator=(const regex_iterator&) = default;

    bool operator==(const regex_iterator& o) const {
        if (_M_done && o._M_done) return true;
        if (_M_done != o._M_done) return false;
        return _M_match[0].first == o._M_match[0].first &&
               _M_match[0].second == o._M_match[0].second &&
               _M_begin == o._M_begin && _M_end == o._M_end;
    }
    bool operator!=(const regex_iterator& o) const { return !(*this == o); }

    const value_type& operator*() const { return _M_match; }
    const value_type* operator->() const { return &_M_match; }

    regex_iterator& operator++() {
        if (_M_done) return *this;
        BidirIt next = _M_match[0].second;
        if (_M_match[0].first == _M_match[0].second) {
            // 空匹配：推进一个字符后继续搜索
            if (next == _M_end) { _M_done = true; return *this; }
            ++next;
        }
        _M_begin = next;
        _M_search();
        return *this;
    }
    regex_iterator operator++(int) { regex_iterator t = *this; ++*this; return t; }

private:
    void _M_search() {
        if (!_M_re) { _M_done = true; return; }
        if (_M_begin == _M_end) {
            // 允许在空串上匹配一次（如 "^"）
            if (!regex_search(_M_begin, _M_end, _M_match, *_M_re, _M_flags)) {
                _M_done = true;
            }
            return;
        }
        if (!regex_search(_M_begin, _M_end, _M_match, *_M_re, _M_flags)) _M_done = true;
    }

    BidirIt  _M_begin{};
    BidirIt  _M_end{};
    const regex_type* _M_re;
    regex_constants::match_flag_type _M_flags = regex_constants::match_default;
    value_type _M_match;
    bool _M_done = true;
};

typedef regex_iterator<std::string::const_iterator> sregex_iterator;
typedef regex_iterator<std::wstring::const_iterator> wsregex_iterator;

inline sregex_iterator sregex_iterator_begin(const std::string& s, const std::regex& re) {
    return sregex_iterator(s.begin(), s.end(), re);
}

//=============================================================
// regex_token_iterator
//
// 支持两种常用用法：
//   submatch >= 0 : 每次匹配产出第 submatch 个子匹配
//   submatch == -1: 产出匹配之间的文本（"按分隔符切分"）
// 也可传入一组下标，每个匹配依次产出这些下标对应的内容。
//=============================================================
template<class BidirIt, class CharT = typename iterator_traits<BidirIt>::value_type,
         class Traits = char_traits<CharT> >
class regex_token_iterator {
public:
    typedef basic_regex<CharT, Traits> regex_type;
    typedef sub_match<BidirIt>         value_type;
    typedef ptrdiff_t                  difference_type;
    typedef const value_type*          pointer;
    typedef const value_type&          reference;
    typedef std::forward_iterator_tag  iterator_category;

    regex_token_iterator() : _M_done(true) {}

    regex_token_iterator(BidirIt a, BidirIt b, const regex_type& re, int submatch = 0,
                         regex_constants::match_flag_type f = regex_constants::match_default)
        : _M_begin(a), _M_end(b), _M_re(&re), _M_flags(f), _M_done(false) {
        _M_subs.push_back(submatch);
        _M_init();
    }

    regex_token_iterator(BidirIt a, BidirIt b, const regex_type& re,
                         const std::vector<int>& subs,
                         regex_constants::match_flag_type f = regex_constants::match_default)
        : _M_begin(a), _M_end(b), _M_re(&re), _M_subs(subs), _M_flags(f), _M_done(false) {
        _M_init();
    }

    bool operator==(const regex_token_iterator& o) const {
        if (_M_done || o._M_done) return _M_done == o._M_done;
        return _M_cur.first == o._M_cur.first && _M_cur.second == o._M_cur.second
            && _M_idx == o._M_idx;
    }
    bool operator!=(const regex_token_iterator& o) const { return !(*this == o); }

    const value_type& operator*() const { return _M_cur; }
    const value_type* operator->() const { return &_M_cur; }

    regex_token_iterator& operator++() {
        if (_M_done) return *this;
        ++_M_idx;
        if (_M_idx < _M_subs.size()) { _M_emit(); return *this; }
        _M_advance();
        return *this;
    }
    regex_token_iterator operator++(int) { regex_token_iterator t = *this; ++*this; return t; }

private:
    // -1 是否在下标表里：决定了"末尾残余文本"要不要单独产出一个 token
    bool _M_wants_split() const {
        for (size_t i = 0; i < _M_subs.size(); ++i)
            if (_M_subs[i] == -1) return true;
        return false;
    }

    void _M_find_next() {
        _M_have = regex_search(_M_begin, _M_end, _M_match, *_M_re, _M_flags);
    }

    void _M_emit() {
        const int idx = _M_subs[_M_idx];
        if (idx == -1) {
            // 上一段结尾 → 本次匹配开头；没有匹配了就是到串尾
            _M_cur.first  = _M_prev_end;
            _M_cur.second = _M_have ? _M_match[0].first : _M_end;
            _M_cur.matched = true;
        } else if (_M_have && static_cast<size_t>(idx) < _M_match.size()) {
            _M_cur = _M_match[static_cast<size_t>(idx)];
        } else {
            _M_cur.first = _M_cur.second = _M_end;
            _M_cur.matched = false;
        }
    }

    void _M_init() {
        _M_prev_end = _M_begin;
        _M_idx = 0;
        _M_find_next();
        if (!_M_have && !_M_wants_split()) { _M_done = true; return; }
        _M_emit();
    }

    void _M_advance() {
        if (!_M_have) { _M_done = true; return; }   // 残余文本已产出，后面没有了
        _M_prev_end = _M_match[0].second;

        BidirIt next = _M_match[0].second;
        if (_M_match[0].first == next) {            // 空匹配：必须前进一格
            if (next == _M_end) { _M_done = true; return; }
            ++next;
        }
        _M_begin = next;
        _M_idx = 0;
        _M_find_next();
        // 没有更多匹配时：只有 -1 模式才再产出一个残余 token
        if (!_M_have && !_M_wants_split()) { _M_done = true; return; }
        _M_emit();
    }

    BidirIt  _M_begin{};
    BidirIt  _M_end{};
    BidirIt  _M_prev_end{};
    const regex_type* _M_re{};
    std::vector<int>  _M_subs;
    size_t   _M_idx = 0;
    regex_constants::match_flag_type _M_flags = regex_constants::match_default;
    match_results<BidirIt> _M_match;
    value_type _M_cur;
    bool     _M_have = false;
    bool     _M_done = true;
};

typedef regex_token_iterator<std::string::const_iterator> sregex_token_iterator;
typedef regex_token_iterator<std::wstring::const_iterator> wsregex_token_iterator;

