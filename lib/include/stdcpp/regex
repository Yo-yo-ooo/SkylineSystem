//=============================================================
// sub_match
//=============================================================
template<class BidirIt>
class sub_match : public pair<BidirIt, BidirIt> {
public:
    typedef typename iterator_traits<BidirIt>::value_type value_type;
    typedef typename iterator_traits<BidirIt>::difference_type difference_type;
    typedef BidirIt iterator;
    typedef basic_string<value_type> string_type;

    bool matched;

    sub_match() : pair<BidirIt, BidirIt>(), matched(false) {}

    difference_type length() const { return matched ? this->second - this->first : 0; }

    operator string_type() const { return str(); }

    string_type str() const {
        return matched ? string_type(this->first, this->second) : string_type();
    }

    int compare(const string_type& s) const { return str().compare(s); }
    int compare(const value_type* s) const { return str().compare(s); }
};

template<class BidirIt>
bool operator==(const sub_match<BidirIt>& a, const sub_match<BidirIt>& b) {
    return a.compare(b.str()) == 0;
}
template<class BidirIt>
bool operator!=(const sub_match<BidirIt>& a, const sub_match<BidirIt>& b) {
    return a.compare(b.str()) != 0;
}
template<class BidirIt>
bool operator<(const sub_match<BidirIt>& a, const sub_match<BidirIt>& b) {
    return a.compare(b.str()) < 0;
}

//=============================================================
// match_results
//=============================================================
template<class BidirIt>
class match_results {
public:
    typedef sub_match<BidirIt>                       value_type;
    typedef const value_type&                        const_reference;
    typedef value_type&                              reference;
    typedef BidirIt                                  const_iterator;
    typedef typename value_type::string_type         string_type;
    typedef typename string_type::size_type          size_type;
    typedef typename iterator_traits<BidirIt>::difference_type difference_type;
    typedef std::vector<value_type>                  container_type;

    match_results() {}
    explicit match_results(const BidirIt& b, const BidirIt& e) : _M_begin(b), _M_end(e) {}

    bool ready() const { return _M_ready; }
    size_type size() const { return _M_subs.size(); }
    bool empty() const { return _M_subs.empty(); }

    const_reference operator[](size_type n) const { return _M_subs[n]; }
    const_reference prefix() const { return _M_prefix; }
    const_reference suffix() const { return _M_suffix; }

    string_type str(size_type n = 0) const { return _M_subs[n].str(); }
    const_iterator begin() const { return _M_begin; }
    const_iterator end() const { return _M_end; }

    difference_type position(size_type n = 0) const {
        return _M_subs[n].matched ? _M_subs[n].first - _M_begin : -1;
    }
    difference_type length(size_type n = 0) const {
        return _M_subs[n].length();
    }

    void swap(match_results& o) {
        _M_subs.swap(o._M_subs);
        std::swap(_M_begin, o._M_begin);
        std::swap(_M_end, o._M_end);
        std::swap(_M_prefix, o._M_prefix);
        std::swap(_M_suffix, o._M_suffix);
        std::swap(_M_ready, o._M_ready);
    }

    // 供内部使用
    std::vector<value_type>& _M_slots() { return _M_subs; }
    value_type& _M_prefix_slot() { return _M_prefix; }
    value_type& _M_suffix_slot() { return _M_suffix; }
    void _M_set(bool ready, BidirIt b, BidirIt e) {
        _M_ready = ready; _M_begin = b; _M_end = e;
    }

private:
    std::vector<value_type> _M_subs;
    BidirIt     _M_begin{};
    BidirIt     _M_end{};
    value_type  _M_prefix;
    value_type  _M_suffix;
    bool        _M_ready = false;
};

//=============================================================
// basic_regex
//=============================================================
template<class CharT, class Traits = char_traits<CharT> >
class basic_regex {
public:
    typedef CharT                                  value_type;
    typedef Traits                                 traits_type;
    typedef basic_string<CharT, Traits>            string_type;
    typedef regex_constants::syntax_option_type    flag_type;
    typedef const CharT*                           locale_type;
    typedef __regex_detail::char_class             char_class_type;

    // 标准要求把 regex_constants 的语法开关作为 basic_regex 的静态成员暴露，
    // 这样 std::regex::icase 才能用（而不必写 std::regex_constants::icase）
    static constexpr flag_type icase      = regex_constants::icase;
    static constexpr flag_type nosubs     = regex_constants::nosubs;
    static constexpr flag_type optimize   = regex_constants::optimize;
    static constexpr flag_type collate    = regex_constants::collate;
    static constexpr flag_type ECMAScript = regex_constants::ECMAScript;
    static constexpr flag_type basic      = regex_constants::basic;
    static constexpr flag_type extended   = regex_constants::extended;
    static constexpr flag_type awk        = regex_constants::awk;
    static constexpr flag_type grep       = regex_constants::grep;
    static constexpr flag_type egrep      = regex_constants::egrep;

    basic_regex() : _M_flags(regex_constants::ECMAScript), _M_groups(0) {}

    explicit basic_regex(const CharT* p, flag_type f = regex_constants::ECMAScript)
        : _M_flags(f), _M_groups(0) {
        _M_compile(p, Traits::length(p));
    }

    basic_regex(const CharT* p, size_t len, flag_type f = regex_constants::ECMAScript)
        : _M_flags(f), _M_groups(0) {
        _M_compile(p, len);
    }

    basic_regex(const string_type& s, flag_type f = regex_constants::ECMAScript)
        : _M_flags(f), _M_groups(0) {
        _M_compile(s.data(), s.size());
    }

    basic_regex(const basic_regex&) = default;
    basic_regex(basic_regex&&) = default;
    basic_regex& operator=(const basic_regex&) = default;
    basic_regex& operator=(basic_regex&&) = default;

    basic_regex& operator=(const CharT* p) { assign(p); return *this; }
    basic_regex& operator=(const string_type& s) { assign(s); return *this; }

    basic_regex& assign(const CharT* p, flag_type f = regex_constants::ECMAScript) {
        _M_flags = f; _M_groups = 0; _M_compile(p, Traits::length(p)); return *this;
    }
    basic_regex& assign(const CharT* p, size_t len, flag_type f = regex_constants::ECMAScript) {
        _M_flags = f; _M_groups = 0; _M_compile(p, len); return *this;
    }
    basic_regex& assign(const string_type& s, flag_type f = regex_constants::ECMAScript) {
        return assign(s.data(), s.size(), f);
    }

    void swap(basic_regex& o) {
        _M_prog.swap(o._M_prog);
        _M_classes.swap(o._M_classes);
        std::swap(_M_flags, o._M_flags);
        std::swap(_M_groups, o._M_groups);
    }

    size_t mark_count() const { return _M_groups; }
    flag_type flags() const { return _M_flags; }
    bool empty() const { return _M_prog.empty(); }

    // 内部访问
    const std::vector<__regex_detail::inst>& _M_program() const { return _M_prog; }
    const std::vector<__regex_detail::char_class>& _M_char_classes() const { return _M_classes; }

private:
    void _M_compile(const CharT* p, size_t len) {
        __regex_detail::compiler<CharT, Traits> c(p, len, _M_flags);
        if (!c.compile()) {
            // error() 返回标准 error_type；负值表示内存不足
            regex_constants::error_type e = (c.error() < 0)
                ? regex_constants::error_space
                : static_cast<regex_constants::error_type>(c.error());
            STDCPP_THROW(regex_error(e));
            STDCPP_FAIL("std::regex: bad pattern");
        }
        _M_prog.swap(c.program());
        _M_classes.swap(c.classes());
        _M_groups = c.group_count();
        if (_M_flags & regex_constants::nosubs) _M_groups = 0;
    }

    std::vector<__regex_detail::inst>       _M_prog;
    std::vector<__regex_detail::char_class> _M_classes;
    flag_type _M_flags;
    size_t    _M_groups;
};

typedef basic_regex<char>    regex;
typedef basic_regex<wchar_t> wregex;

//=============================================================
// 匹配引擎
//=============================================================
namespace __regex_detail {

template<class CharT, class Traits>
struct matcher {
    typedef basic_regex<CharT, Traits> regex_type;
    typedef basic_string<CharT, Traits> string_type;

    const std::vector<inst>&       prog;
    const std::vector<char_class>& classes;
    const CharT*                   text;
    size_t                         len;
    bool                           icase_on;
    bool                           multiline_on;
    bool                           not_bol_on;   // match_not_bol: 起点不当作行首
    bool                           not_eol_on;   // match_not_eol: 终点不当作行尾
    bool                           full_match;   // regex_match：要求正好消耗到串尾
    size_t                         ngroups;

    // 捕获槽：每个组两个槽（起点/终点），0 槽为整体匹配
    std::vector<size_t> caps;

    matcher(const regex_type& re, const CharT* t, size_t n, bool icase_f, bool ml)
        : prog(re._M_program()), classes(re._M_char_classes()), text(t), len(n),
          icase_on(icase_f), multiline_on(ml), not_bol_on(false), not_eol_on(false),
          full_match(false), ngroups(re.mark_count()) {
        caps.assign((ngroups + 1) * 2, npos());
    }

    void not_bol(bool v) { not_bol_on = v; }
    void not_eol(bool v) { not_eol_on = v; }

    static size_t npos() { return static_cast<size_t>(-1); }

    bool char_eq(uint32_t a, uint32_t b) const {
        if (a == b) return true;
        if (!icase_on) return false;
        return ascii_lower(a) == ascii_lower(b);
    }

    bool at_bol(size_t sp) const {
        if (sp == 0) return !not_bol_on;
        if (!multiline_on) return false;
        return static_cast<uint32_t>(text[sp - 1]) == '\n';
    }
    bool at_eol(size_t sp) const {
        if (sp == len) return !not_eol_on;
        if (!multiline_on) return false;
        return static_cast<uint32_t>(text[sp]) == '\n';
    }
    bool is_word_at(size_t i) const {
        return i < len && is_word_char(static_cast<uint32_t>(text[i]));
    }

    //---------------------------------------------------------
    // 迭代式回溯匹配（显式栈）
    //
    // 不用递归的原因有两个，都是在内核里不可接受的：
    //   1) 递归深度随输入长度增长（"a*" 匹配 10 万字符 = 10 万层栈帧）；
    //   2) 空匹配的循环（如 (a*)*）会无限递归直到栈溢出。
    //
    // 栈上放两类撤销记录，按 LIFO 弹出：
    //   UAlt  - 备选分支 (pc, sp)
    //   USave - 回滚某个捕获槽
    //   UMark - 回滚"空循环"哨兵
    // 失败时依次弹出：先回滚捕获，遇到 UAlt 就换到备选分支继续。
    //---------------------------------------------------------
    struct undo {
        size_t kind;   // 0=Alt 1=Save 2=Mark
        size_t a;      // pc / slot / pc
        size_t b;      // sp / 旧值 / 旧值
    };

    std::vector<undo>  _M_stack;
    std::vector<size_t> _M_mark;   // 每个 Split 上一次被进入时的 sp（防空循环）

    void full(bool v) { full_match = v; }

    bool run(size_t pc0, size_t sp0) {
        _M_stack.clear();
        if (_M_mark.size() != prog.size()) _M_mark.assign(prog.size(), npos());

        size_t pc = pc0, sp = sp0;
        bool failed = false;

        for (;;) {
            if (!failed) {
                if (pc >= prog.size()) { failed = true; }
                else {
                    const inst& in = prog[pc];
                    switch (in.op) {
                        case inst::OpChar:
                            if (sp >= len || !char_eq(static_cast<uint32_t>(text[sp]), in.c)) failed = true;
                            else { ++sp; ++pc; }
                            continue;

                        case inst::OpAny:
                            if (sp >= len || static_cast<uint32_t>(text[sp]) == '\n') failed = true;
                            else { ++sp; ++pc; }
                            continue;

                        case inst::OpClass:
                            if (sp >= len || !classes[in.c].match(static_cast<uint32_t>(text[sp]), icase_on)) failed = true;
                            else { ++sp; ++pc; }
                            continue;

                        case inst::OpBol:
                            if (!at_bol(sp)) failed = true; else ++pc;
                            continue;

                        case inst::OpEol:
                            if (!at_eol(sp)) failed = true; else ++pc;
                            continue;

                        case inst::OpWordB: {
                            const bool a = sp > 0 && is_word_char(static_cast<uint32_t>(text[sp - 1]));
                            const bool b = is_word_at(sp);
                            if (a == b) failed = true; else ++pc;
                            continue;
                        }

                        case inst::OpNotWordB: {
                            const bool a = sp > 0 && is_word_char(static_cast<uint32_t>(text[sp - 1]));
                            const bool b = is_word_at(sp);
                            if (a != b) failed = true; else ++pc;
                            continue;
                        }

                        case inst::OpBackref: {
                            const size_t g = in.c;
                            if (g == 0 || 2 * g + 1 >= caps.size()) { failed = true; continue; }
                            const size_t bs = caps[2 * g], be = caps[2 * g + 1];
                            if (bs == npos() || be == npos()) { failed = true; continue; }  // 未参与匹配
                            const size_t n = be - bs;
                            if (sp + n > len) { failed = true; continue; }
                            bool eq = true;
                            for (size_t i = 0; i < n; ++i)
                                if (!char_eq(static_cast<uint32_t>(text[sp + i]),
                                             static_cast<uint32_t>(text[bs + i]))) { eq = false; break; }
                            if (!eq) { failed = true; continue; }
                            sp += n; ++pc;
                            continue;
                        }

                        case inst::OpSave: {
                            const size_t slot = in.c;
                            if (slot < caps.size()) {
                                undo u; u.kind = 1; u.a = slot; u.b = caps[slot];
                                _M_stack.push_back(u);
                                caps[slot] = sp;
                            }
                            ++pc;
                            continue;
                        }

                        case inst::OpSplit: {
                            // 空循环保护：同一个 Split 在没有前进的情况下又被进入，
                            // 说明循环体匹配了空串 —— 只能走退出分支，否则永不终止。
                            if (_M_mark[pc] == sp) { pc = in.y; continue; }
                            undo m; m.kind = 2; m.a = pc; m.b = _M_mark[pc];
                            _M_stack.push_back(m);
                            _M_mark[pc] = sp;

                            undo u; u.kind = 0; u.a = in.y; u.b = sp;
                            _M_stack.push_back(u);
                            pc = in.x;                 // 先试优先分支 x
                            continue;
                        }

                        case inst::OpJmp:
                            pc = in.x;
                            continue;

                        case inst::OpMatch:
                            // regex_match 要求正好消耗到串尾；否则回溯继续找别的路径
                            if (!full_match || sp == len) return true;
                            failed = true;
                            continue;
                    }
                    failed = true;
                    continue;
                }
            }

            //---------------- 回溯 ----------------
            bool resumed = false;
            while (!_M_stack.empty()) {
                const undo u = _M_stack.back();
                _M_stack.pop_back();
                if (u.kind == 1) { caps[u.a] = u.b; continue; }   // 回滚捕获
                if (u.kind == 2) { _M_mark[u.a] = u.b; continue; } // 回滚空循环哨兵
                pc = u.a; sp = u.b;                                // 换到备选分支
                resumed = true;
                break;
            }
            if (!resumed) return false;
            failed = false;
        }
    }
};

