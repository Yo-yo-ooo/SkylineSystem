//=============================================================
//  Integer comparison functions  [utility.intcmp]  (C++20)
//=============================================================
#if STDCPP_UTL_CXX20
namespace __ftl_utl
{
    template<class T, class U>
    static constexpr bool __cmp_unsigned() noexcept
    { return is_unsigned_v<T> == is_unsigned_v<U>; }

    // Both signed or both unsigned -> safe comparison after common type.
    template<class T, class U>
    constexpr bool __cmp_eq_same(T t, U u) noexcept {
        using C = common_type_t<T, U>;
        return static_cast<C>(t) == static_cast<C>(u);
    }
    template<class T, class U>
    constexpr bool __cmp_lt_same(T t, U u) noexcept {
        using C = common_type_t<T, U>;
        return static_cast<C>(t) < static_cast<C>(u);
    }
}

template<class T, class U>
constexpr bool cmp_equal(T t, U u) noexcept
{
    static_assert(is_integral_v<T> && is_integral_v<U>,
        "cmp_equal requires integer types");
    if constexpr (is_signed_v<T> == is_signed_v<U>)
        return __ftl_utl::__cmp_eq_same(t, u);
    else if constexpr (is_signed_v<T>)
        return t < 0 ? false : __ftl_utl::__cmp_eq_same(static_cast<make_unsigned_t<T>>(t), u);
    else
        return u < 0 ? false : __ftl_utl::__cmp_eq_same(t, static_cast<make_unsigned_t<U>>(u));
}

template<class T, class U>
constexpr bool cmp_not_equal(T t, U u) noexcept { return !cmp_equal(t, u); }

template<class T, class U>
constexpr bool cmp_less(T t, U u) noexcept
{
    static_assert(is_integral_v<T> && is_integral_v<U>,
        "cmp_less requires integer types");
    if constexpr (is_signed_v<T> == is_signed_v<U>)
        return __ftl_utl::__cmp_lt_same(t, u);
    else if constexpr (is_signed_v<T>)
        return t < 0 ? true : __ftl_utl::__cmp_lt_same(static_cast<make_unsigned_t<T>>(t), u);
    else
        return u < 0 ? false : __ftl_utl::__cmp_lt_same(t, static_cast<make_unsigned_t<U>>(u));
}

template<class T, class U>
constexpr bool cmp_greater(T t, U u) noexcept { return cmp_less(u, t); }

template<class T, class U>
constexpr bool cmp_less_equal(T t, U u) noexcept { return !cmp_less(u, t); }

template<class T, class U>
constexpr bool cmp_greater_equal(T t, U u) noexcept { return !cmp_less(t, u); }

template<class R, class T>
constexpr bool in_range(T t) noexcept
{
    static_assert(is_integral<T>::value && is_integral<R>::value,
        "in_range requires integer types");
    using UR = make_unsigned_t<R>;
    constexpr R rmin = is_signed<R>::value
        ? static_cast<R>(static_cast<UR>(1) << (sizeof(R)*8 - 1)) : R(0);
    constexpr R rmax = is_signed<R>::value
        ? static_cast<R>(static_cast<UR>(rmin) - UR(1))
        : static_cast<R>(~UR(0));
    return cmp_greater_equal(t, rmin) && cmp_less_equal(t, rmax);
}
#endif // C++20

