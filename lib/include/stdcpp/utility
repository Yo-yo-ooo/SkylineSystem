// to_underlying (C++23)
//=============================================================
#if STDCPP_UTL_CXX23
template<class E>
constexpr typename underlying_type<E>::type to_underlying(E e) noexcept {
    return static_cast<typename underlying_type<E>::type>(e);
}
#endif

