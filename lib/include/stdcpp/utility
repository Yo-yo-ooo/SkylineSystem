//=============================================================
//  pair  [pairs]
//=============================================================
template<class T1, class T2>
struct pair
{
    typedef T1 first_type;
    typedef T2 second_type;

    T1 first;
    T2 second;

    // Default constructor (conditionally explicit in C++17).
#if STDCPP_UTL_CXX17
    template<bool D = is_default_constructible<T1>::value
                    && is_default_constructible<T2>::value,
        typename enable_if<D, int>::type = 0>
    constexpr pair()
        noexcept(is_nothrow_default_constructible<T1>::value
                 && is_nothrow_default_constructible<T2>::value)
        : first(), second() {}
#else
    constexpr pair() : first(), second() {}
#endif

    // Element constructor.
    template<class U1 = T1, class U2 = T2,
        typename enable_if<is_constructible<T1, U1&&>::value
                    && is_constructible<T2, U2&&>::value, int>::type = 0>
    constexpr pair(U1&& x, U2&& y)
        : first(std::forward<U1>(x)), second(std::forward<U2>(y)) {}

    // Converting constructor from another pair.
    template<class U1, class U2,
        typename enable_if<is_constructible<T1, const U1&>::value
                    && is_constructible<T2, const U2&>::value, int>::type = 0>
    constexpr pair(const pair<U1, U2>& p)
        : first(p.first), second(p.second) {}

    template<class U1, class U2,
        typename enable_if<is_constructible<T1, U1&&>::value
                    && is_constructible<T2, U2&&>::value, int>::type = 0>
    constexpr pair(pair<U1, U2>&& p)
        : first(std::forward<U1>(p.first)),
          second(std::forward<U2>(p.second)) {}

    // Copy / move constructors.
    constexpr pair(const pair&) = default;
    constexpr pair(pair&&) = default;

    // Piecewise constructor -- defined in tuple.hpp after tuple is complete.
    template<class... Args1, class... Args2>
    pair(piecewise_construct_t,
         tuple<Args1...> first_args, tuple<Args2...> second_args);

    // Private dispatch constructor for piecewise construction.
    template<size_t... I1, size_t... I2, class Tuple1, class Tuple2>
    pair(__ftl_utl::__idx_pack<I1...>, __ftl_utl::__idx_pack<I2...>,
         Tuple1&& t1, Tuple2&& t2, int);

    pair& operator=(const pair&) = default;
    pair& operator=(pair&&) = default;

    template<class U1, class U2>
    constexpr typename enable_if<is_assignable<T1&, const U1&>::value
                          && is_assignable<T2&, const U2&>::value, pair&>::type
    operator=(const pair<U1, U2>& p)
    { first = p.first; second = p.second; return *this; }

    template<class U1, class U2>
    constexpr typename enable_if<is_assignable<T1&, U1&&>::value
                          && is_assignable<T2&, U2&&>::value, pair&>::type
    operator=(pair<U1, U2>&& p)
    {
        first = std::forward<U1>(p.first);
        second = std::forward<U2>(p.second);
        return *this;
    }

#if STDCPP_UTL_CXX23
    // C++23: assignment from a two-element tuple-like type.
    template<class PairLike,
        typename enable_if<!is_reference<PairLike>::value, int>::type* = nullptr>
    constexpr pair& operator=(PairLike&& pl)
    {
        first  = std::get<0>(std::forward<PairLike>(pl));
        second = std::get<1>(std::forward<PairLike>(pl));
        return *this;
    }
#endif

#if STDCPP_UTL_CXX14
    constexpr
#endif
    void swap(pair& o)
#if STDCPP_UTL_CXX17
        noexcept(is_nothrow_swappable<T1>::value
                 && is_nothrow_swappable<T2>::value)
#endif
    {
        using std::swap;
        swap(first, o.first);
        swap(second, o.second);
    }
};

