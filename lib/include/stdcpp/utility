//=============================================================
// tuple_size / tuple_element for pair (C++11)
//=============================================================
#if STDCPP_UTL_CXX11
template<class T> struct tuple_size;
template<size_t I, class T> struct tuple_element;

template<class T1, class T2>
struct tuple_size<pair<T1, T2> > : integral_constant<size_t, 2> {};

template<class T1, class T2>
struct tuple_element<0, pair<T1, T2> > { typedef T1 type; };
template<class T1, class T2>
struct tuple_element<1, pair<T1, T2> > { typedef T2 type; };

template<size_t I, class T1, class T2>
constexpr typename tuple_element<I, pair<T1, T2> >::type&
get(pair<T1, T2>& p) noexcept {
    return I == 0 ? p.first : p.second;
}
template<size_t I, class T1, class T2>
constexpr const typename tuple_element<I, pair<T1, T2> >::type&
get(const pair<T1, T2>& p) noexcept {
    return I == 0 ? p.first : p.second;
}
#endif

//=============================================================
// index_sequence (C++14)
//=============================================================
#if STDCPP_UTL_CXX14
template<size_t... Ints>
struct index_sequence {
    typedef size_t value_type;
    static constexpr size_t size() noexcept { return sizeof...(Ints); }
};

template<class T, T... Ints>
using integer_sequence = index_sequence<(size_t)Ints...>;

namespace __detail {
    template<size_t N, size_t... Ints>
    struct make_index_seq : make_index_seq<N - 1, N - 1, Ints...> {};
    template<size_t... Ints>
    struct make_index_seq<0, Ints...> { typedef index_sequence<Ints...> type; };
}

template<size_t N>
using make_index_sequence = typename __detail::make_index_seq<N>::type;

template<class... T>
using index_sequence_for = make_index_sequence<sizeof...(T)>;
#endif

//=============================================================
// in_range / cmp_* (C++20 utility.h comparisons)
//=============================================================
#if STDCPP_UTL_CXX20
template<class R, class T>
constexpr bool in_range(T t) noexcept {
    return t >= T(0) ? (unsigned long long)t <= (unsigned long long)R(-1)
                     : (long long)t >= (long long)R(-1) - (long long)R(0);
}

template<class T, class U>
constexpr bool cmp_equal(T t, U u) noexcept {
    using UT = typename make_unsigned<T>::type;
    using UU = typename make_unsigned<U>::type;
    if (t < 0 && u < 0) return true;
    if (t < 0 || u < 0) return false;
    return UT(t) == UU(u);
}
#endif

