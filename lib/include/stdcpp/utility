//  forward_like  [utility.forward.like]  (C++23)
//=============================================================
#if STDCPP_UTL_CXX23
namespace __ftl_utl
{
    template<class T, class U>
    using __forward_like_t = conditional_t<
        is_rvalue_reference_v<T>,
        remove_reference_t<U>&&,
        add_lvalue_reference_t<conditional_t<
            is_const_v<remove_reference_t<T>>,
            add_const_t<remove_reference_t<U>>,
            remove_reference_t<U>>>>;
}

template<class T, class U>
[[nodiscard]] constexpr auto&& forward_like(U&& x) noexcept
{
    static_assert(is_lvalue_reference_v<T>,
        "T must be an lvalue reference type");
    return static_cast<__ftl_utl::__forward_like_t<T, U>>(x);
}
#endif

