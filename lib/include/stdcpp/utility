// Forward declaration of pair and get<I>(pair) (defined after pair).
template<class T1, class T2> struct pair;
template<size_t I, class T1, class T2>
constexpr typename enable_if<I == 0, T1&>::type get(pair<T1, T2>&) noexcept;
template<size_t I, class T1, class T2>
constexpr typename enable_if<I == 0, const T1&>::type get(const pair<T1, T2>&) noexcept;
template<size_t I, class T1, class T2>
constexpr typename enable_if<I == 1, T2&>::type get(pair<T1, T2>&) noexcept;
