#if STDCPP_UTL_CXX14
template<class T, T... I>
struct integer_sequence
{
    typedef T value_type;
    static constexpr size_t size() noexcept { return sizeof...(I); }
};

template<size_t... I>
using index_sequence = integer_sequence<size_t, I...>;

namespace __ftl_utl
{
    // Concatenate two integer_sequences.
    template<class, class> struct __is_cat;
    template<class T, T... A, T... B>
    struct __is_cat<integer_sequence<T, A...>, integer_sequence<T, B...>>
    { using type = integer_sequence<T, A..., (sizeof...(A)+B)...>; };

    template<class T, size_t N>
    struct __make_is
        : __is_cat<typename __make_is<T, N/2>::type,
                   typename __make_is<T, N - N/2>::type> {};
    template<class T> struct __make_is<T, 0> { using type = integer_sequence<T>; };
    template<class T> struct __make_is<T, 1> { using type = integer_sequence<T, 0>; };
}

template<class T, T N>
using make_integer_sequence =
    typename __ftl_utl::__make_is<T, (size_t)N>::type;

template<size_t N>
using make_index_sequence = make_integer_sequence<size_t, N>;

template<class... T>
using index_sequence_for = make_index_sequence<sizeof...(T)>;
#endif // C++14

