//=============================================================
//  move / forward / move_if_noexcept  [utility.swap]
//  If libstdc++'s <bits/move.h> was already pulled in (e.g. by
//  <exception>), skip these to avoid redefinition.  Otherwise
//  provide them and block <bits/move.h> from future inclusion.
//=============================================================
#ifdef _MOVE_H
// <bits/move.h> already included by a system header; it provides
// move/forward/move_if_noexcept/addressof/exchange.
#  define STDCPP_UTL_SKIP_EXCHANGE 1
#  define STDCPP_UTL_SKIP_SWAP 1
#else
#define _MOVE_H 1
template<class T>
constexpr typename remove_reference<T>::type&& move(T&& t) noexcept
{ return static_cast<typename remove_reference<T>::type&&>(t); }

template<class T>
constexpr T&& forward(typename remove_reference<T>::type& t) noexcept
{ return static_cast<T&&>(t); }

template<class T>
constexpr T&& forward(typename remove_reference<T>::type&& t) noexcept
{
    static_assert(!is_lvalue_reference<T>::value,
        "template argument substituting T is an lvalue reference type");
    return static_cast<T&&>(t);
}

// libstdc++ internal helper used by <bits/stl_iterator.h> etc.
template<class T>
struct __move_if_noexcept_cond
    : integral_constant<bool,
        !is_nothrow_move_constructible<T>::value
            && is_copy_constructible<T>::value> {};

template<class T>
constexpr typename conditional<
    !is_nothrow_move_constructible<T>::value
        && is_copy_constructible<T>::value,
    const T&, T&&>::type
move_if_noexcept(T& x) noexcept
{ return std::move(x); }

// addressof  [specialized.addressof]
template<class T>
inline T* addressof(T& r) noexcept
{ return reinterpret_cast<T*>(
    const_cast<char*>(&reinterpret_cast<const volatile char&>(r))); }

// libstdc++ internal __addressof (used by <bits/std_mutex.h> etc.)
template<class T>
inline T* __addressof(T& r) noexcept { return addressof(r); }
#endif // _MOVE_H

//=============================================================
//  swap  [utility.swap]
//=============================================================
#ifndef STDCPP_UTL_SKIP_SWAP
template<class T>
inline
#if STDCPP_UTL_CXX20
constexpr
#endif
_Require<__not_<__is_tuple_like<T>>,
         is_move_constructible<T>,
         is_move_assignable<T>>
swap(T& a, T& b)
noexcept(__and_<is_nothrow_move_constructible<T>,
                is_nothrow_move_assignable<T>>::value)
{
    T tmp(static_cast<T&&>(a));
    a = static_cast<T&&>(b);
    b = static_cast<T&&>(tmp);
}

template<class T, size_t N>
inline
#if STDCPP_UTL_CXX20
constexpr
#endif
__enable_if_t<__is_swappable<T>::value>
swap(T (&a)[N], T (&b)[N])
noexcept(__is_nothrow_swappable<T>::value)
{
    for (size_t i = 0; i < N; ++i) swap(a[i], b[i]);
}
#endif // STDCPP_UTL_SKIP_SWAP

//=============================================================
//  exchange  [utility.exchange]  (C++14)
//=============================================================
#if STDCPP_UTL_CXX14
#ifndef STDCPP_UTL_SKIP_EXCHANGE
template<class T, class U = T>
constexpr T exchange(T& obj, U&& new_val)
{
    T old = std::move(obj);
    obj = std::forward<U>(new_val);
    return old;
}
#endif
#endif

