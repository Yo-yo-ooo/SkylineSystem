//-------------------------------------------------------------
//  __gnu_cxx compatibility for system headers (<vector>, etc.)
//-------------------------------------------------------------
namespace __gnu_cxx
{
    template<bool Cond, class T = void>
    struct __enable_if {};
    template<class T>
    struct __enable_if<true, T> { typedef T __type; };

    template<bool Cond, class IfTrue, class IfFalse>
    struct __conditional_type { typedef IfTrue __type; };
    template<class IfTrue, class IfFalse>
    struct __conditional_type<false, IfTrue, IfFalse> { typedef IfFalse __type; };

    // Minimal __normal_iterator -- enough for system containers.
    template<class It, class Container>
    class __normal_iterator
    {
    protected:
        It _M_current;
    public:
        typedef typename std::iterator_traits<It>::iterator_category iterator_category;
        typedef typename std::iterator_traits<It>::value_type        value_type;
        typedef typename std::iterator_traits<It>::difference_type   difference_type;
        typedef typename std::iterator_traits<It>::reference         reference;
        typedef typename std::iterator_traits<It>::pointer           pointer;

        __normal_iterator() : _M_current() {}
        explicit __normal_iterator(It i) : _M_current(i) {}
        template<class It2>
        __normal_iterator(const __normal_iterator<It2, Container>& o)
            : _M_current(o.base()) {}

        It base() const { return _M_current; }
        reference operator*() const { return *_M_current; }
        pointer operator->() const { return _M_current; }
        __normal_iterator& operator++() { ++_M_current; return *this; }
        __normal_iterator operator++(int)
        { __normal_iterator t = *this; ++_M_current; return t; }
        __normal_iterator& operator--() { --_M_current; return *this; }
        __normal_iterator operator--(int)
        { __normal_iterator t = *this; --_M_current; return t; }
        __normal_iterator operator+(difference_type n) const
        { return __normal_iterator(_M_current + n); }
        __normal_iterator& operator+=(difference_type n)
        { _M_current += n; return *this; }
        __normal_iterator operator-(difference_type n) const
        { return __normal_iterator(_M_current - n); }
        __normal_iterator& operator-=(difference_type n)
        { _M_current -= n; return *this; }
        reference operator[](difference_type n) const
        { return _M_current[n]; }

        bool operator==(const __normal_iterator& o) const
        { return _M_current == o._M_current; }
        bool operator!=(const __normal_iterator& o) const
        { return _M_current != o._M_current; }
        bool operator<(const __normal_iterator& o) const
        { return _M_current < o._M_current; }
        bool operator<=(const __normal_iterator& o) const
        { return _M_current <= o._M_current; }
        bool operator>(const __normal_iterator& o) const
        { return _M_current > o._M_current; }
        bool operator>=(const __normal_iterator& o) const
        { return _M_current >= o._M_current; }
        difference_type operator-(const __normal_iterator& o) const
        { return _M_current - o._M_current; }
    };

    template<class It, class C>
    inline __normal_iterator<It, C>
    operator+(typename __normal_iterator<It, C>::difference_type n,
              const __normal_iterator<It, C>& i)
    { return __normal_iterator<It, C>(i.base() + n); }
}

