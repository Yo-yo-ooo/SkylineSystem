//=============================================================
//  Iterator category tags  [iterator.tags]
//=============================================================
struct input_iterator_tag {};
struct output_iterator_tag {};
struct forward_iterator_tag : input_iterator_tag {};
struct bidirectional_iterator_tag : forward_iterator_tag {};
struct random_access_iterator_tag : bidirectional_iterator_tag {};
#if STDCPP_IT_CXX20
struct contiguous_iterator_tag : random_access_iterator_tag {};
#endif

//=============================================================
//  iterator_traits  [iterator.traits]
//=============================================================
#if STDCPP_IT_CXX11
template<class It, class = void>
struct __iter_traits {};

template<class It>
struct __iter_traits<It,
    void_t<typename It::iterator_category,
         typename It::value_type,
         typename It::difference_type,
         typename It::pointer,
         typename It::reference> >
{
    typedef typename It::iterator_category iterator_category;
    typedef typename It::value_type        value_type;
    typedef typename It::difference_type   difference_type;
    typedef typename It::pointer           pointer;
    typedef typename It::reference         reference;
};

template<class T>
struct __iter_traits<T*, void>
{
    typedef random_access_iterator_tag iterator_category;
    typedef T                          value_type;
    typedef ptrdiff_t                  difference_type;
    typedef T*                         pointer;
    typedef T&                         reference;
};

template<class T>
struct __iter_traits<const T*, void>
{
    typedef random_access_iterator_tag iterator_category;
    typedef T                          value_type;
    typedef ptrdiff_t                  difference_type;
    typedef const T*                   pointer;
    typedef const T&                   reference;
};

template<class It>
struct iterator_traits : __iter_traits<It> {};
#else
// C++98: simple traits without SFINAE
template<class It>
struct iterator_traits
{
    typedef typename It::iterator_category iterator_category;
    typedef typename It::value_type        value_type;
    typedef typename It::difference_type   difference_type;
    typedef typename It::pointer           pointer;
    typedef typename It::reference         reference;
};

template<class T>
struct iterator_traits<T*>
{
    typedef random_access_iterator_tag iterator_category;
    typedef T                          value_type;
    typedef ptrdiff_t                  difference_type;
    typedef T*                         pointer;
    typedef T&                         reference;
};

template<class T>
struct iterator_traits<const T*>
{
    typedef random_access_iterator_tag iterator_category;
    typedef T                          value_type;
    typedef ptrdiff_t                  difference_type;
    typedef const T*                   pointer;
    typedef const T&                   reference;
};
#endif


//-------------------------------------------------------------
//  Internal libstdc++ compatibility helpers.
//  System headers (<bits/stl_algobase.h>, etc.) expect these.
//-------------------------------------------------------------
#if STDCPP_IT_CXX11
template<class It, class Cat = typename iterator_traits<It>::iterator_category>
struct __is_random_access_iter
    : integral_constant<bool, is_base_of<random_access_iterator_tag, Cat>::value>
{
    typedef integral_constant<bool, is_base_of<random_access_iterator_tag, Cat>::value> _Base;
    enum { __value = _Base::value };
};
#else
template<class B, class D>
struct __iter_is_base_of
{
private:
    typedef char _Yes;
    struct _No { char _x[2]; };
    static _Yes _Test(const B*);
    static _No  _Test(...);
public:
    enum { value = sizeof(_Test(static_cast<D*>(0))) == sizeof(_Yes) };
};

template<class It, class Tr = iterator_traits<It>,
         class Cat = typename Tr::iterator_category>
struct __is_random_access_iter
{ enum { __value = __iter_is_base_of<random_access_iterator_tag, Cat>::value }; };
#endif

template<class It>
inline typename iterator_traits<It>::iterator_category
__iterator_category(const It&)
{ return typename iterator_traits<It>::iterator_category(); }

#if STDCPP_IT_CXX11
template<class It>
using __iterator_category_t = typename iterator_traits<It>::iterator_category;

template<class InIter>
using _RequireInputIter =
    typename enable_if<is_convertible<__iterator_category_t<InIter>,
                                     input_iterator_tag>::value>::type;
#endif

