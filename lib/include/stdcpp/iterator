// Forward declarations for stream types
template<class CharT> struct char_traits;
template<class CharT, class Traits> class basic_ostream;
template<class CharT, class Traits> class basic_istream;

//=============================================================
//  Stream iterators  [stream.iterators]
//
//  These require <istream>/<ostream>; they are defined here as
//  templates that work with any stream-like type.  For full
//  compatibility, include <iostream> before this header if you
//  need std::istream_iterator / std::ostream_iterator.
//=============================================================

// ostream_iterator
template<class T, class CharT = char, class Traits = char_traits<CharT>>
class ostream_iterator
    : public iterator<output_iterator_tag, void, void, void, void>
{
public:
    typedef CharT  char_type;
    typedef Traits traits_type;
    typedef basic_ostream<CharT, Traits> ostream_type;

private:
    ostream_type* _M_stream;
    const CharT*  _M_delim;

public:
    ostream_iterator(ostream_type& s) : _M_stream(&s), _M_delim(0) {}
    ostream_iterator(ostream_type& s, const CharT* d)
        : _M_stream(&s), _M_delim(d) {}

    ostream_iterator& operator=(const T& v)
    {
        *_M_stream << v;
        if (_M_delim) *_M_stream << _M_delim;
        return *this;
    }

    ostream_iterator& operator*() { return *this; }
    ostream_iterator& operator++() { return *this; }
    ostream_iterator& operator++(int) { return *this; }
};

// istream_iterator
template<class T, class CharT = char, class Traits = char_traits<CharT>,
         class Distance = ptrdiff_t>
class istream_iterator
    : public iterator<input_iterator_tag, T, Distance, const T*, const T&>
{
public:
    typedef CharT  char_type;
    typedef Traits traits_type;
    typedef basic_istream<CharT, Traits> istream_type;

private:
    istream_type* _M_stream;
    T             _M_value;
    bool          _M_ok;

public:
    istream_iterator() : _M_stream(0), _M_value(), _M_ok(false) {}
    istream_iterator(istream_type& s) : _M_stream(&s), _M_value(), _M_ok(false)
    { _M_read(); }

    const T& operator*() const { return _M_value; }
    const T* operator->() const { return &_M_value; }

    istream_iterator& operator++() { _M_read(); return *this; }
    istream_iterator operator++(int)
    { istream_iterator t = *this; _M_read(); return t; }

    bool _M_equal(const istream_iterator& o) const
    { return (_M_ok == o._M_ok) && (!_M_ok || _M_stream == o._M_stream); }

private:
    void _M_read()
    {
        if (_M_stream && *_M_stream) {
            *_M_stream >> _M_value;
            _M_ok = *_M_stream ? true : false;
        } else {
            _M_ok = false;
        }
    }
};

template<class T, class C, class Tr, class D>
inline bool operator==(const istream_iterator<T,C,Tr,D>& x,
                       const istream_iterator<T,C,Tr,D>& y)
{ return x._M_equal(y); }

template<class T, class C, class Tr, class D>
inline bool operator!=(const istream_iterator<T,C,Tr,D>& x,
                       const istream_iterator<T,C,Tr,D>& y)
{ return !x._M_equal(y); }

