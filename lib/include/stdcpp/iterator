template<class Sent>
class move_sentinel
{
private:
    Sent _M_last;
public:
    constexpr move_sentinel() : _M_last() {}
    constexpr explicit move_sentinel(Sent s) : _M_last(s) {}

    template<class S2>
    constexpr move_sentinel(const move_sentinel<S2>& other)
        : _M_last(other.base()) {}

