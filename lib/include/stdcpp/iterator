template<class It, class Sent>
class common_iterator
{
public:
    using value_type        = typename iterator_traits<It>::value_type;
    using difference_type   = typename iterator_traits<It>::difference_type;
    using pointer           = typename iterator_traits<It>::pointer;
    using reference         = typename iterator_traits<It>::reference;
    using iterator_category = typename iterator_traits<It>::iterator_category;

    constexpr common_iterator() : _M_it(), _M_is_it(true) {}
    constexpr common_iterator(It it) : _M_it(it), _M_is_it(true) {}
    constexpr common_iterator(Sent s) : _M_sent(s), _M_is_it(false) {}

    constexpr reference operator*() { return _M_it; }
    constexpr pointer operator->() { return _M_it; }

    constexpr common_iterator& operator++()
    { ++_M_it; return *this; }
    constexpr common_iterator operator++(int)
    { common_iterator t = *this; ++_M_it; return t; }

    friend constexpr bool operator==(const common_iterator& x,
                                     const common_iterator& y)
    { return x._M_is_it == y._M_is_it && x._M_it == y._M_it; }

private:
    union { It _M_it; Sent _M_sent; };
    bool _M_is_it;
};

