                                    const move_iterator<It>& i)
    -> decltype(s._M_last - i.base())
    { return s._M_last - i.base(); }
    template<class It>
    friend constexpr auto operator-(const move_iterator<It>& i,
                                    const move_sentinel& s)
    -> decltype(i.base() - s._M_last)
    { return i.base() - s._M_last; }
};

