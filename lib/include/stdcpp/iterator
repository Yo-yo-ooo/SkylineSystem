    using difference_type   = iter_difference_t<It>;
    using reference         = const iter_value_t<It>&;
    using pointer           = const iter_value_t<It>*;
    using iterator_category = typename iterator_traits<It>::iterator_category;

    constexpr basic_const_iterator() : _M_it() {}
    constexpr basic_const_iterator(It it) : _M_it(it) {}

    template<class U>
    constexpr basic_const_iterator(const basic_const_iterator<U>& other)
        : _M_it(other.base()) {}

    constexpr It base() const { return _M_it; }
    constexpr reference operator*() const { return *_M_it; }
    constexpr pointer operator->() const { return &*_M_it; }

    constexpr basic_const_iterator& operator++()
    { ++_M_it; return *this; }
    constexpr basic_const_iterator operator++(int)
    { basic_const_iterator t = *this; ++_M_it; return t; }
    constexpr basic_const_iterator& operator--()
    { --_M_it; return *this; }
    constexpr basic_const_iterator operator--(int)
    { basic_const_iterator t = *this; --_M_it; return t; }

    constexpr basic_const_iterator operator+(difference_type n) const
    { return basic_const_iterator(_M_it + n); }
    constexpr basic_const_iterator& operator+=(difference_type n)
    { _M_it += n; return *this; }
    constexpr basic_const_iterator operator-(difference_type n) const
    { return basic_const_iterator(_M_it - n); }
    constexpr basic_const_iterator& operator-=(difference_type n)
    { _M_it -= n; return *this; }

    constexpr reference operator[](difference_type n) const
    { return _M_it[n]; }

    template<class U>
    friend constexpr bool operator==(const basic_const_iterator& x,
                                     const basic_const_iterator<U>& y)
    { return x._M_it == y._M_it; }
    template<class U>
    friend constexpr auto operator-(const basic_const_iterator& x,
                                    const basic_const_iterator<U>& y)
    { return x._M_it - y._M_it; }

private:
    It _M_it;
};

