    bool load(memory_order m = memory_order_seq_cst) const noexcept {
        return __atomic_load_n(&_M_storage, m);
    }
    void store(bool desired, memory_order m = memory_order_seq_cst) noexcept {
        __atomic_store_n(&_M_storage, desired, m);
    }
    bool exchange(bool desired, memory_order m = memory_order_seq_cst) noexcept {
        return __atomic_exchange_n(&_M_storage, desired, m);
    }
    bool compare_exchange_weak(bool& expected, bool desired,
                               memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&_M_storage, &expected, desired, true, success, failure);
    }
    bool compare_exchange_strong(bool& expected, bool desired,
                                 memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&_M_storage, &expected, desired, false, success, failure);
    }
    bool compare_exchange_weak(bool& expected, bool desired,
                               memory_order m = memory_order_seq_cst) noexcept {
        return compare_exchange_weak(expected, desired, m, memory_order_relaxed);
    }
    bool compare_exchange_strong(bool& expected, bool desired,
                                 memory_order m = memory_order_seq_cst) noexcept {
        return compare_exchange_strong(expected, desired, m, memory_order_relaxed);
    }
    operator bool() const noexcept { return load(); }
    bool operator=(bool desired) noexcept { store(desired); return desired; }
    bool is_lock_free() const noexcept { return __atomic_is_lock_free(sizeof(bool), nullptr); }
    static constexpr bool is_always_lock_free = __atomic_always_lock_free(sizeof(bool), nullptr);
};

