//=============================================================
// atomic<T*> pointer specialization
//=============================================================
template<class T>
struct atomic<T*> {
    typedef T* value_type;
private:
    T* _M_storage;
public:
    atomic() noexcept = default;
    constexpr atomic(T* desired) noexcept : _M_storage(desired) {}
    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;

    T* load(memory_order m = memory_order_seq_cst) const noexcept {
        return __atomic_load_n(&_M_storage, m);
    }
    void store(T* desired, memory_order m = memory_order_seq_cst) noexcept {
        __atomic_store_n(&_M_storage, desired, m);
    }
    T* exchange(T* desired, memory_order m = memory_order_seq_cst) noexcept {
        return __atomic_exchange_n(&_M_storage, desired, m);
    }
    bool compare_exchange_weak(T*& expected, T* desired,
                               memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&_M_storage, &expected, desired, true, success, failure);
    }
    bool compare_exchange_strong(T*& expected, T* desired,
                                 memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&_M_storage, &expected, desired, false, success, failure);
    }
    bool compare_exchange_weak(T*& expected, T* desired,
                               memory_order m = memory_order_seq_cst) noexcept {
        return compare_exchange_weak(expected, desired, m, memory_order_relaxed);
    }
    bool compare_exchange_strong(T*& expected, T* desired,
                                 memory_order m = memory_order_seq_cst) noexcept {
        return compare_exchange_strong(expected, desired, m, memory_order_relaxed);
    }
    T* fetch_add(ptrdiff_t v, memory_order m = memory_order_seq_cst) noexcept {
        return __atomic_fetch_add(&_M_storage, v * sizeof(T), m);
    }
    T* fetch_sub(ptrdiff_t v, memory_order m = memory_order_seq_cst) noexcept {
        return __atomic_fetch_sub(&_M_storage, v * sizeof(T), m);
    }
    operator T*() const noexcept { return load(); }
    T* operator=(T* desired) noexcept { store(desired); return desired; }
    T* operator++(int) noexcept { return fetch_add(1); }
    T* operator--(int) noexcept { return fetch_sub(1); }
    T* operator++() noexcept { return fetch_add(1) + 1; }
    T* operator--() noexcept { return fetch_sub(1) - 1; }
    T* operator+=(ptrdiff_t v) noexcept { return fetch_add(v) + v; }
    T* operator-=(ptrdiff_t v) noexcept { return fetch_sub(v) - v; }
    bool is_lock_free() const noexcept { return __atomic_is_lock_free(sizeof(T*), nullptr); }
    static constexpr bool is_always_lock_free = __atomic_always_lock_free(sizeof(T*), nullptr);
};

