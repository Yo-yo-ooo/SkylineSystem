#define STDCPP_ATM_CXX17 (__cplusplus >= 201703L)
#define STDCPP_ATM_CXX20 (__cplusplus >= 202002L)
#ifndef STDCPP_ATM_CXX23
#  define STDCPP_ATM_CXX23 (__cplusplus >= 202302L || __cplusplus == 202100L)
#endif
#ifndef STDCPP_ATM_CXX26
#  define STDCPP_ATM_CXX26 (__cplusplus > 202302L)
#endif

#if STDCPP_ATM_CXX14
#  define STDCPP_ATM_CEXPR constexpr
#else
#  define STDCPP_ATM_CEXPR
#endif

#if STDCPP_ATM_CXX17
#  define STDCPP_ATM_ALF(x) x
#else
#  define STDCPP_ATM_ALF(x) false
#endif

#if STDCPP_ATM_CXX20
#  define STDCPP_ATM_HAS_WAIT 1
#else
#  define STDCPP_ATM_HAS_WAIT 0
#endif

// Defensive: prevent system <atomic> from conflicting if it is
