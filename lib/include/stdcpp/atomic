    explicit atomic_ref(T*& ref) noexcept : _M_p(&ref) {}
    atomic_ref(const atomic_ref&) noexcept = default;
    void store(T* desired, memory_order m = memory_order_seq_cst) const noexcept
    { __atomic_store(_M_p, &desired, (int)m); }
    T* load(memory_order m = memory_order_seq_cst) const noexcept
    { T* r; __atomic_load(_M_p, &r, (int)m); return r; }
    operator T*() const noexcept { return load(); }
    T* exchange(T* desired, memory_order m = memory_order_seq_cst) const noexcept
    { T* r; __atomic_exchange(_M_p, &desired, &r, (int)m); return r; }
    bool compare_exchange_weak(T*& expected, T* desired,
                              memory_order s, memory_order f) const noexcept
    { return __atomic_compare_exchange(_M_p, &expected, &desired, true, (int)s, (int)f); }
    bool compare_exchange_strong(T*& expected, T* desired,
                                memory_order s, memory_order f) const noexcept
    { return __atomic_compare_exchange(_M_p, &expected, &desired, false, (int)s, (int)f); }
    bool compare_exchange_weak(T*& expected, T* desired,
                              memory_order m = memory_order_seq_cst) const noexcept
    { return compare_exchange_weak(expected, desired, m, __atomic_detail::__cmpxchg_failure(m)); }
    bool compare_exchange_strong(T*& expected, T* desired,
                                memory_order m = memory_order_seq_cst) const noexcept
    { return compare_exchange_strong(expected, desired, m, __atomic_detail::__cmpxchg_failure(m)); }
    T* operator=(T* desired) const noexcept { store(desired); return desired; }
    T* fetch_add(ptrdiff_t arg, memory_order m = memory_order_seq_cst) const noexcept
    { return reinterpret_cast<T*>(__atomic_fetch_add(_M_p, arg * sizeof(T), (int)m)); }
    T* fetch_sub(ptrdiff_t arg, memory_order m = memory_order_seq_cst) const noexcept
    { return reinterpret_cast<T*>(__atomic_fetch_sub(_M_p, arg * sizeof(T), (int)m)); }
    T* operator++(int) const noexcept { return fetch_add(1); }
    T* operator--(int) const noexcept { return fetch_sub(1); }
    T* operator++() const noexcept { return fetch_add(1) + 1; }
    T* operator--() const noexcept { return fetch_sub(1) - 1; }
    T* operator+=(ptrdiff_t arg) const noexcept { return fetch_add(arg) + arg; }
    T* operator-=(ptrdiff_t arg) const noexcept { return fetch_sub(arg) - arg; }
    bool is_lock_free() const noexcept
    { return __atomic_is_lock_free(sizeof(T*), _M_p); }
    void wait(T* old, memory_order m = memory_order_seq_cst) const noexcept
    { __atomic_detail::__do_wait(_M_p, old, [m, this] { return this->load(m); }); }
    void notify_one() const noexcept { __atomic_detail::__notify_barrier(); }
    void notify_all() const noexcept { __atomic_detail::__notify_barrier(); }
};

