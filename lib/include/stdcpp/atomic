//=============================================================
// atomic_ref (C++20)
//=============================================================
#if STDCPP_AT_CXX20
template<class T>
struct atomic_ref {
    typedef T value_type;
private:
    T* _M_ptr;
public:
    static constexpr size_t required_alignment = alignof(T);
    explicit atomic_ref(T& t) noexcept : _M_ptr(&t) {}
    atomic_ref(const atomic_ref&) noexcept = default;

    T load(memory_order m = memory_order_seq_cst) const noexcept { return __atomic_load_n(_M_ptr, m); }
    void store(T desired, memory_order m = memory_order_seq_cst) noexcept { __atomic_store_n(_M_ptr, desired, m); }
    T exchange(T desired, memory_order m = memory_order_seq_cst) noexcept { return __atomic_exchange_n(_M_ptr, desired, m); }
    bool compare_exchange_weak(T& expected, T desired, memory_order s, memory_order f) noexcept {
        return __atomic_compare_exchange_n(_M_ptr, &expected, desired, true, s, f);
    }
    bool compare_exchange_strong(T& expected, T desired, memory_order s, memory_order f) noexcept {
        return __atomic_compare_exchange_n(_M_ptr, &expected, desired, false, s, f);
    }
    operator T() const noexcept { return load(); }
    bool is_lock_free() const noexcept { return __atomic_is_lock_free(sizeof(T), nullptr); }
};
#endif

//=============================================================
// free functions (C++11)
//=============================================================
template<class T>
T atomic_load(const atomic<T>* a) noexcept { return a->load(); }
template<class T>
void atomic_store(atomic<T>* a, T v) noexcept { a->store(v); }
template<class T>
T atomic_exchange(atomic<T>* a, T v) noexcept { return a->exchange(v); }
template<class T>
bool atomic_compare_exchange_weak(atomic<T>* a, T* e, T d) noexcept {
    return a->compare_exchange_weak(*e, d);
}
template<class T>
bool atomic_compare_exchange_strong(atomic<T>* a, T* e, T d) noexcept {
    return a->compare_exchange_strong(*e, d);
}

//=============================================================
// kill_dependency (C++11)
//=============================================================
template<class T>
T kill_dependency(T y) noexcept {
    T r = y;
    return r;
}

