    bool compare_exchange_weak(TYPE& e, TYPE d, memory_order s, memory_order f) noexcept { return __atomic_compare_exchange_n(&_M_storage, &e, d, true, s, f); } \
    bool compare_exchange_strong(TYPE& e, TYPE d, memory_order s, memory_order f) noexcept { return __atomic_compare_exchange_n(&_M_storage, &e, d, false, s, f); } \
