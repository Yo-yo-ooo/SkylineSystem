namespace std
{

//=============================================================
//  memory_order  [atomics.order]
//=============================================================
enum memory_order
{
    memory_order_relaxed = __ATOMIC_RELAXED,
    memory_order_consume = __ATOMIC_CONSUME,
    memory_order_acquire = __ATOMIC_ACQUIRE,
    memory_order_release = __ATOMIC_RELEASE,
    memory_order_acq_rel = __ATOMIC_ACQ_REL,
    memory_order_seq_cst = __ATOMIC_SEQ_CST
};

//=============================================================
//  Internal helpers
//=============================================================
namespace __atomic_detail
{
    // Compute the failure memory order from a success order.
    // [atomics.types.operations]/24: failure shall not be
    // release or acq_rel; it is strengthened to acquire if
    // success is acq_rel, and relaxed if success is release.
    inline constexpr memory_order
    __cmpxchg_failure(memory_order m) noexcept
    {
        return m == memory_order_acq_rel ? memory_order_acquire
             : m == memory_order_release ? memory_order_relaxed
             : m;
    }

    // Natural-aligned raw storage for an atomic object.
    template<class T>
    struct __atomic_storage
    {
        alignas(T) unsigned char _M_mem[sizeof(T)];
    };

    //---------------------------------------------------------
    // Portable CPU pause/spin hint for wait loops.
    // x86: PAUSE (rep nop) -- reduces power, improves SMT.
    // ARM: YIELD hint.
    // Other architectures: compiler barrier only.
    //---------------------------------------------------------
    inline void __cpu_pause() noexcept
    {
#if defined(__x86_64__) || defined(__i386__)
        __builtin_ia32_pause();
#elif defined(__aarch64__) || defined(_M_ARM64)
        asm volatile("isb" ::: "memory");
#elif defined(__arm__) || defined(_M_ARM)
        asm volatile("yield" ::: "memory");
#elif defined(__powerpc__) || defined(__ppc__) || defined(__PPC__)
        asm volatile("or 27,27,27" ::: "memory");
#elif defined(__s390x__)
        asm volatile("" ::: "memory");
#elif defined(__mips__)
        asm volatile("" ::: "memory");
#elif defined(__riscv)
        asm volatile("" ::: "memory");
#else
        // Generic fallback: compiler barrier prevents loop
        // hoisting but emits no special instruction.
        asm volatile("" ::: "memory");
#endif
    }

#if STDCPP_ATM_HAS_WAIT
    //---------------------------------------------------------
    // C++20 wait/notify -- portable spin-wait implementation.
    //
    // wait(old): spin until the atomic value differs from old.
    //   Uses an adaptive spin: a bounded number of tight PAUSE
    //   loops, then continues spinning with PAUSE (no OS block).
    //
    // notify_one/notify_all: compiler barriers that ensure the
    //   prior store is visible before spinning waiters observe
    //   it. In a pure spin-wait model these are stateless --
    //   waiters continuously reload the value and will see the
    //   update. The barrier prevents the compiler from delaying
    //   the store past the notify call.
    //
    // This is the standard approach for freestanding / kernel /
    // no-OS environments where futex / WaitOnAddress are absent.
    //---------------------------------------------------------
    static constexpr int __spin_count = 64;

    template<class T, class Fn>
    inline void __do_wait(const volatile T* /*addr*/, T old,
                          Fn load_fn) noexcept
    {
        // Tight adaptive spin.
        for (int i = 0; i < __spin_count; ++i) {
            if (load_fn() != old) return;
            __cpu_pause();
        }
        // Continued spin with pause (no OS dependency).
        while (load_fn() == old)
            __cpu_pause();
    }

    inline void __notify_barrier() noexcept
    {
        // Full compiler + hardware barrier so that the store
        // happens-before any subsequent waiter observation.
        __atomic_thread_fence(__ATOMIC_SEQ_CST);
    }
#endif
} // namespace __atomic_detail

//=============================================================
//  kill_dependency  [atomics.order]
//=============================================================
template<class T>
#if STDCPP_ATM_CXX14
constexpr
#endif
T kill_dependency(T y) noexcept
{
    T r(y);
    return r;
}

//=============================================================
//  fences  [atomics.fences]
//=============================================================
inline void atomic_thread_fence(memory_order m) noexcept
{ __atomic_thread_fence((int)m); }

inline void atomic_signal_fence(memory_order m) noexcept
{ __atomic_signal_fence((int)m); }

//=============================================================
//  atomic_flag  [atomics.flag]
//=============================================================
struct atomic_flag
{
    bool _M_i;

    atomic_flag() noexcept = default;
    ~atomic_flag() noexcept = default;
    atomic_flag(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) volatile = delete;

    bool test_and_set(memory_order m = memory_order_seq_cst) volatile noexcept
    { return __atomic_test_and_set(&_M_i, (int)m); }
    bool test_and_set(memory_order m = memory_order_seq_cst) noexcept
    { return __atomic_test_and_set(&_M_i, (int)m); }

    void clear(memory_order m = memory_order_seq_cst) volatile noexcept
    { __atomic_clear(&_M_i, (int)m); }
    void clear(memory_order m = memory_order_seq_cst) noexcept
    { __atomic_clear(&_M_i, (int)m); }

#if STDCPP_ATM_CXX20
    bool test(memory_order m = memory_order_seq_cst) const volatile noexcept
    { return __atomic_load_n(&_M_i, (int)m) != 0; }
    bool test(memory_order m = memory_order_seq_cst) const noexcept
    { return __atomic_load_n(&_M_i, (int)m) != 0; }

    void wait(bool old, memory_order m = memory_order_seq_cst) const volatile noexcept
    {
        __atomic_detail::__do_wait(&_M_i, old,
            [m, this] { return __atomic_load_n(&_M_i, (int)m) != 0; });
    }
    void wait(bool old, memory_order m = memory_order_seq_cst) const noexcept
    {
        __atomic_detail::__do_wait(&_M_i, old,
            [m, this] { return __atomic_load_n(&_M_i, (int)m) != 0; });
    }
    void notify_one() volatile noexcept
    { __atomic_detail::__notify_barrier(); }
    void notify_one() noexcept
    { __atomic_detail::__notify_barrier(); }
    void notify_all() volatile noexcept
    { __atomic_detail::__notify_barrier(); }
    void notify_all() noexcept
    { __atomic_detail::__notify_barrier(); }
#endif
};

#if STDCPP_ATM_CXX20
#  define ATOMIC_FLAG_INIT {}
#else
#  define ATOMIC_FLAG_INIT { 0 }
#endif

//=============================================================
//  atomic<T>  primary template  [atomics.types.generic]
//=============================================================
template<class T>
struct atomic
{
    static_assert(is_trivially_copyable<T>::value,
        "std::atomic requires a trivially copyable type");

    using value_type = T;

    static constexpr bool is_always_lock_free =
        STDCPP_ATM_ALF(__atomic_always_lock_free(sizeof(T), 0));

private:
    __atomic_detail::__atomic_storage<T> _M_storage;

    T* _M_p() noexcept
    { return reinterpret_cast<T*>(&_M_storage); }
    const T* _M_p() const noexcept
    { return reinterpret_cast<const T*>(&_M_storage); }
    volatile T* _M_p() volatile noexcept
    { return reinterpret_cast<volatile T*>(&_M_storage); }
    const volatile T* _M_p() const volatile noexcept
    { return reinterpret_cast<const volatile T*>(&_M_storage); }

public:
    atomic() noexcept = default;
    ~atomic() noexcept = default;
    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;
    atomic& operator=(const atomic&) volatile = delete;

    STDCPP_ATM_CEXPR atomic(T desired) noexcept : _M_storage{}
    { __builtin_memcpy(_M_p(), &desired, sizeof(T)); }

    void store(T desired, memory_order m = memory_order_seq_cst) volatile noexcept
    { __atomic_store(_M_p(), &desired, (int)m); }
    void store(T desired, memory_order m = memory_order_seq_cst) noexcept
    { __atomic_store(_M_p(), &desired, (int)m); }

    T load(memory_order m = memory_order_seq_cst) const volatile noexcept
    { T r; __atomic_load(_M_p(), &r, (int)m); return r; }
    T load(memory_order m = memory_order_seq_cst) const noexcept
    { T r; __atomic_load(_M_p(), &r, (int)m); return r; }

    operator T() const volatile noexcept { return load(); }
    operator T() const noexcept { return load(); }

    T exchange(T desired, memory_order m = memory_order_seq_cst) volatile noexcept
    { T r; __atomic_exchange(_M_p(), &desired, &r, (int)m); return r; }
    T exchange(T desired, memory_order m = memory_order_seq_cst) noexcept
    { T r; __atomic_exchange(_M_p(), &desired, &r, (int)m); return r; }

    bool compare_exchange_weak(T& expected, T desired,
                              memory_order success, memory_order failure)
        volatile noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       true, (int)success, (int)failure); }
    bool compare_exchange_weak(T& expected, T desired,
                              memory_order success, memory_order failure) noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       true, (int)success, (int)failure); }

    bool compare_exchange_strong(T& expected, T desired,
                                memory_order success, memory_order failure)
        volatile noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       false, (int)success, (int)failure); }
    bool compare_exchange_strong(T& expected, T desired,
                                memory_order success, memory_order failure) noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       false, (int)success, (int)failure); }

    bool compare_exchange_weak(T& expected, T desired,
                              memory_order m = memory_order_seq_cst) volatile noexcept
    { return compare_exchange_weak(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }
    bool compare_exchange_weak(T& expected, T desired,
                              memory_order m = memory_order_seq_cst) noexcept
    { return compare_exchange_weak(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }

    bool compare_exchange_strong(T& expected, T desired,
                                memory_order m = memory_order_seq_cst) volatile noexcept
    { return compare_exchange_strong(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }
    bool compare_exchange_strong(T& expected, T desired,
                                memory_order m = memory_order_seq_cst) noexcept
    { return compare_exchange_strong(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }

    T operator=(T desired) volatile noexcept { store(desired); return desired; }
    T operator=(T desired) noexcept { store(desired); return desired; }

    bool is_lock_free() const volatile noexcept
    { return __atomic_is_lock_free(sizeof(T), _M_p()); }
    bool is_lock_free() const noexcept
    { return __atomic_is_lock_free(sizeof(T), _M_p()); }

#if STDCPP_ATM_HAS_WAIT
    void wait(T old, memory_order m = memory_order_seq_cst) const volatile noexcept
    { __atomic_detail::__do_wait(_M_p(), old, [m, this] { return this->load(m); }); }
    void wait(T old, memory_order m = memory_order_seq_cst) const noexcept
    { __atomic_detail::__do_wait(_M_p(), old, [m, this] { return this->load(m); }); }
    void notify_one() volatile noexcept
    { __atomic_detail::__notify_barrier(); }
    void notify_one() noexcept
    { __atomic_detail::__notify_barrier(); }
    void notify_all() volatile noexcept
    { __atomic_detail::__notify_barrier(); }
    void notify_all() noexcept
    { __atomic_detail::__notify_barrier(); }
#endif
};

//=============================================================
//  atomic<T*> partial specialization  [atomics.types.pointer]
//=============================================================
template<class T>
struct atomic<T*>
{
    using value_type = T*;
    using difference_type = ptrdiff_t;

    static constexpr bool is_always_lock_free =
        STDCPP_ATM_ALF(__atomic_always_lock_free(sizeof(T*), 0));

private:
    __atomic_detail::__atomic_storage<T*> _M_storage;

    T** _M_p() noexcept
    { return reinterpret_cast<T**>(&_M_storage); }
    T* const* _M_p() const noexcept
    { return reinterpret_cast<T* const*>(&_M_storage); }
    T* volatile* _M_p() volatile noexcept
    { return reinterpret_cast<T* volatile*>(&_M_storage); }
    T* const volatile* _M_p() const volatile noexcept
    { return reinterpret_cast<T* const volatile*>(&_M_storage); }

public:
    atomic() noexcept = default;
    ~atomic() noexcept = default;
    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;
    atomic& operator=(const atomic&) volatile = delete;

    STDCPP_ATM_CEXPR atomic(T* desired) noexcept : _M_storage{}
    { __builtin_memcpy(_M_p(), &desired, sizeof(T*)); }

    void store(T* desired, memory_order m = memory_order_seq_cst) volatile noexcept
    { __atomic_store(_M_p(), &desired, (int)m); }
    void store(T* desired, memory_order m = memory_order_seq_cst) noexcept
    { __atomic_store(_M_p(), &desired, (int)m); }

    T* load(memory_order m = memory_order_seq_cst) const volatile noexcept
    { T* r; __atomic_load(_M_p(), &r, (int)m); return r; }
    T* load(memory_order m = memory_order_seq_cst) const noexcept
    { T* r; __atomic_load(_M_p(), &r, (int)m); return r; }

    operator T*() const volatile noexcept { return load(); }
    operator T*() const noexcept { return load(); }

    T* exchange(T* desired, memory_order m = memory_order_seq_cst) volatile noexcept
    { T* r; __atomic_exchange(_M_p(), &desired, &r, (int)m); return r; }
    T* exchange(T* desired, memory_order m = memory_order_seq_cst) noexcept
    { T* r; __atomic_exchange(_M_p(), &desired, &r, (int)m); return r; }

    bool compare_exchange_weak(T*& expected, T* desired,
                              memory_order success, memory_order failure) volatile noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       true, (int)success, (int)failure); }
    bool compare_exchange_weak(T*& expected, T* desired,
                              memory_order success, memory_order failure) noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       true, (int)success, (int)failure); }
    bool compare_exchange_strong(T*& expected, T* desired,
                                memory_order success, memory_order failure) volatile noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       false, (int)success, (int)failure); }
    bool compare_exchange_strong(T*& expected, T* desired,
                                memory_order success, memory_order failure) noexcept
    { return __atomic_compare_exchange(_M_p(), &expected, &desired,
                                       false, (int)success, (int)failure); }

    bool compare_exchange_weak(T*& expected, T* desired,
                              memory_order m = memory_order_seq_cst) volatile noexcept
    { return compare_exchange_weak(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }
    bool compare_exchange_weak(T*& expected, T* desired,
                              memory_order m = memory_order_seq_cst) noexcept
    { return compare_exchange_weak(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }
    bool compare_exchange_strong(T*& expected, T* desired,
                                memory_order m = memory_order_seq_cst) volatile noexcept
    { return compare_exchange_strong(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }
    bool compare_exchange_strong(T*& expected, T* desired,
                                memory_order m = memory_order_seq_cst) noexcept
    { return compare_exchange_strong(expected, desired, m,
            __atomic_detail::__cmpxchg_failure(m)); }

    T* operator=(T* desired) volatile noexcept { store(desired); return desired; }
    T* operator=(T* desired) noexcept { store(desired); return desired; }

    T* fetch_add(ptrdiff_t arg, memory_order m = memory_order_seq_cst) volatile noexcept
    { return reinterpret_cast<T*>(__atomic_fetch_add(_M_p(),
            arg * sizeof(T), (int)m)); }
    T* fetch_add(ptrdiff_t arg, memory_order m = memory_order_seq_cst) noexcept
    { return reinterpret_cast<T*>(__atomic_fetch_add(_M_p(),
            arg * sizeof(T), (int)m)); }

    T* fetch_sub(ptrdiff_t arg, memory_order m = memory_order_seq_cst) volatile noexcept
    { return reinterpret_cast<T*>(__atomic_fetch_sub(_M_p(),
            arg * sizeof(T), (int)m)); }
    T* fetch_sub(ptrdiff_t arg, memory_order m = memory_order_seq_cst) noexcept
    { return reinterpret_cast<T*>(__atomic_fetch_sub(_M_p(),
            arg * sizeof(T), (int)m)); }

    T* operator++(int) volatile noexcept { return fetch_add(1); }
    T* operator++(int) noexcept { return fetch_add(1); }
    T* operator--(int) volatile noexcept { return fetch_sub(1); }
    T* operator--(int) noexcept { return fetch_sub(1); }
    T* operator++() volatile noexcept { return fetch_add(1) + 1; }
    T* operator++() noexcept { return fetch_add(1) + 1; }
    T* operator--() volatile noexcept { return fetch_sub(1) - 1; }
    T* operator--() noexcept { return fetch_sub(1) - 1; }

    T* operator+=(ptrdiff_t arg) volatile noexcept { return fetch_add(arg) + arg; }
    T* operator+=(ptrdiff_t arg) noexcept { return fetch_add(arg) + arg; }
    T* operator-=(ptrdiff_t arg) volatile noexcept { return fetch_sub(arg) - arg; }
    T* operator-=(ptrdiff_t arg) noexcept { return fetch_sub(arg) - arg; }

    bool is_lock_free() const volatile noexcept
    { return __atomic_is_lock_free(sizeof(T*), _M_p()); }
    bool is_lock_free() const noexcept
    { return __atomic_is_lock_free(sizeof(T*), _M_p()); }

#if STDCPP_ATM_HAS_WAIT
    void wait(T* old, memory_order m = memory_order_seq_cst) const volatile noexcept
    { __atomic_detail::__do_wait(_M_p(), old, [m, this] { return this->load(m); }); }
    void wait(T* old, memory_order m = memory_order_seq_cst) const noexcept
    { __atomic_detail::__do_wait(_M_p(), old, [m, this] { return this->load(m); }); }
    void notify_one() volatile noexcept { __atomic_detail::__notify_barrier(); }
    void notify_one() noexcept { __atomic_detail::__notify_barrier(); }
    void notify_all() volatile noexcept { __atomic_detail::__notify_barrier(); }
    void notify_all() noexcept { __atomic_detail::__notify_barrier(); }
#endif
};

//=============================================================
//  Integral fetch operations macro
//=============================================================
#define STDCPP_ATOMIC_INT_FETCH(TYPE)                                          \
    TYPE fetch_add(TYPE arg, memory_order m = memory_order_seq_cst)            \
        volatile noexcept                                                      \
    { return __atomic_fetch_add(_M_p(), arg, (int)m); }                       \
    TYPE fetch_add(TYPE arg, memory_order m = memory_order_seq_cst) noexcept   \
    { return __atomic_fetch_add(_M_p(), arg, (int)m); }                       \
    TYPE fetch_sub(TYPE arg, memory_order m = memory_order_seq_cst)            \
        volatile noexcept                                                      \
    { return __atomic_fetch_sub(_M_p(), arg, (int)m); }                       \
    TYPE fetch_sub(TYPE arg, memory_order m = memory_order_seq_cst) noexcept   \
    { return __atomic_fetch_sub(_M_p(), arg, (int)m); }                       \
    TYPE fetch_and(TYPE arg, memory_order m = memory_order_seq_cst)            \
        volatile noexcept                                                      \
    { return __atomic_fetch_and(_M_p(), arg, (int)m); }                       \
    TYPE fetch_and(TYPE arg, memory_order m = memory_order_seq_cst) noexcept   \
    { return __atomic_fetch_and(_M_p(), arg, (int)m); }                       \
    TYPE fetch_or(TYPE arg, memory_order m = memory_order_seq_cst)             \
        volatile noexcept                                                      \
    { return __atomic_fetch_or(_M_p(), arg, (int)m); }                        \
    TYPE fetch_or(TYPE arg, memory_order m = memory_order_seq_cst) noexcept    \
    { return __atomic_fetch_or(_M_p(), arg, (int)m); }                        \
    TYPE fetch_xor(TYPE arg, memory_order m = memory_order_seq_cst)            \
        volatile noexcept                                                      \
    { return __atomic_fetch_xor(_M_p(), arg, (int)m); }                       \
    TYPE fetch_xor(TYPE arg, memory_order m = memory_order_seq_cst) noexcept   \
    { return __atomic_fetch_xor(_M_p(), arg, (int)m); }                       \
    TYPE operator++(int) volatile noexcept { return fetch_add(1); }            \
    TYPE operator++(int) noexcept { return fetch_add(1); }                     \
    TYPE operator--(int) volatile noexcept { return fetch_sub(1); }            \
    TYPE operator--(int) noexcept { return fetch_sub(1); }                     \
    TYPE operator++() volatile noexcept                                        \
    { return __atomic_add_fetch(_M_p(), 1, __ATOMIC_SEQ_CST); }               \
    TYPE operator++() noexcept                                                 \
    { return __atomic_add_fetch(_M_p(), 1, __ATOMIC_SEQ_CST); }               \
    TYPE operator--() volatile noexcept                                        \
    { return __atomic_sub_fetch(_M_p(), 1, __ATOMIC_SEQ_CST); }               \
    TYPE operator--() noexcept                                                 \
    { return __atomic_sub_fetch(_M_p(), 1, __ATOMIC_SEQ_CST); }               \
    TYPE operator+=(TYPE arg) volatile noexcept { return fetch_add(arg) + arg; } \
    TYPE operator+=(TYPE arg) noexcept { return fetch_add(arg) + arg; }        \
    TYPE operator-=(TYPE arg) volatile noexcept { return fetch_sub(arg) - arg; } \
    TYPE operator-=(TYPE arg) noexcept { return fetch_sub(arg) - arg; }        \
    TYPE operator&=(TYPE arg) volatile noexcept { return fetch_and(arg) & arg; } \
    TYPE operator&=(TYPE arg) noexcept { return fetch_and(arg) & arg; }        \
    TYPE operator|=(TYPE arg) volatile noexcept { return fetch_or(arg) | arg; } \
    TYPE operator|=(TYPE arg) noexcept { return fetch_or(arg) | arg; }         \
    TYPE operator^=(TYPE arg) volatile noexcept { return fetch_xor(arg) ^ arg; } \
    TYPE operator^=(TYPE arg) noexcept { return fetch_xor(arg) ^ arg; }

#if STDCPP_ATM_HAS_WAIT
#  define STDCPP_ATOMIC_WAIT(TYPE)                                             \
    void wait(TYPE old, memory_order m = memory_order_seq_cst) const volatile noexcept \
    { __atomic_detail::__do_wait(_M_p(), old, [m, this] { return this->load(m); }); } \
