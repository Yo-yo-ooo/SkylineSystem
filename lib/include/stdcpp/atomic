//=============================================================
// memory_order
//=============================================================
typedef enum memory_order {
    memory_order_relaxed = __ATOMIC_RELAXED,
    memory_order_consume = __ATOMIC_CONSUME,
    memory_order_acquire = __ATOMIC_ACQUIRE,
    memory_order_release = __ATOMIC_RELEASE,
    memory_order_acq_rel = __ATOMIC_ACQ_REL,
    memory_order_seq_cst = __ATOMIC_SEQ_CST
} memory_order;

inline void atomic_thread_fence(memory_order m) { __atomic_thread_fence(m); }
inline void atomic_signal_fence(memory_order m) { __atomic_signal_fence(m); }

//=============================================================
// atomic_flag
//=============================================================
struct atomic_flag {
    bool _M_val;
    constexpr atomic_flag() noexcept : _M_val(false) {}
    atomic_flag(const atomic_flag&) = delete;
    atomic_flag& operator=(const atomic_flag&) = delete;
    bool test_and_set(memory_order m = memory_order_seq_cst) noexcept {
        return __atomic_test_and_set(&_M_val, m);
    }
    void clear(memory_order m = memory_order_seq_cst) noexcept {
        __atomic_clear(&_M_val, m);
    }
#if STDCPP_AT_CXX20
    bool test(memory_order m = memory_order_seq_cst) const noexcept {
        return __atomic_load_n(&_M_val, m);
    }
    bool wait(bool old, memory_order m = memory_order_seq_cst) const noexcept {
        while (__atomic_load_n(&_M_val, m) == old) { __builtin_ia32_pause(); }
        return true;
    }
    void notify_one() noexcept { __atomic_thread_fence(memory_order_seq_cst); }
    void notify_all() noexcept { __atomic_thread_fence(memory_order_seq_cst); }
#endif
};

#define ATOMIC_FLAG_INIT {}

//=============================================================
// atomic<T> primary template
//=============================================================
template<class T>
struct atomic {
    typedef T value_type;
private:
    T _M_storage;
    static constexpr size_t _S_size = sizeof(T);
public:
    atomic() noexcept = default;
    constexpr atomic(T desired) noexcept : _M_storage(desired) {}
    atomic(const atomic&) = delete;
    atomic& operator=(const atomic&) = delete;

    T load(memory_order m = memory_order_seq_cst) const noexcept {
        return __atomic_load_n(&_M_storage, m);
    }
    void store(T desired, memory_order m = memory_order_seq_cst) noexcept {
        __atomic_store_n(&_M_storage, desired, m);
    }
    T exchange(T desired, memory_order m = memory_order_seq_cst) noexcept {
        return __atomic_exchange_n(&_M_storage, desired, m);
    }
    bool compare_exchange_weak(T& expected, T desired,
                               memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&_M_storage, &expected, desired, true, success, failure);
    }
    bool compare_exchange_strong(T& expected, T desired,
                                 memory_order success, memory_order failure) noexcept {
        return __atomic_compare_exchange_n(&_M_storage, &expected, desired, false, success, failure);
    }
    bool compare_exchange_weak(T& expected, T desired,
                               memory_order m = memory_order_seq_cst) noexcept {
        return compare_exchange_weak(expected, desired, m, memory_order_relaxed);
    }
    bool compare_exchange_strong(T& expected, T desired,
                                 memory_order m = memory_order_seq_cst) noexcept {
        return compare_exchange_strong(expected, desired, m, memory_order_relaxed);
    }

    operator T() const noexcept { return load(); }
    T operator=(T desired) noexcept { store(desired); return desired; }

    bool is_lock_free() const noexcept {
        return __atomic_is_lock_free(sizeof(T), nullptr);
    }
    static constexpr bool is_always_lock_free = __atomic_always_lock_free(sizeof(T), nullptr);
};

//=============================================================
// atomic integral/fetch operations
//=============================================================
#define STDCPP_ATOMIC_INT_OPS(TYPE) \
    TYPE fetch_add(TYPE v, memory_order m = memory_order_seq_cst) noexcept { \
        return __atomic_fetch_add(&_M_storage, v, m); \
    } \
    TYPE fetch_sub(TYPE v, memory_order m = memory_order_seq_cst) noexcept { \
        return __atomic_fetch_sub(&_M_storage, v, m); \
    } \
    TYPE fetch_and(TYPE v, memory_order m = memory_order_seq_cst) noexcept { \
        return __atomic_fetch_and(&_M_storage, v, m); \
    } \
    TYPE fetch_or(TYPE v, memory_order m = memory_order_seq_cst) noexcept { \
        return __atomic_fetch_or(&_M_storage, v, m); \
    } \
    TYPE fetch_xor(TYPE v, memory_order m = memory_order_seq_cst) noexcept { \
        return __atomic_fetch_xor(&_M_storage, v, m); \
    } \
    TYPE operator++(int) noexcept { return fetch_add(1); } \
    TYPE operator--(int) noexcept { return fetch_sub(1); } \
    TYPE operator++() noexcept { return fetch_add(1) + 1; } \
    TYPE operator--() noexcept { return fetch_sub(1) - 1; } \
    TYPE operator+=(TYPE v) noexcept { return fetch_add(v) + v; } \
    TYPE operator-=(TYPE v) noexcept { return fetch_sub(v) - v; } \
    TYPE operator&=(TYPE v) noexcept { return fetch_and(v) & v; } \
    TYPE operator|=(TYPE v) noexcept { return fetch_or(v) | v; } \
    TYPE operator^=(TYPE v) noexcept { return fetch_xor(v) ^ v; }

