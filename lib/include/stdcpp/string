    //---------------------------------------------------------
    // 比较 / 子串
    //---------------------------------------------------------
    int compare(const basic_string& s) const noexcept {
        size_type n = _M_size < s._M_size ? _M_size : s._M_size;
        int r = Traits::compare(_M_data, s._M_data, n);
        if (r != 0) return r;
        if (_M_size < s._M_size) return -1;
        if (_M_size > s._M_size) return 1;
        return 0;
    }
    int compare(size_type pos, size_type n, const basic_string& s) const {
        return substr(pos, n).compare(s);
    }
    int compare(size_type pos, size_type n, const basic_string& s, size_type pos2, size_type n2 = npos) const {
        return substr(pos, n).compare(s.substr(pos2, n2));
    }
    int compare(const CharT* s) const noexcept {
        size_type n = Traits::length(s);
        size_type r = _M_size < n ? _M_size : n;
        int c = Traits::compare(_M_data, s, r);
        if (c != 0) return c;
        if (_M_size < n) return -1;
        if (_M_size > n) return 1;
        return 0;
    }
    int compare(size_type pos, size_type n, const CharT* s) const { return substr(pos, n).compare(s); }
    int compare(size_type pos, size_type n, const CharT* s, size_type n2) const {
        return substr(pos, n).compare(basic_string(s, n2));
    }

    basic_string substr(size_type pos = 0, size_type n = npos) const {
        if (pos > _M_size) __detail::throw_out_of_range("basic_string::substr");
        size_type len = _M_size - pos;
        if (n < len) len = n;
        return basic_string(_M_data + pos, len);
    }

    size_type copy(CharT* dest, size_type n, size_type pos = 0) const {
        if (pos > _M_size) __detail::throw_out_of_range("basic_string::copy");
        size_type len = _M_size - pos;
        if (n < len) len = n;
        Traits::copy(dest, _M_data + pos, len);
        return len;
    }

    void swap(basic_string& other) noexcept {
        if (this == &other) return;
        if (propagate_on_container_swap::value) {
            allocator_type tmp_a = _M_alloc();
            _M_alloc() = other._M_alloc();
            other._M_alloc() = tmp_a;
        } else {
            // 分配器不等且不传播时标准规定行为未定义；调试构建中提前暴露
            STDCPP_ASSERT(_M_alloc() == other._M_alloc());
        }
        _M_swap_data(other);
    }

    allocator_type get_allocator() const noexcept { return _M_alloc(); }
};

