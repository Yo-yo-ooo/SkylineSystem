//=============================================================
// 数值转换（头内实现，不依赖 libc 的 strtol/snprintf）
//=============================================================
namespace __detail {

inline int digit_value(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'z') return c - 'a' + 10;
    if (c >= 'A' && c <= 'Z') return c - 'A' + 10;
    return 99;
}

inline bool is_space_c(char c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\v' || c == '\f';
}

// 解析整数：mag 为无符号量值，neg 表示负号，overflow 表示越界。
// 旧版把符号丢掉了（stoi("-45") 得到 45），这里显式返回 neg。
inline bool parse_integer(const char* s, size_t len, int base, bool& overflow, bool& neg,
                          unsigned long long& mag, size_t& consumed) {
    overflow = false;
    neg = false;
    mag = 0;
    size_t i = 0;
    while (i < len && is_space_c(s[i])) ++i;
    if (i < len && (s[i] == '+' || s[i] == '-')) {
        neg = (s[i] == '-');
        ++i;
    }
    if (base == 0) {
        base = 10;
        if (i + 1 < len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) { base = 16; i += 2; }
        else if (i < len && s[i] == '0') { base = 8; }
    } else if (base == 16 && i + 1 < len && s[i] == '0' && (s[i + 1] == 'x' || s[i + 1] == 'X')) {
        i += 2;
    }
    if (base < 2 || base > 36) return false;

    size_t digits = 0;
    unsigned long long acc = 0;
    const unsigned long long limit = neg ? 9223372036854775808ULL : 9223372036854775807ULL;
    for (; i < len; ++i) {
        int d = digit_value(s[i]);
        if (d >= base) break;
        ++digits;
        if (acc > (limit - static_cast<unsigned long long>(d)) / static_cast<unsigned long long>(base)) {
            overflow = true;
        } else {
            acc = acc * static_cast<unsigned long long>(base) + static_cast<unsigned long long>(d);
        }
    }
    if (digits == 0) return false;
    mag = acc;
    consumed = i;
    return true;
}

inline long long to_signed(unsigned long long mag, bool neg) {
    return neg ? static_cast<long long>(0ULL - mag) : static_cast<long long>(mag);
}

// 十进制浮点解析：符号/整数部分/小数部分/指数，支持 inf / nan。
// 注意：不是“正确舍入”的实现（不追求 last-ulp 精度），够内核与工具使用。
inline long double parse_float(const char* s, size_t len, size_t& consumed) {
    size_t i = 0;
    while (i < len && is_space_c(s[i])) ++i;
    bool neg = false;
    if (i < len && (s[i] == '+' || s[i] == '-')) { neg = (s[i] == '-'); ++i; }

    // inf / infinity / nan
    if (i + 2 < len) {
        const char* p = s + i;
        if ((p[0] == 'i' || p[0] == 'I') && (p[1] == 'n' || p[1] == 'N') && (p[2] == 'f' || p[2] == 'F')) {
            consumed = i + 3;
            long double v = __builtin_huge_val();
            return neg ? -v : v;
        }
        if ((p[0] == 'n' || p[0] == 'N') && (p[1] == 'a' || p[1] == 'A') && (p[2] == 'n' || p[2] == 'N')) {
            consumed = i + 3;
            return __builtin_nan("");
        }
    }

    long double v = 0.0L;
    size_t digits = 0;
    for (; i < len; ++i, ++digits) {
        int d = digit_value(s[i]);
        if (d > 9) break;
        v = v * 10.0L + static_cast<long double>(d);
    }
    if (i < len && s[i] == '.') {
        ++i;
        long double scale = 0.1L;
        for (; i < len; ++i) {
            int d = digit_value(s[i]);
            if (d > 9) break;
            v += static_cast<long double>(d) * scale;
            scale *= 0.1L;
            ++digits;
        }
    }
    if (digits == 0) { consumed = 0; return 0.0L; }

    if (i < len && (s[i] == 'e' || s[i] == 'E')) {
        size_t j = i + 1;
        bool eneg = false;
        if (j < len && (s[j] == '+' || s[j] == '-')) { eneg = (s[j] == '-'); ++j; }
        int exp = 0;
        size_t ed = 0;
        for (; j < len; ++j, ++ed) {
            int d = digit_value(s[j]);
            if (d > 9) break;
            if (exp < 100000) exp = exp * 10 + d;
        }
        if (ed > 0) {
            long double f = 1.0L;
            for (int k = 0; k < exp; ++k) f *= 10.0L;
            v = eneg ? v / f : v * f;
            i = j;
        }
    }
    consumed = i;
    return neg ? -v : v;
}

