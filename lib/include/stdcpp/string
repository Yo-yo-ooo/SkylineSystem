public:
    basic_string() : _M_data(nullptr), _M_size(0), _M_cap(0) {
        _M_reserve(1);
        _M_data[0] = CharT();
    }

    basic_string(const CharT* s) : _M_data(nullptr), _M_size(0), _M_cap(0) {
        _M_size = Traits::length(s);
