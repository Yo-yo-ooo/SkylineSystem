namespace __detail {

inline void utoa_impl(char* buf, size_t bufsz, unsigned long long v, bool neg, size_t& len) {
    char tmp[32];
    size_t n = 0;
    if (v == 0) tmp[n++] = '0';
    while (v) {
        tmp[n++] = static_cast<char>('0' + (v % 10));
        v /= 10;
    }
    size_t k = 0;
    if (neg && k < bufsz) buf[k++] = '-';
    while (n && k + 1 < bufsz) buf[k++] = tmp[--n];
    buf[k] = '\0';
    len = k;
}

} // namespace __detail

inline string to_string(int v) {
    char b[32]; size_t n = 0;
    __detail::utoa_impl(b, sizeof(b), static_cast<unsigned long long>(v < 0 ? -(long long)v : (long long)v), v < 0, n);
    return string(b, n);
}
