    const_reference back() const { return _M_data[_M_size - 1]; }

    void push_back(CharT c) {
        if (_M_size + 2 > _M_cap) _M_reserve(_M_size + 2);
        _M_data[_M_size++] = c;
        _M_data[_M_size] = CharT();
    }
    void pop_back() { if (_M_size > 0) { --_M_size; _M_data[_M_size] = CharT(); } }

    basic_string& append(const CharT* s) {
        size_type n = Traits::length(s);
        if (_M_size + n + 1 > _M_cap) _M_reserve(_M_size + n + 1);
        Traits::copy(_M_data + _M_size, s, n);
        _M_size += n;
        _M_data[_M_size] = CharT();
        return *this;
    }
    basic_string& append(const CharT* s, size_type n) {
        if (_M_size + n + 1 > _M_cap) _M_reserve(_M_size + n + 1);
        Traits::copy(_M_data + _M_size, s, n);
        _M_size += n;
        _M_data[_M_size] = CharT();
        return *this;
    }
    basic_string& append(const basic_string& s) { return append(s._M_data, s._M_size); }
