        return npos;
    }
    size_type find_first_not_of(CharT c, size_type pos = 0) const noexcept {
        for (size_type i = pos; i < _M_size; ++i)
            if (!Traits::eq(_M_data[i], c)) return i;
        return npos;
    }

    size_type find_last_of(const CharT* s, size_type pos, size_type n) const noexcept {
        if (_M_size == 0) return npos;
        if (pos >= _M_size) pos = _M_size - 1;
        for (size_type i = pos + 1; i > 0; --i)
            if (Traits::find(s, n, _M_data[i - 1])) return i - 1;
        return npos;
    }
    size_type find_last_not_of(const CharT* s, size_type pos, size_type n) const noexcept {
        if (_M_size == 0) return npos;
        if (pos >= _M_size) pos = _M_size - 1;
        for (size_type i = pos + 1; i > 0; --i)
            if (!Traits::find(s, n, _M_data[i - 1])) return i - 1;
        return npos;
    }

    basic_string substr(size_type pos = 0, size_type n = npos) const {
        size_type len = n < _M_size - pos ? n : _M_size - pos;
        return basic_string(_M_data + pos, len);
    }

    void resize(size_type n) { resize(n, CharT()); }
    void resize(size_type n, CharT c) {
        if (n < _M_size) {
            _M_size = n;
            _M_data[n] = CharT();
        } else if (n > _M_size) {
            if (n + 1 > _M_cap) _M_reserve(n + 1);
            Traits::assign(_M_data + _M_size, n - _M_size, c);
            _M_size = n;
            _M_data[n] = CharT();
        }
    }

    void swap(basic_string& s) noexcept {
        std::swap(_M_data, s._M_data);
        std::swap(_M_size, s._M_size);
        std::swap(_M_cap, s._M_cap);
    }

    allocator_type get_allocator() const { return allocator_type(); }

#if STDCPP_STR_CXX20
    bool starts_with(basic_string_view<CharT, Traits> sv) const noexcept {
        return _M_size >= sv.size() && Traits::compare(_M_data, sv.data(), sv.size()) == 0;
    }
    bool starts_with(CharT c) const noexcept { return _M_size > 0 && Traits::eq(_M_data[0], c); }
    bool starts_with(const CharT* s) const {
        size_type n = Traits::length(s);
        return _M_size >= n && Traits::compare(_M_data, s, n) == 0;
    }
    bool ends_with(basic_string_view<CharT, Traits> sv) const noexcept {
        return _M_size >= sv.size() && Traits::compare(_M_data + _M_size - sv.size(), sv.data(), sv.size()) == 0;
    }
    bool ends_with(CharT c) const noexcept { return _M_size > 0 && Traits::eq(_M_data[_M_size - 1], c); }
    bool ends_with(const CharT* s) const {
        size_type n = Traits::length(s);
        return _M_size >= n && Traits::compare(_M_data + _M_size - n, s, n) == 0;
    }
#endif

#if STDCPP_STR_CXX23
    bool contains(basic_string_view<CharT, Traits> sv) const noexcept { return find(sv) != npos; }
    bool contains(CharT c) const noexcept { return find(c) != npos; }
    bool contains(const CharT* s) const { return find(s) != npos; }

    template<class Operation>
    void resize_and_overwrite(size_type n, Operation op) {
        if (n + 1 > _M_cap) _M_reserve(n + 1);
        size_type r = static_cast<size_type>(op(_M_data, n));
        _M_data[r] = CharT();
        _M_size = r;
    }
#endif
};

template<class C, class T, class A>
basic_string<C, T, A> operator+(const basic_string<C, T, A>& a, const basic_string<C, T, A>& b) {
    basic_string<C, T, A> r = a; r.append(b); return r;
}
template<class C, class T, class A>
basic_string<C, T, A> operator+(const basic_string<C, T, A>& a, const C* b) {
    basic_string<C, T, A> r = a; r.append(b); return r;
}
template<class C, class T, class A>
basic_string<C, T, A> operator+(const C* a, const basic_string<C, T, A>& b) {
    basic_string<C, T, A> r(a); r.append(b); return r;
}
template<class C, class T, class A>
basic_string<C, T, A> operator+(const basic_string<C, T, A>& a, C b) {
    basic_string<C, T, A> r = a; r.push_back(b); return r;
}

template<class C, class T, class A>
bool operator==(const basic_string<C, T, A>& a, const basic_string<C, T, A>& b) { return a.compare(b) == 0; }
template<class C, class T, class A>
bool operator==(const basic_string<C, T, A>& a, const C* b) { return a.compare(b) == 0; }
template<class C, class T, class A>
bool operator!=(const basic_string<C, T, A>& a, const basic_string<C, T, A>& b) { return a.compare(b) != 0; }
template<class C, class T, class A>
bool operator<(const basic_string<C, T, A>& a, const basic_string<C, T, A>& b) { return a.compare(b) < 0; }
template<class C, class T, class A>
bool operator<=(const basic_string<C, T, A>& a, const basic_string<C, T, A>& b) { return a.compare(b) <= 0; }
template<class C, class T, class A>
bool operator>(const basic_string<C, T, A>& a, const basic_string<C, T, A>& b) { return a.compare(b) > 0; }
template<class C, class T, class A>
bool operator>=(const basic_string<C, T, A>& a, const basic_string<C, T, A>& b) { return a.compare(b) >= 0; }

template<class C, class T, class A>
void swap(basic_string<C, T, A>& a, basic_string<C, T, A>& b) { a.swap(b); }

typedef basic_string<char>     string;
typedef basic_string<wchar_t>  wstring;
