    basic_string(const CharT* s, size_type n) : _M_data(nullptr), _M_size(0), _M_cap(0) {
        _M_size = n;
        _M_reserve(n + 1);
        Traits::copy(_M_data, s, n);
        _M_data[n] = CharT();
    }

    basic_string(size_type n, CharT c) : _M_data(nullptr), _M_size(0), _M_cap(0) {
        _M_reserve(n + 1);
        Traits::assign(_M_data, n, c);
        _M_size = n;
        _M_data[n] = CharT();
    }

    basic_string(const basic_string& other) : _M_data(nullptr), _M_size(0), _M_cap(0) {
        _M_size = other._M_size;
        _M_reserve(_M_size + 1);
        Traits::copy(_M_data, other._M_data, _M_size + 1);
