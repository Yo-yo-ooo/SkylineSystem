    }

    basic_string(initializer_list<CharT> il) : _M_data(nullptr), _M_size(0), _M_cap(0) {
        _M_size = il.size();
        _M_reserve(_M_size + 1);
        size_type i = 0;
        for (const CharT& c : il) _M_data[i++] = c;
        _M_data[_M_size] = CharT();
    }
#endif

    ~basic_string() { if (_M_data) free(_M_data); }

    basic_string& operator=(const basic_string& other) {
