//-------------------------------------------------------------
// 浮点格式化：等价 printf("%.6f")，**正确舍入**
//
// 旧实现用 `frac * 1e6 + 0.5` 在 long double 里估算：本身就有舍入误差，
// 大数还会整数溢出后退化成指数形式（与 "%f" 语义不符）。
//
// 这里走精确路径：
//   1. 把 v 拆成 尾数 m（整数）× 2^e。拆分只用乘/除 2 的幂，对二进制浮点
//      是精确运算，不引入误差；不依赖 frexpl 之类的 libm 符号。
//   2. v * 10^6 = m * 5^6 * 2^(e+6)，用二进制大整数精确表示。
//   3. 若 e+6 < 0，右移并**按 ties-to-even 舍入**（与 printf 的默认舍入
//      模式一致）；否则左移。
//   4. 输出十进制，按小数点插在倒数第 6 位。
// 全程只用整数运算，因此与 libc 的 %.6f 逐字符一致（含 1e300 这类大数）。
//-------------------------------------------------------------
namespace __detail {

// long double 的尾数宽度：<=64 位时用 unsigned long long 就够，
// 只有 binary128（113 位）才需要 __int128。这样在 32 位目标上也能编译。
#if defined(__LDBL_MANT_DIG__) && (__LDBL_MANT_DIG__ > 64)
#  if !defined(__SIZEOF_INT128__)
#    error "stdcpp: long double has >64-bit mantissa but compiler lacks __int128"
#  endif
typedef unsigned __int128 mant_t;
#else
typedef unsigned long long mant_t;
#endif

// 二进制大整数：小端 32 位肢
struct bignum {
    uint32_t* d;
    size_t    n;    // 有效肢数，0 表示数值为 0
    size_t    cap;

    template<class UInt>
    void init(UInt v) {
        n = 0;
        while (v) {
            d[n++] = static_cast<uint32_t>(v);
            v >>= 32;
        }
    }

    void mul_small(uint32_t f) {
        unsigned long long carry = 0;
        for (size_t i = 0; i < n; ++i) {
            unsigned long long cur = static_cast<unsigned long long>(d[i]) * f + carry;
            d[i] = static_cast<uint32_t>(cur);
            carry = cur >> 32;
        }
        if (carry) d[n++] = static_cast<uint32_t>(carry);
    }

    void shl(int bits) {
        if (n == 0) return;
        const size_t ls = static_cast<size_t>(bits) / 32;
        const unsigned bs = static_cast<unsigned>(bits) % 32;
        if (ls) {
            for (size_t i = n; i-- > 0;) d[i + ls] = d[i];
            for (size_t i = 0; i < ls; ++i) d[i] = 0;
            n += ls;
        }
        if (bs) {
            uint32_t carry = 0;
            for (size_t i = 0; i < n; ++i) {
                uint32_t nv = (d[i] << bs) | carry;
                carry = d[i] >> (32 - bs);
                d[i] = nv;
            }
            if (carry) d[n++] = carry;
        }
    }

    void add1() {
        for (size_t i = 0; i < n; ++i) {
            if (++d[i]) return;
        }
        d[n++] = 1;
    }

    // 右移 bits 位，按 nearest-even 舍入
    void shr_round(int bits) {
        const size_t idx = static_cast<size_t>(bits) - 1;
        const size_t li = idx / 32;
        const unsigned bi = static_cast<unsigned>(idx % 32);

        // 先取舍入位与 sticky（必须在位移前，位移后信息就没了）
        int round_bit = 0, sticky = 0;
        if (li < n) {
            round_bit = static_cast<int>((d[li] >> bi) & 1u);
            for (size_t i = 0; i < li && !sticky; ++i)
                if (d[i]) sticky = 1;
            if (!sticky && bi) {
                const uint32_t mask = (1u << bi) - 1u;
                if (d[li] & mask) sticky = 1;
            }
        }

        const size_t ls = static_cast<size_t>(bits) / 32;
        const unsigned bs = static_cast<unsigned>(bits) % 32;
        if (ls >= n) {
            n = 0;
        } else {
            for (size_t i = 0; i + ls < n; ++i) d[i] = d[i + ls];
            n -= ls;
            if (bs) {
                for (size_t i = 0; i < n; ++i) {
                    uint32_t nv = d[i] >> bs;
                    if (i + 1 < n) nv |= d[i + 1] << (32 - bs);
                    d[i] = nv;
                }
                while (n > 0 && d[n - 1] == 0) --n;
            }
        }

        if (round_bit) {
            if (sticky) {
                add1();
            } else {
                // 恰好一半：向偶数舍入
                const bool odd = (n > 0) && (d[0] & 1u);
                if (odd) add1();
            }
        }
    }
};

// v = m * 2^e，m 为整数；仅用 2 的幂缩放，保证精确
inline void decompose_float(long double v, mant_t& m, int& e) {
    int k = 0;
    while (v >= 0x1p64L) { v /= 0x1p64L; k += 64; }
    while (v >= 2.0L)   { v /= 2.0L;     ++k; }
    while (v < 0x1p-64L) { v *= 0x1p64L; k -= 64; }
    while (v < 1.0L)    { v *= 2.0L;     --k; }

    // 此时 v ∈ [1,2)，按 long double 的尾数位数放大成整数
#if defined(__LDBL_MANT_DIG__) && (__LDBL_MANT_DIG__ == 113)
    const int mant = 113;
    const long double scale = 0x1p112L;
#elif defined(__LDBL_MANT_DIG__) && (__LDBL_MANT_DIG__ == 64)
    const int mant = 64;
    const long double scale = 0x1p63L;
#else
    const int mant = 53;
    const long double scale = 0x1p52L;
#endif
    m = static_cast<mant_t>(v * scale);
    e = k - (mant - 1);
}

} // namespace __detail

inline string to_string(long double v) {
    if (v != v) return string("nan");                 // NaN

    bool neg = __builtin_signbit(v) != 0;
    if (neg) v = -v;

    {
        // 判断 inf：有限值的 v - v 为 0，inf 的 v - v 为 NaN
        const long double z = v - v;
        if (z != z) return neg ? string("-inf") : string("inf");
    }

    __detail::mant_t m = 0;
    int e = 0;
    if (v > 0.0L) {
        __detail::decompose_float(v, m, e);
    }

    // N = round(v * 10^6) = m * 5^6 * 2^(e+6)
    const int kShift = e + 6;
    const size_t limbs = static_cast<size_t>(128 + (kShift > 0 ? kShift : 0)) / 32 + 8;
    const size_t digits_cap = limbs * 10 + 16;
    char* raw = static_cast<char*>(__detail::alloc_bytes(limbs * sizeof(uint32_t) + digits_cap));

    __detail::bignum bn;
    bn.d = reinterpret_cast<uint32_t*>(raw);
    bn.n = 0;
    bn.cap = limbs;
    bn.init(m);
    if (bn.n) {
        bn.mul_small(15625u);                  // 5^6
        if (kShift > 0) bn.shl(kShift);
        else if (kShift < 0) bn.shr_round(-kShift);
    }

    // 十进制输出（to_dec 会就地消耗 bn）
    char* dg = raw + limbs * sizeof(uint32_t);
    size_t pos = digits_cap;
    dg[--pos] = '\0';
    if (bn.n == 0) {
        dg[--pos] = '0';
    } else {
        while (bn.n > 0) {
            unsigned long long rem = 0;
            for (size_t i = bn.n; i-- > 0;) {
                const unsigned long long cur = (rem << 32) | bn.d[i];
                bn.d[i] = static_cast<uint32_t>(cur / 1000000000ull);
                rem = cur % 1000000000ull;
            }
            while (bn.n > 0 && bn.d[bn.n - 1] == 0) --bn.n;
            if (bn.n > 0) {
                for (int t = 0; t < 9; ++t) { dg[--pos] = char('0' + rem % 10); rem /= 10; }
            } else {
                do { dg[--pos] = char('0' + rem % 10); rem /= 10; } while (rem);
            }
        }
    }

    const char* digits = dg + pos;
    const size_t len = digits_cap - pos - 1;

    string r;
    if (neg) r.push_back('-');
    if (len <= 6) {
        r.append("0.");
        for (size_t i = 0; i < 6 - len; ++i) r.push_back('0');
        r.append(digits, len);
    } else {
        r.append(digits, len - 6);
        r.push_back('.');
        r.append(digits + len - 6, 6);
    }

    __detail::dealloc_bytes(raw);
    return r;
}
inline string to_string(float v) { return to_string(static_cast<long double>(v)); }
inline string to_string(double v) { return to_string(static_cast<long double>(v)); }

