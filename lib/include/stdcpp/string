    //---------------------------------------------------------
    // 容量
    //---------------------------------------------------------
    size_type size() const noexcept { return _M_size; }
    size_type length() const noexcept { return _M_size; }
    size_type capacity() const noexcept { return _M_cap; }
    size_type max_size() const noexcept { return size_type(-1) / sizeof(CharT) - 1; }
    bool empty() const noexcept { return _M_size == 0; }

    void reserve(size_type n = 0) { _M_reserve(n); }
    void shrink_to_fit() {
        if (_M_size <= _S_local_cap) {
            if (!_M_is_local()) {
                CharT tmp[_S_local_cap + 1];
                Traits::copy(tmp, _M_data, _M_size);
                tmp[_M_size] = CharT();
                _M_dispose();
                _M_data = _M_sso;
                _M_cap = _S_local_cap;
                Traits::copy(_M_sso, tmp, _M_size + 1);
            }
            return;
        }
        if (_M_cap > _M_size) {
            CharT* p = allocator_traits<Allocator>::allocate(_M_alloc(), _M_size + 1);
            Traits::copy(p, _M_data, _M_size + 1);
            _M_dispose();
            _M_data = p;
            _M_cap = _M_size;
        }
    }
    void clear() noexcept { _M_size = 0; _M_data[0] = CharT(); }
    void resize(size_type n) { resize(n, CharT()); }
    void resize(size_type n, CharT c) {
        if (n < _M_size) {
            _M_size = n;
            _M_data[n] = CharT();
        } else if (n > _M_size) {
            _M_reserve(n);
            Traits::assign(_M_data + _M_size, n - _M_size, c);
            _M_size = n;
            _M_data[n] = CharT();
        }
    }

