    //---------------------------------------------------------
    // 赋值（带分配器传播）
    //---------------------------------------------------------
    basic_string& operator=(const basic_string& other) {
        if (this == &other) return *this;
        if (propagate_on_container_copy_assignment::value && !(_M_alloc() == other._M_alloc())) {
            // 先用对方的分配器造一份，成功后再接管，避免中途失败留下半释放状态
            basic_string tmp(other._M_data, other._M_size, other._M_alloc());
            _M_dispose();
            _M_alloc() = other._M_alloc();
            _M_take(tmp);
        } else {
            if (propagate_on_container_copy_assignment::value) _M_alloc() = other._M_alloc();
            _M_assign_raw(other._M_data, other._M_size);
        }
        return *this;
    }

    basic_string& operator=(basic_string&& other) noexcept {
        if (this == &other) return *this;
        if (propagate_on_container_move_assignment::value || _M_alloc() == other._M_alloc()) {
            _M_dispose();
            if (propagate_on_container_move_assignment::value) _M_alloc() = other._M_alloc();
            _M_take(other);
        } else {
            // 分配器不等且不传播：不能接管对方缓冲区，只能逐字符拷贝
            _M_assign_raw(other._M_data, other._M_size);
            other.clear();
        }
        return *this;
    }
    basic_string& operator=(const CharT* s) { _M_assign_raw(s, Traits::length(s)); return *this; }
    basic_string& operator=(CharT c) { _M_assign_raw(&c, 1); return *this; }
    basic_string& operator=(initializer_list<CharT> il) { _M_assign_raw(il.begin(), il.size()); return *this; }

    basic_string& assign(const basic_string& s) { return operator=(s); }
    basic_string& assign(basic_string&& s) noexcept { return operator=(static_cast<basic_string&&>(s)); }
    basic_string& assign(const CharT* s) { return operator=(s); }
    basic_string& assign(const CharT* s, size_type n) { _M_assign_raw(s, n); return *this; }
    basic_string& assign(size_type n, CharT c) {
        if (n > _M_cap) _M_reserve(n);
        Traits::assign(_M_data, n, c);
        _M_size = n;
        _M_data[n] = CharT();
        return *this;
    }
    template<class InputIt, class = typename enable_if<!is_integral<InputIt>::value>::type>
    basic_string& assign(InputIt first, InputIt last) {
        clear();
        for (; first != last; ++first) push_back(static_cast<CharT>(*first));
        return *this;
    }
    basic_string& assign(initializer_list<CharT> il) { return assign(il.begin(), il.size()); }

