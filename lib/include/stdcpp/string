    // 追加
    //---------------------------------------------------------
    void push_back(CharT c) {
        _M_reserve(_M_size + 1);
        _M_data[_M_size++] = c;
        _M_data[_M_size] = CharT();
    }
    void pop_back() {
        if (_M_size) { --_M_size; _M_data[_M_size] = CharT(); }
    }

    basic_string& append(const basic_string& s) { return append(s._M_data, s._M_size); }
    basic_string& append(const basic_string& s, size_type pos, size_type n = npos) {
        if (pos > s._M_size) __detail::throw_out_of_range("basic_string::append");
        size_type len = s._M_size - pos;
        if (n < len) len = n;
        return append(s._M_data + pos, len);
    }
    basic_string& append(const CharT* s, size_type n) {
        if (n == 0) return *this;
        bool heap = false;
        CharT stackbuf[64];
        const bool self = (s >= _M_data && s < _M_data + _M_size + 1);
        if (self) s = _M_make_temp(s, n, stackbuf, sizeof(stackbuf) / sizeof(CharT), heap);
        _M_reserve(_M_size + n);
        Traits::copy(_M_data + _M_size, s, n);
        _M_size += n;
        _M_data[_M_size] = CharT();
        if (heap) __detail::dealloc_bytes_aligned(const_cast<CharT*>(s), alignof(CharT));
        return *this;
    }
    basic_string& append(const CharT* s) { return append(s, Traits::length(s)); }
    basic_string& append(size_type n, CharT c) {
        _M_reserve(_M_size + n);
        Traits::assign(_M_data + _M_size, n, c);
        _M_size += n;
        _M_data[_M_size] = CharT();
        return *this;
    }
    template<class InputIt, class = typename enable_if<!is_integral<InputIt>::value>::type>
    basic_string& append(InputIt first, InputIt last) {
        for (; first != last; ++first) push_back(static_cast<CharT>(*first));
        return *this;
    }
    basic_string& append(initializer_list<CharT> il) { return append(il.begin(), il.size()); }

    basic_string& operator+=(const basic_string& s) { return append(s); }
    basic_string& operator+=(const CharT* s) { return append(s); }
    basic_string& operator+=(CharT c) { push_back(c); return *this; }
    basic_string& operator+=(initializer_list<CharT> il) { return append(il); }

    //---------------------------------------------------------
    // 插入 / 删除 / 替换
    //---------------------------------------------------------
    basic_string& insert(size_type pos, const basic_string& s) { return insert(pos, s._M_data, s._M_size); }
    basic_string& insert(size_type pos, const CharT* s) { return insert(pos, s, Traits::length(s)); }

    basic_string& insert(size_type pos, const CharT* s, size_type n) {
        if (pos > _M_size) __detail::throw_out_of_range("basic_string::insert");
        if (n == 0) return *this;
        bool heap = false;
        CharT stackbuf[64];
        const bool self = (s >= _M_data && s < _M_data + _M_size + 1);
        if (self) s = _M_make_temp(s, n, stackbuf, sizeof(stackbuf) / sizeof(CharT), heap);
        _M_reserve(_M_size + n);
        Traits::move(_M_data + pos + n, _M_data + pos, _M_size - pos + 1);
        Traits::copy(_M_data + pos, s, n);
        _M_size += n;
        if (heap) __detail::dealloc_bytes_aligned(const_cast<CharT*>(s), alignof(CharT));
        return *this;
    }

    basic_string& insert(size_type pos, size_type n, CharT c) {
        if (pos > _M_size) __detail::throw_out_of_range("basic_string::insert");
        _M_reserve(_M_size + n);
        Traits::move(_M_data + pos + n, _M_data + pos, _M_size - pos + 1);
        Traits::assign(_M_data + pos, n, c);
        _M_size += n;
        return *this;
    }

    iterator insert(const_iterator p, CharT c) {
        size_type pos = static_cast<size_type>(p - _M_data);
        insert(pos, 1, c);
        return _M_data + pos;
    }
    iterator insert(const_iterator p, size_type n, CharT c) {
        size_type pos = static_cast<size_type>(p - _M_data);
        insert(pos, n, c);
        return _M_data + pos;
    }
    template<class InputIt, class = typename enable_if<!is_integral<InputIt>::value>::type>
    iterator insert(const_iterator p, InputIt first, InputIt last) {
        size_type pos = static_cast<size_type>(p - _M_data);
        basic_string tmp(first, last);
        insert(pos, tmp._M_data, tmp._M_size);
        return _M_data + pos;
    }

    basic_string& erase(size_type pos = 0, size_type n = npos) {
        if (pos > _M_size) __detail::throw_out_of_range("basic_string::erase");
        size_type len = _M_size - pos;
        if (n < len) len = n;
        Traits::move(_M_data + pos, _M_data + pos + len, _M_size - pos - len + 1);
        _M_size -= len;
        return *this;
    }
    iterator erase(const_iterator p) {
        size_type pos = static_cast<size_type>(p - _M_data);
        erase(pos, 1);
        return _M_data + pos;
    }
    iterator erase(const_iterator first, const_iterator last) {
        size_type pos = static_cast<size_type>(first - _M_data);
        size_type n = static_cast<size_type>(last - first);
        erase(pos, n);
        return _M_data + pos;
    }

    basic_string& replace(size_type pos, size_type n, const basic_string& s) {
