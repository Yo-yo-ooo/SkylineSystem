        size_type len = _M_size - pos;
        if (n < len) len = n;
        // 先把源拷出来：源可能与目标区间重叠
        basic_string tmp(s, n2);
        erase(pos, len);
        insert(pos, tmp._M_data, tmp._M_size);
        return *this;
    }
    basic_string& replace(size_type pos, size_type n, size_type n2, CharT c) {
        if (pos > _M_size) __detail::throw_out_of_range("basic_string::replace");
        size_type len = _M_size - pos;
