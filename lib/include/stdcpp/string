// basic_string
//=============================================================
template<class CharT, class Traits = char_traits<CharT>, class Allocator = allocator<CharT> >
// 私有继承 Allocator：无状态分配器（std::allocator）不占额外空间（EBO）
class basic_string : private Allocator {
public:
    typedef Traits       traits_type;
    typedef CharT        value_type;
    typedef Allocator    allocator_type;
    typedef size_t       size_type;
    typedef ptrdiff_t    difference_type;
    typedef CharT&       reference;
    typedef const CharT& const_reference;
    typedef CharT*       pointer;
    typedef const CharT* const_pointer;
    typedef CharT*       iterator;
    typedef const CharT* const_iterator;
    typedef std::reverse_iterator<iterator>       reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    static constexpr size_type npos = size_type(-1);

    // 分配器传播策略（与 vector 一致）
    typedef typename allocator_traits<Allocator>::propagate_on_container_copy_assignment
        propagate_on_container_copy_assignment;
    typedef typename allocator_traits<Allocator>::propagate_on_container_move_assignment
        propagate_on_container_move_assignment;
    typedef typename allocator_traits<Allocator>::propagate_on_container_swap
        propagate_on_container_swap;

private:
    static constexpr size_type _S_local_cap = 15;

    allocator_type& _M_alloc() noexcept { return *static_cast<allocator_type*>(this); }
    const allocator_type& _M_alloc() const noexcept {
        return *static_cast<const allocator_type*>(this);
    }

    CharT     _M_sso[_S_local_cap + 1];
    CharT*    _M_data;
    size_type _M_size;
    size_type _M_cap;   // 不含结尾 '\0' 的可用容量

    bool _M_is_local() const noexcept { return _M_data == _M_sso; }
    void _M_set_local() noexcept {
        _M_data = _M_sso;
        _M_size = 0;
        _M_cap = _S_local_cap;
        _M_sso[0] = CharT();
    }
    void _M_dispose() noexcept {
        if (!_M_is_local()) allocator_traits<Allocator>::deallocate(_M_alloc(), _M_data, _M_cap + 1);
    }

    // 接管 src 的内容（前置条件：*this 当前不持有缓冲区）
    void _M_take(basic_string& src) noexcept {
        if (src._M_is_local()) {
            Traits::copy(_M_sso, src._M_sso, src._M_size + 1);
            _M_data = _M_sso;
            _M_size = src._M_size;
            _M_cap = _S_local_cap;
            src._M_set_local();
        } else {
            _M_data = src._M_data;
            _M_size = src._M_size;
            _M_cap = src._M_cap;
            _M_sso[0] = CharT();
            src._M_set_local();
        }
    }

    // 只交换存储内容，不动分配器（swap 的分配器处理在外层完成）
    void _M_swap_data(basic_string& o) noexcept {
        if (_M_is_local() && o._M_is_local()) {
            CharT tmp[_S_local_cap + 1];
            const size_type n1 = _M_size, n2 = o._M_size;
            Traits::copy(tmp, _M_sso, n1 + 1);
            Traits::copy(_M_sso, o._M_sso, n2 + 1);
            Traits::copy(o._M_sso, tmp, n1 + 1);
            _M_size = n2;
            o._M_size = n1;
            return;
        }
        if (_M_is_local() != o._M_is_local()) {
            basic_string& heap_side = _M_is_local() ? o : *this;
            basic_string& loc_side  = _M_is_local() ? *this : o;
            CharT localbuf[_S_local_cap + 1];
            const size_type lsize = loc_side._M_size;
            Traits::copy(localbuf, loc_side._M_sso, lsize + 1);

            loc_side._M_data = heap_side._M_data;
            loc_side._M_size = heap_side._M_size;
            loc_side._M_cap  = heap_side._M_cap;

            heap_side._M_data = heap_side._M_sso;
            heap_side._M_size = lsize;
            heap_side._M_cap  = _S_local_cap;
            Traits::copy(heap_side._M_sso, localbuf, lsize + 1);
            return;
        }
        CharT* d = _M_data;
        const size_type sz = _M_size, cp = _M_cap;
        _M_data = o._M_data; _M_size = o._M_size; _M_cap = o._M_cap;
        o._M_data = d; o._M_size = sz; o._M_cap = cp;
    }

    // 保证 capacity >= n（不改变 size / 内容）
    void _M_reserve(size_type n) {
        if (n <= _M_cap) return;
        size_type newcap = _M_cap ? _M_cap : _S_local_cap;
        while (newcap < n) {
            size_type next = newcap * 2;
            if (next <= newcap) { newcap = n; break; }   // 溢出保护
            newcap = next;
        }
        CharT* p = allocator_traits<Allocator>::allocate(_M_alloc(), newcap + 1);
        Traits::copy(p, _M_data, _M_size);
        p[_M_size] = CharT();
        _M_dispose();
        _M_data = p;
        _M_cap = newcap;
    }

    void _M_assign_raw(const CharT* s, size_type n) {
        // 自引用检测：s 落在本对象当前缓冲区时，扩容会释放旧内存，
        // 必须先把数据搬到新缓冲区再释放（先拷贝后扩容的顺序不能反）。
        const bool self = (s >= _M_data && s < _M_data + _M_size + 1);
        if (self && n > _M_cap) {
            CharT* p = allocator_traits<Allocator>::allocate(_M_alloc(), n + 1);
            Traits::move(p, s, n);
            p[n] = CharT();
            _M_dispose();
            _M_data = p;
            _M_cap = n;
            _M_size = n;
            return;
        }
        if (n > _M_cap) _M_reserve(n);
        if (n) Traits::move(_M_data, s, n);
        _M_size = n;
        _M_data[n] = CharT();
    }

    // 把 [s, s+n) 复制到临时缓冲区（用于自引用场景）
    CharT* _M_make_temp(const CharT* s, size_type n, CharT* stackbuf, size_type stackcap, bool& heap) {
        heap = false;
        if (n <= stackcap) {
            Traits::copy(stackbuf, s, n);
            return stackbuf;
        }
        CharT* p = static_cast<CharT*>(__detail::alloc_bytes_aligned(n * sizeof(CharT), alignof(CharT)));
        Traits::copy(p, s, n);
        heap = true;
        return p;
    }

public:
    //---------------------------------------------------------
    // 构造 / 析构
    //---------------------------------------------------------
    basic_string() noexcept { _M_set_local(); }

    basic_string(const CharT* s) { _M_set_local(); _M_assign_raw(s, Traits::length(s)); }
    basic_string(const CharT* s, size_type n) { _M_set_local(); _M_assign_raw(s, n); }
    basic_string(size_type n, CharT c) {
