        return replace(static_cast<size_type>(first - _M_data), static_cast<size_type>(last - first), s);
    }
    basic_string& replace(const_iterator first, const_iterator last, const CharT* s) {
        return replace(static_cast<size_type>(first - _M_data), static_cast<size_type>(last - first), s);
    }
    basic_string& replace(const_iterator first, const_iterator last, size_type n, CharT c) {
        return replace(static_cast<size_type>(first - _M_data), static_cast<size_type>(last - first), n, c);
