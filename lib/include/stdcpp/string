inline int stoi(const string& s, size_t* pos = nullptr, int base = 10) {
    bool ov = false, neg = false; unsigned long long mag = 0; size_t used = 0;
    bool ok = __detail::parse_integer(s.c_str(), s.size(), base, ov, neg, mag, used);
    if (!ok) __detail::throw_invalid_argument("stoi");
    if (ov || (!neg && mag > 2147483647ULL) || (neg && mag > 2147483648ULL))
        __detail::throw_out_of_range("stoi");
    if (pos) *pos = used;
    return neg ? static_cast<int>(-static_cast<long long>(mag)) : static_cast<int>(mag);
}
inline long stol(const string& s, size_t* pos = nullptr, int base = 10) {
    bool ov = false, neg = false; unsigned long long mag = 0; size_t used = 0;
    bool ok = __detail::parse_integer(s.c_str(), s.size(), base, ov, neg, mag, used);
    if (!ok) __detail::throw_invalid_argument("stol");
    // long 在 Windows(LLP64) 是 32 位、Linux(LP64) 是 64 位，必须按
    // sizeof(long) 判界，否则跨平台行为不一致（静默截断）。
    const unsigned long long lmax = (sizeof(long) == 8) ? 9223372036854775807ULL : 2147483647ULL;
    const unsigned long long lmin_mag = (sizeof(long) == 8) ? 9223372036854775808ULL : 2147483648ULL;
    if (ov || (!neg && mag > lmax) || (neg && mag > lmin_mag))
        __detail::throw_out_of_range("stol");
    if (pos) *pos = used;
    return neg ? static_cast<long>(-static_cast<long long>(mag)) : static_cast<long>(mag);
}
