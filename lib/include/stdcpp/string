template<class T> struct char_traits;

template<> struct char_traits<char> {
    typedef char       char_type;
    typedef int        int_type;
    typedef size_t     pos_type;
    typedef ptrdiff_t  off_type;

    static void assign(char& dst, const char& src) { dst = src; }
    static bool eq(char a, char b) { return a == b; }
    static bool lt(char a, char b) { return a < b; }
    static int compare(const char* s1, const char* s2, size_t n) { return memcmp(s1, s2, n); }
    static size_t length(const char* s) { return strlen(s); }
    static const char* find(const char* s, size_t n, const char& a) {
        return (const char*)memchr(s, a, n);
    }
    static char* move(char* dst, const char* src, size_t n) { return (char*)memmove(dst, src, n); }
    static char* copy(char* dst, const char* src, size_t n) { return (char*)memcpy(dst, src, n); }
    static char* assign(char* s, size_t n, char a) { return (char*)memset(s, a, n); }
    static int_type not_eof(int_type c) { return eq_int_type(c, eof()) ? 0 : c; }
    static char_type to_char_type(int_type c) { return (char_type)c; }
    static int_type to_int_type(char_type c) { return (int_type)(unsigned char)c; }
    static bool eq_int_type(int_type a, int_type b) { return a == b; }
    static int_type eof() { return -1; }
};

