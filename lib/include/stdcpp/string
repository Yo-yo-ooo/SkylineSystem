    size_type find(const basic_string& s, size_type pos = 0) const noexcept {
        return find(s._M_data, pos, s._M_size);
    }
    size_type find(const CharT* s, size_type pos, size_type n) const noexcept {
        if (n == 0) return pos <= _M_size ? pos : npos;
        if (pos > _M_size || n > _M_size - pos) return npos;
        for (size_type i = pos; i + n <= _M_size; ++i)
            if (Traits::compare(_M_data + i, s, n) == 0) return i;
        return npos;
    }
    size_type find(const CharT* s, size_type pos = 0) const noexcept { return find(s, pos, Traits::length(s)); }
    size_type find(CharT c, size_type pos = 0) const noexcept {
        if (pos >= _M_size) return npos;
        const CharT* p = Traits::find(_M_data + pos, _M_size - pos, c);
        return p ? static_cast<size_type>(p - _M_data) : npos;
    }

    size_type rfind(const basic_string& s, size_type pos = npos) const noexcept {
        return rfind(s._M_data, pos, s._M_size);
    }
    size_type rfind(const CharT* s, size_type pos, size_type n) const noexcept {
        if (n > _M_size) return npos;
        size_type i = _M_size - n;
        if (pos < i) i = pos;
        for (;;) {
            if (Traits::compare(_M_data + i, s, n) == 0) return i;
            if (i == 0) break;
            --i;
        }
        return npos;
    }
    size_type rfind(const CharT* s, size_type pos = npos) const noexcept { return rfind(s, pos, Traits::length(s)); }
    size_type rfind(CharT c, size_type pos = npos) const noexcept {
        if (_M_size == 0) return npos;
        size_type i = _M_size - 1;
        if (pos < i) i = pos;
        for (;;) {
            if (Traits::eq(_M_data[i], c)) return i;
            if (i == 0) break;
            --i;
        }
        return npos;
    }

