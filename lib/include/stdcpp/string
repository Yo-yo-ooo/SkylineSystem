        size_type len = n < other._M_size - pos ? n : other._M_size - pos;
        _M_reserve(len + 1);
        Traits::copy(_M_data, other._M_data + pos, len);
        _M_size = len;
        _M_data[len] = CharT();
    }

#if STDCPP_STR_CXX11
    basic_string(basic_string&& other) noexcept
        : _M_data(other._M_data), _M_size(other._M_size), _M_cap(other._M_cap) {
        other._M_data = nullptr;
