    void clear() noexcept { _M_size = 0; _M_data[0] = CharT(); }

    const CharT* c_str() const noexcept { return _M_data; }
    const CharT* data() const noexcept { return _M_data; }
#if STDCPP_STR_CXX17
    CharT* data() noexcept { return _M_data; }
#endif
    operator const CharT*() const { return _M_data; }

    reference operator[](size_type i) { return _M_data[i]; }
