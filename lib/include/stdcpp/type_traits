namespace std {

// ============================================================================
// Primitive utilities needed by everything else
// ============================================================================

// --- integral_constant / true_type / false_type ----------------------------
template <typename T, T v>
struct integral_constant {
    static constexpr T value = v;
    using value_type = T;
    using type = integral_constant<T, v>;
    constexpr operator value_type() const noexcept { return value; }
#ifdef _STDCPP_CXX14
    constexpr value_type operator()() const noexcept { return value; }
#endif
};
template <typename T, T v>
constexpr T integral_constant<T, v>::value;

using true_type  = integral_constant<bool, true>;
using false_type = integral_constant<bool, false>;

// --- type_identity (C++20 std, used internally from C++11) -----------------
template <typename T>
struct type_identity { using type = T; };

// --- minimal <cstddef> / <cstdint> replacements ----------------------------
using size_t = decltype(sizeof(0));
using int8_t   = signed char;
using int16_t  = short;
using int32_t  = int;
using int64_t  = long long;
using uint8_t  = unsigned char;
using uint16_t = unsigned short;
using uint32_t = unsigned int;
using uint64_t = unsigned long long;
using int_least8_t   = signed char;
using int_least16_t  = short;
using int_least32_t  = int;
using int_least64_t  = long long;
using uint_least8_t  = unsigned char;
using uint_least16_t = unsigned short;
using uint_least32_t = unsigned int;
using uint_least64_t = unsigned long long;
#ifdef __SIZEOF_INT128__
using int128_t  = __int128;
using uint128_t = unsigned __int128;
#endif

// --- forward declarations (needed for two-phase lookup) --------------------
template <typename T> struct remove_const;
template <typename T> struct remove_volatile;
template <typename T> struct remove_cv;
template <typename T> struct remove_reference;
template <typename T> struct add_rvalue_reference;
template <typename T> struct is_function;
template <typename T> struct is_member_pointer;
template <typename T> struct is_member_object_pointer;
template <bool B, typename T, typename F> struct conditional;
template <typename... T> struct common_type;
template <typename T> struct decay;

// declval must be declared before use in dependent contexts (two-phase lookup)
template <typename T>
typename add_rvalue_reference<T>::type declval() noexcept;

