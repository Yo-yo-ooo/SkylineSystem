    : integral_constant<bool, __is_class(T)> {};
#else
template <typename T> struct is_enum : false_type {};
template <typename T> struct is_union : false_type {};
namespace _detail {
template <typename T> true_type  is_class_test(int T::*);
template <typename>   false_type is_class_test(...);
}
template <typename T> struct is_class
    : decltype(_detail::is_class_test<T>(0)) {};
#endif

