_STDCPP_IS_FUNC(volatile, , noexcept)
_STDCPP_IS_FUNC(const volatile, , noexcept)
_STDCPP_IS_FUNC( , &, noexcept)
_STDCPP_IS_FUNC(const, &, noexcept)
_STDCPP_IS_FUNC(volatile, &, noexcept)
