namespace _detail {
template <int N> struct invoke_prio : invoke_prio<N-1> {};
template <> struct invoke_prio<0> {};

// Regular callable
template <typename F, typename... A>
constexpr auto invoke_do(invoke_prio<3>, F&& f, A&&... a)
    noexcept(noexcept(forward<F>(f)(forward<A>(a)...)))
    -> decltype(forward<F>(f)(forward<A>(a)...))
{
    return forward<F>(f)(forward<A>(a)...);
}

// Member function pointer + reference/value object
template <typename MP, typename T, typename... A,
          enable_if_t<is_member_function_pointer<
              remove_reference_t<MP>>::value, int> = 0>
constexpr auto invoke_do(invoke_prio<2>, MP&& f, T&& t, A&&... a)
    noexcept(noexcept((forward<T>(t).*f)(forward<A>(a)...)))
    -> decltype((forward<T>(t).*f)(forward<A>(a)...))
{
    return (forward<T>(t).*f)(forward<A>(a)...);
}

// Member object pointer + reference/value object
template <typename MP, typename T,
          enable_if_t<is_member_object_pointer<
              remove_reference_t<MP>>::value, int> = 0>
constexpr auto invoke_do(invoke_prio<1>, MP&& m, T&& t)
    noexcept(noexcept(forward<T>(t).*m))
    -> decltype(forward<T>(t).*m)
{
    return forward<T>(t).*m;
}

// Member pointer + pointer-like object (dereference and retry)
template <typename MP, typename T, typename... A>
constexpr auto invoke_do(invoke_prio<0>, MP&& f, T&& t, A&&... a)
    noexcept(noexcept(invoke_do(invoke_prio<3>(),
                          forward<MP>(f), *forward<T>(t), forward<A>(a)...)))
    -> decltype(invoke_do(invoke_prio<3>(),
                          forward<MP>(f), *forward<T>(t), forward<A>(a)...))
{
    return invoke_do(invoke_prio<3>(),
                     forward<MP>(f), *forward<T>(t), forward<A>(a)...);
}
} // namespace _detail

template <typename F, typename... A>
constexpr auto invoke(F&& f, A&&... a)
    noexcept(noexcept(_detail::invoke_do(
        _detail::invoke_prio<3>(), forward<F>(f), forward<A>(a)...)))
    -> decltype(_detail::invoke_do(
        _detail::invoke_prio<3>(), forward<F>(f), forward<A>(a)...))
{
    return _detail::invoke_do(
        _detail::invoke_prio<3>(), forward<F>(f), forward<A>(a)...);
}

namespace _detail {
template <typename F, typename... A>
struct invoke_result_impl {
private:
    template <typename G, typename... B>
    static auto test(int)
        -> type_identity<decltype(invoke_do(
            invoke_prio<3>(), declval<G>(), declval<B>()...))>;
    template <typename, typename...>
    static auto test(...) -> void;
public:
    using type = typename decltype(test<F, A...>(0))::type;
};
} // namespace _detail

template <typename F, typename... A>
struct invoke_result : _detail::invoke_result_impl<F, A...> {};

template <typename F, typename... A>
using invoke_result_t = typename invoke_result<F, A...>::type;

