    noexcept(is_nothrow_move_constructible<T>::value &&
             is_nothrow_move_assignable<T>::value)
{
    T tmp = static_cast<T&&>(a);
    a = static_cast<T&&>(b);
    b = static_cast<T&&>(tmp);
}

