// --- forward_like ----------------------------------------------------------
template <typename T, typename U>
[[nodiscard]] constexpr auto&& forward_like(U&& x) noexcept {
    using T_noref = remove_reference_t<T>;
    using U_noref = remove_reference_t<U>;
    using U_cv = conditional_t<
        is_const<T_noref>::value, const U_noref, U_noref>;
    using U_cv2 = conditional_t<
        is_volatile<T_noref>::value, volatile U_cv, U_cv>;
    if constexpr (is_rvalue_reference<T>::value) {
        return static_cast<U_cv2&&>(x);
    } else {
        return static_cast<U_cv2&>(x);
    }
}

