// --- is_signed / is_unsigned -----------------------------------------------
namespace _detail {
template <typename T, bool = is_arithmetic<T>::value>
struct is_signed_base : integral_constant<bool, T(-1) < T(0)> {};
template <typename T>
struct is_signed_base<T, false> : false_type {};

template <typename T, bool = is_arithmetic<T>::value>
struct is_unsigned_base : integral_constant<bool, T(0) < T(-1)> {};
template <typename T>
struct is_unsigned_base<T, false> : false_type {};
} // namespace _detail

template <typename T>
struct is_signed : _detail::is_signed_base<T>::type {};
template <typename T>
struct is_unsigned : _detail::is_unsigned_base<T>::type {};

// --- alignment_of ----------------------------------------------------------
template <typename T>
struct alignment_of
    : integral_constant<size_t,
#ifdef _STDCPP_GNU
        __alignof__(T)
#else
        alignof(T)
#endif
      > {};

// --- rank / extent ---------------------------------------------------------
template <typename T>           struct rank      : integral_constant<size_t, 0> {};
template <typename T>           struct rank<T[]> : integral_constant<size_t, rank<T>::value + 1> {};
template <typename T, size_t N> struct rank<T[N]> : integral_constant<size_t, rank<T>::value + 1> {};

template <typename T, unsigned I = 0>
struct extent : integral_constant<size_t, 0> {};
template <typename T>
struct extent<T[], 0> : integral_constant<size_t, 0> {};
template <typename T, unsigned I>
struct extent<T[], I> : integral_constant<size_t, extent<T, I - 1>::value> {};
template <typename T, size_t N>
struct extent<T[N], 0> : integral_constant<size_t, N> {};
template <typename T, size_t N, unsigned I>
struct extent<T[N], I> : integral_constant<size_t, extent<T, I - 1>::value> {};

// --- aligned_storage / aligned_union ---------------------------------------
namespace _detail {
// Union of fundamental types to determine maximum native alignment.
union max_align {
    char c; short s; int i; long l; long long ll;
    float f; double d; long double ld;
    void* p; void (*fp)();
};

template <size_t...> struct max_size;
template <size_t X> struct max_size<X> : integral_constant<size_t, X> {};
template <size_t X, size_t Y, size_t... R>
struct max_size<X, Y, R...> : integral_constant<size_t,
    (X >= Y ? max_size<X, R...>::value : max_size<Y, R...>::value)> {};

template <size_t...> struct max_align_of;
template <size_t X> struct max_align_of<X> : integral_constant<size_t, X> {};
template <size_t X, size_t Y, size_t... R>
struct max_align_of<X, Y, R...> : integral_constant<size_t,
    (X >= Y ? max_align_of<X, R...>::value : max_align_of<Y, R...>::value)> {};
} // namespace _detail

template <size_t Len,
          size_t Align = alignment_of<_detail::max_align>::value>
struct aligned_storage {
    struct type {
        alignas(Align) unsigned char data[Len];
    };
};

template <size_t Len, typename... T>
struct aligned_union {
    static constexpr size_t alignment_value =
        _detail::max_align_of<alignment_of<T>::value...>::value;
private:
    static constexpr size_t max_size_ =
        _detail::max_size<Len, sizeof(T)...>::value;
public:
    struct type {
        alignas(alignment_value) unsigned char data[max_size_];
    };
};

// ============================================================================
// Type relationships  [meta.rel]
// ============================================================================

template <typename T, typename U> struct is_same : false_type {};
template <typename T>             struct is_same<T, T> : true_type {};

#ifdef _STDCPP_GNU
template <typename Base, typename Derived>
struct is_base_of : integral_constant<bool,
    __is_base_of(Base, Derived) || is_same<Base, Derived>::value> {};
#else
namespace _detail {
template <typename B, typename D>
auto is_base_of_test(int) -> decltype(static_cast<B*>(static_cast<D*>(nullptr)), true_type{});
template <typename, typename>
false_type is_base_of_test(...);
}
template <typename Base, typename Derived>
struct is_base_of : decltype(_detail::is_base_of_test<Base, Derived>(0)) {};
#endif

#ifdef _STDCPP_GNU
// Portable SFINAE implementation (works on GCC and Clang)
namespace _detail {
template <typename From, typename To, bool = is_void<To>::value>
struct is_convertible_impl {
    template <typename T>
    static void sink(T) noexcept;
    template <typename F, typename T>
    static auto test(int) -> decltype(sink<T>(declval<F>()), true_type{});
    template <typename, typename>
    static auto test(...) -> false_type;
    using type = decltype(test<From, To>(0));
};
// Anything converts to void (including void -> void)
template <typename From, typename To>
struct is_convertible_impl<From, To, true> : true_type {};
} // namespace _detail
template <typename From, typename To>
struct is_convertible
    : _detail::is_convertible_impl<From, To>::type {};
#else
namespace _detail {
template <typename To> void conv_test(To) noexcept;
template <typename From, typename To>
auto is_convertible_test(int) -> decltype(conv_test<To>(declval<From>()), true_type{});
template <typename, typename>
false_type is_convertible_test(...);
}
template <typename From, typename To>
struct is_convertible : decltype(_detail::is_convertible_test<From, To>(0)) {};
#endif

