#elif defined(__clang__)
#  if __has_feature(is_layout_compatible)
#    define _STDCPP_HAS_LAYOUT_INTRINSICS 1
#  endif
#  if __has_feature(reference_binds_to_temporary)
#    define _STDCPP_HAS_REF_TEMP_INTRINSICS 1
#  endif
#  if __has_feature(is_scoped_enum)
#    define _STDCPP_HAS_SCOPED_ENUM 1
#  endif
#  if __has_feature(is_implicit_lifetime)
#    define _STDCPP_HAS_IMPLICIT_LIFETIME 1
