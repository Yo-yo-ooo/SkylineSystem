namespace _detail {
template <typename T> struct is_function_base : false_type {};

// Macro to generate cv/ref-qualified function type specializations
#define _STDCPP_IS_FUNC(CV, REF, NOEXCEPT)                                       \
template <typename R, typename... A>                                          \
struct is_function_base<R(A... ) CV REF NOEXCEPT> : true_type {};            \
template <typename R, typename... A>                                          \
struct is_function_base<R(A..., ...) CV REF NOEXCEPT> : true_type {};

_STDCPP_IS_FUNC( , , )
_STDCPP_IS_FUNC(const, , )
_STDCPP_IS_FUNC(volatile, , )
_STDCPP_IS_FUNC(const volatile, , )
_STDCPP_IS_FUNC( , &, )
_STDCPP_IS_FUNC(const, &, )
_STDCPP_IS_FUNC(volatile, &, )
_STDCPP_IS_FUNC(const volatile, &, )
_STDCPP_IS_FUNC( , &&, )
_STDCPP_IS_FUNC(const, &&, )
_STDCPP_IS_FUNC(volatile, &&, )
_STDCPP_IS_FUNC(const volatile, &&, )
#ifdef _STDCPP_CXX17
_STDCPP_IS_FUNC( , , noexcept)
