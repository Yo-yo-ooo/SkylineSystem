// --- is_member_pointer -----------------------------------------------------
namespace _detail {
template <typename T> struct is_member_pointer_base : false_type {};
template <typename T, typename C>
struct is_member_pointer_base<T C::*> : true_type {};

template <typename T> struct is_member_obj_ptr_base : false_type {};
template <typename T, typename C>
struct is_member_obj_ptr_base<T C::*>
    : integral_constant<bool, !is_function<T>::value> {};
} // namespace _detail

template <typename T>
struct is_member_pointer
    : _detail::is_member_pointer_base<typename remove_cv<T>::type> {};

template <typename T>
struct is_member_object_pointer
    : _detail::is_member_obj_ptr_base<typename remove_cv<T>::type> {};

template <typename T>
struct is_member_function_pointer
    : integral_constant<bool,
        is_member_pointer<T>::value &&
