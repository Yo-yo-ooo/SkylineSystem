    struct param_type {
        explicit param_type(RealType n = RealType(1)) : _M_n(n) {}
        RealType n() const { return _M_n; }
        bool operator==(const param_type& o) const { return _M_n == o._M_n; }
        bool operator!=(const param_type& o) const { return !(*this == o); }
    private:
        RealType _M_n;
    };

    explicit student_t_distribution(RealType n = RealType(1)) : _M_p(n) {}
    explicit student_t_distribution(const param_type& p) : _M_p(p) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
