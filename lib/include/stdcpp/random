    struct param_type {
        explicit param_type(double mean = 1.0) : _M_mean(mean) {}
        double mean() const { return _M_mean; }
        bool operator==(const param_type& o) const { return _M_mean == o._M_mean; }
        bool operator!=(const param_type& o) const { return !(*this == o); }
    private:
        double _M_mean;
    };

    explicit poisson_distribution(double mean = 1.0) : _M_p(mean) {}
    explicit poisson_distribution(const param_type& p) : _M_p(p) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    double mean() const { return _M_p.mean(); }
    result_type min() const { return 0; }
    result_type max() const { return result_type(0x7fffffff); }

    template<class URBG>
    result_type operator()(URBG& g) {
        // Knuth 乘积法：L = exp(-mean)，累乘直到 < L。mean 很大时较慢，
        // 但实现简单且无精度陷阱（大 mean 场景可改用正态近似）。
        const double L = __detail::m_exp(-_M_p.mean());
        double p = 1.0;
        result_type k = 0;
        do {
            ++k;
            p *= 1.0 - generate_canonical<double, 53, URBG>(g);
        } while (p > L);
        return k - 1;
    }

    bool operator==(const poisson_distribution& o) const { return _M_p == o._M_p; }
    bool operator!=(const poisson_distribution& o) const { return !(*this == o); }

private:
    param_type _M_p;
};

//=============================================================
// gamma / chi_squared / fisher_f / student_t / cauchy / weibull /
// extreme_value
//=============================================================
template<class RealType = double>
class gamma_distribution {
public:
    typedef RealType result_type;
    struct param_type {
        param_type(RealType alpha = RealType(1), RealType beta = RealType(1))
            : _M_alpha(alpha), _M_beta(beta) {}
        RealType alpha() const { return _M_alpha; }
        RealType beta() const { return _M_beta; }
        bool operator==(const param_type& o) const {
            return _M_alpha == o._M_alpha && _M_beta == o._M_beta;
        }
        bool operator!=(const param_type& o) const { return !(*this == o); }
    private:
        RealType _M_alpha, _M_beta;
    };

    explicit gamma_distribution(RealType alpha = RealType(1), RealType beta = RealType(1))
        : _M_p(alpha, beta) {}
    explicit gamma_distribution(const param_type& p) : _M_p(p) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    RealType alpha() const { return _M_p.alpha(); }
    RealType beta() const { return _M_p.beta(); }
    result_type min() const { return RealType(0); }
    result_type max() const { return result_type(1e308); }

    template<class URBG>
    result_type operator()(URBG& g) {
        // Marsaglia-Tsang 方法（alpha >= 1）；alpha < 1 用 boost 技巧
        if (_M_p.alpha() < RealType(1)) {
            const RealType u = generate_canonical<RealType, 53, URBG>(g);
            gamma_distribution<RealType> g2(_M_p.alpha() + RealType(1), RealType(1));
            return g2(g) * static_cast<RealType>(
                __detail::m_exp(__detail::m_log(u) / _M_p.alpha()));
        }
        const RealType d = _M_p.alpha() - RealType(1) / RealType(3);
        const RealType c = RealType(1) / __detail::sqrt_nr(RealType(9) * d);
        for (;;) {
            RealType x, v;
            do {
                x = (*this).template _M_normal(g);
                v = RealType(1) + c * x;
            } while (v <= RealType(0));
            v = v * v * v;
            const RealType u = generate_canonical<RealType, 53, URBG>(g);
            if (u < RealType(1) - RealType(0.0331) * x * x * x * x) return d * v * _M_p.beta();
            if (__detail::m_log(u) < RealType(0.5) * x * x + d * (RealType(1) - v + __detail::m_log(v)))
                return d * v * _M_p.beta();
        }
    }

    bool operator==(const gamma_distribution& o) const { return _M_p == o._M_p; }
    bool operator!=(const gamma_distribution& o) const { return !(*this == o); }

private:
    template<class URBG>
    RealType _M_normal(URBG& g) {
        RealType u, v, s;
        do {
            u = generate_canonical<RealType, 53, URBG>(g) * RealType(2) - RealType(1);
            v = generate_canonical<RealType, 53, URBG>(g) * RealType(2) - RealType(1);
            s = u * u + v * v;
        } while (s >= RealType(1) || s == RealType(0));
        return u * __detail::sqrt_nr(RealType(-2) * __detail::m_log(s) / s);
    }

    param_type _M_p;
};

