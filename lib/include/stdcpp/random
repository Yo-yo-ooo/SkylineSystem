    param_type _M_p;
};

//=============================================================
// discrete_distribution
//=============================================================
template<class IntType = int>
class discrete_distribution {
public:
    typedef IntType result_type;
    struct param_type {
        param_type() {}
        template<class InputIt>
        param_type(InputIt first, InputIt last) { _M_init(first, last); }
        param_type(initializer_list<double> il) { _M_init(il.begin(), il.end()); }

        const std::vector<double>& probabilities() const { return _M_p; }

        template<class InputIt>
        void _M_init(InputIt first, InputIt last) {
            _M_p.clear();
            double sum = 0;
            for (; first != last; ++first) {
                const double w = *first;
                _M_p.push_back(w);
                sum += w;
            }
            if (sum <= 0) {
                // 全零权重：退化为均匀分布
                for (size_t i = 0; i < _M_p.size(); ++i) _M_p[i] = 1.0;
                sum = static_cast<double>(_M_p.size());
            }
            if (sum > 0)
                for (size_t i = 0; i < _M_p.size(); ++i) _M_p[i] /= sum;
            _M_cdf.clear();
            double acc = 0;
            for (size_t i = 0; i < _M_p.size(); ++i) {
                acc += _M_p[i];
                _M_cdf.push_back(acc);
            }
        }

        bool operator==(const param_type& o) const {
            if (_M_p.size() != o._M_p.size()) return false;
            for (size_t i = 0; i < _M_p.size(); ++i)
                if (_M_p[i] != o._M_p[i]) return false;
            return true;
        }
        bool operator!=(const param_type& o) const { return !(*this == o); }

        std::vector<double> _M_p;
        std::vector<double> _M_cdf;
    };

    discrete_distribution() { std::initializer_list<double> il = {1.0}; _M_p._M_init(il.begin(), il.end()); }
    template<class InputIt>
    discrete_distribution(InputIt first, InputIt last) : _M_p(first, last) {}
    discrete_distribution(initializer_list<double> il) : _M_p(il) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    result_type min() const { return 0; }
    result_type max() const { return static_cast<result_type>(_M_p._M_p.size() ? _M_p._M_p.size() - 1 : 0); }
    const std::vector<double>& probabilities() const { return _M_p._M_p; }

    template<class URBG>
    result_type operator()(URBG& g) {
        const double u = generate_canonical<double, 53, URBG>(g);
        const std::vector<double>& cdf = _M_p._M_cdf;
        size_t lo = 0, hi = cdf.size();
        while (lo < hi) {
            const size_t mid = lo + (hi - lo) / 2;
            if (u < cdf[mid]) hi = mid;
            else lo = mid + 1;
        }
        if (lo >= cdf.size()) lo = cdf.size() ? cdf.size() - 1 : 0;
        return static_cast<result_type>(lo);
    }

    bool operator==(const discrete_distribution& o) const { return _M_p == o._M_p; }
    bool operator!=(const discrete_distribution& o) const { return !(*this == o); }

private:
    param_type _M_p;
};

//=============================================================
// piecewise_constant_distribution
//=============================================================
template<class RealType = double>
class piecewise_constant_distribution {
public:
    typedef RealType result_type;
    struct param_type {
        param_type() {}
        template<class InputIt1, class InputIt2>
        param_type(InputIt1 fb, InputIt1 fe, InputIt2 wb) {
            _M_init(fb, fe, wb);
        }
        param_type(initializer_list<RealType> bl, initializer_list<RealType> wl) {
            _M_init(bl.begin(), bl.end(), wl.begin());
        }

        template<class InputIt1, class InputIt2>
        void _M_init(InputIt1 fb, InputIt1 fe, InputIt2 wb) {
            _M_b.clear();
            for (; fb != fe; ++fb) _M_b.push_back(*fb);
            _M_w.assign(_M_b.size() > 0 ? _M_b.size() - 1 : 0, RealType(0));
            for (size_t i = 0; i + 1 < _M_b.size(); ++i, ++wb) _M_w[i] = *wb;
            // 归一化为概率密度
            RealType total = 0;
            for (size_t i = 0; i < _M_w.size(); ++i) total += _M_w[i] * (_M_b[i + 1] - _M_b[i]);
            if (total > 0)
                for (size_t i = 0; i < _M_w.size(); ++i) _M_w[i] /= total;
        }

        bool operator==(const param_type& o) const {
            if (_M_b.size() != o._M_b.size()) return false;
            for (size_t i = 0; i < _M_b.size(); ++i) if (_M_b[i] != o._M_b[i]) return false;
            for (size_t i = 0; i < _M_w.size(); ++i) if (_M_w[i] != o._M_w[i]) return false;
            return true;
        }
        bool operator!=(const param_type& o) const { return !(*this == o); }

        std::vector<RealType> _M_b;
        std::vector<RealType> _M_w;
    };

    piecewise_constant_distribution() {}
    template<class InputIt1, class InputIt2>
    piecewise_constant_distribution(InputIt1 fb, InputIt1 fe, InputIt2 wb) : _M_p(fb, fe, wb) {}
    piecewise_constant_distribution(initializer_list<RealType> bl, initializer_list<RealType> wl)
        : _M_p(bl, wl) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    result_type min() const { return _M_p._M_b.empty() ? RealType(0) : _M_p._M_b.front(); }
    result_type max() const { return _M_p._M_b.empty() ? RealType(1) : _M_p._M_b.back(); }
    std::vector<RealType> intervals() const { return _M_p._M_b; }
    std::vector<RealType> densities() const { return _M_p._M_w; }

    template<class URBG>
    result_type operator()(URBG& g) {
        if (_M_p._M_b.size() < 2) return RealType(0);
        const double u = generate_canonical<double, 53, URBG>(g);
        double acc = 0;
        for (size_t i = 0; i + 1 < _M_p._M_b.size(); ++i) {
            const double seg = _M_p._M_w[i] * (_M_p._M_b[i + 1] - _M_p._M_b[i]);
            if (u < acc + seg || i + 2 == _M_p._M_b.size()) {
                const double t = seg > 0 ? (u - acc) / seg : 0.0;
                return static_cast<RealType>(_M_p._M_b[i] + t * (_M_p._M_b[i + 1] - _M_p._M_b[i]));
            }
            acc += seg;
        }
        return _M_p._M_b.back();
    }

    bool operator==(const piecewise_constant_distribution& o) const { return _M_p == o._M_p; }
    bool operator!=(const piecewise_constant_distribution& o) const { return !(*this == o); }

private:
    param_type _M_p;
};

//=============================================================
// piecewise_linear_distribution
//=============================================================
template<class RealType = double>
class piecewise_linear_distribution {
public:
    typedef RealType result_type;
    struct param_type {
        param_type() {}
        template<class InputIt1, class InputIt2>
        param_type(InputIt1 fb, InputIt1 fe, InputIt2 wb) { _M_init(fb, fe, wb); }
        param_type(initializer_list<RealType> bl, initializer_list<RealType> wl) {
            _M_init(bl.begin(), bl.end(), wl.begin());
        }

        template<class InputIt1, class InputIt2>
        void _M_init(InputIt1 fb, InputIt1 fe, InputIt2 wb) {
            _M_b.clear();
            for (; fb != fe; ++fb) _M_b.push_back(*fb);
            _M_w.clear();
            for (size_t i = 0; i < _M_b.size(); ++i, ++wb) _M_w.push_back(*wb);
            // 归一化：梯形面积
            RealType total = 0;
            for (size_t i = 0; i + 1 < _M_b.size(); ++i)
                total += (_M_w[i] + _M_w[i + 1]) * (_M_b[i + 1] - _M_b[i]) / RealType(2);
            if (total > 0)
                for (size_t i = 0; i < _M_w.size(); ++i) _M_w[i] /= total;
        }

        bool operator==(const param_type& o) const {
            if (_M_b.size() != o._M_b.size()) return false;
            for (size_t i = 0; i < _M_b.size(); ++i) if (_M_b[i] != o._M_b[i]) return false;
            for (size_t i = 0; i < _M_w.size(); ++i) if (_M_w[i] != o._M_w[i]) return false;
            return true;
        }
        bool operator!=(const param_type& o) const { return !(*this == o); }

        std::vector<RealType> _M_b;
        std::vector<RealType> _M_w;
    };

    piecewise_linear_distribution() {}
    template<class InputIt1, class InputIt2>
    piecewise_linear_distribution(InputIt1 fb, InputIt1 fe, InputIt2 wb) : _M_p(fb, fe, wb) {}
    piecewise_linear_distribution(initializer_list<RealType> bl, initializer_list<RealType> wl)
        : _M_p(bl, wl) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    result_type min() const { return _M_p._M_b.empty() ? RealType(0) : _M_p._M_b.front(); }
    result_type max() const { return _M_p._M_b.empty() ? RealType(1) : _M_p._M_b.back(); }
    std::vector<RealType> intervals() const { return _M_p._M_b; }
    std::vector<RealType> densities() const { return _M_p._M_w; }

    template<class URBG>
    result_type operator()(URBG& g) {
        if (_M_p._M_b.size() < 2) return RealType(0);
        const double u = generate_canonical<double, 53, URBG>(g);
        double acc = 0;
        for (size_t i = 0; i + 1 < _M_p._M_b.size(); ++i) {
            const double d = _M_p._M_b[i + 1] - _M_p._M_b[i];
            const double area = (_M_p._M_w[i] + _M_p._M_w[i + 1]) * d / 2.0;
            if (u < acc + area || i + 2 == _M_p._M_b.size()) {
                // 在该段内按线性密度反解（面积比例 t 满足二次方程）
                const double w0 = _M_p._M_w[i], w1 = _M_p._M_w[i + 1];
                double t = 0.0;
                if (area > 0) {
                    const double target = (u - acc) / area;     // [0,1) 的段内累积
                    if (w0 == w1) {
                        t = target;
                    } else {
                        const double a = (w1 - w0) / 2.0;
                        const double b = w0;
                        // a t² + b t - target*(a+b) = 0
                        const double c = -target * (a + b);
                        const double disc = b * b - 4 * a * c;
                        t = disc > 0 ? (-b + __detail::sqrt_nr(disc)) / (2 * a) : target;
                        if (t < 0) t = 0;
                        if (t > 1) t = 1;
                    }
                }
                return static_cast<RealType>(_M_p._M_b[i] + t * d);
            }
            acc += area;
        }
        return _M_p._M_b.back();
    }

    bool operator==(const piecewise_linear_distribution& o) const { return _M_p == o._M_p; }
    bool operator!=(const piecewise_linear_distribution& o) const { return !(*this == o); }

private:
    param_type _M_p;
};

//=============================================================
// random_device
//
// 没有真实熵源：把对象地址、调用计数和一个 splitmix 混合起来。
// 仅用于给引擎播种，**不可用于安全用途**。
//=============================================================
class random_device {
public:
    typedef unsigned int result_type;

    explicit random_device(const char* token = nullptr) : _M_s(0) {
        const uintptr_t addr = reinterpret_cast<uintptr_t>(this);
        _M_s = static_cast<uint64_t>(addr) * 0x9E3779B97F4A7C15ULL ^ 0x5DEECE66DULL;
        (void)token;
    }

    result_type operator()() {
        // splitmix64
        _M_s += 0x9E3779B97F4A7C15ULL;
        uint64_t z = _M_s;
        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
        z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
        z = z ^ (z >> 31);
        return static_cast<result_type>(z >> 32);
    }

    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return 0xFFFFFFFFu; }
    double entropy() const { return 0.0; }   // 无可用熵源

private:
    uint64_t _M_s;
};

