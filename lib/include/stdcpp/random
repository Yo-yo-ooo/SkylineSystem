//=============================================================
// generate_canonical
//=============================================================
template<class RealType, size_t bits, class URBG>
RealType generate_canonical(URBG& g) {
    const size_t digits = static_cast<size_t>(__detail::real_digits<RealType>::value);
    const size_t b = (bits < digits) ? bits : digits;

    // r = 引擎取值个数；log2(r) 用位长近似（r 是 2 的幂时精确）
    const unsigned long long r_u = static_cast<unsigned long long>(URBG::max())
                                 - static_cast<unsigned long long>(URBG::min()) + 1ULL;
    size_t log2r = 0;
    { unsigned long long v = r_u; while (v > 1) { v >>= 1; ++log2r; } }
    if (log2r == 0) log2r = 1;

    const size_t k = (b + log2r - 1) / log2r;   // 需要抽取的次数

    // sum_{i=0}^{k-1} (g()-min) * r^i  /  r^k  ∈ [0,1)
    const long double r = static_cast<long double>(r_u);
    long double sum = 0.0L;
    long double factor = 1.0L;
    for (size_t i = 0; i < k; ++i) {
        sum += static_cast<long double>(g() - URBG::min()) * factor;
        factor *= r;
    }
    return static_cast<RealType>(sum / factor);
}

//=============================================================
// 离散均匀分布
//=============================================================
template<class IntType = int>
class uniform_int_distribution {
public:
    typedef IntType result_type;

    struct param_type {
        param_type(IntType a = 0, IntType b = 9) : _M_a(a), _M_b(b) {}
        IntType a() const { return _M_a; }
        IntType b() const { return _M_b; }
        bool operator==(const param_type& o) const { return _M_a == o._M_a && _M_b == o._M_b; }
        bool operator!=(const param_type& o) const { return !(*this == o); }
    private:
        IntType _M_a, _M_b;
    };

    explicit uniform_int_distribution(IntType a = 0, IntType b = 9) : _M_p(a, b) {}
    explicit uniform_int_distribution(const param_type& p) : _M_p(p) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    result_type a() const { return _M_p.a(); }
    result_type b() const { return _M_p.b(); }
    result_type min() const { return _M_p.a(); }
    result_type max() const { return _M_p.b(); }

    template<class URBG>
    result_type operator()(URBG& g) {
        using urange = unsigned long long;
        const urange range = static_cast<urange>(
            static_cast<long long>(_M_p.b()) - static_cast<long long>(_M_p.a()));
        const urange src = static_cast<urange>(URBG::max() - URBG::min());
        if (range == 0) return _M_p.a();

        if (src >= range) {
            // 拒绝采样：避免取模偏差
            const urange limit = src - (src % (range + 1));
            urange v;
            do { v = static_cast<urange>(g() - URBG::min()); } while (v >= limit && limit != 0);
            return static_cast<result_type>(_M_p.a() + static_cast<IntType>(v % (range + 1)));
        }
        // 源范围小于目标范围：拼接
        urange v = 0;
        urange acc = 1;
        while (acc <= range) {
            v = v * (src + 1) + static_cast<urange>(g() - URBG::min());
            acc *= (src + 1);
        }
        return static_cast<result_type>(_M_p.a() + static_cast<IntType>(v % (range + 1)));
    }

    template<class URBG>
    result_type operator()(URBG& g, const param_type& p) {
        uniform_int_distribution tmp(p);
        return tmp(g);
    }

    bool operator==(const uniform_int_distribution& o) const { return _M_p == o._M_p; }
    bool operator!=(const uniform_int_distribution& o) const { return !(*this == o); }

private:
    param_type _M_p;
};

