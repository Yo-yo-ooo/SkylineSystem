// 正态 / 对数正态
//=============================================================
template<class RealType = double>
class normal_distribution {
public:
    typedef RealType result_type;
    struct param_type {
        param_type(RealType m = RealType(0), RealType s = RealType(1)) : _M_mean(m), _M_stddev(s) {}
        RealType mean() const { return _M_mean; }
        RealType stddev() const { return _M_stddev; }
        bool operator==(const param_type& o) const {
            return _M_mean == o._M_mean && _M_stddev == o._M_stddev;
        }
        bool operator!=(const param_type& o) const { return !(*this == o); }
    private:
        RealType _M_mean, _M_stddev;
    };

    explicit normal_distribution(RealType mean = RealType(0), RealType stddev = RealType(1))
        : _M_p(mean, stddev), _M_has(false), _M_saved(0) {}
    explicit normal_distribution(const param_type& p) : _M_p(p), _M_has(false), _M_saved(0) {}

    void reset() { _M_has = false; }
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    result_type mean() const { return _M_p.mean(); }
    result_type stddev() const { return _M_p.stddev(); }
    result_type min() const { return result_type(-1e308); }
    result_type max() const { return result_type(1e308); }

    template<class URBG>
    result_type operator()(URBG& g) {
        // Marsaglia polar method：成对生成，缓存第二个
        if (_M_has) { _M_has = false; return _M_p.mean() + _M_p.stddev() * _M_saved; }
        RealType u, v, s;
        do {
            u = generate_canonical<RealType, 53, URBG>(g) * RealType(2) - RealType(1);
            v = generate_canonical<RealType, 53, URBG>(g) * RealType(2) - RealType(1);
            s = u * u + v * v;
        } while (s >= RealType(1) || s == RealType(0));
        const RealType m = __detail::sqrt_nr(RealType(-2) * __detail::m_log(s) / s);
        _M_saved = v * m;
        _M_has = true;
        return _M_p.mean() + _M_p.stddev() * (u * m);
    }

    bool operator==(const normal_distribution& o) const {
        return _M_p == o._M_p && _M_has == o._M_has &&
               (!_M_has || _M_saved == o._M_saved);
    }
    bool operator!=(const normal_distribution& o) const { return !(*this == o); }

private:
    param_type _M_p;
    bool       _M_has;
    RealType   _M_saved;
};

