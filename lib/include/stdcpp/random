namespace __detail {

// 2^bits - 1（bits 取 1..64，避免 1<<64 的 UB）
constexpr uint64_t mask_bits(unsigned bits) {
    return bits >= 64 ? ~0ULL : ((1ULL << bits) - 1ULL);
}

// 模乘：m 可能接近 2^64，直接乘会溢出
template<class UIntType>
constexpr UIntType mulmod(UIntType a, UIntType b, UIntType m) {
#if defined(__SIZEOF_INT128__)
    if (m == 0) return static_cast<UIntType>(a * b);
    return static_cast<UIntType>((static_cast<unsigned __int128>(a) * b) % m);
#else
    // 无 128 位整数时用「加乘」避免溢出（O(log b) 次加法）
    if (m == 0) return static_cast<UIntType>(a * b);
    UIntType r = 0;
    a %= m;
    b %= m;
    while (b) {
        if (b & 1) { r += a; if (r >= m) r -= m; }
        a += a;
        if (a >= m) a -= m;
        b >>= 1;
    }
    return r;
#endif
}

// 实数尾数位数（给 generate_canonical 用，避免依赖 <limits>）
template<class T> struct real_digits;
template<> struct real_digits<float>       { static constexpr int value = __FLT_MANT_DIG__; };
template<> struct real_digits<double>      { static constexpr int value = __DBL_MANT_DIG__; };
template<> struct real_digits<long double> { static constexpr int value = __LDBL_MANT_DIG__; };

} // namespace __detail

//=============================================================
// seed_seq
//=============================================================
class seed_seq {
public:
    template<class InputIt>
    seed_seq(InputIt begin, InputIt end) {
        for (; begin != end; ++begin) _M_v.push_back(static_cast<uint32_t>(*begin));
    }
    seed_seq(initializer_list<uint32_t> il) {
        for (const uint32_t* p = il.begin(); p != il.end(); ++p) _M_v.push_back(*p);
    }
    template<class RandomAccessIt>
    void generate(RandomAccessIt begin, RandomAccessIt end) const {
        size_t n = static_cast<size_t>(end - begin);
        if (n == 0) return;
        if (_M_v.empty()) {
            // 标准规定的退化情形
            for (size_t k = 0; k < n; ++k) begin[k] = 0x8b8b8b8bu;
            return;
        }
        const size_t s = _M_v.size();

        // 1) 用 0x8b8b8b8b 填充，并混入 seed 序列
        for (size_t k = 0; k < n; ++k) begin[k] = 0x8b8b8b8bu;

        // 2) t = log2(n) 次混合
        size_t t = 0;
        for (size_t v = n; v > 1; v >>= 1) ++t;   // floor(log2(n))

        for (size_t i = 0; i < t; ++i) {
            // 每轮对 [0,n) 做一次 "带进位的循环混合"
            for (size_t k = 0; k < n; ++k) {
                const uint32_t prev = (k == 0) ? begin[n - 1] : begin[k - 1];
                const uint32_t cur = begin[k];
                begin[k] = cur ^ ((prev ^ (prev >> 27)) * 1664525u);
                begin[k] += (k < s) ? _M_v[k] : 0u;
            }
        }
    }

    size_t size() const { return _M_v.size(); }

    template<class OutputIt>
    void param(OutputIt dest) const {
        for (size_t i = 0; i < _M_v.size(); ++i) *dest++ = _M_v[i];
    }

private:
    std::vector<uint32_t> _M_v;
};

//=============================================================
// linear_congruential_engine
//=============================================================
template<class UIntType, UIntType a, UIntType c, UIntType m>
class linear_congruential_engine {
public:
    typedef UIntType result_type;
    static constexpr result_type multiplier = a;
    static constexpr result_type increment = c;
    static constexpr result_type modulus = m;
    static constexpr result_type default_seed = 1u;

    explicit linear_congruential_engine(result_type s = default_seed) { seed(s); }

    void seed(result_type s = default_seed) {
        _M_x = (c % m == 0 && s == 0) ? 1 : (s % m);
    }

    result_type operator()() {
        _M_x = static_cast<result_type>(
            (__detail::mulmod<result_type>(a, _M_x, m) + c % m) % m);
        return _M_x;
    }

    void discard(unsigned long long z) { while (z--) (*this)(); }

    static constexpr result_type min() { return c == 0u ? 1u : 0u; }
    static constexpr result_type max() { return m - 1u; }

    bool operator==(const linear_congruential_engine& y) const { return _M_x == y._M_x; }
    bool operator!=(const linear_congruential_engine& y) const { return !(*this == y); }

private:
    result_type _M_x;
};

//=============================================================
// mersenne_twister_engine
//
// 逐位对照标准（C++ [rand.predef]）：状态转移、tempering 常数顺序都按标准，
// 数组下标回绕用 (i+1)%n。
//=============================================================
template<class UIntType, size_t w, size_t n, size_t m, size_t r,
         UIntType a, size_t u, UIntType d, size_t s, UIntType b,
         size_t t, UIntType c, size_t l, UIntType f>
class mersenne_twister_engine {
public:
    typedef UIntType result_type;
    static constexpr size_t word_size = w;
    static constexpr size_t state_size = n;
    static constexpr size_t shift_size = m;
    static constexpr size_t mask_bits = r;
    static constexpr result_type xor_mask = a;
    static constexpr size_t tempering_u = u;
    static constexpr result_type tempering_d = d;
    static constexpr size_t tempering_s = s;
    static constexpr result_type tempering_b = b;
    static constexpr size_t tempering_t = t;
    static constexpr result_type tempering_c = c;
    static constexpr size_t tempering_l = l;
    static constexpr result_type initialization_multiplier = f;
    static constexpr result_type default_seed = 5489u;

    explicit mersenne_twister_engine(result_type sd = default_seed) { seed(sd); }

    template<class Sseq>
    explicit mersenne_twister_engine(Sseq& q) { seed(q); }

    template<class Sseq>
    void seed(Sseq& q) {
        // 用 seed_seq 直接铺满状态，然后从 index = n 开始（下次调用触发 twist）
        uint32_t buf[n];
        q.generate(buf, buf + n);
        const result_type wmask = static_cast<result_type>(__detail::mask_bits(w));
        for (size_t i = 0; i < n; ++i)
            _M_x[i] = static_cast<result_type>(buf[i]) & wmask;
        _M_i = n;
    }

    void seed(result_type value = default_seed) {
        const result_type wmask = static_cast<result_type>(__detail::mask_bits(w));
        _M_x[0] = value & wmask;
        for (size_t i = 1; i < n; ++i) {
            const result_type prev = _M_x[i - 1];
            _M_x[i] = (f * (prev ^ (prev >> (w - 2))) + static_cast<result_type>(i)) & wmask;
        }
        _M_i = n;
    }

    result_type operator()() {
        if (_M_i >= n) _M_twist();
        result_type y = _M_x[_M_i++];
        y ^= (y >> u) & d;
        y ^= (y << s) & b;
        y ^= (y << t) & c;
        y ^= (y >> l);
        return y & static_cast<result_type>(__detail::mask_bits(w));
    }

    void discard(unsigned long long z) { while (z--) (*this)(); }

    static constexpr result_type min() { return 0; }
    static constexpr result_type max() {
        return static_cast<result_type>(__detail::mask_bits(w));
    }

    bool operator==(const mersenne_twister_engine& y) const {
        if (_M_i != y._M_i) return false;
        for (size_t k = 0; k < n; ++k)
            if (_M_x[k] != y._M_x[k]) return false;
        return true;
    }
    bool operator!=(const mersenne_twister_engine& y) const { return !(*this == y); }

private:
    void _M_twist() {
        const result_type wmask = static_cast<result_type>(__detail::mask_bits(w));
        const result_type lower = static_cast<result_type>(__detail::mask_bits(r));
        const result_type upper = static_cast<result_type>(wmask & ~lower);

        for (size_t i = 0; i < n; ++i) {
            const result_type y = (_M_x[i] & upper) | (_M_x[(i + 1) % n] & lower);
            const result_type y1 = y >> 1;
            const result_type ya = (y & 1u) ? a : static_cast<result_type>(0);
            _M_x[i] = _M_x[(i + m) % n] ^ y1 ^ ya;
        }
        _M_i = 0;
    }

    result_type _M_x[n];
    size_t      _M_i;
};

//=============================================================
// subtract_with_carry_engine
//
// 递推：x[i] = (x[i-s] - x[i-r] - carry) mod 2^w
// 用一个长度为 r 的环形缓冲：位置 i 上的旧值就是 x[i-r]，被覆盖。
//=============================================================
template<class UIntType, size_t w, size_t s, size_t r>
class subtract_with_carry_engine {
public:
    typedef UIntType result_type;
    static constexpr size_t word_size = w;
    static constexpr size_t short_lag = s;
    static constexpr size_t long_lag = r;
    static constexpr result_type default_seed = 19780503u;

    explicit subtract_with_carry_engine(result_type value = default_seed) { seed(value); }

    template<class Sseq>
    explicit subtract_with_carry_engine(Sseq& q) { seed(q); }

    template<class Sseq>
    void seed(Sseq& q) {
        uint32_t buf[r];
        q.generate(buf, buf + r);
        const uint32_t wmask = static_cast<uint32_t>(__detail::mask_bits(w));
        for (size_t i = 0; i < r; ++i) _M_x[i] = static_cast<result_type>(buf[i] & wmask);
        _M_carry = (_M_x[r - 1] == 0) ? 1u : 0u;
        _M_k = 0;
        discard(r);
    }

    void seed(result_type value = default_seed) {
        // 标准做法：用线性同余引擎铺满初始状态，再丢弃 r 个值消除初值相关性
        typedef linear_congruential_engine<uint32_t, 40014u, 0u, 2147483563u> lcg_t;
        lcg_t lcg(value == 0u ? default_seed : value);
        const uint32_t wmask = static_cast<uint32_t>(__detail::mask_bits(w));
        for (size_t i = 0; i < r; ++i) {
            _M_x[i] = static_cast<result_type>(lcg() & wmask);
        }
        _M_carry = (_M_x[r - 1] == 0) ? 1u : 0u;
        _M_k = 0;
        discard(r);                     // 预热
    }

    result_type operator()() {
        const result_type wmask = static_cast<result_type>(__detail::mask_bits(w));
        const size_t i = _M_k;
        const size_t j = (i + r - s) % r;          // i - s (mod r)

        const long long d = static_cast<long long>(_M_x[j])
                          - static_cast<long long>(_M_x[i])
                          - static_cast<long long>(_M_carry);
        _M_carry = (d < 0) ? 1u : 0u;
        _M_x[i] = static_cast<result_type>(static_cast<unsigned long long>(d) & wmask);
        _M_k = (i + 1) % r;
        return _M_x[i];
    }

    void discard(unsigned long long z) { while (z--) (*this)(); }

    static constexpr result_type min() { return 0; }
    static constexpr result_type max() {
        return static_cast<result_type>(__detail::mask_bits(w));
    }

    bool operator==(const subtract_with_carry_engine& y) const {
        if (_M_carry != y._M_carry || _M_k != y._M_k) return false;
        for (size_t k = 0; k < r; ++k)
            if (_M_x[k] != y._M_x[k]) return false;
        return true;
    }
    bool operator!=(const subtract_with_carry_engine& y) const { return !(*this == y); }

private:
    result_type _M_x[r];
    result_type _M_carry;
    size_t      _M_k;
};

//=============================================================
// 适配器：discard_block_engine
//=============================================================
template<class Engine, size_t p, size_t r>
class discard_block_engine {
public:
    typedef typename Engine::result_type result_type;
    static constexpr size_t block_size = p;
    static constexpr size_t used_block = r;

    discard_block_engine() : _M_e(), _M_n(0) {}
    explicit discard_block_engine(const Engine& e) : _M_e(e), _M_n(0) {}
    explicit discard_block_engine(Engine&& e) : _M_e(static_cast<Engine&&>(e)), _M_n(0) {}
    explicit discard_block_engine(result_type s) : _M_e(s), _M_n(0) {}

    void seed(result_type s = Engine::default_seed) { _M_e.seed(s); _M_n = 0; }
    void seed(seed_seq& q) { _M_e.seed(q); _M_n = 0; }

    result_type operator()() {
        if (_M_n >= used_block) {
            _M_e.discard(block_size - used_block);
            _M_n = 0;
        }
        ++_M_n;
        return _M_e();
    }

    void discard(unsigned long long z) { while (z--) (*this)(); }

    const Engine& base() const { return _M_e; }

    static constexpr result_type min() { return Engine::min(); }
    static constexpr result_type max() { return Engine::max(); }

    bool operator==(const discard_block_engine& y) const {
        return _M_n == y._M_n && _M_e == y._M_e;
    }
    bool operator!=(const discard_block_engine& y) const { return !(*this == y); }

private:
    Engine _M_e;
    size_t _M_n;
};

//=============================================================
// 适配器：independent_bits_engine
//=============================================================
template<class Engine, size_t w, class UIntType>
class independent_bits_engine {
public:
    typedef UIntType result_type;

    independent_bits_engine() : _M_e() {}
    explicit independent_bits_engine(const Engine& e) : _M_e(e) {}
    explicit independent_bits_engine(Engine&& e) : _M_e(static_cast<Engine&&>(e)) {}
    explicit independent_bits_engine(result_type s) : _M_e(s) {}

    void seed(result_type s = Engine::default_seed) { _M_e.seed(s); }
    void seed(seed_seq& q) { _M_e.seed(q); }

    result_type operator()() {
        if (w == 0) return 0;
        // 用「拒绝采样」构造 w 位无偏值：凑够 w 位或超过上界就重来
        const result_type range = static_cast<result_type>(
            w >= sizeof(result_type) * 8 ? ~result_type(0) : ((result_type(1) << w) - 1));
        const result_type src_range = static_cast<result_type>(Engine::max() - Engine::min());

        if (w <= 32 && src_range >= range) {
            // 源范围足够大：单次取值后取低位（标准允许的简化实现）
            result_type v;
            do {
                v = static_cast<result_type>(_M_e() - Engine::min());
            } while (v > range);
            return v;
        }

        // 拼接多次取值
        result_type result = 0;
        size_t filled = 0;
        while (filled < w) {
            result_type v = static_cast<result_type>(_M_e() - Engine::min());
            size_t take = (w - filled) < (sizeof(result_type) * 8) ? (w - filled)
                                                                   : sizeof(result_type) * 8;
            const result_type mask = static_cast<result_type>(
                take >= sizeof(result_type) * 8 ? ~result_type(0) : ((result_type(1) << take) - 1));
            result |= static_cast<result_type>((v & mask) << filled);
            filled += take;
        }
        return static_cast<result_type>(result & range);
    }

    void discard(unsigned long long z) { while (z--) (*this)(); }

    const Engine& base() const { return _M_e; }
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() {
        return static_cast<result_type>(
            w >= sizeof(result_type) * 8 ? ~result_type(0) : ((result_type(1) << w) - 1));
    }

    bool operator==(const independent_bits_engine& y) const { return _M_e == y._M_e; }
    bool operator!=(const independent_bits_engine& y) const { return !(*this == y); }

private:
    Engine _M_e;
};

//=============================================================
// 适配器：shuffle_order_engine
//=============================================================
template<class Engine, size_t k>
class shuffle_order_engine {
public:
    typedef typename Engine::result_type result_type;

    shuffle_order_engine() { _M_init(); }
    explicit shuffle_order_engine(const Engine& e) : _M_e(e) { _M_init(); }
    explicit shuffle_order_engine(Engine&& e) : _M_e(static_cast<Engine&&>(e)) { _M_init(); }
    explicit shuffle_order_engine(result_type s) : _M_e(s) { _M_init(); }

    void seed(result_type s = Engine::default_seed) { _M_e.seed(s); _M_init(); }
    void seed(seed_seq& q) { _M_e.seed(q); _M_init(); }

    result_type operator()() {
        const size_t j = static_cast<size_t>(
            _M_e() % static_cast<result_type>(k));
        result_type r = _M_v[j];
        _M_v[j] = (_M_y == 0) ? _M_e() : _M_y;
        _M_y = r;
        return r;
    }

    void discard(unsigned long long z) { while (z--) (*this)(); }

    const Engine& base() const { return _M_e; }
    static constexpr result_type min() { return Engine::min(); }
    static constexpr result_type max() { return Engine::max(); }

    bool operator==(const shuffle_order_engine& y) const {
        if (_M_y != y._M_y || !(_M_e == y._M_e)) return false;
        for (size_t i = 0; i < k; ++i)
            if (_M_v[i] != y._M_v[i]) return false;
        return true;
    }
    bool operator!=(const shuffle_order_engine& y) const { return !(*this == y); }

private:
    void _M_init() {
        for (size_t i = 0; i < k; ++i) _M_v[i] = _M_e();
        _M_y = _M_e();
    }

    Engine     _M_e;
    result_type _M_v[k];
    result_type _M_y;
};

