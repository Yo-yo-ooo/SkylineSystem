    explicit weibull_distribution(RealType a = RealType(1), RealType b = RealType(1)) : _M_p(a, b) {}
    explicit weibull_distribution(const param_type& p) : _M_p(p) {}

    void reset() {}
    param_type param() const { return _M_p; }
    void param(const param_type& p) { _M_p = p; }
    RealType a() const { return _M_p.a(); }
    RealType b() const { return _M_p.b(); }
    result_type min() const { return RealType(0); }
    result_type max() const { return result_type(1e308); }

    template<class URBG>
    result_type operator()(URBG& g) {
        const RealType u = generate_canonical<RealType, 53, URBG>(g);
        return _M_p.b() * static_cast<RealType>(
            __detail::m_exp(__detail::m_log(-__detail::m_log(RealType(1) - u)) / _M_p.a()));
    }

    bool operator==(const weibull_distribution& o) const { return _M_p == o._M_p; }
    bool operator!=(const weibull_distribution& o) const { return !(*this == o); }

private:
    param_type _M_p;
};

