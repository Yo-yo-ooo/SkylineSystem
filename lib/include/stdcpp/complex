inline namespace literals {
inline namespace complex_literals {

// 标准库保留后缀（"i"），GCC 在不认识 std 上下文时会给出 -Wliteral-suffix
#if defined(__GNUC__) && !defined(__clang__)
#  pragma GCC diagnostic push
#  pragma GCC diagnostic ignored "-Wliteral-suffix"
#endif

constexpr complex<double> operator""i(unsigned long long im) {
    return complex<double>(0.0, static_cast<double>(im));
}
constexpr complex<double> operator""i(long double im) {
    return complex<double>(0.0, static_cast<double>(im));
}

#if defined(__GNUC__) && !defined(__clang__)
#  pragma GCC diagnostic pop
#endif

} // namespace complex_literals
} // namespace literals

