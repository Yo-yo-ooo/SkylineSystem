//=============================================================
//  make_tuple / tie / forward_as_tuple
//=============================================================
namespace __ftl_tup
{
    // unwrap reference_wrapper for make_tuple.
    template<class T> struct __unwrap_refwrap { typedef T type; };
    template<class T> struct __unwrap_refwrap<reference_wrapper<T>>
    { typedef T& type; };
}

template<class... Ts>
constexpr tuple<typename __ftl_tup::__unwrap_refwrap<typename decay<Ts>::type>::type...>
make_tuple(Ts&&... ts)
{
    return tuple<typename __ftl_tup::__unwrap_refwrap<typename decay<Ts>::type>::type...>(
        std::forward<Ts>(ts)...);
}

template<class... Ts>
constexpr tuple<Ts&...> tie(Ts&... ts) noexcept
{ return tuple<Ts&...>(ts...); }

template<class... Ts>
constexpr tuple<Ts&&...> forward_as_tuple(Ts&&... ts) noexcept
{ return tuple<Ts&&...>(std::forward<Ts>(ts)...); }

//=============================================================
//  tuple_cat
//=============================================================
namespace __ftl_tup
{
    // Build a type pack from all tuple element types.
    template<class... Ts> struct __type_pack {};

    template<class Pack, class Tuple> struct __concat_pack;
    template<class... Ts, class... Us>
    struct __concat_pack<__type_pack<Ts...>, tuple<Us...>>
    { typedef __type_pack<Ts..., Us...> type; };

    template<class... Tuples>
    struct __all_types;
    template<> struct __all_types<> { typedef __type_pack<> type; };
    template<class T, class... Rest>
    struct __all_types<T, Rest...>
        : __concat_pack<typename __all_types<Rest...>::type,
                        typename remove_reference<T>::type> {};

    template<class Pack> struct __pack_to_tuple;
    template<class... Ts>
    struct __pack_to_tuple<__type_pack<Ts...>> { typedef tuple<Ts...> type; };

    // Recursive expansion: process tuples left to right, accumulating elements.
    template<size_t N> struct __cat_tag {};

    // Base: no tuples remaining, construct Ret from accumulated elements.
    template<size_t N, class Ret, class... Elems>
    constexpr typename enable_if<N == 0, Ret>::type
    __cat_next(__cat_tag<N>, Elems&&... elems)
    { return Ret(std::forward<Elems>(elems)...); }

    // N > 0: expand the first tuple, then recurse.
    template<size_t N, class Ret, size_t... Is, class First, class... Rest>
    constexpr Ret __cat_expand(__cat_tag<N>, __tup_idx<Is...>,
                               First&& first, Rest&&... rest)
    {
        return __cat_next<N-1, Ret>(__cat_tag<N-1>{},
            std::forward<Rest>(rest)...,
            get<Is>(std::forward<First>(first))...);
    }

    // N > 0 dispatch: build index sequence for the first tuple and expand.
    // Constrained with N != 0 to avoid clashing with the base case.
    template<size_t N, class Ret, class First, class... Rest>
    constexpr auto __cat_next(__cat_tag<N>, First&& first, Rest&&... rest)
        -> decltype(__cat_expand<N, Ret>(__cat_tag<N>{},
            __tup_mkidx<tuple_size<typename remove_reference<First>::type>::value>{},
            std::forward<First>(first), std::forward<Rest>(rest)...))
    {
        return __cat_expand<N, Ret>(__cat_tag<N>{},
            __tup_mkidx<tuple_size<typename remove_reference<First>::type>::value>{},
            std::forward<First>(first), std::forward<Rest>(rest)...);
    }
}

template<class... Tuples>
constexpr typename __ftl_tup::__pack_to_tuple<
    typename __ftl_tup::__all_types<Tuples...>::type>::type
tuple_cat(Tuples&&... tuples)
{
    typedef typename __ftl_tup::__pack_to_tuple<
        typename __ftl_tup::__all_types<Tuples...>::type>::type _Ret;
    return __ftl_tup::__cat_next<sizeof...(Tuples), _Ret>(
        __ftl_tup::__cat_tag<sizeof...(Tuples)>{},
        std::forward<Tuples>(tuples)...);
}

