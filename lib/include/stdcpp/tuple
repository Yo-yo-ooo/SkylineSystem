//=============================================================
//  tuple implementation (recursive inheritance)
//=============================================================
namespace __ftl_tup
{
    // C++11-compatible void_t.
    template<class...> struct __void { typedef void type; };

    // Tag for selecting the tuple_elements constructor.
    template<class...> struct __tag {};

    // Check if a type is a specialization of tuple.
    template<class T> struct __is_tuple : false_type {};
    template<class... Ts> struct __is_tuple<tuple<Ts...>> : true_type {};

    // Check if a type is a specialization of pair.
    template<class T> struct __is_pair : false_type {};
    template<class T1, class T2> struct __is_pair<pair<T1, T2>> : true_type {};

    // Check if a type is tuple-like (has tuple_size).
    template<class T, class = void> struct __is_tuple_like : false_type {};
    template<class T> struct __is_tuple_like<T,
        typename __void<typename tuple_size<T>::type>::type> : true_type {};

    // Build a tuple from a callable's return? No -- allocator construction.

    // Helper: Nth element accessor.
    template<size_t I, class T>
    struct __nth;

    template<class Head, class... Tail>
    struct __nth<0, tuple<Head, Tail...>>
    { typedef Head type; };

    template<size_t I, class Head, class... Tail>
    struct __nth<I, tuple<Head, Tail...>>
        : __nth<I-1, tuple<Tail...>> {};
}

template<class... Ts> class tuple;

// tuple_size / tuple_element for tuple.
template<class... Ts>
struct tuple_size<tuple<Ts...>>
    : public integral_constant<size_t, sizeof...(Ts)> {};

template<size_t I, class... Ts>
struct tuple_element<I, tuple<Ts...>>
    : __ftl_tup::__nth<I, tuple<Ts...>> {};

#if STDCPP_UTL_CXX14
template<class... Ts>
struct tuple_size<const tuple<Ts...>>
    : public integral_constant<size_t, sizeof...(Ts)> {};
template<size_t I, class... Ts>
struct tuple_element<I, const tuple<Ts...>>
{ typedef add_const_t<typename tuple_element<I, tuple<Ts...>>::type> type; };
#endif

// ---- recursive tuple -------------------------------------------
template<>
class tuple<>
{
public:
    constexpr tuple() noexcept = default;
#if STDCPP_UTL_CXX14
    constexpr void swap(tuple&) noexcept {}
#else
    void swap(tuple&) noexcept {}
#endif
    constexpr bool operator==(const tuple&) const { return true; }
    constexpr bool operator<(const tuple&) const { return false; }
};

template<class Head, class... Tail>
class tuple<Head, Tail...> : private tuple<Tail...>
{
    using __base = tuple<Tail...>;
    Head _head;

    template<size_t I, class... Us>
    friend constexpr typename enable_if<I == 0,
        typename tuple_element<0, tuple<Us...>>::type&>::type
    get(tuple<Us...>& t) noexcept;
    template<size_t I, class... Us>
    friend constexpr typename enable_if<I == 0,
        const typename tuple_element<0, tuple<Us...>>::type&>::type
    get(const tuple<Us...>& t) noexcept;
    template<size_t I, class... Us>
    friend constexpr typename enable_if<I == 0,
        typename tuple_element<0, tuple<Us...>>::type&&>::type
    get(tuple<Us...>&& t) noexcept;
    template<size_t I, class... Us>
    friend constexpr typename enable_if<I == 0,
        const typename tuple_element<0, tuple<Us...>>::type&&>::type
    get(const tuple<Us...>&& t) noexcept;

    template<size_t I, class... Us>
    friend constexpr typename enable_if<I != 0,
        typename tuple_element<I, tuple<Us...>>::type&>::type
    get(tuple<Us...>& t) noexcept;
    template<size_t I, class... Us>
    friend constexpr typename enable_if<I != 0,
        const typename tuple_element<I, tuple<Us...>>::type&>::type
    get(const tuple<Us...>& t) noexcept;
    template<size_t I, class... Us>
    friend constexpr typename enable_if<I != 0,
        typename tuple_element<I, tuple<Us...>>::type&&>::type
    get(tuple<Us...>&& t) noexcept;
    template<size_t I, class... Us>
    friend constexpr typename enable_if<I != 0,
        const typename tuple_element<I, tuple<Us...>>::type&&>::type
    get(const tuple<Us...>&& t) noexcept;

    // Piecewise constructor for pair needs access.
    template<class, class> friend struct pair;

public:
    // Default constructor.
    template<bool D = is_default_constructible<Head>::value
                    && __ftl_tup::__is_tuple<__base>::value,
        class = void>
    struct __def_ok { typedef void type; };

    constexpr tuple() : __base(), _head() {}

    // Element constructor (direct).
    template<class U, class... Us,
        typename enable_if<sizeof...(Us) == sizeof...(Tail)
            && is_constructible<Head, U&&>::value
            && is_constructible<__base, Us&&...>::value, int>::type = 0>
    constexpr tuple(U&& u, Us&&... us)
        : __base(std::forward<Us>(us)...), _head(std::forward<U>(u)) {}

    // Converting constructor from another tuple.
    template<class... Us,
        typename enable_if<sizeof...(Us) == 1 + sizeof...(Tail)
            && is_constructible<Head, const typename tuple_element<0, tuple<Us...>>::type&>::value, int>::type = 0>
    constexpr tuple(const tuple<Us...>& o)
        : __base(static_cast<const tuple<Us...>&>(o).tail()),
          _head(o.head()) {}

    template<class... Us,
        typename enable_if<sizeof...(Us) == 1 + sizeof...(Tail)
            && is_constructible<Head, typename tuple_element<0, tuple<Us...>>::type&&>::value, int>::type = 0>
    constexpr tuple(tuple<Us...>&& o)
        : __base(std::move(static_cast<tuple<Us...>&>(o)).move_tail()),
          _head(std::move(o.move_head())) {}

    // Converting constructor from pair (only when 2 elements).
    template<class U1, class U2,
        typename enable_if<1 + sizeof...(Tail) == 2
            && is_constructible<Head, const U1&>::value, int>::type = 0>
    constexpr tuple(const pair<U1, U2>& p)
        : __base(p.second), _head(p.first) {}

    template<class U1, class U2,
        typename enable_if<1 + sizeof...(Tail) == 2
            && is_constructible<Head, U1&&>::value, int>::type = 0>
    constexpr tuple(pair<U1, U2>&& p)
        : __base(std::move(p.second)), _head(std::move(p.first)) {}

    // Copy / move.
    constexpr tuple(const tuple&) = default;
    constexpr tuple(tuple&&) = default;

    tuple& operator=(const tuple&) = default;
    tuple& operator=(tuple&&) = default;

    // Converting assignment.
    template<class... Us>
#if STDCPP_UTL_CXX14
    constexpr
#endif
    typename enable_if<sizeof...(Us) == 1 + sizeof...(Tail)
        && is_assignable<Head&, const typename tuple_element<0, tuple<Us...>>::type&>::value, tuple&>::type
    operator=(const tuple<Us...>& o)
    {
        _head = o.head();
        this->tail() = static_cast<const tuple<Us...>&>(o).tail();
        return *this;
    }

    template<class... Us>
#if STDCPP_UTL_CXX14
    constexpr
#endif
    typename enable_if<sizeof...(Us) == 1 + sizeof...(Tail)
        && is_assignable<Head&, typename tuple_element<0, tuple<Us...>>::type&&>::value, tuple&>::type
    operator=(tuple<Us...>&& o)
    {
        _head = std::move(o.move_head());
        this->tail() = std::move(static_cast<tuple<Us...>&>(o)).move_tail();
        return *this;
    }

    // Pair assignment.
    template<class U1, class U2>
#if STDCPP_UTL_CXX14
    constexpr
#endif
    typename enable_if<1 + sizeof...(Tail) == 2
        && is_assignable<Head&, const U1&>::value, tuple&>::type
    operator=(const pair<U1, U2>& p)
    {
        _head = p.first;
        this->tail().head() = p.second;
        return *this;
    }

    template<class U1, class U2>
#if STDCPP_UTL_CXX14
    constexpr
#endif
    typename enable_if<1 + sizeof...(Tail) == 2
        && is_assignable<Head&, U1&&>::value, tuple&>::type
    operator=(pair<U1, U2>&& p)
    {
        _head = std::move(p.first);
        this->tail().head() = std::move(p.second);
        return *this;
    }

    Head& head() noexcept { return _head; }
    const Head& head() const noexcept { return _head; }
    Head&& move_head() noexcept { return std::move(_head); }

    __base& tail() noexcept { return *this; }
    const __base& tail() const noexcept { return *this; }
    __base&& move_tail() noexcept { return std::move(*this); }

    void swap(tuple& o)
#if STDCPP_UTL_CXX17
        noexcept(is_nothrow_swappable<Head>::value
                 && is_nothrow_swappable<__base>::value)
#endif
    {
        using std::swap;
        swap(_head, o._head);
        this->tail().swap(o.tail());
    }
};

// Deduction guides (C++17).
#if STDCPP_UTL_CXX17
template<class... Ts>
tuple(Ts...) -> tuple<Ts...>;
template<class T1, class T2>
tuple(pair<T1, T2>) -> tuple<T1, T2>;
#endif

//=============================================================
//  get<I>(tuple)
//=============================================================
template<size_t I, class... Ts>
constexpr typename enable_if<I == 0,
    typename tuple_element<0, tuple<Ts...>>::type&>::type
get(tuple<Ts...>& t) noexcept
{ return t.head(); }

template<size_t I, class... Ts>
constexpr typename enable_if<I == 0,
    const typename tuple_element<0, tuple<Ts...>>::type&>::type
get(const tuple<Ts...>& t) noexcept
{ return t.head(); }

template<size_t I, class... Ts>
constexpr typename enable_if<I == 0,
    typename tuple_element<0, tuple<Ts...>>::type&&>::type
get(tuple<Ts...>&& t) noexcept
{ return t.move_head(); }

template<size_t I, class... Ts>
constexpr typename enable_if<I == 0,
    const typename tuple_element<0, tuple<Ts...>>::type&&>::type
get(const tuple<Ts...>&& t) noexcept
{ return std::move(t.head()); }

template<size_t I, class... Ts>
constexpr typename enable_if<I != 0,
    typename tuple_element<I, tuple<Ts...>>::type&>::type
get(tuple<Ts...>& t) noexcept
{ return get<I-1>(t.tail()); }

template<size_t I, class... Ts>
constexpr typename enable_if<I != 0,
    const typename tuple_element<I, tuple<Ts...>>::type&>::type
get(const tuple<Ts...>& t) noexcept
{ return get<I-1>(t.tail()); }

template<size_t I, class... Ts>
constexpr typename enable_if<I != 0,
    typename tuple_element<I, tuple<Ts...>>::type&&>::type
get(tuple<Ts...>&& t) noexcept
{ return get<I-1>(t.move_tail()); }

template<size_t I, class... Ts>
constexpr typename enable_if<I != 0,
    const typename tuple_element<I, tuple<Ts...>>::type&&>::type
get(const tuple<Ts...>&& t) noexcept
{ return get<I-1>(std::move(t).tail()); }

// get<T>(tuple) (C++14)
#if STDCPP_UTL_CXX14
namespace __ftl_tup
{
    template<class T, class... Ts> struct __find;
    template<class T, class... Rest>
    struct __find<T, T, Rest...> : integral_constant<size_t, 0> {};
    template<class T, class U, class... Rest>
    struct __find<T, U, Rest...>
        : integral_constant<size_t, 1 + __find<T, Rest...>::value> {};
}

template<class T, class... Ts>
constexpr T& get(tuple<Ts...>& t) noexcept
{ return get<__ftl_tup::__find<T, Ts...>::value>(t); }
template<class T, class... Ts>
constexpr const T& get(const tuple<Ts...>& t) noexcept
{ return get<__ftl_tup::__find<T, Ts...>::value>(t); }
template<class T, class... Ts>
constexpr T&& get(tuple<Ts...>&& t) noexcept
{ return get<__ftl_tup::__find<T, Ts...>::value>(std::move(t)); }
template<class T, class... Ts>
constexpr const T&& get(const tuple<Ts...>&& t) noexcept
{ return get<__ftl_tup::__find<T, Ts...>::value>(std::move(t)); }
