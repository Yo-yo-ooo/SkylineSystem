namespace std
{
#if !STDCPP_UTL_CXX14
// C++11-compatible aliases.
template<size_t... I> using __tup_idx = __ftl_utl::__idx_pack<I...>;
template<size_t N> using __tup_mkidx = typename __ftl_utl::__mk_pack<N>::type;
