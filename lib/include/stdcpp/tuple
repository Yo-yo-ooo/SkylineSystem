namespace std {

//=============================================================
// tuple
//=============================================================
template<class... Types>
class tuple;

template<>
class tuple<> {
public:
    void swap(tuple&) noexcept {}
};

template<class Head, class... Tail>
class tuple<Head, Tail...> {
public:
    Head _M_head;
    tuple<Tail...> _M_tail;

    constexpr tuple() : _M_head(), _M_tail() {}

    constexpr tuple(const Head& h, const Tail&... t)
        : _M_head(h), _M_tail(t...) {}

    template<class UHead, class... UTail,
             class = typename enable_if<sizeof...(UTail) == sizeof...(Tail)>::type>
    constexpr tuple(UHead&& h, UTail&&... t)
        : _M_head(std::forward<UHead>(h)), _M_tail(std::forward<UTail>(t)...) {}

    tuple(const tuple&) = default;
    tuple(tuple&&) = default;

    template<class UHead, class... UTail>
    tuple(const tuple<UHead, UTail...>& other)
        : _M_head(other._M_head), _M_tail(other._M_tail) {}

    template<class UHead, class... UTail>
    tuple(tuple<UHead, UTail...>&& other)
        : _M_head(std::move(other._M_head)), _M_tail(std::move(other._M_tail)) {}

    tuple& operator=(const tuple&) = default;
    tuple& operator=(tuple&&) = default;

    template<class UHead, class... UTail>
    tuple& operator=(const tuple<UHead, UTail...>& other) {
        _M_head = other._M_head;
        _M_tail = other._M_tail;
        return *this;
    }

    void swap(tuple& other) {
        using std::swap;
        swap(_M_head, other._M_head);
        _M_tail.swap(other._M_tail);
    }
};

//=============================================================
// tuple_size / tuple_element
//=============================================================
template<class T> struct tuple_size;
template<class... Types>
struct tuple_size<tuple<Types...> > : integral_constant<size_t, sizeof...(Types)> {};

template<size_t I, class T> struct tuple_element;

template<class Head, class... Tail>
struct tuple_element<0, tuple<Head, Tail...> > { typedef Head type; };

template<size_t I, class Head, class... Tail>
struct tuple_element<I, tuple<Head, Tail...> >
    : tuple_element<I - 1, tuple<Tail...> > {};

#if STDCPP_TPL_CXX14
template<size_t I, class T>
using tuple_element_t = typename tuple_element<I, T>::type;
#endif

//=============================================================
// get
//=============================================================
template<size_t I, class Head, class... Tail>
constexpr Head& get_head(tuple<Head, Tail...>& t) noexcept {
    return t._M_head;
}
template<size_t I, class Head, class... Tail>
constexpr const Head& get_head(const tuple<Head, Tail...>& t) noexcept {
    return t._M_head;
}

template<size_t I, class T>
constexpr typename tuple_element<I, T>::type& get(T& t) noexcept;

template<class Head, class... Tail>
constexpr Head& get_helper(tuple<Head, Tail...>& t, integral_constant<size_t, 0>) noexcept {
    return t._M_head;
}
template<size_t I, class Head, class... Tail>
constexpr typename tuple_element<I, tuple<Head, Tail...> >::type&
get_helper(tuple<Head, Tail...>& t, integral_constant<size_t, I>) noexcept {
    return get_helper(t._M_tail, integral_constant<size_t, I - 1>());
}

template<size_t I, class... Types>
constexpr typename tuple_element<I, tuple<Types...> >::type&
get(tuple<Types...>& t) noexcept {
    return get_helper(t, integral_constant<size_t, I>());
}

template<class Head, class... Tail>
constexpr const Head& get_helper(const tuple<Head, Tail...>& t, integral_constant<size_t, 0>) noexcept {
    return t._M_head;
}
template<size_t I, class Head, class... Tail>
constexpr const typename tuple_element<I, tuple<Head, Tail...> >::type&
get_helper(const tuple<Head, Tail...>& t, integral_constant<size_t, I>) noexcept {
    return get_helper(t._M_tail, integral_constant<size_t, I - 1>());
}

template<size_t I, class... Types>
constexpr const typename tuple_element<I, tuple<Types...> >::type&
get(const tuple<Types...>& t) noexcept {
    return get_helper(t, integral_constant<size_t, I>());
}

//=============================================================
// make_tuple / forward_as_tuple / tie
//=============================================================
template<class... Types>
constexpr tuple<typename decay<Types>::type...> make_tuple(Types&&... args) {
    return tuple<typename decay<Types>::type...>(std::forward<Types>(args)...);
}

template<class... Types>
constexpr tuple<Types&&...> forward_as_tuple(Types&&... args) noexcept {
    return tuple<Types&&...>(std::forward<Types>(args)...);
}

template<class... Types>
constexpr tuple<Types&...> tie(Types&... args) noexcept {
    return tuple<Types&...>(args...);
}

//=============================================================
// tuple_cat
//=============================================================
namespace __tuple_detail {
    template<class... Tuples>
    struct tuple_cat_result;

    template<>
    struct tuple_cat_result<> { typedef tuple<> type; };

    template<class... T1>
    struct tuple_cat_result<tuple<T1...> > { typedef tuple<T1...> type; };

    template<class... T1, class... T2, class... Rest>
    struct tuple_cat_result<tuple<T1...>, tuple<T2...>, Rest...>
        : tuple_cat_result<tuple<T1..., T2...>, Rest...> {};
}

template<class... Tuples>
constexpr tuple<> tuple_cat(Tuples&&...) { return tuple<>(); }

//=============================================================
// comparison operators
//=============================================================
inline constexpr bool operator==(const tuple<>&, const tuple<>&) { return true; }
inline constexpr bool operator<(const tuple<>&, const tuple<>&) { return false; }

template<class... T1, class... T2>
bool operator==(const tuple<T1...>& a, const tuple<T2...>& b) {
    return a._M_head == b._M_head && a._M_tail == b._M_tail;
}
template<class... T1, class... T2>
bool operator!=(const tuple<T1...>& a, const tuple<T2...>& b) { return !(a == b); }
template<class... T1, class... T2>
bool operator<(const tuple<T1...>& a, const tuple<T2...>& b) {
    if (a._M_head < b._M_head) return true;
    if (b._M_head < a._M_head) return false;
    return a._M_tail < b._M_tail;
}

//=============================================================
// swap
//=============================================================
template<class... Types>
void swap(tuple<Types...>& a, tuple<Types...>& b) { a.swap(b); }

//=============================================================
// ignore
//=============================================================
namespace __tuple_detail {
    struct ignore_t {
        template<class T>
        const ignore_t& operator=(const T&) const { return *this; }
    };
}
constexpr __tuple_detail::ignore_t ignore{};

//=============================================================
// apply (C++17)
//=============================================================
#if STDCPP_TPL_CXX17
namespace __tuple_detail {
    template<class F, class Tuple, size_t... I>
    constexpr auto apply_impl(F&& f, Tuple&& t, index_sequence<I...>)
        -> decltype(std::forward<F>(f)(get<I>(std::forward<Tuple>(t))...)) {
        return std::forward<F>(f)(get<I>(std::forward<Tuple>(t))...);
    }
}

template<class F, class Tuple>
constexpr auto apply(F&& f, Tuple&& t)
    -> decltype(__tuple_detail::apply_impl(
        std::forward<F>(f), std::forward<Tuple>(t),
        make_index_sequence<tuple_size<typename decay<Tuple>::type>::value>{})) {
    return __tuple_detail::apply_impl(
        std::forward<F>(f), std::forward<Tuple>(t),
        make_index_sequence<tuple_size<typename decay<Tuple>::type>::value>{});
}
#endif

} // namespace std
#endif // C++11

#endif // STDCPP_TUPLE_HPP
