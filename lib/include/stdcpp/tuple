//=============================================================
//  swap for tuple
//=============================================================
template<class... Ts>
#if STDCPP_UTL_CXX17
constexpr
#endif
void swap(tuple<Ts...>& a, tuple<Ts...>& b)
noexcept(noexcept(a.swap(b)))
{ a.swap(b); }

//=============================================================
//  comparison operators
//=============================================================
namespace __ftl_tup
{
    inline constexpr bool __eq(const tuple<>&, const tuple<>&) { return true; }
    template<class H, class... T>
    bool __eq(const tuple<H, T...>& a, const tuple<H, T...>& b)
    { return a.head() == b.head() && __eq(a.tail(), b.tail()); }

    inline constexpr bool __lt(const tuple<>&, const tuple<>&) { return false; }
    template<class H, class... T>
    bool __lt(const tuple<H, T...>& a, const tuple<H, T...>& b)
    {
        if (a.head() < b.head()) return true;
        if (b.head() < a.head()) return false;
        return __lt(a.tail(), b.tail());
    }
}

template<class... T, class... U>
constexpr bool operator==(const tuple<T...>& a, const tuple<U...>& b)
{
    static_assert(sizeof...(T) == sizeof...(U), "tuple size mismatch");
    return __ftl_tup::__eq(a, b);
}
template<class... T, class... U>
constexpr bool operator!=(const tuple<T...>& a, const tuple<U...>& b)
{ return !(a == b); }
template<class... T, class... U>
constexpr bool operator<(const tuple<T...>& a, const tuple<U...>& b)
{
    static_assert(sizeof...(T) == sizeof...(U), "tuple size mismatch");
    return __ftl_tup::__lt(a, b);
}
template<class... T, class... U>
constexpr bool operator>(const tuple<T...>& a, const tuple<U...>& b)
{ return b < a; }
template<class... T, class... U>
constexpr bool operator<=(const tuple<T...>& a, const tuple<U...>& b)
{ return !(b < a); }
template<class... T, class... U>
constexpr bool operator>=(const tuple<T...>& a, const tuple<U...>& b)
{ return !(a < b); }

//=============================================================
//  apply  (C++17)
//=============================================================
#if STDCPP_UTL_CXX17
namespace __ftl_tup
{
    template<class F, class Tuple, size_t... I>
    constexpr decltype(auto) __apply(F&& f, Tuple&& t, index_sequence<I...>)
    {
        return std::forward<F>(f)(get<I>(std::forward<Tuple>(t))...);
    }
}

template<class F, class Tuple>
constexpr decltype(auto) apply(F&& f, Tuple&& t)
{
    return __ftl_tup::__apply(
        std::forward<F>(f), std::forward<Tuple>(t),
        make_index_sequence<tuple_size<remove_reference_t<Tuple>>::value>{});
}
#endif

//=============================================================
//  make_from_tuple  (C++17)
//=============================================================
#if STDCPP_UTL_CXX17
namespace __ftl_tup
{
    template<class T, class Tuple, size_t... I>
    constexpr T __make_from(Tuple&& t, index_sequence<I...>)
    { return T(get<I>(std::forward<Tuple>(t))...); }
}

template<class T, class Tuple>
constexpr T make_from_tuple(Tuple&& t)
{
    return __ftl_tup::__make_from<T>(
        std::forward<Tuple>(t),
        make_index_sequence<tuple_size<remove_reference_t<Tuple>>::value>{});
}
#endif

//=============================================================
//  pair piecewise constructor (defined here, where tuple is complete)
//=============================================================
template<class T1, class T2>
template<class... Args1, class... Args2>
pair<T1, T2>::pair(piecewise_construct_t,
                   tuple<Args1...> first_args,
                   tuple<Args2...> second_args)
    : pair(typename __ftl_utl::__mk_pack<sizeof...(Args1)>::type(),
           typename __ftl_utl::__mk_pack<sizeof...(Args2)>::type(),
           std::move(first_args), std::move(second_args), 0)
{}

// Define the private piecewise dispatch constructor of pair.
template<class T1, class T2>
template<size_t... I1, size_t... I2, class Tuple1, class Tuple2>
pair<T1, T2>::pair(__ftl_utl::__idx_pack<I1...>, __ftl_utl::__idx_pack<I2...>,
                   Tuple1&& t1, Tuple2&& t2, int)
    : first(get<I1>(std::forward<Tuple1>(t1))...)
    , second(get<I2>(std::forward<Tuple2>(t2))...)
{}

