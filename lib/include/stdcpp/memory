//=============================================================
// auto_ptr (C++98, deprecated C++11, removed C++17)
//=============================================================
#if !STDCPP_MEM_CXX17
template<class T>
class auto_ptr {
    T* _M_ptr;
public:
    typedef T element_type;
    explicit auto_ptr(T* p = nullptr) : _M_ptr(p) {}
    auto_ptr(auto_ptr& other) : _M_ptr(other.release()) {}
    template<class U>
    auto_ptr(auto_ptr<U>& other) : _M_ptr(other.release()) {}
    ~auto_ptr() { delete _M_ptr; }

    auto_ptr& operator=(auto_ptr& other) {
        reset(other.release()); return *this;
    }
    T& operator*() const { return *_M_ptr; }
    T* operator->() const { return _M_ptr; }
    T* get() const { return _M_ptr; }
    T* release() { T* t = _M_ptr; _M_ptr = nullptr; return t; }
    void reset(T* p = nullptr) { if (_M_ptr != p) { delete _M_ptr; _M_ptr = p; } }
};
#endif

//=============================================================
// unique_ptr (C++11)
//=============================================================
#if STDCPP_MEM_CXX11
template<class T>
struct default_delete {
    default_delete() noexcept = default;
    template<class U>
    default_delete(const default_delete<U>&) noexcept {}
    void operator()(T* p) const { delete p; }
};

template<class T>
struct default_delete<T[]> {
    void operator()(T* p) const { delete[] p; }
};

template<class T, class D = default_delete<T> >
class unique_ptr {
    T* _M_ptr;
    D _M_del;
public:
    typedef T  element_type;
    typedef D  deleter_type;
    typedef T* pointer;

    constexpr unique_ptr() noexcept : _M_ptr(nullptr) {}
    constexpr unique_ptr(nullptr_t) noexcept : _M_ptr(nullptr) {}
    explicit unique_ptr(pointer p) noexcept : _M_ptr(p) {}
    unique_ptr(pointer p, const D& d) noexcept : _M_ptr(p), _M_del(d) {}
    unique_ptr(unique_ptr&& u) noexcept : _M_ptr(u._M_ptr), _M_del(std::move(u._M_del)) { u._M_ptr = nullptr; }

    ~unique_ptr() { if (_M_ptr) _M_del(_M_ptr); }

    unique_ptr& operator=(unique_ptr&& u) noexcept {
        reset(u.release());
        _M_del = std::move(u._M_del);
        return *this;
    }
    unique_ptr& operator=(nullptr_t) noexcept { reset(); return *this; }

    T& operator*() const { return *_M_ptr; }
    T* operator->() const noexcept { return _M_ptr; }
    pointer get() const noexcept { return _M_ptr; }
    deleter_type& get_deleter() noexcept { return _M_del; }
    const deleter_type& get_deleter() const noexcept { return _M_del; }
    explicit operator bool() const noexcept { return _M_ptr != nullptr; }

    pointer release() noexcept { pointer t = _M_ptr; _M_ptr = nullptr; return t; }
    void reset(pointer p = pointer()) noexcept {
        pointer old = _M_ptr;
        _M_ptr = p;
        if (old) _M_del(old);
    }
    void swap(unique_ptr& u) noexcept {
        std::swap(_M_ptr, u._M_ptr);
        std::swap(_M_del, u._M_del);
    }

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;
};

// array specialization
template<class T, class D>
class unique_ptr<T[], D> {
    T* _M_ptr;
public:
    typedef T  element_type;
    typedef D  deleter_type;
    typedef T* pointer;

    constexpr unique_ptr() noexcept : _M_ptr(nullptr) {}
    constexpr unique_ptr(nullptr_t) noexcept : _M_ptr(nullptr) {}
    explicit unique_ptr(pointer p) noexcept : _M_ptr(p) {}
    ~unique_ptr() { if (_M_ptr) delete[] _M_ptr; }

    unique_ptr& operator=(nullptr_t) noexcept { reset(); return *this; }

    T& operator[](size_t i) const { return _M_ptr[i]; }
    pointer get() const noexcept { return _M_ptr; }
    explicit operator bool() const noexcept { return _M_ptr != nullptr; }

    pointer release() noexcept { pointer t = _M_ptr; _M_ptr = nullptr; return t; }
    void reset(pointer p = pointer()) noexcept {
        pointer old = _M_ptr;
        _M_ptr = p;
        if (old) delete[] old;
    }
};

template<class T, class... Args>
unique_ptr<T> make_unique(Args&&... args) {
    return unique_ptr<T>(new T(std::forward<Args>(args)...));
}
template<class T>
unique_ptr<T> make_unique(size_t n) {
    return unique_ptr<T>(new typename remove_extent<T>::type[n]());
}

template<class T, class D>
void swap(unique_ptr<T, D>& a, unique_ptr<T, D>& b) noexcept { a.swap(b); }

template<class T1, class D1, class T2, class D2>
bool operator==(const unique_ptr<T1, D1>& a, const unique_ptr<T2, D2>& b) { return a.get() == b.get(); }
template<class T1, class D1, class T2, class D2>
bool operator!=(const unique_ptr<T1, D1>& a, const unique_ptr<T2, D2>& b) { return a.get() != b.get(); }
template<class T, class D>
bool operator==(const unique_ptr<T, D>& a, nullptr_t) { return a.get() == nullptr; }
template<class T, class D>
bool operator!=(const unique_ptr<T, D>& a, nullptr_t) { return a.get() != nullptr; }
#endif

//=============================================================
// shared_ptr / weak_ptr (C++11)
//=============================================================
#if STDCPP_MEM_CXX11
class _sp_counted_base {
    long _M_use;
    long _M_weak;
public:
    _sp_counted_base() : _M_use(1), _M_weak(1) {}
    virtual ~_sp_counted_base() {}
    virtual void _M_dispose() = 0;
    virtual void _M_destroy() { delete this; }

    void _M_add_ref() { __atomic_add_fetch(&_M_use, 1, __ATOMIC_RELAXED); }
    void _M_add_weak() { __atomic_add_fetch(&_M_weak, 1, __ATOMIC_RELAXED); }
    void _M_release() {
        if (__atomic_sub_fetch(&_M_use, 1, __ATOMIC_ACQ_REL) == 0) {
            _M_dispose();
            _M_release_weak();
        }
    }
    void _M_release_weak() {
        if (__atomic_sub_fetch(&_M_weak, 1, __ATOMIC_ACQ_REL) == 0)
            _M_destroy();
    }
    long _M_use_count() const { return __atomic_load_n(&_M_use, __ATOMIC_RELAXED); }
};

template<class T>
class _sp_counted_ptr : public _sp_counted_base {
    T* _M_ptr;
public:
    _sp_counted_ptr(T* p) : _M_ptr(p) {}
    void _M_dispose() override { delete _M_ptr; }
};

template<class T, class D>
class _sp_counted_del : public _sp_counted_base {
    T* _M_ptr;
    D  _M_del;
public:
    _sp_counted_del(T* p, D d) : _M_ptr(p), _M_del(std::move(d)) {}
    void _M_dispose() override { _M_del(_M_ptr); }
};

class _sp_weak_count;

template<class T>
class shared_ptr {
    template<class U> friend class shared_ptr;
    friend class _sp_weak_count;

    T* _M_ptr;
    _sp_counted_base* _M_ref;

    void _M_add_ref() { if (_M_ref) _M_ref->_M_add_ref(); }

public:
    typedef T element_type;

    constexpr shared_ptr() noexcept : _M_ptr(nullptr), _M_ref(nullptr) {}
    constexpr shared_ptr(nullptr_t) noexcept : _M_ptr(nullptr), _M_ref(nullptr) {}

    explicit shared_ptr(T* p) : _M_ptr(p), _M_ref(new _sp_counted_ptr<T>(p)) {}

    template<class D>
    shared_ptr(T* p, D d) : _M_ptr(p), _M_ref(new _sp_counted_del<T, D>(p, std::move(d))) {}

    shared_ptr(const shared_ptr& other) noexcept
        : _M_ptr(other._M_ptr), _M_ref(other._M_ref) { _M_add_ref(); }

    template<class U>
    shared_ptr(const shared_ptr<U>& other) noexcept
        : _M_ptr(other._M_ptr), _M_ref(other._M_ref) { _M_add_ref(); }

    shared_ptr(shared_ptr&& other) noexcept
        : _M_ptr(other._M_ptr), _M_ref(other._M_ref) {
        other._M_ptr = nullptr;
        other._M_ref = nullptr;
    }

    ~shared_ptr() { if (_M_ref) _M_ref->_M_release(); }

    shared_ptr& operator=(const shared_ptr& other) noexcept {
        if (this != &other) {
            if (_M_ref) _M_ref->_M_release();
            _M_ptr = other._M_ptr;
            _M_ref = other._M_ref;
            _M_add_ref();
        }
        return *this;
    }
    shared_ptr& operator=(shared_ptr&& other) noexcept {
        if (this != &other) {
            if (_M_ref) _M_ref->_M_release();
            _M_ptr = other._M_ptr;
            _M_ref = other._M_ref;
            other._M_ptr = nullptr;
            other._M_ref = nullptr;
        }
        return *this;
    }

    void reset() noexcept {
        if (_M_ref) _M_ref->_M_release();
        _M_ptr = nullptr;
        _M_ref = nullptr;
    }
    void reset(T* p) {
        if (_M_ref) _M_ref->_M_release();
        _M_ptr = p;
        _M_ref = new _sp_counted_ptr<T>(p);
    }

    T* get() const noexcept { return _M_ptr; }
    T& operator*() const noexcept { return *_M_ptr; }
    T* operator->() const noexcept { return _M_ptr; }
    long use_count() const noexcept { return _M_ref ? _M_ref->_M_use_count() : 0; }
    explicit operator bool() const noexcept { return _M_ptr != nullptr; }
    void swap(shared_ptr& other) noexcept {
        std::swap(_M_ptr, other._M_ptr);
        std::swap(_M_ref, other._M_ref);
    }
};

template<class T, class... Args>
shared_ptr<T> make_shared(Args&&... args) {
    return shared_ptr<T>(new T(std::forward<Args>(args)...));
}

template<class T, class U>
shared_ptr<T> static_pointer_cast(const shared_ptr<U>& r) noexcept {
    return shared_ptr<T>(static_cast<T*>(r.get()));
}
template<class T, class U>
shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U>& r) noexcept {
    if (auto p = dynamic_cast<T*>(r.get())) return shared_ptr<T>(p);
    return shared_ptr<T>();
}
template<class T, class U>
shared_ptr<T> const_pointer_cast(const shared_ptr<U>& r) noexcept {
    return shared_ptr<T>(const_cast<T*>(r.get()));
}

template<class T>
class weak_ptr {
    T* _M_ptr;
    _sp_counted_base* _M_ref;
public:
    typedef T element_type;

    constexpr weak_ptr() noexcept : _M_ptr(nullptr), _M_ref(nullptr) {}

    weak_ptr(const shared_ptr<T>& s) noexcept
        : _M_ptr(s._M_ptr), _M_ref(s._M_ref) {
        if (_M_ref) _M_ref->_M_add_weak();
    }

    weak_ptr(const weak_ptr& other) noexcept
        : _M_ptr(other._M_ptr), _M_ref(other._M_ref) {
        if (_M_ref) _M_ref->_M_add_weak();
    }

    ~weak_ptr() { if (_M_ref) _M_ref->_M_release_weak(); }

    weak_ptr& operator=(const weak_ptr& other) noexcept {
        if (this != &other) {
            if (_M_ref) _M_ref->_M_release_weak();
            _M_ptr = other._M_ptr;
            _M_ref = other._M_ref;
            if (_M_ref) _M_ref->_M_add_weak();
        }
        return *this;
    }
    weak_ptr& operator=(const shared_ptr<T>& s) noexcept {
        if (_M_ref) _M_ref->_M_release_weak();
        _M_ptr = s._M_ptr;
        _M_ref = s._M_ref;
        if (_M_ref) _M_ref->_M_add_weak();
        return *this;
    }

    long use_count() const noexcept { return _M_ref ? _M_ref->_M_use_count() : 0; }
    bool expired() const noexcept { return use_count() == 0; }

    shared_ptr<T> lock() const noexcept {
        if (expired()) return shared_ptr<T>();
        return shared_ptr<T>(*this);
    }

    void reset() noexcept {
        if (_M_ref) _M_ref->_M_release_weak();
        _M_ptr = nullptr;
        _M_ref = nullptr;
    }
};

template<class T>
class enable_shared_from_this {
    weak_ptr<T> _M_weak;
protected:
    enable_shared_from_this() noexcept {}
    enable_shared_from_this(const enable_shared_from_this&) noexcept {}
    enable_shared_from_this& operator=(const enable_shared_from_this&) noexcept { return *this; }
    ~enable_shared_from_this() {}
public:
    shared_ptr<T> shared_from_this() { return shared_ptr<T>(_M_weak); }
    shared_ptr<const T> shared_from_this() const { return shared_ptr<const T>(_M_weak); }
};
