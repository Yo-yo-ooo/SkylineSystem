//-------------------------------------------------------------
//  allocate_shared  [util.smartptr.shared.create]
//-------------------------------------------------------------
namespace __memory_detail
{
    // Control block that uses an allocator for its own memory.
    template<class T, class Alloc>
    struct __sp_counted_alloc : __sp_counted_base
    {
        using __alloc_traits = allocator_traits<Alloc>;
        using __cb_alloc = typename __alloc_traits::template rebind_alloc<__sp_counted_alloc>;

        alignas(T) unsigned char _M_storage[sizeof(T)];
        [[no_unique_address]] __cb_alloc _M_alloc;

        template<class A, class... Args>
        __sp_counted_alloc(A&& a, Args&&... args)
            : _M_alloc(std::forward<A>(a))
        { ::new((void*)_M_storage) T(std::forward<Args>(args)...); }

        T* _M_obj() STDCPP_MEM_NOEXCEPT { return reinterpret_cast<T*>(&_M_storage); }
        void _M_dispose() STDCPP_MEM_NOEXCEPT override { _M_obj()->~T(); }
        void _M_destroy() STDCPP_MEM_NOEXCEPT override
        {
            __cb_alloc a = _M_alloc;
            this->~__sp_counted_alloc();
            a.deallocate(this, 1);
        }
    };
}

template<class T, class Alloc, class... Args>
inline shared_ptr<T> allocate_shared(const Alloc& alloc, Args&&... args)
{
    using __cb = __memory_detail::__sp_counted_alloc<T, Alloc>;
    using __cb_alloc = typename __memory_detail::__sp_counted_alloc<T, Alloc>::__cb_alloc;
    __cb_alloc a(alloc);
    __cb* mem = a.allocate(1);
    if (!mem) __memory_detail::__throw_bad_alloc();
    __cb* cb = ::new((void*)mem) __cb(alloc, std::forward<Args>(args)...);
    shared_ptr<T> sp(cb, cb->_M_obj(), 0);
    sp._M_enable_shared_from_this(sp.get());
    return sp;
}

#if STDCPP_MEM_CXX20
template<class T, class Alloc>
inline shared_ptr<T> allocate_shared_for_overwrite(const Alloc& alloc)
{
    using __cb = __memory_detail::__sp_counted_alloc<T, Alloc>;
    using __cb_alloc = typename __memory_detail::__sp_counted_alloc<T, Alloc>::__cb_alloc;
    __cb_alloc a(alloc);
    __cb* mem = a.allocate(1);
    if (!mem) __memory_detail::__throw_bad_alloc();
    __cb* cb = ::new((void*)mem) __cb(alloc);
    ::new((void*)cb->_M_obj()) T;
    shared_ptr<T> sp(cb, cb->_M_obj(), 0);
    sp._M_enable_shared_from_this(sp.get());
    return sp;
}
#endif

