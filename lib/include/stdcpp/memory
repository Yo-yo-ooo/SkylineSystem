inline shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U>& r) STDCPP_MEM_NOEXCEPT
{
    if (T* p = dynamic_cast<T*>(r.get()))
        return shared_ptr<T>(r, p);
    return shared_ptr<T>();
