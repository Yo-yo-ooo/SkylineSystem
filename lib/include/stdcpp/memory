//=============================================================
//  pointer_traits  [pointer.traits]
//=============================================================
#if STDCPP_MEM_CXX11
namespace __memory_detail
{
    template<class Ptr, class = void>
    struct __ptr_element { using type = void; };
    template<template<class...> class Ptr, class T, class... Args>
    struct __ptr_element<Ptr<T, Args...>, void> { using type = T; };
    template<class Ptr>
    struct __ptr_element<Ptr, void_t<typename Ptr::element_type>>
    { using type = typename Ptr::element_type; };

    template<class Ptr, class U, class = void>
    struct __ptr_rebind { using type = typename Ptr::template rebind<U>::other; };
    template<template<class...> class Ptr, class T, class... Args, class U>
    struct __ptr_rebind<Ptr<T, Args...>, U, void>
    { using type = Ptr<U, Args...>; };
    template<class Ptr, class U>
    struct __ptr_rebind<Ptr, U, void_t<typename Ptr::template rebind<U>>>
    { using type = typename Ptr::template rebind<U>; };

    template<class Ptr, class = void>
    struct __ptr_diff { using type = ptrdiff_t; };
    template<class Ptr>
    struct __ptr_diff<Ptr, void_t<typename Ptr::difference_type>>
    { using type = typename Ptr::difference_type; };
}

template<class Ptr>
struct pointer_traits
{
    using pointer = Ptr;
    using element_type = typename __memory_detail::__ptr_element<Ptr>::type;
    using difference_type = typename __memory_detail::__ptr_diff<Ptr>::type;

    template<class U>
    using rebind = typename __memory_detail::__ptr_rebind<Ptr, U>::type;

    static pointer pointer_to(
        typename conditional<is_void<element_type>::value,
            char&, typename add_lvalue_reference<element_type>::type>::type r)
    { return Ptr::pointer_to(r); }
};

template<class T>
struct pointer_traits<T*>
{
    using pointer = T*;
    using element_type = T;
    using difference_type = ptrdiff_t;

    template<class U> using rebind = U*;

    static T* pointer_to(T& r) STDCPP_MEM_NOEXCEPT { return &r; }
};
#endif // C++11

