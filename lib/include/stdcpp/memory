template<class T>
struct default_delete
{
    constexpr default_delete() STDCPP_MEM_NOEXCEPT = default;
    template<class U,
        class = typename enable_if<is_convertible<U*, T*>::value>::type>
    default_delete(const default_delete<U>&) STDCPP_MEM_NOEXCEPT {}
    void operator()(T* p) const { delete p; }
};

template<class T>
struct default_delete<T[]>
{
    constexpr default_delete() STDCPP_MEM_NOEXCEPT = default;
    template<class U>
    void operator()(U* p) const { delete[] p; }
