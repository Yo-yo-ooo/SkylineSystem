//-------------------------------------------------------------
//  shared_ptr free functions
//-------------------------------------------------------------
template<class T, class... Args>
inline shared_ptr<T> make_shared(Args&&... args)
{
    using __cb = __memory_detail::__sp_counted_inplace<T>;
    void* mem = std::malloc(sizeof(__cb));
    if (!mem) __memory_detail::__throw_bad_alloc();
    __cb* cb = ::new(mem) __cb(std::forward<Args>(args)...);
    shared_ptr<T> sp(cb, cb->_M_obj(), 0);
    sp._M_enable_shared_from_this(sp.get());
    return sp;
}

#if STDCPP_MEM_CXX20
template<class T>
inline shared_ptr<T> make_shared_for_overwrite()
{
    using __cb = __memory_detail::__sp_counted_inplace<T>;
    void* mem = std::malloc(sizeof(__cb));
    if (!mem) __memory_detail::__throw_bad_alloc();
    __cb* cb = ::new(mem) __cb;
    // Default-initialize (no value-init) for overwrite semantics.
    ::new((void*)cb->_M_obj()) T;
    shared_ptr<T> sp(cb, cb->_M_obj(), 0);
    sp._M_enable_shared_from_this(sp.get());
    return sp;
}
#endif

