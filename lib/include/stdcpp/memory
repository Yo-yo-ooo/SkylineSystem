//-------------------------------------------------------------
//  destroy_at / destroy / destroy_n  (C++17)
//-------------------------------------------------------------
#if STDCPP_MEM_CXX17
template<class T>
inline void destroy_at(T* p) { p->~T(); }

template<class ForwardIt>
inline void destroy(ForwardIt first, ForwardIt last)
{
    for (; first != last; ++first)
        destroy_at(&*first);
}

