namespace __memory_detail
{
    template<class Alloc, class T, class = void>
    struct __alloc_ptr { using type = T*; };
    template<class Alloc, class T>
    struct __alloc_ptr<Alloc, T, void_t<typename Alloc::pointer>>
    { using type = typename Alloc::pointer; };

    template<class Alloc, class = void>
    struct __alloc_cptr { using type = const typename Alloc::value_type*; };
    template<class Alloc>
    struct __alloc_cptr<Alloc, void_t<typename Alloc::const_pointer>>
    { using type = typename Alloc::const_pointer; };

    template<class Alloc, class = void>
    struct __alloc_vptr { using type = void*; };
    template<class Alloc>
    struct __alloc_vptr<Alloc, void_t<typename Alloc::void_pointer>>
    { using type = typename Alloc::void_pointer; };

    template<class Alloc, class = void>
    struct __alloc_cvptr { using type = const void*; };
    template<class Alloc>
    struct __alloc_cvptr<Alloc, void_t<typename Alloc::const_void_pointer>>
    { using type = typename Alloc::const_void_pointer; };

    template<class Alloc, class = void>
    struct __alloc_diff { using type = ptrdiff_t; };
    template<class Alloc>
    struct __alloc_diff<Alloc, void_t<typename Alloc::difference_type>>
    { using type = typename Alloc::difference_type; };

    template<class Alloc, class = void>
    struct __alloc_size { using type = size_t; };
    template<class Alloc>
    struct __alloc_size<Alloc, void_t<typename Alloc::size_type>>
    { using type = typename Alloc::size_type; };

    // Template-specialization rebind: AllocTpl<OldT, Args...> -> AllocTpl<T, Args...>
    template<class Alloc, class T>
    struct __alloc_rebind_tpl { using other = allocator<T>; };
    template<template<class, class...> class AllocTpl, class OldT, class... Args, class T>
    struct __alloc_rebind_tpl<AllocTpl<OldT, Args...>, T>
    { using other = AllocTpl<T, Args...>; };

    // If Alloc has rebind<T>::other, use it; otherwise use template rebind.
    template<class Alloc, class T, class = void>
    struct __alloc_rebind
    { using other = typename __alloc_rebind_tpl<Alloc, T>::other; };
    template<class Alloc, class T>
    struct __alloc_rebind<Alloc, T, void_t<typename Alloc::template rebind<T>::other>>
    { using other = typename Alloc::template rebind<T>::other; };

    template<class Alloc, class = void>
    struct __alloc_propagate_on_container_copy_assignment : false_type {};
    template<class Alloc>
    struct __alloc_propagate_on_container_copy_assignment<
        Alloc, void_t<typename Alloc::propagate_on_container_copy_assignment>>
        : Alloc::propagate_on_container_copy_assignment {};

    template<class Alloc, class = void>
    struct __alloc_propagate_on_container_move_assignment : false_type {};
    template<class Alloc>
    struct __alloc_propagate_on_container_move_assignment<
        Alloc, void_t<typename Alloc::propagate_on_container_move_assignment>>
        : Alloc::propagate_on_container_move_assignment {};

    template<class Alloc, class = void>
    struct __alloc_propagate_on_container_swap : false_type {};
    template<class Alloc>
    struct __alloc_propagate_on_container_swap<
        Alloc, void_t<typename Alloc::propagate_on_container_swap>>
        : Alloc::propagate_on_container_swap {};

    template<class Alloc, class = void>
    struct __alloc_is_always_equal : is_empty<Alloc> {};
    template<class Alloc>
    struct __alloc_is_always_equal<
        Alloc, void_t<typename Alloc::is_always_equal>>
        : Alloc::is_always_equal {};



    template<class Alloc>
    inline size_t __max_size(const Alloc&) STDCPP_MEM_NOEXCEPT
    { return static_cast<size_t>(-1) / sizeof(typename Alloc::value_type); }


}

template<class Alloc>
struct allocator_traits
{
    using allocator_type = Alloc;
    using value_type = typename Alloc::value_type;
    using pointer = typename __memory_detail::__alloc_ptr<Alloc, value_type>::type;
    using const_pointer = typename __memory_detail::__alloc_cptr<Alloc>::type;
    using void_pointer = typename __memory_detail::__alloc_vptr<Alloc>::type;
    using const_void_pointer = typename __memory_detail::__alloc_cvptr<Alloc>::type;
    using difference_type = typename __memory_detail::__alloc_diff<Alloc>::type;
    using size_type = typename __memory_detail::__alloc_size<Alloc>::type;

    template<class T>
    using rebind_alloc = typename __memory_detail::__alloc_rebind<Alloc, T>::other;
    template<class T>
    using rebind_traits = allocator_traits<rebind_alloc<T>>;

    using propagate_on_container_copy_assignment =
        typename __memory_detail::__alloc_propagate_on_container_copy_assignment<Alloc>::type;
    using propagate_on_container_move_assignment =
        typename __memory_detail::__alloc_propagate_on_container_move_assignment<Alloc>::type;
    using propagate_on_container_swap =
        typename __memory_detail::__alloc_propagate_on_container_swap<Alloc>::type;
    using is_always_equal =
        typename __memory_detail::__alloc_is_always_equal<Alloc>::type;

    static pointer allocate(Alloc& a, size_type n)
    { return a.allocate(n); }
    static pointer allocate(Alloc& a, size_type n, const_void_pointer)
    { return a.allocate(n); }
    static void deallocate(Alloc& a, pointer p, size_type n)
    { a.deallocate(p, n); }

    template<class T, class... Args>
    static void construct(Alloc&, T* p, Args&&... args)
    { ::new((void*)p) T(std::forward<Args>(args)...); }

    template<class T>
    static void destroy(Alloc&, T* p) { p->~T(); }

    static size_type max_size(const Alloc& a) STDCPP_MEM_NOEXCEPT
    { return __memory_detail::__max_size(a); }

    static Alloc select_on_container_copy_construction(const Alloc& a)
    { return a; }
};
#endif // C++11

//=============================================================
//  allocator<T>  [default.allocator]
//
//  allocate() uses malloc(); deallocate() uses free().
//=============================================================
template<class T>
class allocator
{
public:
    typedef size_t    size_type;
    typedef ptrdiff_t difference_type;
    typedef T*        pointer;
    typedef const T*  const_pointer;
    typedef T&        reference;
    typedef const T&  const_reference;
    typedef T         value_type;

    template<class U>
    struct rebind { typedef allocator<U> other; };

#if STDCPP_MEM_CXX20
    using is_always_equal = true_type;
#endif

    allocator() STDCPP_MEM_NOEXCEPT {}
    allocator(const allocator&) STDCPP_MEM_NOEXCEPT {}
    template<class U> allocator(const allocator<U>&) STDCPP_MEM_NOEXCEPT {}
    ~allocator() {}

    pointer address(reference x) const STDCPP_MEM_NOEXCEPT { return &x; }
    const_pointer address(const_reference x) const STDCPP_MEM_NOEXCEPT { return &x; }

    pointer allocate(size_type n, const void* /*hint*/ = 0)
    {
        if (n > size_type(-1) / sizeof(T))
            __memory_detail::__throw_bad_alloc();
        void* p = std::malloc(n * sizeof(T));
        if (!p) __memory_detail::__throw_bad_alloc();
        return static_cast<T*>(p);
    }

    void deallocate(pointer p, size_type /*n*/)
    { std::free(p); }

#if STDCPP_MEM_CXX11
    template<class U, class... Args>
    void construct(U* p, Args&&... args)
    { ::new((void*)p) U(std::forward<Args>(args)...); }

    template<class U>
    void destroy(U* p) { p->~U(); }
#else
    void construct(pointer p, const T& val) { ::new((void*)p) T(val); }
    void destroy(pointer p) { p->~T(); }
#endif

    size_type max_size() const STDCPP_MEM_NOEXCEPT
    { return size_type(-1) / sizeof(T); }
};

