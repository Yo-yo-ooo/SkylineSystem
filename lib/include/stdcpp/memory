//=============================================================
// align (C++11)
//=============================================================
inline void* align(size_t alignment, size_t size, void*& ptr, size_t& space) {
    uintptr_t p = (uintptr_t)ptr;
    uintptr_t a = (p + alignment - 1) & ~(alignment - 1);
    size_t diff = a - p;
    if (space < diff + size) return nullptr;
    ptr = (void*)a;
    space -= diff;
    return ptr;
}

