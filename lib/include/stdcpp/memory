//=============================================================
//  unique_ptr  [unique.ptr]
//=============================================================
namespace __memory_detail
{
    template<class T, class D>
    struct __unique_ptr_base
    {
        using pointer = T;
        T _M_ptr;
        constexpr __unique_ptr_base() STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr) {}
        explicit constexpr __unique_ptr_base(T p) STDCPP_MEM_NOEXCEPT : _M_ptr(p) {}
    };
}

template<class T, class D = default_delete<T>>
class unique_ptr
{
public:
    using pointer      = T*;
    using element_type = T;
    using deleter_type = D;

private:
    T* _M_ptr;
    [[no_unique_address]] D _M_del;

    static_assert(!is_rvalue_reference<D>::value,
                  "unique_ptr deleter cannot be rvalue reference");

public:
    constexpr unique_ptr() STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr), _M_del() {}
    constexpr unique_ptr(nullptr_t) STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr), _M_del() {}
    explicit unique_ptr(T* p) STDCPP_MEM_NOEXCEPT : _M_ptr(p), _M_del() {}
    unique_ptr(T* p, const D& d) STDCPP_MEM_NOEXCEPT : _M_ptr(p), _M_del(d) {}
    unique_ptr(T* p, D&& d) STDCPP_MEM_NOEXCEPT : _M_ptr(p), _M_del(std::move(d)) {}

    template<class U,
        class = typename enable_if<is_convertible<U*, T*>::value>::type>
    unique_ptr(U* p, const D& d) STDCPP_MEM_NOEXCEPT : _M_ptr(p), _M_del(d) {}
    template<class U,
        class = typename enable_if<is_convertible<U*, T*>::value>::type>
    unique_ptr(U* p, D&& d) STDCPP_MEM_NOEXCEPT : _M_ptr(p), _M_del(std::move(d)) {}

    unique_ptr(unique_ptr&& u) STDCPP_MEM_NOEXCEPT
        : _M_ptr(u._M_ptr), _M_del(std::move(u._M_del))
    { u._M_ptr = 0; }

    template<class U, class E,
        class = typename enable_if<
            is_convertible<U*, T*>::value &&
            !is_array<U>::value>::type>
    unique_ptr(unique_ptr<U, E>&& u) STDCPP_MEM_NOEXCEPT
        : _M_ptr(u.release()), _M_del(std::move(u.get_deleter())) {}

    ~unique_ptr() { if (_M_ptr) _M_del(_M_ptr); }

    unique_ptr& operator=(unique_ptr&& u) STDCPP_MEM_NOEXCEPT
    {
        if (this != &u) {
            reset(u.release());
            _M_del = std::move(u._M_del);
        }
        return *this;
    }
    template<class U, class E>
    unique_ptr& operator=(unique_ptr<U, E>&& u) STDCPP_MEM_NOEXCEPT
    {
        reset(u.release());
        _M_del = std::move(u.get_deleter());
        return *this;
    }
    unique_ptr& operator=(nullptr_t) STDCPP_MEM_NOEXCEPT { reset(); return *this; }

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    T* release() STDCPP_MEM_NOEXCEPT { T* t = _M_ptr; _M_ptr = 0; return t; }
    void reset(T* p = 0) STDCPP_MEM_NOEXCEPT
    { T* old = _M_ptr; _M_ptr = p; if (old) _M_del(old); }
    void swap(unique_ptr& u) STDCPP_MEM_NOEXCEPT
    {
        T* t = _M_ptr; _M_ptr = u._M_ptr; u._M_ptr = t;
        D d = std::move(_M_del); _M_del = std::move(u._M_del); u._M_del = std::move(d);
    }

    T* get() const STDCPP_MEM_NOEXCEPT { return _M_ptr; }
    D& get_deleter() STDCPP_MEM_NOEXCEPT { return _M_del; }
    const D& get_deleter() const STDCPP_MEM_NOEXCEPT { return _M_del; }
    explicit operator bool() const STDCPP_MEM_NOEXCEPT { return _M_ptr != nullptr; }

    T& operator*() const { return *_M_ptr; }
    T* operator->() const STDCPP_MEM_NOEXCEPT { return _M_ptr; }
};

// unique_ptr<T[]> partial specialization
template<class T, class D>
class unique_ptr<T[], D>
{
public:
    using pointer      = T*;
    using element_type = T;
    using deleter_type = D;

private:
    T* _M_ptr;
    [[no_unique_address]] D _M_del;

public:
    constexpr unique_ptr() STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr), _M_del() {}
    constexpr unique_ptr(nullptr_t) STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr), _M_del() {}
    template<class U,
        class = typename enable_if<is_pointer<U>::value &&
                                   is_convertible<U, T*>::value>::type>
    explicit unique_ptr(U p) STDCPP_MEM_NOEXCEPT : _M_ptr(p), _M_del() {}

    unique_ptr(unique_ptr&& u) STDCPP_MEM_NOEXCEPT
        : _M_ptr(u._M_ptr), _M_del(std::move(u._M_del))
    { u._M_ptr = nullptr; }

    ~unique_ptr() { if (_M_ptr) _M_del(_M_ptr); }

    unique_ptr& operator=(unique_ptr&& u) STDCPP_MEM_NOEXCEPT
    {
        reset(u.release());
        _M_del = std::move(u._M_del);
        return *this;
    }
    unique_ptr& operator=(nullptr_t) STDCPP_MEM_NOEXCEPT { reset(); return *this; }

    unique_ptr(const unique_ptr&) = delete;
    unique_ptr& operator=(const unique_ptr&) = delete;

    T* release() STDCPP_MEM_NOEXCEPT { T* t = _M_ptr; _M_ptr = nullptr; return t; }
    template<class U,
        class = typename enable_if<is_pointer<U>::value &&
                                   is_convertible<U, T*>::value>::type>
    void reset(U p) STDCPP_MEM_NOEXCEPT
    { T* old = _M_ptr; _M_ptr = p; if (old) _M_del(old); }
    void reset(nullptr_t = nullptr) STDCPP_MEM_NOEXCEPT
    { T* old = _M_ptr; _M_ptr = nullptr; if (old) _M_del(old); }
    void swap(unique_ptr& u) STDCPP_MEM_NOEXCEPT
    {
        T* t = _M_ptr; _M_ptr = u._M_ptr; u._M_ptr = t;
        D d = std::move(_M_del); _M_del = std::move(u._M_del); u._M_del = std::move(d);
    }

    T* get() const STDCPP_MEM_NOEXCEPT { return _M_ptr; }
    D& get_deleter() STDCPP_MEM_NOEXCEPT { return _M_del; }
    const D& get_deleter() const STDCPP_MEM_NOEXCEPT { return _M_del; }
    explicit operator bool() const STDCPP_MEM_NOEXCEPT { return _M_ptr != nullptr; }

    T& operator[](size_t i) const { return _M_ptr[i]; }
};

template<class T, class... Args,
    class = typename enable_if<!is_array<T>::value>::type>
inline unique_ptr<T> make_unique(Args&&... args)
{ return unique_ptr<T>(new T(std::forward<Args>(args)...)); }

template<class T,
    class = typename enable_if<is_array<T>::value && extent<T>::value == 0>::type>
inline unique_ptr<T> make_unique(size_t n)
{
    using U = typename remove_extent<T>::type;
    return unique_ptr<T>(new U[n]());
}

template<class T, class... Args,
    class = typename enable_if<is_array<T>::value && extent<T>::value != 0>::type>
void make_unique(Args&&...) = delete;

