//-------------------------------------------------------------
//  Shared pointer control block
//-------------------------------------------------------------
namespace __memory_detail
{
    using __atomic_count = long;

    inline long __atomic_inc(long* p) STDCPP_MEM_NOEXCEPT
    { return __atomic_add_fetch(p, 1, __ATOMIC_SEQ_CST); }
    inline long __atomic_dec(long* p) STDCPP_MEM_NOEXCEPT
    { return __atomic_sub_fetch(p, 1, __ATOMIC_SEQ_CST); }
    inline long __atomic_load(const long* p) STDCPP_MEM_NOEXCEPT
    { return __atomic_load_n(p, __ATOMIC_SEQ_CST); }

    struct __sp_counted_base
    {
        __atomic_count _M_use_count;
        __atomic_count _M_weak_count;

        __sp_counted_base() STDCPP_MEM_NOEXCEPT
            : _M_use_count(1), _M_weak_count(1) {}
        virtual ~__sp_counted_base() STDCPP_MEM_NOEXCEPT = default;

        virtual void _M_dispose() STDCPP_MEM_NOEXCEPT = 0;
        virtual void _M_destroy() STDCPP_MEM_NOEXCEPT { std::free(this); }

        void _M_add_ref() STDCPP_MEM_NOEXCEPT { __atomic_inc(&_M_use_count); }
        void _M_weak_add_ref() STDCPP_MEM_NOEXCEPT { __atomic_inc(&_M_weak_count); }

        void _M_release() STDCPP_MEM_NOEXCEPT
        {
            if (__atomic_dec(&_M_use_count) == 0) {
                _M_dispose();
                _M_weak_release();
            }
        }
        void _M_weak_release() STDCPP_MEM_NOEXCEPT
        {
            if (__atomic_dec(&_M_weak_count) == 0)
                _M_destroy();
        }

        long _M_use_count_load() const noexcept
        { return __atomic_load(&_M_use_count); }
    };

    // Control block for shared_ptr<T>(raw pointer)
    template<class T>
    struct __sp_counted_ptr : __sp_counted_base
    {
        T* _M_ptr;
        explicit __sp_counted_ptr(T* p) STDCPP_MEM_NOEXCEPT : _M_ptr(p) {}
        void _M_dispose() STDCPP_MEM_NOEXCEPT override { delete _M_ptr; }
    };

    // Control block for shared_ptr with custom deleter
    template<class T, class D>
    struct __sp_counted_deleter : __sp_counted_base
    {
        T* _M_ptr;
        D  _M_del;
        __sp_counted_deleter(T* p, D d) STDCPP_MEM_NOEXCEPT
            : _M_ptr(p), _M_del(std::move(d)) {}
        void _M_dispose() STDCPP_MEM_NOEXCEPT override { _M_del(_M_ptr); }
    };

    // Control block + in-place object for make_shared
    template<class T>
    struct __sp_counted_inplace : __sp_counted_base
    {
        alignas(T) unsigned char _M_storage[sizeof(T)];

        T* _M_obj() STDCPP_MEM_NOEXCEPT
        { return reinterpret_cast<T*>(&_M_storage); }

        template<class... Args>
        explicit __sp_counted_inplace(Args&&... args)
        { ::new((void*)_M_storage) T(std::forward<Args>(args)...); }

        void _M_dispose() STDCPP_MEM_NOEXCEPT override { _M_obj()->~T(); }
    };

    // Control block + in-place array for make_shared<T[]>
    template<class T>
    struct __sp_counted_inplace_array : __sp_counted_base
    {
        T* _M_array;
        size_t _M_n;

        template<class... Args>
        __sp_counted_inplace_array(size_t n, Args&&... args) : _M_n(n)
        {
            _M_array = static_cast<T*>(std::malloc(n * sizeof(T)));
            if (!_M_array) __throw_bad_alloc();
            size_t i = 0;
            try {
                for (; i < n; ++i)
                    ::new((void*)(_M_array + i)) T(std::forward<Args>(args)...);
            } catch (...) {
                for (size_t j = 0; j < i; ++j)
                    _M_array[j].~T();
                std::free(_M_array);
                throw;
            }
        }

        void _M_dispose() STDCPP_MEM_NOEXCEPT override
        {
            for (size_t i = 0; i < _M_n; ++i)
                _M_array[i].~T();
        }
        void _M_destroy() STDCPP_MEM_NOEXCEPT override
        {
            std::free(_M_array);
            std::free(this);
        }
    };
} // namespace __memory_detail

