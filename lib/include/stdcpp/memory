//=============================================================
// raw storage
//=============================================================
template<class T>
struct _destroy_one { void operator()(T* p) { p->~T(); } };

template<class InputIt>
void destroy(InputIt first, InputIt last) {
    for (; first != last; ++first) destroy_at(&*first);
}

template<class T>
void destroy_at(T* p) { p->~T(); }

template<class ForwardIt, class Size>
ForwardIt destroy_n(ForwardIt first, Size n) {
    for (Size i = 0; i < n; ++i, ++first) destroy_at(&*first);
    return first;
}

//=============================================================
// uninitialized_*
//=============================================================
template<class InputIt, class ForwardIt>
ForwardIt uninitialized_copy(InputIt first, InputIt last, ForwardIt d_first) {
    typedef typename iterator_traits<ForwardIt>::value_type VT;
    ForwardIt d = d_first;
    try {
        for (; first != last; ++first, ++d)
            ::new ((void*)&*d) VT(*first);
        return d;
    } catch (...) {
        for (; d_first != d; ++d_first) d_first->~VT();
        throw;
    }
}

template<class InputIt, class Size, class ForwardIt>
ForwardIt uninitialized_copy_n(InputIt first, Size n, ForwardIt d_first) {
    typedef typename iterator_traits<ForwardIt>::value_type VT;
    ForwardIt d = d_first;
    try {
        for (Size i = 0; i < n; ++i, ++first, ++d)
            ::new ((void*)&*d) VT(*first);
        return d;
    } catch (...) {
        for (; d_first != d; ++d_first) d_first->~VT();
        throw;
    }
}

template<class ForwardIt, class T>
void uninitialized_fill(ForwardIt first, ForwardIt last, const T& v) {
    typedef typename iterator_traits<ForwardIt>::value_type VT;
    ForwardIt d = first;
    try {
        for (; d != last; ++d) ::new ((void*)&*d) VT(v);
    } catch (...) {
        for (; first != d; ++first) first->~VT();
        throw;
    }
}

template<class ForwardIt, class Size, class T>
ForwardIt uninitialized_fill_n(ForwardIt first, Size n, const T& v) {
    typedef typename iterator_traits<ForwardIt>::value_type VT;
    ForwardIt d = first;
    try {
        for (Size i = 0; i < n; ++i, ++d) ::new ((void*)&*d) VT(v);
        return d;
    } catch (...) {
        for (; first != d; ++first) first->~VT();
        throw;
    }
}

#if STDCPP_MEM_CXX17
template<class ForwardIt, class... Args>
void uninitialized_construct(ForwardIt first, ForwardIt last, Args&&... args) {
    for (; first != last; ++first)
        ::new ((void*)&*first) typename iterator_traits<ForwardIt>::value_type(std::forward<Args>(args)...);
}

template<class ForwardIt, class Size, class... Args>
ForwardIt uninitialized_construct_n(ForwardIt first, Size n, Args&&... args) {
    for (Size i = 0; i < n; ++i, ++first)
        ::new ((void*)&*first) typename iterator_traits<ForwardIt>::value_type(std::forward<Args>(args)...);
    return first;
}
#endif

#if STDCPP_MEM_CXX17
template<class InputIt, class ForwardIt>
ForwardIt uninitialized_move(InputIt first, InputIt last, ForwardIt d_first) {
    typedef typename iterator_traits<ForwardIt>::value_type VT;
    ForwardIt d = d_first;
    try {
        for (; first != last; ++first, ++d)
            ::new ((void*)&*d) VT(std::move(*first));
        return d;
    } catch (...) {
        for (; d_first != d; ++d_first) d_first->~VT();
        throw;
    }
}

template<class InputIt, class Size, class ForwardIt>
pair<InputIt, ForwardIt> uninitialized_move_n(InputIt first, Size n, ForwardIt d_first) {
    typedef typename iterator_traits<ForwardIt>::value_type VT;
    ForwardIt d = d_first;
    Size i = 0;
    try {
        for (; i < n; ++i, ++first, ++d)
            ::new ((void*)&*d) VT(std::move(*first));
        return {first, d};
    } catch (...) {
        for (; d_first != d; ++d_first) d_first->~VT();
        throw;
    }
}
#endif

