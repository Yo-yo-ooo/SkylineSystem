//=============================================================
//  Internal helpers
//=============================================================
namespace __memory_detail
{
    // Throw bad_alloc (out-of-line to avoid code bloat).
    #if STDCPP_MEM_CXX11
    [[noreturn]] void __throw_bad_alloc();
#else
    void __throw_bad_alloc() __attribute__((noreturn));
#endif

    // malloc + bad_alloc on failure.
    inline void* __xmalloc(size_t n)
    {
        void* p = std::malloc(n);
        if (!p) __throw_bad_alloc();
        return p;
    }

    // Type-safe placement construction / destruction.
    template<class T>
    inline void __construct(T* p) { ::new((void*)p) T(); }

    template<class T>
    inline void __destroy(T* p) { p->~T(); }

#if STDCPP_MEM_CXX11
    template<class T, class... Args>
    inline void __construct(T* p, Args&&... args)
    { ::new((void*)p) T(std::forward<Args>(args)...); }

    // Trivial-copy / trivial-init optimization tags.
    template<class T>
    struct __is_trivially_relocatable
        : integral_constant<bool, is_trivially_copyable<T>::value> {};
#endif

} // namespace __memory_detail

