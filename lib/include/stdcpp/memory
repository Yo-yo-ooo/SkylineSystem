    class = typename enable_if<!is_array<T>::value>::type>
inline unique_ptr<T> make_unique_for_overwrite()
{ return unique_ptr<T>(new T); }

template<class T,
    class = typename enable_if<is_array<T>::value && extent<T>::value == 0>::type>
inline unique_ptr<T> make_unique_for_overwrite(size_t n)
{
    using U = typename remove_extent<T>::type;
    return unique_ptr<T>(new U[n]);
}
