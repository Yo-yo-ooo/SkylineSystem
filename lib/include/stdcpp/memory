//=============================================================
//  raw_storage_iterator  (C++98; deprecated C++17; removed C++20)
//=============================================================
#if !STDCPP_MEM_CXX20
template<class OutputIt, class T>
class raw_storage_iterator
{
    OutputIt _M_iter;
public:
    typedef output_iterator_tag iterator_category;
    typedef void                value_type;
    typedef void                difference_type;
    typedef void                pointer;
    typedef void                reference;

    explicit raw_storage_iterator(OutputIt x) : _M_iter(x) {}

    raw_storage_iterator& operator*() { return *this; }
    raw_storage_iterator& operator=(const T& element)
    {
        ::new((void*)&*_M_iter) T(element);
        return *this;
    }
#if STDCPP_MEM_CXX11
    raw_storage_iterator& operator=(T&& element)
    {
        ::new((void*)&*_M_iter) T(std::move(element));
        return *this;
    }
#endif
    raw_storage_iterator& operator++() { ++_M_iter; return *this; }
    raw_storage_iterator operator++(int)
    { raw_storage_iterator t = *this; ++_M_iter; return t; }
};
#endif

//=============================================================
//  get_temporary_buffer / return_temporary_buffer
//  (C++98; deprecated C++17; removed C++20)
//=============================================================
#if !STDCPP_MEM_CXX20
template<class T>
pair<T*, ptrdiff_t> get_temporary_buffer(ptrdiff_t n) STDCPP_MEM_NOEXCEPT
{
    if (n <= 0) return pair<T*, ptrdiff_t>(static_cast<T*>(0), 0);
    // Try progressively smaller sizes.
    while (n > 0) {
        void* p = std::malloc((size_t)n * sizeof(T));
        if (p) return pair<T*, ptrdiff_t>(static_cast<T*>(p), n);
        n /= 2;
    }
    return pair<T*, ptrdiff_t>(static_cast<T*>(0), 0);
}

