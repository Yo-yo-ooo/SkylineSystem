//  weak_ptr (forward declaration)
//-------------------------------------------------------------
template<class T> class weak_ptr;
template<class T> class enable_shared_from_this;
template<class T> class shared_ptr;

//-------------------------------------------------------------
//  shared_ptr  [util.smartptr.shared]
//-------------------------------------------------------------
template<class T>
class shared_ptr
{
public:
    using element_type = T;
    using weak_type = weak_ptr<T>;

    // Constructors
    constexpr shared_ptr() STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr), _M_ref(nullptr) {}
    constexpr shared_ptr(nullptr_t) STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr), _M_ref(nullptr) {}

    template<class Y,
        class = typename enable_if<is_convertible<Y*, T*>::value>::type>
    explicit shared_ptr(Y* p) : _M_ptr(p), _M_ref(nullptr)
    {
        using __cb = __memory_detail::__sp_counted_ptr<Y>;
        void* mem = std::malloc(sizeof(__cb));
        if (!mem) { delete p; __memory_detail::__throw_bad_alloc(); }
        _M_ref = ::new(mem) __cb(p);
        _M_enable_shared_from_this(p);
    }

    template<class Y, class D,
        class = typename enable_if<is_convertible<Y*, T*>::value>::type>
    shared_ptr(Y* p, D d) : _M_ptr(p), _M_ref(nullptr)
    {
        using __cb = __memory_detail::__sp_counted_deleter<Y, D>;
        void* mem = std::malloc(sizeof(__cb));
        if (!mem) { d(p); __memory_detail::__throw_bad_alloc(); }
        _M_ref = ::new(mem) __cb(p, std::move(d));
    }

    template<class D>
    shared_ptr(nullptr_t p, D d) : _M_ptr(nullptr), _M_ref(nullptr)
    {
        using __cb = __memory_detail::__sp_counted_deleter<void, D>;
        void* mem = std::malloc(sizeof(__cb));
        if (!mem) { d(p); __memory_detail::__throw_bad_alloc(); }
        _M_ref = ::new(mem) __cb(p, std::move(d));
    }

    shared_ptr(const shared_ptr& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { if (_M_ref) _M_ref->_M_add_ref(); }

    template<class Y,
        class = typename enable_if<is_convertible<Y*, T*>::value>::type>
    shared_ptr(const shared_ptr<Y>& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { if (_M_ref) _M_ref->_M_add_ref(); }

    shared_ptr(shared_ptr&& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { r._M_ptr = 0; r._M_ref = nullptr; }

    template<class Y,
        class = typename enable_if<is_convertible<Y*, T*>::value>::type>
    shared_ptr(shared_ptr<Y>&& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { r._M_ptr = 0; r._M_ref = nullptr; }

    // Aliasing constructor: no convertibility between Y* and T* required.
    template<class Y>
    shared_ptr(const shared_ptr<Y>& r, T* p) STDCPP_MEM_NOEXCEPT
        : _M_ptr(p), _M_ref(r._M_ref)
    { if (_M_ref) _M_ref->_M_add_ref(); }

    template<class Y>
    shared_ptr(shared_ptr<Y>&& r, T* p) STDCPP_MEM_NOEXCEPT
        : _M_ptr(p), _M_ref(r._M_ref)
    { r._M_ptr = 0; r._M_ref = nullptr; }

    // Construct from weak_ptr
    template<class Y,
        class = typename enable_if<is_convertible<Y*, T*>::value>::type>
    shared_ptr(const weak_ptr<Y>& r) : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    {
        if (!_M_ref || __memory_detail::__atomic_load(&_M_ref->_M_use_count) == 0)
            throw bad_weak_ptr();
        _M_ref->_M_add_ref();
    }

    ~shared_ptr() { if (_M_ref) _M_ref->_M_release(); }

    // Assignment
    shared_ptr& operator=(const shared_ptr& r) STDCPP_MEM_NOEXCEPT
    {
        if (this != &r) {
            if (_M_ref) _M_ref->_M_release();
            _M_ptr = r._M_ptr;
            _M_ref = r._M_ref;
            if (_M_ref) _M_ref->_M_add_ref();
        }
        return *this;
    }
    template<class Y>
    shared_ptr& operator=(const shared_ptr<Y>& r) STDCPP_MEM_NOEXCEPT
    {
        if (_M_ref) _M_ref->_M_release();
        _M_ptr = r._M_ptr;
        _M_ref = r._M_ref;
        if (_M_ref) _M_ref->_M_add_ref();
        return *this;
    }
    shared_ptr& operator=(shared_ptr&& r) STDCPP_MEM_NOEXCEPT
    {
        if (this != &r) {
            if (_M_ref) _M_ref->_M_release();
            _M_ptr = r._M_ptr;
            _M_ref = r._M_ref;
            r._M_ptr = 0;
            r._M_ref = nullptr;
        }
        return *this;
    }
    template<class Y>
    shared_ptr& operator=(shared_ptr<Y>&& r) STDCPP_MEM_NOEXCEPT
    {
        if (_M_ref) _M_ref->_M_release();
        _M_ptr = r._M_ptr;
        _M_ref = r._M_ref;
        r._M_ptr = 0;
        r._M_ref = nullptr;
        return *this;
    }

    // Modifiers
    void reset() STDCPP_MEM_NOEXCEPT
    { if (_M_ref) _M_ref->_M_release(); _M_ptr = 0; _M_ref = nullptr; }

    template<class Y>
    void reset(Y* p)
    {
        if (_M_ref) _M_ref->_M_release();
        using __cb = __memory_detail::__sp_counted_ptr<Y>;
        void* mem = std::malloc(sizeof(__cb));
        if (!mem) { delete p; __memory_detail::__throw_bad_alloc(); }
        _M_ptr = p;
        _M_ref = ::new(mem) __cb(p);
        _M_enable_shared_from_this(p);
    }

    template<class Y, class D>
    void reset(Y* p, D d)
    {
        if (_M_ref) _M_ref->_M_release();
        using __cb = __memory_detail::__sp_counted_deleter<Y, D>;
        void* mem = std::malloc(sizeof(__cb));
        if (!mem) { d(p); __memory_detail::__throw_bad_alloc(); }
        _M_ptr = p;
        _M_ref = ::new(mem) __cb(p, std::move(d));
    }

    void swap(shared_ptr& r) STDCPP_MEM_NOEXCEPT
    {
        T* tmp = _M_ptr; _M_ptr = r._M_ptr; r._M_ptr = tmp;
        __memory_detail::__sp_counted_base* t = _M_ref;
        _M_ref = r._M_ref; r._M_ref = t;
    }

    // Observers
    T* get() const STDCPP_MEM_NOEXCEPT { return _M_ptr; }
    T& operator*() const STDCPP_MEM_NOEXCEPT { return *_M_ptr; }
    T* operator->() const STDCPP_MEM_NOEXCEPT { return _M_ptr; }
    long use_count() const noexcept
    { return _M_ref ? _M_ref->_M_use_count_load() : 0; }
    bool unique() const STDCPP_MEM_NOEXCEPT { return use_count() == 1; }
    explicit operator bool() const STDCPP_MEM_NOEXCEPT { return _M_ptr != nullptr; }

    // Casts (internal)
    template<class U>
    bool owner_before(const shared_ptr<U>& r) const noexcept
    { return _M_ref < r._M_ref; }
    template<class U>
    bool owner_before(const weak_ptr<U>& r) const noexcept
    { return _M_ref < r._M_ref; }

private:
    T* _M_ptr;
    __memory_detail::__sp_counted_base* _M_ref;

    template<class U> friend class shared_ptr;
    template<class U> friend class weak_ptr;
    template<class U> friend class enable_shared_from_this;

    // make_shared / allocate_shared support
    template<class U, class... Args>
    friend shared_ptr<U> make_shared(Args&&...);
    template<class U, size_t N>
    friend shared_ptr<U> make_shared();
    template<class T2, class Alloc, class... Args>
    friend shared_ptr<T2> allocate_shared(const Alloc&, Args&&...);

    explicit shared_ptr(__memory_detail::__sp_counted_inplace<T>* cb)
        : _M_ptr(cb->_M_obj()), _M_ref(cb) {}

    // Direct control-block constructor (for weak_ptr::lock)
    shared_ptr(__memory_detail::__sp_counted_base* cb, T* p) STDCPP_MEM_NOEXCEPT
        : _M_ptr(p), _M_ref(cb) {}

    // Constructor from control block + pointer (for allocate_shared)
    shared_ptr(__memory_detail::__sp_counted_base* cb, T* p, int) STDCPP_MEM_NOEXCEPT
        : _M_ptr(p), _M_ref(cb) {}

    // enable_shared_from_this support
    template<class Y>
    void _M_enable_shared_from_this(Y* p)
    {
        _M_enable_esft(p, is_convertible<Y*, const enable_shared_from_this<Y>*>{});
    }

    template<class Y>
    void _M_enable_esft(Y* p, true_type)
    {
        if (p) {
            using esft = enable_shared_from_this<Y>;
            esft* ep = const_cast<esft*>(static_cast<const esft*>(p));
#if STDCPP_MEM_CXX17
            if (!ep->weak_from_this().expired()) return;
#endif
            ep->_M_weak_this = shared_ptr<Y>(*this, p);
        }
    }
    template<class Y>
    void _M_enable_esft(Y*, false_type) {}
};

//-------------------------------------------------------------
//  weak_ptr  [util.smartptr.weak]
//-------------------------------------------------------------
template<class T>
class weak_ptr
{
public:
    using element_type = T;

    constexpr weak_ptr() STDCPP_MEM_NOEXCEPT : _M_ptr(nullptr), _M_ref(nullptr) {}

    template<class Y,
        class = typename enable_if<is_convertible<Y*, T*>::value>::type>
    weak_ptr(const shared_ptr<Y>& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { if (_M_ref) _M_ref->_M_weak_add_ref(); }

    weak_ptr(const weak_ptr& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { if (_M_ref) _M_ref->_M_weak_add_ref(); }

    template<class Y,
        class = typename enable_if<is_convertible<Y*, T*>::value>::type>
    weak_ptr(const weak_ptr<Y>& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { if (_M_ref) _M_ref->_M_weak_add_ref(); }

    weak_ptr(weak_ptr&& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { r._M_ptr = 0; r._M_ref = nullptr; }

    template<class Y>
    weak_ptr(weak_ptr<Y>&& r) STDCPP_MEM_NOEXCEPT
        : _M_ptr(r._M_ptr), _M_ref(r._M_ref)
    { r._M_ptr = 0; r._M_ref = nullptr; }

    ~weak_ptr() { if (_M_ref) _M_ref->_M_weak_release(); }

    weak_ptr& operator=(const weak_ptr& r) STDCPP_MEM_NOEXCEPT
    {
        if (this != &r) {
            if (r._M_ref) r._M_ref->_M_weak_add_ref();
            if (_M_ref) _M_ref->_M_weak_release();
            _M_ptr = r._M_ptr;
            _M_ref = r._M_ref;
        }
        return *this;
    }
    template<class Y>
    weak_ptr& operator=(const weak_ptr<Y>& r) STDCPP_MEM_NOEXCEPT
    {
        if (r._M_ref) r._M_ref->_M_weak_add_ref();
        if (_M_ref) _M_ref->_M_weak_release();
        _M_ptr = r._M_ptr;
        _M_ref = r._M_ref;
        return *this;
    }
    template<class Y>
    weak_ptr& operator=(const shared_ptr<Y>& r) STDCPP_MEM_NOEXCEPT
    {
        if (r._M_ref) r._M_ref->_M_weak_add_ref();
        if (_M_ref) _M_ref->_M_weak_release();
        _M_ptr = r._M_ptr;
        _M_ref = r._M_ref;
        return *this;
    }
    weak_ptr& operator=(weak_ptr&& r) STDCPP_MEM_NOEXCEPT
    {
        if (this != &r) {
            if (_M_ref) _M_ref->_M_weak_release();
            _M_ptr = r._M_ptr; _M_ref = r._M_ref;
            r._M_ptr = 0; r._M_ref = nullptr;
        }
        return *this;
    }
    template<class Y>
    weak_ptr& operator=(weak_ptr<Y>&& r) STDCPP_MEM_NOEXCEPT
    {
        if (_M_ref) _M_ref->_M_weak_release();
        _M_ptr = r._M_ptr; _M_ref = r._M_ref;
        r._M_ptr = 0; r._M_ref = nullptr;
        return *this;
    }

    void reset() STDCPP_MEM_NOEXCEPT
    { if (_M_ref) _M_ref->_M_weak_release(); _M_ptr = 0; _M_ref = nullptr; }

    void swap(weak_ptr& r) STDCPP_MEM_NOEXCEPT
    {
        T* t = _M_ptr; _M_ptr = r._M_ptr; r._M_ptr = t;
        __memory_detail::__sp_counted_base* c = _M_ref;
        _M_ref = r._M_ref; r._M_ref = c;
    }

    long use_count() const noexcept
    { return _M_ref ? _M_ref->_M_use_count_load() : 0; }
    bool expired() const STDCPP_MEM_NOEXCEPT { return use_count() == 0; }

    shared_ptr<T> lock() const noexcept
    {
        if (!_M_ref) return shared_ptr<T>();
        // Try to increment use_count atomically.
        long old = __memory_detail::__atomic_load(&_M_ref->_M_use_count);
        while (old != 0) {
            if (__atomic_compare_exchange_n(&_M_ref->_M_use_count, &old, old + 1,
                    false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST))
                return shared_ptr<T>(_M_ref, _M_ptr);
        }
        return shared_ptr<T>();
    }

    template<class U>
    bool owner_before(const shared_ptr<U>& r) const noexcept
    { return _M_ref < r._M_ref; }
    template<class U>
    bool owner_before(const weak_ptr<U>& r) const noexcept
    { return _M_ref < r._M_ref; }

private:
    T* _M_ptr;
    __memory_detail::__sp_counted_base* _M_ref;

    template<class U> friend class shared_ptr;
    template<class U> friend class weak_ptr;
};

