// Forward declarations
template<class Key, class T, class Hash, class KeyEqual, class Allocator>
class unordered_multimap;

template<class Key, class T, class Hash = hash<Key>,
         class KeyEqual = equal_to<Key>, class Allocator = void>
class unordered_map {
public:
    typedef Key key_type;
    typedef T mapped_type;
    typedef pair<const Key, T> value_type;
    typedef Hash hasher;
    typedef KeyEqual key_equal;
    typedef size_t size_type;

    typedef _hash_table<Key, value_type, Hash, KeyEqual, Allocator, false,
                        __hash_detail::_select1st<value_type> > _table_type;
    typedef typename _table_type::iterator iterator;
    typedef typename _table_type::const_iterator const_iterator;

private:
    _table_type _M_table;

public:
    unordered_map() : _M_table() {}
    explicit unordered_map(size_type n, const hasher& hf = hasher(),
                           const key_equal& eql = key_equal())
        : _M_table(n, hf, eql) {}
    template<class InputIt>
    unordered_map(InputIt first, InputIt last, size_type n = 0,
                  const hasher& hf = hasher(), const key_equal& eql = key_equal())
        : _M_table(n, hf, eql) {
        for (; first != last; ++first) _M_table.insert_unique(*first);
    }
    unordered_map(const unordered_map& other) : _M_table(other._M_table) {}
    unordered_map(initializer_list<value_type> il) : _M_table() {
        for (const value_type& v : il) _M_table.insert_unique(v);
    }

    unordered_map& operator=(const unordered_map& other) { _M_table = other._M_table; return *this; }
    unordered_map& operator=(initializer_list<value_type> il) {
        _M_table.clear();
        for (const value_type& v : il) _M_table.insert_unique(v);
        return *this;
    }

    iterator begin() { return _M_table.begin(); }
    const_iterator begin() const { return _M_table.begin(); }
    const_iterator cbegin() const { return _M_table.cbegin(); }
    iterator end() { return _M_table.end(); }
    const_iterator end() const { return _M_table.end(); }
    const_iterator cend() const { return _M_table.cend(); }

    bool empty() const { return _M_table.empty(); }
    size_type size() const { return _M_table.size(); }
    size_type max_size() const { return _M_table.max_size(); }
    size_type bucket_count() const { return _M_table.bucket_count(); }

    void clear() { _M_table.clear(); }

    pair<iterator, bool> insert(const value_type& v) { return _M_table.insert_unique(v); }
    template<class... Args>
    pair<iterator, bool> emplace(Args&&... args) {
        return _M_table.emplace_unique(std::forward<Args>(args)...);
    }
    void insert(initializer_list<value_type> il) {
        for (const value_type& v : il) _M_table.insert_unique(v);
    }

    iterator erase(const_iterator pos) { return _M_table.erase(pos); }
    size_type erase(const key_type& k) { return _M_table.erase(k); }

    T& operator[](const key_type& k) {
        auto p = _M_table.insert_unique(value_type(k, T()));
        return p.first->second;
    }
    T& at(const key_type& k) {
        iterator it = find(k);
        if (it == end()) throw out_of_range("unordered_map::at");
        return it->second;
    }
    const T& at(const key_type& k) const {
        const_iterator it = find(k);
        if (it == end()) throw out_of_range("unordered_map::at");
        return it->second;
    }

    iterator find(const key_type& k) { return _M_table.find(k); }
    const_iterator find(const key_type& k) const { return _M_table.find(k); }
    size_type count(const key_type& k) const { return _M_table.count(k); }
    pair<iterator, iterator> equal_range(const key_type& k) { return _M_table.equal_range(k); }

    void rehash(size_type n) { _M_table.rehash(n); }
    void reserve(size_type n) { _M_table.reserve(n); }
    hasher hash_function() const { return _M_table.hash_function(); }
    key_equal key_eq() const { return _M_table.key_eq(); }
    float load_factor() const { return _M_table.load_factor(); }
    float max_load_factor() const { return _M_table.max_load_factor(); }
    void max_load_factor(float z) { _M_table.max_load_factor(z); }
    size_type bucket(const key_type& k) const { return _M_table.bucket(k); }
    size_type bucket_size(size_type n) const { return _M_table.bucket_size(n); }
    size_type max_bucket_count() const { return _M_table.max_bucket_count(); }
    void swap(unordered_map& other) { _M_table.swap(other._M_table); }

#if STDCPP_UM_CXX17
    template<class H2, class E2>
    void merge(unordered_map<Key, T, H2, E2, Allocator>& source) {
        for (auto it = source.begin(); it != source.end(); ) {
            auto next = it; ++next;
            auto r = insert(*it);
            if (r.second) source.erase(it);
            it = next;
        }
    }
    template<class H2, class E2>
    void merge(unordered_multimap<Key, T, H2, E2, Allocator>& source) {
        for (auto it = source.begin(); it != source.end(); ) {
            auto next = it; ++next;
            auto r = insert(*it);
            if (r.second) source.erase(it);
            it = next;
        }
    }
#endif

#if STDCPP_UM_CXX20
    bool contains(const key_type& k) const { return find(k) != end(); }
#endif
};

template<class K, class T, class H, class E, class A>
bool operator==(const unordered_map<K, T, H, E, A>& a, const unordered_map<K, T, H, E, A>& b) {
    if (a.size() != b.size()) return false;
    for (auto it = a.begin(); it != a.end(); ++it) {
        auto f = b.find(it->first);
        if (f == b.end() || f->second != it->second) return false;
    }
    return true;
}
template<class K, class T, class H, class E, class A>
bool operator!=(const unordered_map<K, T, H, E, A>& a, const unordered_map<K, T, H, E, A>& b) { return !(a == b); }
template<class K, class T, class H, class E, class A>
void swap(unordered_map<K, T, H, E, A>& a, unordered_map<K, T, H, E, A>& b) { a.swap(b); }

