template<class Key, class T, class Hash = hash<Key>,
         class KeyEqual = equal_to<Key>, class Allocator = void>
class unordered_multimap {
public:
    typedef Key key_type;
    typedef T mapped_type;
    typedef pair<const Key, T> value_type;
    typedef Hash hasher;
    typedef KeyEqual key_equal;
    typedef size_t size_type;

    typedef _hash_table<Key, value_type, Hash, KeyEqual, Allocator, true,
                        __hash_detail::_select1st<value_type> > _table_type;
    typedef typename _table_type::iterator iterator;
    typedef typename _table_type::const_iterator const_iterator;

private:
    _table_type _M_table;

public:
    unordered_multimap() : _M_table() {}
    explicit unordered_multimap(size_type n, const hasher& hf = hasher(),
                                const key_equal& eql = key_equal())
        : _M_table(n, hf, eql) {}
    unordered_multimap(const unordered_multimap& other) : _M_table(other._M_table) {}
    unordered_multimap(initializer_list<value_type> il) : _M_table() {
        for (const value_type& v : il) _M_table.insert_equal(v);
    }

    iterator begin() { return _M_table.begin(); }
    const_iterator begin() const { return _M_table.begin(); }
    iterator end() { return _M_table.end(); }
    const_iterator end() const { return _M_table.end(); }
    bool empty() const { return _M_table.empty(); }
    size_type size() const { return _M_table.size(); }
    size_type max_size() const { return _M_table.max_size(); }
    size_type bucket_count() const { return _M_table.bucket_count(); }
    void clear() { _M_table.clear(); }

    iterator insert(const value_type& v) { return _M_table.insert_equal(v); }
    template<class... Args>
    iterator emplace(Args&&... args) { return _M_table.emplace_equal(std::forward<Args>(args)...); }

    iterator erase(const_iterator pos) { return _M_table.erase(pos); }
    size_type erase(const key_type& k) { return _M_table.erase(k); }

    iterator find(const key_type& k) { return _M_table.find(k); }
    const_iterator find(const key_type& k) const { return _M_table.find(k); }
    size_type count(const key_type& k) const { return _M_table.count(k); }

    float load_factor() const { return _M_table.load_factor(); }
    float max_load_factor() const { return _M_table.max_load_factor(); }
    void max_load_factor(float z) { _M_table.max_load_factor(z); }
    size_type bucket(const key_type& k) const { return _M_table.bucket(k); }
    size_type bucket_size(size_type n) const { return _M_table.bucket_size(n); }
    size_type max_bucket_count() const { return _M_table.max_bucket_count(); }
    void rehash(size_type n) { _M_table.rehash(n); }
    void reserve(size_type n) { _M_table.reserve(n); }
    hasher hash_function() const { return _M_table.hash_function(); }
    key_equal key_eq() const { return _M_table.key_eq(); }
    void swap(unordered_multimap& other) { _M_table.swap(other._M_table); }

#if STDCPP_UM_CXX20
    bool contains(const key_type& k) const { return find(k) != end(); }
#endif
};

template<class K, class T, class H, class E, class A>
void swap(unordered_multimap<K, T, H, E, A>& a, unordered_multimap<K, T, H, E, A>& b) { a.swap(b); }

