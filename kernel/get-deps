# SkylineSystem dependency check.
#
# Third-party sources (lwIP, lwext4, FatFs, flanterm, stb_truetype, libart,
# tidwall hashmap, mpaland/printf, x86mem) are vendored in-tree, so there is
# nothing to download here. The only external artefacts are fetched by the
# top-level Makefile:
#   * limine-binary/  <- Limine release tarball (prebuilt bootloader)
#   * limine-protocol <- cloned only when kernel/src/limine.h is missing
#   * OVMF            <- only for `make run` (UEFI)
#
# This script used to contain clone/download helpers that were never called
# (a no-op). It now verifies that the vendored dependencies are actually
# present, so a truncated checkout fails loudly instead of at compile time.
set -eu

srcdir="$(dirname "$0")"
cd "$srcdir"

missing=0
check() {
    if [ ! -e "$1" ]; then
        echo "error: missing vendored dependency: kernel/$1" >&2
        missing=1
    fi
}

check include/lwip/lwipopts.h
check include/fs/lwext4/ext4.h
check include/fs/fatfs/ff.h
check include/flanterm/flanterm.h
check src/limine.h

if [ "$missing" -ne 0 ]; then
    echo "get-deps: vendored dependencies incomplete" >&2
    exit 1
fi

echo "get-deps: vendored dependencies present; nothing to download"
